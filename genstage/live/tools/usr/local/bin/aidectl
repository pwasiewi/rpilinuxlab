#!/bin/bash
# aidectl — AIDE file-integrity lifecycle: baseline, check, report reading.
# Wraps the aide(1) two-step dance (run + activate new database) and the two
# report sinks configured in aide.conf (journal via aide-check.service and
# /var/log/aide/aide.log).
set -euo pipefail

CONF="${AIDE_CONF:-/etc/aide/aide.conf}"
UNIT="aide-check.service"
LOCK="/run/lock/aidectl.lock"
# ntfy topic for reconcile notices; 'off' disables (and then reconcile still accepts)
NTFY_URL="${AIDECTL_NTFY_URL:-http://192.168.0.88:8090/aide}"
NOTICE=""
trap 'if [[ -n ${NOTICE} ]]; then rm -f -- "${NOTICE}"; fi' EXIT

help() {
    cat <<EOF
Usage: aidectl [-c CONF] [-y] <verb> [args]

Verbs:
  init          Build the first baseline and activate it.
                Refuses to overwrite an existing baseline without confirmation.
  check         One-shot integrity check against the current baseline
                (same as the daily timer run; report goes to stdout + log).
  update        Check AND write a new database in one pass, then — after
                confirmation — activate it as the new baseline.
                Use after reviewing/explaining reported changes.
  report [N]    Print the last N reports from the log file (default 1).
  journal       Show timer-run history from the journal (extra args pass
                through to journalctl, e.g.: aidectl journal --since -7d).
  status        Timer, baseline and log at a glance.
  reconcile [--dry-run]
                Check AND write a new database (like update), then accept it
                WITHOUT a prompt only if every finding is explained by Portage:
                the file belongs to a package merged since the baseline
                (/var/log/emerge.log), its md5/symlink target matches that
                package's CONTENTS and its sha256 matches what AIDE recorded
                (one read); only content may change — a new setuid/setgid bit,
                capability, owner, ACL or xattr HOLDs; data caches (mime, icon,
                gschemas, info dir, ...) count when anything was merged, the
                module-listing caches (pixbuf loaders, gtk immodules, gio
                modules, gconv) only when every listed .so is package-owned
                (gconv: regenerated byte-for-byte); a removal counts only if
                no installed package still owns the path and it belonged to an
                unmerged package or an older version of a merged one.
                HOLD (old baseline kept, exit 3) on anything else, and ALWAYS on
                /etc, /boot, /efi, /root, ~/.ssh. Every accept and HOLD is sent
                to ntfy BEFORE the new db is activated; no notice, no accept
                (exit 4). --dry-run classifies only and sends nothing.
                Full classification: /var/log/aide/reconcile.log.
  classify JSON T0 [VDB EMERGE_LOG [ROOT]]
                Run only the reconcile classifier on an aide JSON report
                (T0 = baseline epoch). ROOT prefixes every filesystem access
                (fixtures under /tmp). For testing and debugging.

Environment (reconcile): AIDECTL_NTFY_URL (default ${NTFY_URL}, 'off' = no
notices), AIDECTL_MAX_FINDINGS (60000), AIDECTL_MAX_REMOVED (5000).

Options:
  -c CONF       aide config (default: ${CONF})
  -y            skip the confirmation prompt (init/update)

Exit-code cheat sheet (aide): 0 = clean, 1-7 = differences found
(bitmask: 1 added, 2 removed, 4 changed), >=14 = real error.
aidectl treats 1-7 as reportable findings, >=14 as fatal.
EOF
}

die() { echo "❌ $*" >&2; exit 1; }

# notify TITLE PRIORITY TAGS BODYFILE -> 0 only when ntfy accepted the message
notify() {
    if [[ ${NTFY_URL} == off ]]; then
        logger -t aidectl "ntfy off (AIDECTL_NTFY_URL=off): $1"
        return 0
    fi
    curl -fsS --max-time 15 -o /dev/null -H "Title: $1" -H "Priority: $2" -H "Tags: $3" \
        --data-binary @"$4" "${NTFY_URL}"
}

db_sha() { sha256sum "$1" | cut -c1-64; }

confirm() {
    [[ ${ASSUME_YES} == yes ]] && return 0
    local reply
    read -r -p "$1 Type 'yes' to proceed: " reply
    [[ ${reply} == yes ]] || die "Aborted."
}

need_root() { [[ ${EUID} -eq 0 ]] || die "Root required."; }

# database_in/database_out from aide.conf (file: URLs), with stock defaults
db_path() {  # db_path <database_in|database_out>
    local val
    val=$(grep -E "^${1}=file:" "${CONF}" | tail -1 | cut -d: -f2- || true)
    [[ -n ${val} ]] && { echo "${val}"; return; }
    case "$1" in
        database_in)  echo /var/lib/aide/aide.db ;;
        database_out) echo /var/lib/aide/aide.db.new ;;
    esac
}

# Run aide capturing its exit code without tripping set -e; 1-7 = findings.
run_aide() {  # run_aide <--init|--check|--update> -> sets AIDE_RC
    AIDE_RC=0
    flock -n 9 || die "Another aide run holds ${LOCK} (timer job in progress?)"
    /usr/bin/aide "$1" --config="${CONF}" || AIDE_RC=$?
    [[ ${AIDE_RC} -lt 14 ]] ||
        die "aide $1 failed with exit ${AIDE_RC} (>=14 = internal error, not findings) — new database NOT activated"
} 9>"${LOCK}"

activate() {
    local dbin dbout
    dbin=$(db_path database_in); dbout=$(db_path database_out)
    [[ -s ${dbout} ]] || die "No new database at ${dbout} — nothing to activate."
    mv -f "${dbout}" "${dbin}"
    echo "✅ Baseline activated: ${dbin} ($(date -r "${dbin}" '+%F %T'))"
}

cmd_init() {
    local dbin; dbin=$(db_path database_in)
    if [[ -s ${dbin} ]]; then
        confirm "Baseline ${dbin} already exists — a fresh init REPLACES it and forgets all history."
    fi
    run_aide --init
    activate
}

cmd_check() {
    run_aide --check
    if [[ ${AIDE_RC} -eq 0 ]]; then
        echo "✅ Clean — filesystem matches the baseline."
    else
        echo "⚠  Differences found (exit ${AIDE_RC}). Review above; if all changes are explained, run: aidectl update"
    fi
}

cmd_update() {
    run_aide --update
    if [[ ${AIDE_RC} -eq 0 ]]; then
        echo "✅ Clean — baseline unchanged, new database discarded."
        rm -f "$(db_path database_out)"
        return
    fi
    confirm "Accept the differences above as the new baseline?"
    activate
}

cmd_report() {
    local n="${1:-1}" log
    [[ ${n} =~ ^[0-9]+$ ]] || die "report takes a number, got: ${n}"
    log=$(grep -E "^report_url=file:" "${CONF}" | tail -1 | cut -d: -f2- || true)
    log="${log:-/var/log/aide/aide.log}"
    [[ -s ${log} ]] || die "No reports yet in ${log}"
    # reports are appended; split on their first line and print the last N
    awk -v n="${n}" '
        /^Start timestamp:/ { c++ }
        { blk[c] = blk[c] $0 "\n" }
        END { for (i = (c-n+1 > 1 ? c-n+1 : 1); i <= c; i++) printf "%s", blk[i] }
    ' "${log}"
}

cmd_journal() {
    journalctl -u "${UNIT}" --no-pager "$@"
}

cmd_status() {
    local dbin; dbin=$(db_path database_in)
    systemctl list-timers "${UNIT%.service}.timer" --no-pager 2>/dev/null || true
    echo
    if [[ -s ${dbin} ]]; then
        echo "Baseline: ${dbin} — $(stat -c '%s bytes, activated %y' "${dbin}" | cut -d. -f1)"
    else
        echo "Baseline: MISSING — run: aidectl init"
    fi
    local log; log=$(grep -E "^report_url=file:" "${CONF}" | tail -1 | cut -d: -f2- || true)
    log="${log:-/var/log/aide/aide.log}"
    if [[ -s ${log} ]]; then
        echo "Last report ($(date -r "${log}" '+%F %T')):"
        grep -E "^(Start timestamp|AIDE found|  (Added|Removed|Changed) entries)" "${log}" | tail -5
    else
        echo "No reports in ${log} yet."
    fi
}

# Classifier for 'reconcile' (stdlib Python, run isolated with -I).
# argv: JSON T0 [VDB EMERGE_LOG [ROOT]] -> prints a summary, writes the full list
# to RECONCILE_LOG and an ntfy body to RECONCILE_NOTICE when set;
# exit 0 = every finding explained, 3 = hold, anything else = classifier error.
CLASSIFIER=$(cat <<'PY'
import base64, binascii, hashlib, json, os, re, stat, subprocess, sys, tempfile, time

# argv: JSON T0 [VDB [EMERGE_LOG [ROOT]]]. ROOT is a test hook for `classify`
# only (fixtures live under /tmp); cmd_reconcile never passes it.
argv = sys.argv
report, t0 = argv[1], int(argv[2])
vdb = argv[3] if len(argv) > 3 and argv[3] else "/var/db/pkg"
elog = argv[4] if len(argv) > 4 and argv[4] else "/var/log/emerge.log"
ROOT = argv[5].rstrip("/") if len(argv) > 5 else ""
outlog = os.environ.get("RECONCILE_LOG", "")
notice = os.environ.get("RECONCILE_NOTICE", "")
MAX_FINDINGS = int(os.environ.get("AIDECTL_MAX_FINDINGS", "60000"))
MAX_REMOVED = int(os.environ.get("AIDECTL_MAX_REMOVED", "5000"))
MAX_ATTRIB_OWNERS = 40   # a removal "explained" only via a dir shared by more packages is too weak

def fs(p):
    return ROOT + p

SENSITIVE = re.compile(r"^/(etc|boot|efi|root)(/|$)|^/home/[^/]+/\.ssh(/|$)")
# Data caches regenerated by package postinst/eselect, never listed in CONTENTS.
DATA_CACHES = re.compile(
    r"^/usr/share/mime(/|$)"
    r"|^/usr/share/icons/[^/]+/icon-theme\.cache$"
    r"|^/usr/share/applications/mimeinfo\.cache$"
    r"|^/usr/share/glib-2\.0/schemas/gschemas\.compiled$"
    r"|^/usr/share/info/dir$"
    r"|^/usr/share/fonts/.*/(fonts\.(dir|scale)|\.uuid)$"
    r"|^/usr/lib/locale/locale-archive$")
# P0-4: caches that name shared objects to dlopen(). Value = (kind, module path prefix).
CODE_CACHES = [
    (re.compile(r"^/usr/lib(64)?/gdk-pixbuf-2\.0/[^/]+/loaders\.cache$"), "pixbuf", r"^/usr/lib(64)?/gdk-pixbuf-2\.0/"),
    (re.compile(r"^/usr/lib(64)?/gtk-[234]\.0/[^/]+/immodules\.cache$"), "gtkim", r"^/usr/lib(64)?/gtk-[234]\.0/"),
    (re.compile(r"^/usr/lib(64)?/gio/modules/giomodule\.cache$"), "gio", None),
    (re.compile(r"^/usr/lib64/gconv/gconv-modules\.cache$"), "gconv", None),
]
# P0-3: removals here are always reviewed by hand (unowned files included).
CRITICAL_RM = re.compile(
    r"^/usr/local(/|$)|^/usr/lib/modules(/|$)|^/usr/lib(64)?/security(/|$)"
    r"|^/usr/lib/systemd(/|$)|^/usr/lib/(udev|sysctl\.d|modprobe\.d|modules-load\.d|tmpfiles\.d|sysusers\.d|pam\.d|binfmt\.d)(/|$)"
    r"|^/usr/share/polkit-1(/|$)")
HASHES = {"md5", "sha1", "sha256", "sha512", "rmd160", "tiger", "crc32", "crc32b",
          "haval", "gost", "whirlpool", "stribog256", "stribog512"}
BENIGN = {"modify_time", "change_time", "access_time", "inode", "block_count"}
# P0-1: the only attributes a package merge may change without review, per file type.
ALLOWED = {"f": {"size", "growing_size"} | HASHES | BENIGN,
           "d": {"size", "link_count"} | BENIGN,
           "l": {"size", "link_name"} | BENIGN}
ADDED_XATTRS_OK = {"user.pax.flags"}
ACL_BASE = re.compile(r"^A: (user|group|other)::[r-][w-][x-]$")
PN = re.compile(r"^([^/]+/.+?)-\d[^-]*(-r\d+)?$")

def no_dupes(pairs):
    d = {}
    for k, v in pairs:
        if k in d:  # AIDE 0.18.8 escapes only '\' in names: a crafted name can forge keys
            raise ValueError(f"duplicate JSON key {k!r} — crafted file name in the AIDE report?")
        d[k] = v
    return d

with open(report) as f:
    rep = json.load(f, object_pairs_hook=no_dupes)
added, removed, changed = (rep.get(k) or {} for k in ("added", "removed", "changed"))
details = rep.get("details") or {}
for k, v in (("added", added), ("removed", removed), ("changed", changed)):
    if not isinstance(v, dict):
        sys.exit(f"classifier: '{k}' is not an object (report_grouped / summarize_changes changed?)")

# packages merged / unmerged since the baseline
merged, unmerged = set(), set()
pat_m = re.compile(r"^(\d+):\s+::: completed emerge \(\d+ of \d+\) (\S+) to /")
pat_u = re.compile(r"^(\d+):\s+>>> unmerge success: (\S+)")
with open(elog, errors="replace") as f:
    for line in f:
        m = pat_m.match(line) or pat_u.match(line)
        if m and int(m.group(1)) >= t0:
            (merged if "completed emerge" in line else unmerged).add(m.group(2))

def pn(atom):
    m = PN.match(atom)
    return m.group(1) if m else atom
unmerged_pn = {pn(a) for a in unmerged}

# Canonical path = realpath(dirname) + basename: CONTENTS lists /usr/sbin/visudo,
# /sbin/*, /lib/modules/* on this merged-usr host; AIDE reports the physical path.
_rp = {}
def canon(p):
    d, _, b = p.rpartition("/")
    c = _rp.get(d)
    if c is None:
        r = os.path.realpath(fs(d or "/"))
        if ROOT and (r == ROOT or r.startswith(ROOT + "/")):
            r = r[len(ROOT):]
        c = _rp[d] = r.rstrip("/")
    return f"{c}/{b}" if b else (c or "/")

def contents_lines(cf):
    with open(cf, errors="replace") as f:
        for line in f:
            line = line.rstrip("\n")
            if line.startswith("obj "):
                body, md5, _mt = line[4:].rsplit(" ", 2)
                yield body, ("obj", md5)
            elif line.startswith("sym "):
                path, _, target = line[4:].rsplit(" ", 1)[0].partition(" -> ")
                yield path, ("sym", target)
            elif line.startswith("dir "):
                yield line[4:], ("dir", None)

def all_atoms():
    for cat in sorted(os.listdir(vdb)):
        cd = os.path.join(vdb, cat)
        if not os.path.isdir(cd):
            continue
        for p in sorted(os.listdir(cd)):
            if os.path.isfile(os.path.join(cd, p, "CONTENTS")):
                yield f"{cat}/{p}"

# CONTENTS index of the merged packages that are still installed (canonical paths)
index = {}
for atom in sorted(merged):
    cf = os.path.join(vdb, atom, "CONTENTS")
    if os.path.isfile(cf):
        for path, (etype, ref) in contents_lines(cf):
            index[canon(path)] = (etype, ref, atom)

def aide_hex(v):
    if not isinstance(v, str) or not v:
        return None
    if re.fullmatch(r"[0-9a-f]{32,128}", v):
        return v
    try:
        return base64.b64decode(v, validate=True).hex()
    except (binascii.Error, ValueError):
        return None

def new_val(det, field):
    a = det.get(field)
    return a.get("new") if isinstance(a, dict) else None

def read_once(path, keep=False):
    """P0-2: one open, one read; md5 (CONTENTS) and sha256 (AIDE) of the same bytes."""
    fd = os.open(fs(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise IsADirectoryError(path)
        m, s, buf = hashlib.md5(), hashlib.sha256(), []
        while chunk := os.read(fd, 1 << 20):
            m.update(chunk); s.update(chunk)
            if keep:
                buf.append(chunk)
        return m.hexdigest(), s.hexdigest(), st.st_size, (b"".join(buf) if keep else None)
    finally:
        os.close(fd)

def ftype_of(path, summary, det):
    if isinstance(summary, str) and len(summary) > 1:
        return summary[0]
    p = new_val(det, "perm") if det else None
    if isinstance(p, str) and p:
        return {"-": "f"}.get(p[0], p[0])
    try:
        st = os.lstat(fs(path))
    except OSError:
        return "?"
    return "d" if stat.S_ISDIR(st.st_mode) else "l" if stat.S_ISLNK(st.st_mode) else "f" if stat.S_ISREG(st.st_mode) else "?"

def attr_gate(det, ft):
    """P0-1 for changed entries: anything outside ALLOWED[ft] is a HOLD."""
    extra = set(det) - ALLOWED.get(ft, set())
    return f"attribute change: {','.join(sorted(extra))}" if extra else None

def priv_gate(det, ft):
    """P0-1 for added entries: no special bits, foreign owner, ACL or security xattr."""
    perm = new_val(det, "perm")
    if not isinstance(perm, str) or len(perm) != 10:
        return "no recorded perm (JSON sink needs report_level=added_removed_entries)"
    bad = []
    if perm[3] in "sS": bad.append("setuid")
    if perm[6] in "sl": bad.append("setgid")          # AIDE prints sgid-without-x as 'l'
    if perm[9] in "tT": bad.append("sticky")
    if perm[8] == "w" and ft != "l": bad.append("world-writable")
    for fld in ("uid", "gid"):
        v = new_val(det, fld)
        if v not in (None, 0, "0"):
            bad.append(f"{fld}={v}")
    acl = new_val(det, "acl")
    for e in ([acl] if isinstance(acl, str) else acl or []):
        if not ACL_BASE.match(e):
            bad.append(f"acl '{e}'")
    xa = new_val(det, "xattrs")
    for e in ([xa] if isinstance(xa, str) else xa or []):
        m = re.match(r"^\[\d+\] (\S+) (=|<=>) ", e)
        if m and m.group(1) not in ADDED_XATTRS_OK:
            bad.append(f"xattr {m.group(1)}")
    return ("new " + ", ".join(bad)) if bad else None

# --- P0-4 pre-pass: read each code cache once, tie to AIDE's sha256, list its modules
def code_cache_kind(path):
    for rx, kind, prefix in CODE_CACHES:
        if rx.match(path):
            return kind, prefix
    return None, None

QUOTED = re.compile(r'"((?:[^"\\]|\\.)*)"')
cache_info = {}       # path -> (error or None, kind, [module paths], bytes)
for path in list(added) + list(changed):
    kind, prefix = code_cache_kind(path)
    if not kind:
        continue
    det = details.get(path) or {}
    want = aide_hex(new_val(det, "sha256"))
    try:
        _m, sha, _sz, data = read_once(path, keep=True)
    except OSError as e:
        cache_info[path] = (f"unreadable ({e.strerror or e})", kind, [], b""); continue
    if want is None:
        cache_info[path] = ("no AIDE sha256 for the cache", kind, [], data); continue
    if sha != want:
        cache_info[path] = ("cache bytes differ from what AIDE recorded (TOCTOU?)", kind, [], data); continue
    mods, err = [], None
    text = data.decode("utf-8", "replace")
    if kind in ("pixbuf", "gtkim"):
        for ln in text.splitlines():
            if ln.startswith("#") or not ln.strip():
                continue
            toks = QUOTED.findall(ln)
            rest = QUOTED.sub("", ln).strip()
            if len(toks) == 1 and not rest:
                mods.append(toks[0])
            elif any(t.endswith(".so") or t.startswith("/") and ".so" in t for t in toks):
                err = f"shared-object path outside a module line: {ln[:80]}"
        for mpath in mods:
            if not mpath.startswith("/") or not mpath.endswith(".so") or ".." in mpath.split("/"):
                err = f"module path not absolute .so: {mpath}"
            elif not re.match(prefix, mpath):
                err = f"module outside {prefix}: {mpath}"
    elif kind == "gio":
        base = path.rsplit("/", 1)[0]
        for ln in text.splitlines():
            if not ln.strip():
                continue
            name, sep, _eps = ln.partition(":")
            if not sep or not re.fullmatch(r"[A-Za-z0-9._+-]+\.so", name):
                err = f"bad giomodule.cache line: {ln[:80]}"
            else:
                mods.append(f"{base}/{name}")
    cache_info[path] = (err, kind, mods, data)

# --- P0-3/P0-4: one pass over ALL installed CONTENTS, but remember only queried paths
def stem(name):
    """Version-free name: torchaudio-2.11.0a0+4e3e282.dist-info -> torchaudio, libicuuc.so.76.1 -> libicuuc.so"""
    s = re.sub(r"[-_.]?v?\d.*$", "", name)
    return s if len(s) >= 3 and s != name else None

_ls = {}
def listing(d):
    if d not in _ls:
        try:
            _ls[d] = os.listdir(fs(d))
        except OSError:
            _ls[d] = []
    return _ls[d]

def siblings(anc, path):
    """Existing entries next to the removed subtree root that differ only by version."""
    child = path[len(anc) + 1:].split("/")[0]
    st = stem(child)
    return [f"{anc}/{n}" for n in listing(anc) if n != child and stem(n) == st] if st else []

def ancestors(p):
    while True:
        p = p.rpartition("/")[0]
        if not p or p == "/usr":
            return
        yield p

query = set()
for path in removed:
    query.add(path)
    for anc in ancestors(path):
        query.add(anc)
        if os.path.isdir(fs(anc)):
            query.update(siblings(anc, path))
for err, kind, mods, _d in cache_info.values():
    query.update(mods)
owners = {}           # canonical path -> [(etype, atom)]
if query:
    for atom in all_atoms():
        for path, (etype, _ref) in contents_lines(os.path.join(vdb, atom, "CONTENTS")):
            c = canon(path)
            if c in query:
                owners.setdefault(c, []).append((etype, atom))

def judge_code_cache(path):
    err, kind, mods, data = cache_info[path]
    if err:
        return False, "cache-code", err
    if not merged:
        return False, "cache-code", "code cache changed but nothing merged"
    if kind == "gconv":
        with tempfile.TemporaryDirectory(prefix="aidectl-gconv-") as td:
            out = os.path.join(td, "gconv-modules.cache")
            cmd = ["/usr/bin/iconvconfig", "-o", out] + ([f"--prefix={ROOT}"] if ROOT else [])
            r = subprocess.run(cmd, env={"PATH": "/usr/bin:/bin", "LC_ALL": "C"},
                               stdin=subprocess.DEVNULL, capture_output=True, timeout=60)
            if r.returncode != 0:
                return False, "cache-code", f"iconvconfig failed ({r.returncode})"
            with open(out, "rb") as f:
                same = f.read() == data
        return (True, "cache-gconv", "regenerated by iconvconfig byte-for-byte") if same else \
               (False, "cache-code", "gconv cache differs from iconvconfig output")
    for mpath in mods:
        own = [a for t, a in owners.get(mpath, []) if t == "obj"]
        if not own:
            return False, "cache-code", f"module not owned by an installed package: {mpath}"
        if not os.path.isfile(fs(mpath)) or os.path.islink(fs(mpath)):
            return False, "cache-code", f"module missing or a symlink: {mpath}"
    return True, f"cache-{kind}", f"{len(mods)} modules, all package-owned"

def judge_removed(path):
    if code_cache_kind(path)[0] or DATA_CACHES.match(path):
        return (True, "rm-cache", "cache removed during a merge") if (merged or unmerged) else \
               (False, "rm-unexplained", "cache removed but nothing merged")
    if os.path.lexists(fs(path)):
        return False, "rm-present", "AIDE says removed, but the path exists"
    if not path.startswith("/usr/"):
        return False, "rm-unexplained", "removal outside /usr"
    if CRITICAL_RM.match(path):
        return False, "rm-critical", "removal under a critical directory"
    own = owners.get(path)
    if own:
        return False, "rm-owned", f"still owned by installed {own[0][1]} (missing package file)"
    if not unmerged_pn:
        return False, "rm-unexplained", "nothing unmerged since the baseline"
    for anc in ancestors(path):
        o = owners.get(anc)
        if not o:
            continue
        pns = {pn(a) for _t, a in o}
        hit = sorted(pns & unmerged_pn)
        if hit and len(pns) <= MAX_ATTRIB_OWNERS:
            return True, "rm-unmerged", f"{hit[0]} unmerged; owns {anc}"
        # shared dir (site-packages, /usr/lib64): accept only via a same-stem sibling,
        # e.g. foo-1.2.dist-info removed while foo-1.3.dist-info is owned by unmerged foo
        for sib in siblings(anc, path):
            shit = sorted({pn(a) for _t, a in owners.get(sib, [])} & unmerged_pn)
            if shit:
                return True, "rm-sibling", f"{shit[0]} unmerged; owns the new version {sib}"
        if hit:
            return False, "rm-weak", f"only the shared dir {anc} ({len(pns)} owners) links it to {hit[0]}"
        return False, "rm-unexplained", f"nearest owned dir {anc} belongs to {sorted(pns)[0]}…, none unmerged"
    return False, "rm-unexplained", "no owned ancestor directory"

def judge(path, summary, kind):
    if SENSITIVE.match(path):
        return False, "sensitive", "sensitive path (always reviewed by hand)"
    if kind == "removed":
        return judge_removed(path)
    det = details.get(path)
    if not isinstance(det, dict):
        return False, "no-details", "no AIDE details (JSON sink needs report_level=added_removed_entries)"
    ft = ftype_of(path, summary, det)
    gate = attr_gate(det, ft) if kind == "changed" else priv_gate(det, ft)
    if gate:
        return False, "attr", gate
    if path in cache_info:
        return judge_code_cache(path)
    if DATA_CACHES.match(path):
        return (True, "cache-data", "post-merge data cache") if merged else \
               (False, "cache-data", "cache changed but nothing merged")
    ent = index.get(path)
    if ent is None:
        return False, "unowned", "not owned by any package merged since the baseline"
    etype, ref, atom = ent
    try:
        if etype == "obj":
            if ft != "f":
                return False, "type", f"{atom}: CONTENTS says file, AIDE saw '{ft}'"
            want = aide_hex(new_val(det, "sha256"))
            if want is None and kind == "changed" and not (set(det) & HASHES):
                want = "unchanged"          # metadata-only change (BENIGN attrs), content same as baseline
            if want is None:
                return False, "no-hash", f"{atom}: AIDE recorded no sha256"
            md5, sha, size, _ = read_once(path)
            if md5 != ref:
                return False, "md5", f"{atom}: MD5 MISMATCH vs CONTENTS"
            if want != "unchanged" and sha != want:
                return False, "toctou", f"{atom}: file read now differs from what AIDE recorded"
            nsz = new_val(det, "size")
            if nsz is not None and int(nsz) != size:
                return False, "toctou", f"{atom}: size differs from what AIDE recorded"
            return True, "obj", f"{atom}: md5 = CONTENTS, sha256 = AIDE"
        if etype == "sym":
            if ft != "l" or not os.path.islink(fs(path)):
                return False, "type", f"{atom}: CONTENTS says symlink, disk differs"
            ln = new_val(det, "link_name")
            if ln is not None and ln != ref:
                return False, "sym", f"{atom}: AIDE link target differs from CONTENTS"
            return (True, "sym", f"{atom}: link target matches") if os.readlink(fs(path)) == ref else \
                   (False, "sym", f"{atom}: LINK TARGET MISMATCH")
        if etype == "dir":
            return (True, "dir", f"{atom}: directory") if ft == "d" and os.path.isdir(fs(path)) else \
                   (False, "type", f"{atom}: CONTENTS says dir, disk differs")
    except (OSError, ValueError) as e:
        return False, "unreadable", f"{atom}: unreadable ({getattr(e, 'strerror', None) or e})"
    return False, "type", "unknown CONTENTS entry type"

rows = []
for kind, entries in (("added", added), ("removed", removed), ("changed", changed)):
    for path, summary in entries.items():
        ok, rule, why = judge(path, summary, kind)
        rows.append((ok, kind, path, rule, why))

# --- structural and volume guards (P0-5): synthetic HOLD rows
n_find = len(rows)
noe = rep.get("number_of_entries") or {}
for k, v in (("added", added), ("removed", removed), ("changed", changed)):
    if k in noe and int(noe[k]) != len(v):
        rows.append((False, "report", "*", "structure", f"{k}: summary says {noe[k]}, report lists {len(v)}"))
if rep.get("different_attributes"):
    rows.append((False, "report", "*", "structure",
                 f"{len(rep['different_attributes'])} entries changed their AIDE rule (aide.conf edit?)"))
if n_find > MAX_FINDINGS:
    rows.append((False, "report", "*", "volume", f"{n_find} findings > AIDECTL_MAX_FINDINGS={MAX_FINDINGS}"))
n_rm_ok = sum(1 for r in rows if r[0] and r[3] in ("rm-unmerged", "rm-sibling"))
if n_rm_ok > MAX_REMOVED:
    rows.append((False, "report", "*", "volume", f"{n_rm_ok} accepted removals > AIDECTL_MAX_REMOVED={MAX_REMOVED}"))

held = sum(1 for r in rows if not r[0])
per_rule = {}
for ok, _k, _p, rule, _w in rows:
    key = ("OK " if ok else "HOLD ") + rule
    per_rule[key] = per_rule.get(key, 0) + 1

print(f"reconcile: baseline {time.strftime('%F %T', time.localtime(t0))}; merged since: {len(merged)}, unmerged: {len(unmerged)}")
print(f"  findings: {n_find} (added {len(added)}, removed {len(removed)}, changed {len(changed)}); explained {sum(1 for r in rows if r[0])}, HELD {held}")
print("  rules: " + ", ".join(f"{k} {v}" for k, v in sorted(per_rule.items())))
holds = [r for r in rows if not r[0]]
for ok, kind, path, rule, why in holds[:40]:
    print(f"  HOLD {kind:7} {path}  — [{rule}] {why}")
if held > 40:
    print(f"  ... {held - 40} more HOLD lines in the full log")
if outlog:
    with open(outlog, "a") as f:
        f.write(f"=== {time.strftime('%F %T')} report={report} baseline_t0={t0} merged={sorted(merged)} unmerged={sorted(unmerged)}\n")
        for ok, kind, path, rule, why in rows:
            f.write(f"{'OK  ' if ok else 'HOLD'} {kind:7} {path}\t{rule}\t{why}\n")
if notice:   # body for the ntfy message; cmd_reconcile adds the aide.db hashes
    lines = [f"findings {n_find} (+{len(added)} -{len(removed)} ~{len(changed)}), HOLD {held}",
             f"merged {len(merged)}: " + " ".join(sorted(merged))[:600],
             f"unmerged {len(unmerged)}"]
    lines += [f"{k}: {v}" for k, v in sorted(per_rule.items(), key=lambda kv: (-kv[1], kv[0]))]
    lines += [f"HOLD {p} [{rule}] {why}"[:200] for _o, _k, p, rule, why in holds[:8]]
    with open(notice, "w") as f:
        f.write("\n".join(lines)[:3500] + "\n")
sys.exit(0 if held == 0 else 3)
PY
)

# JSON report path: the report_url that follows a report_format=json line
json_report() {
    awk -F'file:' '/^report_format=/{fmt=$0} /^report_url=file:/{ if (fmt=="report_format=json") print $2 }' "${CONF}" | tail -1
}

cmd_classify() {
    [[ $# -ge 2 ]] || die "classify JSON T0 [VDB EMERGE_LOG]"
    python3 -I -c "${CLASSIFIER}" "$@"
}

cmd_reconcile() {
    local dry=no rc json dbin dbout t0 old_sha new_sha host
    [[ ${1:-} == --dry-run ]] && dry=yes
    dbin=$(db_path database_in); dbout=$(db_path database_out)
    [[ -s ${dbin} ]] || die "No baseline at ${dbin} — run: aidectl init"
    json=$(json_report)
    [[ -n ${json} ]] || die "aide.conf has no JSON report sink (report_format=json before a report_url=file: line)"
    t0=$(stat -c %Y "${dbin}")
    run_aide --update
    if [[ ${AIDE_RC} -eq 0 ]]; then
        echo "✅ Clean — baseline unchanged, new database discarded."
        rm -f "${dbout}"
        return 0
    fi
    [[ -s ${json} ]] || die "aide wrote no JSON report at ${json}"
    NOTICE=$(mktemp /run/aidectl-notice.XXXXXX)
    host=$(hostname -s)
    old_sha=$(db_sha "${dbin}")
    rc=0
    RECONCILE_LOG=/var/log/aide/reconcile.log RECONCILE_NOTICE="${NOTICE}" \
        python3 -I -c "${CLASSIFIER}" "${json}" "${t0}" || rc=$?
    if [[ ${rc} -eq 0 && ${dry} == no ]]; then
        # no notice, no accept: the phone copy is the off-host record of every baseline
        new_sha=$(db_sha "${dbout}")
        printf 'old aide.db %s\nnew aide.db %s\n' "${old_sha}" "${new_sha}" >> "${NOTICE}"
        if ! notify "${host}: AIDE reconcile ACCEPTED" default white_check_mark "${NOTICE}"; then
            rm -f "${dbout}"
            logger -t aidectl "reconcile: ntfy notice failed — baseline unchanged"
            echo "⚠  HOLD — ntfy notice failed, baseline unchanged. Accept by hand with: aidectl update"
            return 4
        fi
        activate
        [[ $(db_sha "${dbin}") == "${new_sha}" ]] || die "activated ${dbin} differs from the announced sha256 ${new_sha}"
        logger -t aidectl "reconcile: every finding explained by Portage, new baseline activated (sha256 ${new_sha})"
        return 0
    fi
    rm -f "${dbout}"
    if [[ ${rc} -eq 0 ]]; then
        echo "✅ (dry run) every finding explained — 'aidectl reconcile' would activate the new baseline."
        return 0
    fi
    if [[ ${rc} -ne 3 ]]; then
        if [[ ${dry} == no ]]; then
            echo "classifier exit ${rc}; aide.db ${old_sha} kept" > "${NOTICE}"
            notify "${host}: AIDE reconcile ERROR" high warning "${NOTICE}" || true
        fi
        die "classifier failed (exit ${rc}) — baseline unchanged"
    fi
    printf 'baseline kept: aide.db %s\n' "${old_sha}" >> "${NOTICE}"
    if [[ ${dry} == no ]] && ! notify "${host}: AIDE reconcile HOLD" high warning "${NOTICE}"; then
        echo "⚠  ntfy notice for this HOLD failed" >&2
    fi
    logger -t aidectl "reconcile: HOLD, unexplained findings — baseline unchanged (see /var/log/aide/reconcile.log)"
    echo "⚠  HOLD — baseline unchanged. Review the HOLD lines; accept by hand with: aidectl update"
    return 3
}

ASSUME_YES=no
while getopts ":c:yh" opt; do
    case "${opt}" in
        c) CONF="${OPTARG}" ;;
        y) ASSUME_YES=yes ;;
        h) help; exit 0 ;;
        *) help; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -ge 1 ]] || { help; exit 0; }
verb="$1"; shift

case "${verb}" in
    init)    need_root; cmd_init ;;
    check)   need_root; cmd_check ;;
    update)  need_root; cmd_update ;;
    report)  need_root; cmd_report "$@" ;;
    journal) cmd_journal "$@" ;;
    status)  need_root; cmd_status ;;
    reconcile) need_root; cmd_reconcile "$@" ;;
    classify)  cmd_classify "$@" ;;
    -h|--help|help) help ;;
    *) die "Unknown verb: ${verb} (see: aidectl -h)" ;;
esac
