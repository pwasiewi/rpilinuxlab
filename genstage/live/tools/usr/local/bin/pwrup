#!/usr/bin/env python3
"""pwrup — update helper for the pwr overlay.

Answers three questions the overlay itself doesn't:
  which packages are pwr-only vs patched forks vs version bumps of ::gentoo
  (index), which bin/app packages have newer upstream releases (check), and
  how to bump one with the least typing (bump).

Classification against ::gentoo (highest non-live version on each side):
  ONLY   not in ::gentoo at all — pwr is the sole source
  BUMP   pwr carries a NEWER version than ::gentoo
  FORK   same version as ::gentoo — exists for its patches/USE changes
  OLDER  pwr is BEHIND ::gentoo — candidate for deletion or resync
  LIVE   only -9999 ebuilds in pwr

`check` reads the github remote-id from each package's metadata.xml and
compares the newest non-prerelease tag against the pwr version. Upstreams
that are not on GitHub (google-chrome, slack, ...) are skipped — those
packages live in ::gentoo anyway and update there.

Some upstreams publish every channel as a full GitHub release (brave marks
nightlies non-prerelease), so `check` also honours an optional per-package
asset filter in <overlay>/pwrup.conf:

    # cat/pkg  <regex an asset name must match for the release to count>
    www-client/brave-bin  ^brave-browser_[0-9.]+_amd64\\.deb$

A filtered package only accepts releases carrying a matching asset; the
tags/atom fallbacks are disabled for it (they cannot see assets).
"""

import argparse
import json
import os
import re
import sys
import urllib.request
from datetime import date
from pathlib import Path

PWR = Path(os.environ.get("PWR_DIR", "/home/pwas/Claude/pwr"))
GENTOO = Path("/var/db/repos/gentoo")
VDB = Path("/var/db/pkg")
INDEX = PWR / "INDEX.md"
MANUAL_MARK = "<!-- MANUAL NOTES — everything below survives `pwrup index` -->"
SKIP_DIRS = {"profiles", "metadata", "eclass", "licenses", ".git"}

try:
    from portage.versions import vercmp as _vercmp
except ImportError:  # non-Gentoo host: good enough for sane version strings
    def _vercmp(a, b):
        def key(v):
            return [int(x) if x.isdigit() else x
                    for x in re.split(r"[._-]", v) if x]
        ka, kb = key(a), key(b)
        return (ka > kb) - (ka < kb)


def vercmp(a, b):
    # portage returns None for strings that are not valid versions (git tags
    # like "2024-01-release"); treat those as equal rather than crashing
    r = _vercmp(a, b)
    return 0 if r is None else r


def valid_version(v):
    return _vercmp(v, v) is not None


def die(msg):
    print(f"pwrup: {msg}", file=sys.stderr)
    sys.exit(1)


def ebuild_versions(pkgdir: Path, pkg: str):
    vers = []
    for f in pkgdir.glob(f"{pkg}-*.ebuild"):
        v = f.name[len(pkg) + 1:-len(".ebuild")]
        if v and v[0].isdigit():
            vers.append(v)
    return vers


def highest(vers):
    """Highest non-live version, or None if only -9999 (or nothing)."""
    real = [v for v in vers if not v.startswith("9999")]
    if not real:
        return None
    top = real[0]
    for v in real[1:]:
        if vercmp(v, top) > 0:
            top = v
    return top


def remote_id(pkgdir: Path):
    meta = pkgdir / "metadata.xml"
    if not meta.is_file():
        return None, None
    m = re.search(r'remote-id type="([^"]+)">([^<]+)<', meta.read_text())
    return (m.group(1), m.group(2)) if m else (None, None)


def installed_version(cat: str, pkg: str):
    """(version, repository) of the installed copy, or (None, None)."""
    for d in VDB.glob(f"{cat}/{pkg}-*"):
        v = d.name[len(pkg) + 1:]
        if not v or not v[0].isdigit():
            continue  # sibling package sharing the prefix (llama-cpp-cpu)
        repo = (d / "repository")
        return v, repo.read_text().strip() if repo.is_file() else "?"
    return None, None


def scan_overlay():
    """Yield dicts describing every package in the overlay, sorted."""
    out = []
    for catdir in sorted(PWR.iterdir()):
        if not catdir.is_dir() or catdir.name in SKIP_DIRS:
            continue
        for pkgdir in sorted(catdir.iterdir()):
            pkg = pkgdir.name
            vers = ebuild_versions(pkgdir, pkg) if pkgdir.is_dir() else []
            if not vers:
                continue  # junk dir without ebuilds
            cat = catdir.name
            top = highest(vers)
            live = any(v.startswith("9999") for v in vers)
            gdir = GENTOO / cat / pkg
            gtop = highest(ebuild_versions(gdir, pkg)) if gdir.is_dir() else None
            if not gdir.is_dir():
                cls = "ONLY"
            elif top is None:
                cls = "LIVE"
            elif gtop is None or vercmp(top, gtop) > 0:
                cls = "BUMP"
            elif vercmp(top, gtop) == 0:
                cls = "FORK"
            else:
                cls = "OLDER"
            patches = len(list((pkgdir / "files").glob("*"))) \
                if (pkgdir / "files").is_dir() else 0
            rtype, rid = remote_id(pkgdir)
            ivers, irepo = installed_version(cat, pkg)
            out.append(dict(cat=cat, pkg=pkg, top=top, live=live, gtop=gtop,
                            cls=cls, patches=patches, rtype=rtype, rid=rid,
                            ivers=ivers, irepo=irepo))
    return out


# ---------------------------------------------------------------------------
# index
# ---------------------------------------------------------------------------
def cmd_index(_args):
    rows = scan_overlay()
    manual = ""
    if INDEX.is_file():
        text = INDEX.read_text()
        if MANUAL_MARK in text:
            manual = text[text.index(MANUAL_MARK):]
    if not manual:
        manual = MANUAL_MARK + "\n\n## Notes\n\n(add per-package notes here)\n"

    counts = {}
    for r in rows:
        counts[r["cls"]] = counts.get(r["cls"], 0) + 1
    lines = [
        "# pwr overlay — package index",
        "",
        f"Generated by `pwrup index` on {date.today()}. "
        f"{len(rows)} packages: "
        + ", ".join(f"{v} {k}" for k, v in sorted(counts.items())) + ".",
        "",
        "Class vs ::gentoo — ONLY: not in gentoo; BUMP: pwr newer; FORK: same",
        "version, exists for its patches; OLDER: pwr behind gentoo (resync or",
        "drop!); LIVE: only -9999 here. `inst` = installed version::repo.",
        "",
        "| package | pwr | ::gentoo | class | files/ | inst | upstream |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    ]
    for r in rows:
        ver = r["top"] or ""
        if r["live"]:
            ver = (ver + " +9999").strip()
        inst = f"{r['ivers']}::{r['irepo']}" if r["ivers"] else ""
        up = f"{r['rtype']}:{r['rid']}" if r["rid"] else ""
        lines.append(
            f"| {r['cat']}/{r['pkg']} | {ver} | {r['gtop'] or ''} "
            f"| {r['cls']} | {r['patches'] or ''} | {inst} | {up} |")
    lines += [
        "",
        "## Quick update recipes",
        "",
        "- **Version bump (bin/app packages):** `pwrup check` to see what's",
        "  stale, then `pwrup bump cat/pkg NEWVER` (copies the newest ebuild,",
        "  regenerates the Manifest). Review, test-install, then:",
        "  commit + push in ~/Claude/pwr, `sudo emaint sync -r pwr`,",
        "  `git pull` in /home/tmp/.repos/pwr (image builds read that clone).",
        "- **FORK packages:** diff against ::gentoo before bumping — the whole",
        "  point is the local patches; re-apply them onto the new ebuild.",
        "- **OLDER packages:** decide — either the pwr copy earned its keep",
        "  (pinned on purpose: say so in Notes) or delete it and let ::gentoo",
        "  take over.",
        "- **LIVE (-9999):** no bump needed; rebuild pulls HEAD. Pin via",
        "  EGIT_COMMIT in package.env when reproducibility matters.",
        "",
    ]
    INDEX.write_text("\n".join(lines) + "\n" + manual)
    print(f"wrote {INDEX} ({len(rows)} packages)")
    stale = [f"{r['cat']}/{r['pkg']}" for r in rows if r["cls"] == "OLDER"]
    if stale:
        print("OLDER than ::gentoo (resync or drop):", ", ".join(stale))


# ---------------------------------------------------------------------------
# check
# ---------------------------------------------------------------------------
def gh_token():
    """GITHUB_TOKEN, else the logged-in gh CLI's token (anonymous API is
    60 req/h — one full `check` run blows through that)."""
    tok = os.environ.get("GITHUB_TOKEN")
    if tok is None:
        import subprocess
        try:
            tok = subprocess.run(["gh", "auth", "token"], capture_output=True,
                                 text=True, timeout=10).stdout.strip() or None
        except (OSError, subprocess.TimeoutExpired):
            tok = None
        os.environ["GITHUB_TOKEN"] = tok or ""
    return tok or None


def gh_get(url):
    tok = gh_token()
    req = urllib.request.Request(url, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "pwrup",
        **({"Authorization": f"Bearer {tok}"} if tok else {}),
    })
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def clean_tag(tag, pkg):
    """Normalize a git tag to a comparable version, or None."""
    t = tag.strip()
    for pre in (f"{pkg}-", "v", "V"):
        if t.startswith(pre):
            t = t[len(pre):]
    if not re.fullmatch(r"[0-9][0-9a-z._-]*", t):
        return None
    return t if valid_version(t) else None


def gh_atom(rid, feed):
    """Tag names from the releases.atom/tags.atom web feed — not subject to
    the API rate limit, but releases.atom cannot filter out prereleases."""
    from urllib.parse import unquote
    req = urllib.request.Request(f"https://github.com/{rid}/{feed}",
                                 headers={"User-Agent": "pwrup"})
    with urllib.request.urlopen(req, timeout=20) as r:
        text = r.read().decode("utf-8", "replace")
    # entry ids look like <id>tag:github.com,2008:Repository/1234/v2.16.0</id>
    return [unquote(t)
            for t in re.findall(r"Repository/\d+/([^<]+)</id>", text)]


def load_filters():
    """cat/pkg -> asset-name regex from <overlay>/pwrup.conf (optional)."""
    conf = PWR / "pwrup.conf"
    filt = {}
    if conf.is_file():
        for ln in conf.read_text().splitlines():
            ln = ln.strip()
            if not ln or ln.startswith("#"):
                continue
            parts = ln.split(None, 1)
            if len(parts) != 2:
                die(f"pwrup.conf: expected 'cat/pkg regex', got: {ln}")
            cp, rx = parts
            try:
                filt[cp] = re.compile(rx)
            except re.error as e:
                die(f"pwrup.conf: bad regex for {cp}: {e}")
    return filt


def latest_upstream(rid, pkg, asset_re=None):
    """Newest final-release version for a github repo, or (None, why)."""
    cand, note = [], None
    try:
        rels = gh_get(f"https://api.github.com/repos/{rid}/releases?per_page=30")
        for rel in rels:
            if rel.get("draft") or rel.get("prerelease"):
                continue
            if asset_re and not any(asset_re.search(a.get("name", ""))
                                    for a in rel.get("assets", [])):
                continue  # wrong channel (nightly/beta published as release)
            v = clean_tag(rel.get("tag_name", ""), pkg)
            if v:
                cand.append(v)
        if not cand and not asset_re:  # repo tags without release objects
            tags = gh_get(f"https://api.github.com/repos/{rid}/tags?per_page=30")
            cand = [v for t in tags
                    if (v := clean_tag(t.get("name", ""), pkg))]
    except Exception as e:  # noqa: BLE001 — reported per-package below
        note = f"api: {e}"
    if not cand and asset_re:
        return None, note or "no release has an asset matching pwrup.conf filter"
    if not cand:
        for feed in ("releases.atom", "tags.atom"):
            try:
                cand = [v for t in gh_atom(rid, feed)
                        if (v := clean_tag(t, pkg))]
            except Exception as e:  # noqa: BLE001
                note = note or f"atom: {e}"
            if cand:
                note = "via atom feed — prereleases not filtered"
                break
    if not cand:
        return None, note or "no parseable release tags"
    top = cand[0]
    for v in cand[1:]:
        if vercmp(v, top) > 0:
            top = v
    return top, note


def cmd_check(args):
    rows = scan_overlay()
    if args.packages:
        want = set(args.packages)
        rows = [r for r in rows
                if f"{r['cat']}/{r['pkg']}" in want or r["pkg"] in want]
        if not rows:
            die(f"no overlay package matches: {' '.join(args.packages)}")
    else:
        rows = [r for r in rows if r["rtype"] == "github" and r["top"]]
    filters = load_filters()
    stale = 0
    for r in rows:
        cp = f"{r['cat']}/{r['pkg']}"
        if r["rtype"] != "github" or not r["rid"]:
            print(f"SKIP      {cp:44} no github remote-id in metadata.xml")
            continue
        if not r["top"]:
            print(f"SKIP      {cp:44} live-only (-9999)")
            continue
        up, why = latest_upstream(r["rid"], r["pkg"], filters.get(cp))
        if up is None:
            print(f"?         {cp:44} {why}")
        elif vercmp(up, r["top"]) > 0:
            stale += 1
            extra = f"  [{why}]" if why else ""
            print(f"OUTDATED  {cp:44} pwr {r['top']}  ->  upstream {up}{extra}")
        elif vercmp(up, r["top"]) < 0:
            print(f"AHEAD     {cp:44} pwr {r['top']}  (upstream {up})")
        else:
            print(f"ok        {cp:44} {r['top']}")
    if stale:
        print(f"\n{stale} outdated — bump with: pwrup bump cat/pkg NEWVER")
    sys.exit(1 if stale else 0)


# ---------------------------------------------------------------------------
# bump
# ---------------------------------------------------------------------------
def cmd_bump(args):
    m = re.fullmatch(r"([^/]+)/([^/]+)", args.package)
    if not m:
        die("package must be category/name, e.g. www-client/brave-bin")
    cat, pkg = m.groups()
    pkgdir = PWR / cat / pkg
    pkgdir.is_dir() or die(f"no such overlay package: {pkgdir}")
    top = highest(ebuild_versions(pkgdir, pkg)) or die(f"{pkg}: only -9999 here")
    new = pkgdir / f"{pkg}-{args.version}.ebuild"
    if new.exists():
        die(f"{new.name} already exists")
    src = pkgdir / f"{pkg}-{top}.ebuild"
    new.write_text(src.read_text())
    print(f"copied {src.name} -> {new.name}")
    if os.system(f"ebuild {new} manifest") != 0:
        die("Manifest failed — fix SRC_URI (or fetch) and re-run "
            f"`ebuild {new} manifest`")
    print(f"""Manifest OK. Next:
  1. review: diff against {src.name}; FORK packages: re-check local patches
  2. test:   sudo emerge -1a ={cat}/{pkg}-{args.version}::pwr
  3. ship:   git -C {PWR} add {cat}/{pkg} && git -C {PWR} commit && push
             sudo emaint sync -r pwr
             git -C /home/tmp/.repos/pwr pull   # image builds read this clone
  4. index:  pwrup index""")


def main():
    ap = argparse.ArgumentParser(
        prog="pwrup", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("index", help="(re)generate INDEX.md in the overlay")
    c = sub.add_parser("check", help="compare pwr versions with GitHub releases")
    c.add_argument("packages", nargs="*",
                   help="cat/pkg or pkg (default: all with a github remote-id)")
    b = sub.add_parser("bump", help="copy newest ebuild to VERSION + Manifest")
    b.add_argument("package", help="category/name")
    b.add_argument("version", help="new upstream version")
    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        sys.exit(0)
    PWR.is_dir() or die(f"overlay not found: {PWR} (set PWR_DIR)")
    {"index": cmd_index, "check": cmd_check, "bump": cmd_bump}[args.cmd](args)


if __name__ == "__main__":
    main()
