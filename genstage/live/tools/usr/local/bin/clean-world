#!/bin/bash
# clean-world — Gentoo world-file hygiene: find world entries that are
# redundant (hard runtime dependencies of other installed packages) and
# deselect them one by one, without falling into the provider-choice trap.
#
# Every world entry is classified from the vdb — RDEPEND/PDEPEND/IDEPEND of
# all installed packages. Build-time DEPEND/BDEPEND are ignored on purpose:
# depclean reasons about runtime deps only, so a build-time-only consumer
# would not protect the entry anyway.
#
#   STALE     not installed any more — what 'emaint --fix world' removes
#   LEAF      nothing depends on it: world is exactly where it belongs — keep
#   PROVIDER  referenced only inside '|| ( ... )' any-of groups (usually via
#             a virtual, e.g. zen-sources <- virtual/linux-sources): the
#             world entry pins YOUR provider choice — keep
#   DEP       hard runtime dependency of another installed package: redundant
#             in world; safe to deselect — it stays installed while a
#             consumer stays and is swept by depclean when the last one goes
#
# Only DEP entries are ever offered for deselection. Deselection edits the
# world file directly (exact-line removal; first change makes a
# world.bak-clean-world backup) — same effect as 'emerge --deselect', but it
# works identically on a live-image rootfs via -r. Nothing is ever unmerged:
# a modifying run ends with 'emerge -p --depclean' so the consequences are
# visible before any real depclean.
#
# The review workflow for a long DEP list: '-g FILE' writes the candidates
# one per line, grouped by how safe the deselection usually is (libraries
# first, system/toolchain last) and sorted inside each group by consumer
# count (more consumers = better anchored). Edit the file — DELETE or
# comment out everything you want to KEEP — then '-a FILE' walks it with
# per-entry y/N prompts; 'yes y |' bulk-accepts a reviewed file.

set -euo pipefail

help() { cat <<EOF
Usage: clean-world [-r ROOT] -c [ENTRY...]   classify world entries (report)
       clean-world [-r ROOT] -i [ENTRY...]   interactive: drop STALE entries,
                                             per-entry deselect prompts for
                                             DEP, depclean preview      [root]
       clean-world [-r ROOT] -g FILE         write the DEP candidates to FILE,
                                             grouped for review
       clean-world [-r ROOT] -a FILE         deselect the entries left in
                                             FILE, y/N per entry        [root]
Options:
  -r ROOT    operate on ROOT's world/vdb instead of / (live-image rootfs)
  ENTRY...   limit -c/-i to these world entries (default: the whole file)
Examples:
  clean-world -c                       audit the host's world
  clean-world -g /tmp/world.plan       plan file; edit, KEEP = delete the line
  sudo clean-world -a /tmp/world.plan  apply what remained, one y/N each
  yes y | sudo clean-world -a /tmp/world.plan     bulk-accept a reviewed plan
  sudo xp host clean-world -c          the same audit via the xp dispatcher
  sudo xp nvidiahard clean-world -c    audit the live image's world
EOF
}

die()  { echo "❌  $*" >&2; exit 1; }
info() { echo ">>>  $*"; }
warn() { echo "⚠️   $*" >&2; }

MODE="" ROOT="" PLAN=""
ONLY=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) help; exit 0 ;;
        -c) MODE=check ;;
        -i) MODE=interactive ;;
        -g) MODE=plan;  shift; [[ $# -ge 1 ]] || die "-g needs a file"; PLAN="$1" ;;
        -a) MODE=apply; shift; [[ $# -ge 1 ]] || die "-a needs a file"; PLAN="$1" ;;
        -r) shift; [[ $# -ge 1 ]] || die "-r needs a directory"
            ROOT="${1%/}" ;;
        -*) die "Unknown option: $1 (see: clean-world -h)" ;;
        *)  ONLY+=("$1") ;;
    esac
    shift
done
[[ -n ${MODE} ]] || { help; exit 0; }

WORLD="${ROOT}/var/lib/portage/world"
VDB="${ROOT}/var/db/pkg"
[[ -f ${WORLD} ]] || die "No world file: ${WORLD}"
[[ -d ${VDB} ]]   || die "No package database: ${VDB}"
case ${MODE} in interactive|apply)
    [[ ${EUID} -eq 0 ]] || die "Root required for -${MODE:0:1}." ;;
esac

TMPD=$(mktemp -d)
trap 'command rm -rf "${TMPD}"' EXIT

changed=0
backup_once() {
    [[ ${changed} -eq 0 ]] || return 0
    command cp -p "${WORLD}" "${WORLD}.bak-clean-world"
    info "Backup: ${WORLD}.bak-clean-world"
}
drop_entry() {
    backup_once
    # grep -vxF into a temp, then cat back: keeps the inode, owner and mode
    grep -vxF "$1" "${WORLD}" > "${TMPD}/world.new" || true
    cat "${TMPD}/world.new" > "${WORLD}"
    changed=$((changed + 1))
}
depclean_preview() {
    echo
    if [[ ${changed} -eq 0 ]]; then
        info "No changes made."
        return 0
    fi
    info "${changed} entries removed — depclean preview (nothing is unmerged):"
    if [[ -z ${ROOT} ]]; then
        emerge -p --depclean || warn "depclean preview failed — resolve before any real depclean"
    else
        emerge --root="${ROOT}" --config-root="${ROOT}" -p --depclean ||
            warn "depclean preview failed (image config resolves against host paths) — verify inside the chroot"
    fi
    info "Review the list above; run the real depclean yourself when satisfied."
}

# --- apply mode: no classification, just the reviewed plan -----------------
if [[ ${MODE} == apply ]]; then
    [[ -f ${PLAN} ]] || die "No plan file: ${PLAN}"
    n_skip=0
    # the plan comes in on fd 3: stdin must stay free for the y/N prompts —
    # a plain 'done < plan' would make the inner read eat plan lines as
    # answers (and 'yes y |' could never reach it)
    while IFS= read -r line <&3; do
        entry=$(echo "${line}" | sed 's/[[:space:]]*#.*//; s/[[:space:]]*$//')
        [[ -n ${entry} ]] || continue
        if ! grep -qxF "${entry}" "${WORLD}"; then
            warn "skip (not a world entry — already deselected?): ${entry}"
            n_skip=$((n_skip + 1))
            continue
        fi
        ans=""; read -r -p "  deselect ${entry}? [y/N] " ans || ans=""
        if [[ ${ans} == y ]]; then
            drop_entry "${entry}"
            echo "        deselected ${entry}"
        fi
    done 3< "${PLAN}"
    [[ ${n_skip} -eq 0 ]] || info "Skipped ${n_skip} entries not present in world."
    depclean_preview
    exit 0
fi

# --- classification (check / interactive / plan) ---------------------------
DEPFILES="${TMPD}/depfiles"
find "${VDB}" -mindepth 3 -maxdepth 3 \
    \( -name RDEPEND -o -name PDEPEND -o -name IDEPEND \) > "${DEPFILES}"

# hard_ref FILE — how a vdb dep file refers to the package in ${CW_RE}:
# exit 0 = hard dependency (outside every '|| ( ... )' group; use? groups
# count as hard), 2 = any-of only, 1 = no reference (grep pre-filter hit a
# substring, e.g. cat/foo matching cat/foo-tools). Blockers (!atom) are
# conflicts, not deps, and never count.
hard_ref() {
    awk '
    { n = split($0, t, /[ \t]+/)
      for (i = 1; i <= n; i++) {
          tok = t[i]
          if (tok == "||") { pend = 1; continue }
          if (tok == "(")  { anyof[depth++] = pend; pend = 0; continue }
          if (tok == ")")  { depth--; continue }
          pend = 0
          if (tok ~ /^!/) continue
          sub(/\[[^\]]*\]$/, "", tok)
          if (tok ~ ENVIRON["CW_RE"]) {
              hard = 1
              for (d = 0; d < depth; d++) if (anyof[d]) hard = 0
              if (hard) { got_hard = 1; exit }
              got_any = 1
          }
      } }
    END { if (got_hard) exit 0; exit got_any ? 2 : 1 }
    ' "$1"
}

# consumer file path -> "category/name" of the depending package
consumer_pkg() {
    local d="${1%/*}"
    local pf="${d##*/}" cat="${d%/*}"; cat="${cat##*/}"
    echo "${cat}/$(echo "${pf}" | sed 's/-[0-9].*$//')"
}

# plan grouping: how risky is deselecting an entry of this kind, on average.
# 1 = C/C++ libraries, 2 = language/virtual packages, 3 = plugins/themes/
# fonts, 4 = tools & applications (keep what you want for itself!),
# 5 = system/boot/toolchain (extra care; some are @system-protected anyway)
group_of() {
    local cat="${1%%/*}" pn="${1##*/}"
    case "${cat}" in
        sys-devel|sys-apps|sys-kernel|sys-boot|sys-fs|sys-auth|sys-process|sys-power|sys-block|llvm-core|llvm-runtimes)
            echo 5 ;;
        *-libs|dev-cpp) echo 1 ;;
        dev-python|dev-perl|dev-ruby|dev-java|dev-lua|dev-tcltk|virtual) echo 2 ;;
        media-plugins|x11-themes|media-fonts|app-emacs|app-vim|kde-frameworks) echo 3 ;;
        *) [[ ${pn} == lib* ]] && echo 1 || echo 4 ;;
    esac
}
GROUP_TITLES=(
    ""  # 1-based
    "C/C++ libraries — the safe end: nothing here is an end-user application"
    "language & virtual packages — python/perl/... modules, usually safe"
    "plugins, themes, fonts — safe, they follow their application"
    "tools & applications — KEEP the ones you want for themselves (world is where that is recorded)"
    "system, boot & toolchain — extra care; @system protects some, not all"
)

if [[ ${#ONLY[@]} -gt 0 ]]; then
    for e in "${ONLY[@]}"; do
        grep -qxF "${e}" "${WORLD}" || die "'${e}' is not a world entry in ${WORLD}"
    done
    ENTRIES=("${ONLY[@]}")
else
    mapfile -t ENTRIES < "${WORLD}"
fi

declare -a STALE=() DEPSEL=() DEPINFO=()
n_leaf=0 n_prov=0
for entry in "${ENTRIES[@]}"; do
    [[ -n ${entry} ]] || continue
    if [[ ${entry} == @* ]]; then
        warn "skipping set entry: ${entry}"
        continue
    fi
    # cat/pn: strip a version-operator prefix, a :slot suffix, and (only when
    # an operator forced a version) the version itself
    catpn=$(echo "${entry}" | sed 's/^[<>=~!]*//; s/:.*//')
    [[ ${entry} == [\<\>=~]* ]] && catpn=$(echo "${catpn}" | sed 's/-[0-9][^/]*$//')

    if ! compgen -G "${VDB}/${catpn}-[0-9]*" > /dev/null; then
        printf 'STALE     %s   (not installed)\n' "${entry}"
        STALE+=("${entry}")
        continue
    fi

    # regex for one dep token; [+] etc. bracket-escaped so gtk+-style names work
    esc=$(echo "${catpn}" | sed 's/[+.]/[&]/g')
    export CW_RE="^[!<>=~]*${esc}(-[0-9][^:]*)?(:.*)?\$"

    hard_by="" soft_by=""
    while IFS= read -r f; do
        # other slots of the same package are not consumers of it
        [[ $(consumer_pkg "${f}") == "${catpn}" ]] && continue
        rc=0; hard_ref "${f}" || rc=$?
        case ${rc} in
            0) hard_by+="$(consumer_pkg "${f}") " ;;
            2) soft_by+="$(consumer_pkg "${f}") " ;;
        esac
    done < <(xargs -a "${DEPFILES}" grep -lF -- "${catpn}" 2>/dev/null | sort -u)

    hard_by=$(echo "${hard_by}" | tr ' ' '\n' | grep . | sort -u | tr '\n' ' ' || true)
    if [[ -n ${hard_by// } ]]; then
        printf 'DEP       %-40s <- %s\n' "${entry}" "${hard_by}"
        DEPSEL+=("${entry}")
        DEPINFO+=("${entry}|${hard_by% }")
    elif [[ -n ${soft_by// } ]]; then
        soft_by=$(echo "${soft_by}" | tr ' ' '\n' | grep . | sort -u | tr '\n' ' ' || true)
        printf 'PROVIDER  %-40s any-of via: %s\n' "${entry}" "${soft_by}"
        n_prov=$((n_prov + 1))
    else
        printf 'LEAF      %s\n' "${entry}"
        n_leaf=$((n_leaf + 1))
    fi
done

info "leaf: ${n_leaf} (keep)  provider-choice: ${n_prov} (keep)  hard-dep: ${#DEPSEL[@]} (deselectable)  stale: ${#STALE[@]}"

# --- plan mode: grouped candidate file for review --------------------------
if [[ ${MODE} == plan ]]; then
    {
        echo "# clean-world plan — $(hostname), root ${ROOT:-/}, $(date +%F)"
        echo "# One candidate per line, riskiest groups last. Review: DELETE or"
        echo "# comment out every line you want to KEEP in world, then:"
        echo "#   sudo clean-world${ROOT:+ -r ${ROOT}} -a ${PLAN}"
        echo "#   yes y | sudo clean-world${ROOT:+ -r ${ROOT}} -a ${PLAN}   # bulk, after review"
        for g in 1 2 3 4 5; do
            glines=""
            for di in "${DEPINFO[@]}"; do
                entry="${di%%|*}"; consumers="${di#*|}"
                catpn=$(echo "${entry}" | sed 's/^[<>=~!]*//; s/:.*//')
                [[ $(group_of "${catpn}") == "${g}" ]] || continue
                n=$(echo "${consumers}" | wc -w)
                short=$(echo "${consumers}" | tr ' ' '\n' | head -5 | tr '\n' ' ')
                [[ ${n} -le 5 ]] || short="${short}…"
                glines+="$(printf '%03d|%-44s # %s: %s' "${n}" "${entry}" "${n}" "${short% }")"$'\n'
            done
            [[ -n ${glines} ]] || continue
            echo
            echo "## ${GROUP_TITLES[g]}"
            # inside a group: most consumers first — better anchored, safer
            printf '%s' "${glines}" | sort -t'|' -k1,1nr | cut -d'|' -f2-
        done
    } > "${PLAN}"
    info "Plan written: ${PLAN} (${#DEPSEL[@]} candidates in $(grep -c '^## ' "${PLAN}") groups)"
    exit 0
fi
[[ ${MODE} == interactive ]] || exit 0

# --- interactive part ------------------------------------------------------
if [[ ${#STALE[@]} -gt 0 ]]; then
    echo
    info "${#STALE[@]} stale entr$( [[ ${#STALE[@]} -eq 1 ]] && echo y || echo ies) (this is what 'emaint --fix world' does):"
    printf '    %s\n' "${STALE[@]}"
    ans=""; read -r -p "Drop them all? [y/N] " ans || ans=""
    if [[ ${ans} == y ]]; then
        for e in "${STALE[@]}"; do drop_entry "${e}"; done
        info "Dropped ${#STALE[@]} stale entries."
    fi
fi

if [[ ${#DEPSEL[@]} -gt 0 ]]; then
    echo
    info "Hard-dep entries, one decision each (y = deselect, anything else keeps):"
    for e in "${DEPSEL[@]}"; do
        ans=""; read -r -p "  deselect ${e}? [y/N] " ans || ans=""
        if [[ ${ans} == y ]]; then
            drop_entry "${e}"
            echo "        deselected"
        fi
    done
fi

depclean_preview
