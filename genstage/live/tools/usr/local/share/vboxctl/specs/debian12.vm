# Debian 12 server node — unattended = yes (preseed generated by VirtualBox);
# also the base for `vboxctl packer debian12 --box` (preseed in http/).
name       = debian12
ostype     = Debian12_64
iso        = debian-12.2.0-amd64-DVD-1.iso
cpus       = 2
ram        = 4G
vram       = 32
firmware   = efi
chipset    = ich9
controller = sata
disk       = 32G
nic        = nat,type=virtio
nic        = bridged,type=virtio          # first Up bridge on the host
port       = ssh,2222,22
usb        = off
audio      = off
clipboard  = off
paravirt   = kvm
unattended = yes
user       = user
password   = changeme
hostname   = debian12.local
locale     = en_US
timezone   = Europe/Warsaw
additions  = on
post_install = apt-get install -y openssh-server sudo && usermod -aG sudo user
ssh_user   = user
box        = generic/debian12
