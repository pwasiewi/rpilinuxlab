+/**
+ * The FFTW planner (fftw_plan_*, fftw_destroy_plan, and zita-convolver's
+ * Convproc setup/cleanup built on it) is not thread-safe. Every user of it
+ * holds this mutex (backport of upstream 95842279ab, 2025-12-13).
+ */
+inline std::mutex& fftw_lock() {
+  static std::mutex fftw_mutex;
+  return fftw_mutex;
+}
