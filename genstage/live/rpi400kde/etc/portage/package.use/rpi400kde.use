# Per-package USE for the rpi400kde profile. Synced into the crossdev sysroot
# as package.use/xprofile-rpi400kde.use by 'xarm setup'/'xarm tune' and shipped
# onto the card by 'xp rpi400kde conf' — keep both sides in this one file.
# Global flags belong in PROF_BOARD_USE (profiles/rpi400kde.conf), not here.
#
# Starts empty on purpose: entries are added per resolver failure during the
# Phase 2 probe (emerge -pv), each with a one-line reason.

# REQUIRED_USE any-of(adolc boost ... openmp ... sparsehash ...): the sysroot
# bootstrap keeps -openmp globally, so pick the cheapest backend — sparsehash
# is header-only. Chain: plasma-meta -> spectacle -> opencv[eigen] -> eigen.
dev-cpp/eigen sparsehash

# -gtk drops app-admin/system-config-printer, whose chain ends in
# libnotify[introspection] -> gobject-introspection: unbuildable with crossdev
# (glib vendors the scanner since 2.88). Printing itself is untouched — CUPS
# and the KDE print dialog stay; only the GTK printer-setup tool goes.
kde-plasma/print-manager -gtk

# Cellular-modem protocol backends: libqmi[qrtr] -> libqrtr-glib and libmbim
# are GLib libraries that ship introspection data, the same cross wall as
# above. Chain: plasma-meta[networkmanager] -> plasma-nm -> modemmanager-qt ->
# modemmanager. A Pi 400 has no WWAN modem; ModemManager itself stays.
net-misc/modemmanager -qmi -qrtr -mbim

# Both flags exist to keep a bare "-I/usr/include" out of the cross compile.
# media-gfx/graphite2 ships a pkg-config file that is literally
# "Cflags: -I/usr/include" with no prefix variable, so pkg-config's
# PKG_CONFIG_SYSROOT_DIR has nothing to rewrite; every consumer (harfbuzz ->
# pango -> ...) then parses the HOST glibc headers next to the sysroot's and
# dies on -Werror=redundant-decls. cairo drags the same closure in through
# libharfbuzz-cairo. Neither is needed by Qt/KDE: graphite is SIL smart-font
# shaping, libharfbuzz-cairo serves hb-view.
media-libs/harfbuzz -cairo -graphite

# Bootstrap cycle on a fresh ROOT (nothing installed yet): sys-libs/gpm needs
# ncurses to build, and the arm64 desktop profile default is ncurses[+gpm],
# which needs gpm back (buildtime_slot_op). -gpm on ncurses breaks the cycle;
# gpm itself still merges fine once ncurses exists. Cost: ncurses-linked
# terminal apps lose gpm mouse support in text UIs — irrelevant under Plasma.
sys-libs/ncurses -gpm

# The pam flag (profile default, no reverse dep requires it) builds
# pam_gnome_keyring — a GNOME-keyring login-unlock module, meaningless on a
# KDE/kwallet image — AND its pam_test binary, which meson links against the
# HOST's x86 libpamtest.so whenever the host also has pam_wrapper installed
# ("file in wrong format"). Cutting the flag removes both.
app-crypt/libsecret -pam

# wpa_gui-qt4 (USE=gui) is built with qmake, which has no cross awareness:
# it loads the HOST's /usr/lib64/qt6/mkspecs and injects the x86-only
# -mno-direct-extern-access into the aarch64 compile. Nothing is lost:
# plasma-nm is the WiFi UI on this image, wpa_gui is a redundant X11 tool.
net-wireless/wpa_supplicant -gui

# Cross-compile autoconf trap, not a real feature gap: eventfd(2) is a
# RUNTIME test the configure script cannot execute under cross (no target
# binary can run natively), so it falls back to "assuming no" — and the
# ebuild's default +eventfd USE explicitly requests --enable-itc=eventfd
# regardless, which conflicts with that "no" and hard-fails configure.
# -eventfd switches to --enable-itc=pipe, which has no such runtime check.
net-libs/libmicrohttpd -eventfd
