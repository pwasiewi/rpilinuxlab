# Keywords for the rpi400kde profile — synced to the sysroot as
# package.accept_keywords/xprofile-rpi400kde.keywords by 'xarm setup'/'tune'.
# Empty on purpose: Plasma 6.6.6 / Qt 6.11.1 / sddm / mesa are stable arm64.
# Add ~arm64 entries only per verified resolver failure, with a reason.

# emoji coverage for the desktop; ~arch on every arch (probe 2026-08-08).
# fonts-meta was dropped instead of keyworded: it cascades into ~arm64 niche
# fonts (oldstandard, ...) — the profile lists concrete stable fonts.
media-fonts/noto-emoji

# plain C, no arch-specific code; only ever keyworded ~arm64 (probe 2026-08-08)
app-forensics/aide

# ::pwr live fork (upstream left ::gentoo); shell script, arch-independent.
# The sysroot reaches ::pwr via repos.conf/pwr.conf — written by hand next to
# xarm's gentoo.conf pin, host path /var/db/repos/pwr since the 2026-08
# nvhard reinstall (not shipped to the card: the card gets the built
# binpkg, not the repo). xarm setup only creates gentoo.conf when missing,
# so the hand-written file survives.
app-forensics/lynis **

# crossdev wart: host (BROOT) build deps resolve with THIS file's keywords.
# glslang BDEPENDs the exact-same-version spirv-tools on the host, and the
# host runs the ~arch 1.4.350 line — keep the sysroot on the same versions or
# the resolver schedules a host downgrade that conflicts (probe 2026-08-08)
dev-util/glslang
dev-util/spirv-tools
dev-util/spirv-headers

# --- amdkdehard QoL transplant batch (2026-08-15) ---------------------------
# Departure from the per-verified-failure rule above, backed by the cheaper
# probe instead: an md5-cache keyword scan (skill gentoo-live-image #1b) of
# the whole transplanted list. Every atom below is ~arm64-only in ::gentoo
# and listed in PROF_PKGS — a missing entry is a guaranteed resolver abort.
app-admin/awscli-bin
app-admin/bitwarden-cli-bin
app-admin/keepassxc
app-admin/passwordsafe
app-admin/pydf
app-benchmarks/sysbench
app-crypt/johntheripper-jumbo
app-crypt/yubikey-manager
app-editors/vscodium
app-forensics/yara
app-misc/bb
app-misc/cmatrix
app-misc/evtest
app-misc/linux-logo
app-misc/solaar
app-portage/diffmask
app-portage/elogv
app-portage/euses
app-portage/ufed
app-text/podofo
app-text/qpdfview
dev-db/dbeaver-bin
dev-debug/bpftrace
dev-lang/cfortran
dev-python/yara-python
media-gfx/mypaint
media-plugins/audacious-plugins
media-sound/audacious
media-sound/pavucontrol
media-sound/strawberry
net-analyzer/iftop
net-analyzer/iptraf-ng
net-misc/putty
net-print/cups-pdf
net-vpn/networkmanager-openvpn
sys-apps/most
sys-apps/pcsc-tools
sys-auth/pam_u2f
sys-auth/yubico-piv-tool
sys-block/gparted
sys-fs/compsize
sys-fs/ddrescue
sys-fs/exfat-utils
sys-fs/fuse-exfat
sys-fs/lxcfs
sys-power/powertop
www-client/firefox-l10n
x11-apps/xlogo

# Pure PPD data with no arm64 keywords at all; printers are an explicit
# parity goal (the amd64 images got Kyocera/Samsung discovery 2026-08-14)
net-print/foomatic-db-ppds **

# Sysroot slot conflict (probe 2026-08-16): arm64-stable wayland-1.24.0
# BDEPENDs exactly ~wayland-scanner-1.24.0, but the sysroot already runs
# scanner-1.26.0 — lift wayland itself to the matching ~arm64 version.
dev-libs/wayland

# sys-apps/pcsc-tools (QoL transplant) needs its perl binding, ~arm64 only
dev-perl/pcsc-perl

# media-sound/strawberry dep, plain Qt C++ helper lib, ~arm64 only
dev-libs/kdsingleapplication

# strawberry (and eigen's chosen backend) build-dep; header-only, ~arm64
dev-cpp/sparsehash

# Autounmask batch (probe 2026-08-16), all ~arm64-only deps of QoL atoms:
# bpftrace -> bcc + blazesym_c; yubikey-manager -> signxml + python-pskc +
# ccid; johntheripper-jumbo -> two perl modules; sysbench -> concurrencykit.
dev-util/bcc
dev-libs/blazesym_c
dev-python/signxml
dev-python/python-pskc
app-crypt/ccid
dev-perl/Compress-Raw-Lzma
dev-perl/Digest-MD2
dev-libs/concurrencykit
# ...and the scanner itself: its meson cross-build demands a NATIVE
# wayland-scanner of the SAME version, and the host runs 1.26.0 — the
# arm64-stable 1.24.0 can therefore never cross-build here.
dev-util/wayland-scanner

# Cross-compiling guile hard-requires a HOST guile of the SAME version (the
# native binary precompiles the target's .go bytecode): host carries 3.0.11
# while arm64-stable is 3.0.10 -> "building Guile 3.0.10 but /usr/bin/guile
# has version 3.0.11". 3.0.11 is ~arm64; keyword it to match the host.
dev-scheme/guile

# --- alert mesh (2026-08-30) ------------------------------------------------
# ntfy push server + publish CLI, prebuilt static arm64 binary from ::pwr —
# the same trio the amd64 images keyword in common image.keywords.
# net-vpn/tailscale needs no entry: stable arm64 in ::gentoo.
net-misc/ntfy-bin ~arm64
acct-user/ntfy ~arm64
acct-group/ntfy ~arm64

# --- node box (2026-08-30) --------------------------------------------------
# BCHN official prebuilt aarch64 tarball + EloPool/ckpool fork, both ::pwr;
# acct-user/bitcoin & acct-group/bitcoin are stable arm64 (eclass keywords).
net-p2p/bitcoin-cash-node-bin ~arm64
net-misc/elopool ~arm64
