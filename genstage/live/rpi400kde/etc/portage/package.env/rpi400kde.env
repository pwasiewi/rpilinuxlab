# Per-package build-env escapes for the rpi400kde profile — synced to the
# sysroot as package.env/xprofile-rpi400kde.env. Referenced env files must
# exist in the sysroot's etc/portage/env/ (add them to this layer if needed).
# Empty until a package proves it needs a lowmem/no-ccache escape.

# ALL cross cmake builds: confine config-mode find_package to the sysroot
# (see env/cmake-cross.conf — host's newer KF6 configs win version sorting
# otherwise). Must stay FIRST so later, more specific entries can override.
*/* xprofile-cmake-cross.conf

# Host Qt6 tools live in /usr/lib64/cmake, Qt's QT_HOST_PATH probe looks in
# lib/cmake — every cross dev-qt build dies on "Qt6::syncqt not found"
# without this (see env/qt-host-cmake.conf; the xprofile- prefix is how
# 'xarm setup/tune' names synced files). Also overrides (drops) the global
# MODE_PACKAGE=ONLY above — Qt's host-tool lookup manages find roots itself.
dev-qt/* xprofile-qt-host-cmake.conf

# Cross cups detection: point configure at the sysroot's cups-config
# (see env/cups-cross.conf for the full mechanism).
app-text/ghostscript-gpl xprofile-cups-cross.conf

# Builds a native host tool in a nested cmake that inherits the ARM CFLAGS —
# x86 cc rejects -march=armv8-a (see env/neutral-cflags.conf).
kde-frameworks/syntax-highlighting xprofile-neutral-cflags.conf

# Cross-builds a native qtwaylandscanner_kde and demands KF6_HOST_TOOLING
# (see env/kf6-host-tooling.conf; add further packages hitting the same
# "Please provide a prefix with a native Qt build" error here).
kde-plasma/kwin xprofile-kf6-host-tooling.conf
kde-plasma/kwin-x11 xprofile-kf6-host-tooling.conf

# ck's configure autodetects the HOST platform under cross (see the env file)
dev-libs/concurrencykit xprofile-ck-cross-platform.conf
# zxcvbn-c's makefile compiles its dictgen generator with the HOST g++ but
# the environment CXXFLAGS — same class as syntax-highlighting above.
dev-libs/zxcvbn-c xprofile-neutral-cflags.conf
# Makefile hardcodes host "cc" but takes target CFLAGS (see the env file)
app-text/aha xprofile-cross-cc-makeopts.conf# crate links via host-emulation rust-lld without this (see the env file)
dev-libs/blazesym_c xprofile-cargo-cross-linker.conf
# cmake try_run seeded for cross (see the env file)
dev-libs/libptytty xprofile-libptytty-tryrun.conf# Cross ld cannot find the uninstalled sibling libns for rndc's link (see the
# env file header); relax shared-lib symbol checking for this one package.
net-dns/bind xprofile-bind-cross-shlib.conf
# AC_CHECK_FILES refuses to run under cross; pre-seed the two cache vars
# (colm present in the sysroot, DIST absent from the tarball).
dev-util/ragel xprofile-ragel-crossfile.conf
# Host standalone libtool links shared libs with its baked-in x86 CC; use
# the sysroot's cross-configured libtool script (see the env file header).
dev-util/dialog xprofile-dialog-cross-libtool.conf
# Host qmake's no_direct_extern_access feature injects an x86-only flag into
# the aarch64 compile; shadow the .prf via QMAKEFEATURES (see env header).
dev-python/pyqt6 xprofile-pyqt-cross-qmakefeatures.conf
