# Keyword exceptions the image needs but the host file does not supply.
#
# host.keywords is a copy of this host's list, and the host's entry for
# picom-jonaburg is a bare atom, i.e. ~amd64. That was enough here because the
# installed copy is x11-misc/picom-jonaburg-8, an orphan left over from before
# ::guru deleted the release ebuild. Only -9999 exists now, and its KEYWORDS
# sits in the non-live branch of the ebuild:
#
#   if [[ ${PV} == *9999 ]]; then EGIT_REPO_URI=...
#   else ... KEYWORDS="~amd64"; fi
#
# so at PV=9999 KEYWORDS is empty and nothing short of '**' accepts it.
#
# All four atoms below are live ebuilds: 'pkgs' will git-clone upstream HEAD at
# build time. That is unreviewed code entering the image and it makes the build
# non-reproducible — pin them (EGIT_COMMIT in ::pwr) or drop them from
# PROF_LIVE_OVERLAY_PKGS if that matters more than having them.
x11-misc/picom-jonaburg **
dev-util/tracee **
# amdkde only (::pwr): same shape, KEYWORDS empty at PV=9999.
app-misc/dezkvm **
dev-util/opencode-bin **
# Reached through the overlay set rather than listed: dev-python/tyro-9999
# (::pwr) <- sci-ml/unsloth-9999. Its own dependency is on a -9999
# docstring-parser, which has no KEYWORDS at all, so '~amd64' is not enough.
dev-python/docstring-parser **

# Testing-only, keyworded ~amd64, listed by amdkde and not by the host's own
# package.accept_keywords. Found by keyword-checking every listed atom against
# the repo rather than by hitting them one failed run at a time.
dev-util/catalyst
app-misc/qwen-code

# Testing-only DEPENDENCIES, found by resolving the whole graph rather than by
# hitting them one failed run at a time. The host's list could not cover these:
# they are pulled by versions the image resolves to and the host does not.
#   feedparser-sgmllib  <- dev-python/feedparser <- app-text/calibre
# Unversioned on purpose; autounmask suggests '=<exact version>', which rots
# at the next bump.
dev-python/feedparser-sgmllib

# The perl virtuals, as a family rather than one atom at a time.
#
# dev-lang/perl is ~amd64 in host.keywords, so the stage3's 5.42 is upgraded
# to 5.44 in pass 1 — but every virtual/perl-* has ONE version per perl
# release, and only the 5.42-matching ones are stable. Their dependency is
#   || ( =dev-lang/perl-5.42* ~perl-core/${module}-${PV} )
# and portage takes the first satisfiable branch, so with perl-5.42.2 still
# visible in the tree it schedules a SECOND perl alongside the installed 5.44
# and dies on the slot conflict. The 5.44-matching virtual (e.g.
# virtual/perl-Archive-Tar-3.120.0) is ~amd64 and invisible until keyworded.
#
# This was three hand-found atoms until 2026-08-07, when a full pass-2 resolve
# turned up virtual/perl-Archive-Tar and virtual/perl-IO-Socket-IP as well.
# There is no reason to expect that list to be complete either: the set is
# "whichever core modules a package in this image happens to reach", and it
# changes with the package list AND with every perl bump. Keywording the
# family states the actual rule — if perl is testing here, its virtuals are
# testing here. perl-core/* comes along because it is the other branch of the
# same || and has exactly the same stable-lags-perl problem.
#
# The host does not need this: it has the perl-core/* packages installed from
# earlier upgrades, so its virtuals resolve through the second branch.
virtual/perl-*
perl-core/*
#   protobuf   <- dev-ruby/google-protobuf <- googleapis-common-protos-types
#                 <- dev-ruby/grpc
# (dev-python/pyqtgraph was here for net-wireless/gqrx; both dropped from
#  amdkde on 2026-08-05 — the ~amd64 pyqtgraph caps numpy <2.5.0.)
dev-libs/protobuf

# PROF_LIVE_OVERLAY_PKGS dependencies. That step runs AFTER 'pkgs' and has its
# own resolver graph, so nothing above covers it; these came out of a single
# 'emerge -p --autounmask=y --autounmask-write=n' sweep over the whole overlay
# list on 2026-08-07, rather than one aborted run per atom.
#   glom, face      <- dev-python/semgrep
#   cachebox        <- deepdiff <- dbt-common <- dbt-adapters <- dev-util/dbt-core
#   acct-user/lemonade <- sci-ml/lemonade  (an acct-user/* is keyworded like any
#                      other package, and a missing one masks its consumer)
dev-python/glom
dev-python/face
dev-python/cachebox
acct-user/lemonade
#   ntfy user+group <- net-misc/ntfy-bin (nvidiahard overlay list, 2026-08-30)
net-misc/ntfy-bin
acct-user/ntfy
acct-group/ntfy

# host.keywords lists 'dev-util/shaderc', but shaderc lives in media-libs — the
# package moved category and the host's entry has silently matched nothing
# since. It does not bite the host, which simply never re-resolved; it is fatal
# here. dev-util/glslang IS keyworded, so the image sees glslang-1.4.350.0
# (subslot 16.3), while the newest VISIBLE shaderc stays at the stable 2026.1,
# which wants ':0/16.2='. Only shaderc-2026.2 accepts 16.3 and it is ~amd64.
# Result: an unsolvable glslang/spirv-tools/spirv-headers slot conflict.
media-libs/shaderc

# The tree pairs media-libs/alsa-lib-1.2.16.1 (stable) with alsa-utils
# 1.2.15.2 (stable) — and that combination does not compile: alsa-lib 1.2.16
# changed the error-handler callback signature, so aconnect.c fails with
# "'err' undeclared". The matching utils release is keyworded; take it.
=media-sound/alsa-utils-1.2.16 ~amd64

# Cisco Secure Client and its retro dependency stack, merged by
# 'xp <profile> restrict-run'. webkit-gtk:4 is the slot ::gentoo dropped, so it
# only exists in ::pwr and only as ~amd64; the client itself is ~amd64 because
# nothing about a vendor binary earns a stable keyword.
=net-libs/webkit-gtk-2.48.3-r1 ~amd64
net-vpn/cisco-secure-client ~amd64

# nvidiahard unsloth/vllm chain via ::stuff (2026-08-08): the five ~amd64
# deps the autounmask pass listed (mcp and friends). Bare atoms, host-file
# style; inert on images whose graphs never reach them.
dev-python/fastapi
dev-python/httpx-sse
dev-python/sse-starlette
dev-python/pybase64
dev-python/mcp

# app-misc/ddcci-driver-linux (::pwr, written 2026-08-13): an out-of-tree
# kernel module pinned to an upstream master commit. Bare atom, not '**' —
# unlike the live ebuilds at the top of this file it has a real version and
# KEYWORDS="~amd64", and the pin means 'pkgs' fetches a fixed tarball rather
# than cloning HEAD, so it does not carry their reproducibility caveat.
app-misc/ddcci-driver-linux

# games-util/modrinth-app-bin (::pwr, packaged 2026-08-16): prebuilt Tauri
# launcher repacked from the upstream GitHub-releases .deb — real version,
# KEYWORDS="-* ~amd64", pinned distfile, so a bare atom like ddcci above.
games-util/modrinth-app-bin

# nvidiahard, 2026-08-19. The Trezor set (::pwr): trezor-suite-bin is
# KEYWORDS="-* ~amd64" (prebuilt Electron, amd64 only by construction),
# dev-python/trezor carries the trezorctl CLI, and the four small ::pwr
# libraries plus hidapi/libusb1 from ::gentoo are its ~amd64-only closure —
# copied from the host's own list, where the same set was needed.
app-crypt/trezor-suite-bin
app-crypt/trezor-udev-rules
dev-python/trezor
dev-python/mnemonic
dev-python/shamir-mnemonic
dev-python/slip10
dev-python/construct-classes
dev-python/hidapi
dev-python/libusb1

# nvidiahard: the operator's own fork of the Plasma shader wallpaper (::pwr,
# EGIT branch audio-fork). PV=9999 with empty KEYWORDS, so '**' like the live
# ebuilds at the top of this file — and it shares their caveat: 'pkgs' clones
# the branch HEAD, so pin EGIT_COMMIT in ::pwr if the image has to be
# reproducible.
kde-misc/plasma-wallpaper-shader **

# mcp 2.0.0 split its type definitions into a new package. Only dev-python/mcp
# itself needs it, and the sole consumer of mcp here (dev-python/vllm-9999)
# asks for it unversioned, so the 1.28.1 -> 2.0.0 update is unobstructed once
# the new half is keyworded. Without this, @installed proposes mcp-2.0.0 every
# run and stops on "mcp-types-2.0.0 masked by ~amd64 keyword".
dev-python/mcp-types

# dev-util/perf: stable is 6.19.12, and the images run a 7.x kernel. The tool
# reads a newer kernel's counters fine — the RAPL PMU (power/energy-pkg) that
# perf is here for is version-agnostic — but a version-matched perf is worth
# having for anything beyond that, and the host already runs the ~amd64 one.
# Deliberately unversioned: pinning =dev-util/perf-7.1 would rot at the next
# kernel bump, and every profile inherits this file through the 'common'
# overlay layer, so one line covers amdkde/amdkdehard/nvidiahard/intelhard/
# corehard.
dev-util/perf
