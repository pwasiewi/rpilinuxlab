# package.use for the amd64kdehardened live image.
#
# Verbatim copy of this host's /etc/portage/package.use/{moje,systemowe}.use,
# taken 2026-08-04, for the same reason as host.keywords next door:
# PROF_LIVE_PKGS is this host's world(5), so the USE-dependency constraints
# that world needs are this host's too. sys-power/suspend[crypt] requiring
# dev-libs/libgcrypt[static-libs] is the shape of it — an unsatisfiable USE
# dependency is a resolver error, so it aborts the whole 'pkgs' run.
#
# Checked against the hardened profile before copying: nothing here touches
# hardened/pie/ssp/pic, and the flags it does set in that area — caps,
# filecaps, seccomp, -suid — all point the same way the profile does.
#
# Regenerate with:
#   cat /etc/portage/package.use/{moje,systemowe}.use

*/* PYTHON_TARGETS: -* python3_13 python3_14
*/* PYTHON_SINGLE_TARGET: -* python3_14
net-firewall/ufw PYTHON_SINGLE_TARGET: -* python3_13
sys-apps/polychromatic PYTHON_SINGLE_TARGET: -* python3_13
sys-devel/distcc PYTHON_SINGLE_TARGET: -* python3_13
dev-util/gtk-builder-convert PYTHON_SINGLE_TARGET: -* python3_13
media-libs/libffado PYTHON_SINGLE_TARGET: -* python3_13
net-mail/mailutils PYTHON_SINGLE_TARGET: -* python3_13
