# Per-package build-environment overrides. Rationale lives in each env/*.conf.
dev-qt/qtwebengine    j12.conf
net-libs/webkit-gtk   j12.conf
app-misc/oneko        std-gnu17.conf
# Every openjdk slot, not just :11 — the pkg_pretend check is on ${PN}, so any
# of them dies the same way. Kept here rather than scoped to the 'restrict-run'
# step, because a JDK can also be pulled into the main graph by anything
# needing virtual/jdk to build.
dev-java/openjdk      no-ccache.conf
# lorcon's hand-written Makefile generates .depend by invoking $(CC) in a way
# the ccache masquerade rejects outright: "ccache: error: not an absolute
# path: '.'" -> make: *** [Makefile:111: .depend] Error 1. Nothing to gain from
# caching a package this small anyway.
net-wireless/lorcon   no-ccache.conf

# The ML stack. Transplanted from this host's own package.env, MINUS its
# 'native' entries: the host builds these with -march=native, and this image is
# deliberately -march=znver3 -mtune=znver5 so the ISO still boots on something
# other than this exact CPU. Everything else in that host block applies here and
# was simply never carried over — which is how caffe2 came to build at -j32 and
# OOM the machine (see lowmem-j4.conf).
#
# caffe2 and pytorch additionally share a git commit pin — they are two halves
# of one source tree and git-r3 would otherwise fetch each independently. See
# torch-git-pin.conf.
# gcc15.conf: the CUDA packages build with gcc-15 while the desktop tracks
# gcc-16 — nvcc caps the host compiler at 15 (see the env file). This list is
# the maintained "gcc-15 set"; keep it in step with what actually feeds a .cu
# file to nvcc. It is inert in amdkdehard (a gcc-16, no-CUDA image that carries
# none of these atoms — it ships sci-misc/llama-cpp-cpu instead) and redundant
# in amdkde (gcc-15 throughout via its package.mask layer). It only changes a
# build in nvidiahard, whose desktop is gcc-16.
#
# sci-misc/llama-cpp is deliberately NOT here: its ebuild sets
# CUDAHOSTCXX="$(cuda_gccdir)" itself under use cuda, so nvcc's ccbin already
# lands on gcc-15 without an override, and its host half is small enough that
# the mixed host16/ccbin15 build is fine. Forcing CC there would only break the
# gcc-16 CPU images that also build it.
sci-ml/caffe2               lowmem-j4.conf ndebug.conf ccache-cuda.conf torch-git-pin.conf gcc15.conf
sci-ml/pytorch              torch-git-pin.conf gcc15.conf
dev-python/vllm             ccache-cuda.conf gcc15.conf
sci-ml/torchvision          ccache-cuda.conf gcc15.conf
sci-ml/torchaudio           gcc15.conf
dev-libs/cutlass            gcc15.conf
dev-python/flash-attn       gcc15.conf
dev-python/bitsandbytes     gcc15.conf
dev-python/liger-kernel     gcc15.conf
dev-util/nvidia-cuda-toolkit gcc15.conf
sci-misc/llama-cpp    cmake-release.conf ndebug.conf
sci-misc/ik-llama-cpp cmake-release.conf ndebug.conf

# Out-of-tree kernel modules follow the kernel's toolchain (clang) — see
# env/kmod-llvm.conf. Any new kmod package added to the image belongs here too.
x11-drivers/nvidia-drivers      kmod-llvm.conf
app-emulation/virtualbox-modules kmod-llvm.conf
sys-apps/openrazer              kmod-llvm.conf
