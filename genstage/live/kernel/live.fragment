# Kconfig fragment: what a live ISO cannot boot without.
#
# Merged onto the base config by 'xstage amd64 kernel' using the kernel's own
# scripts/kconfig/merge_config.sh, then closed with 'make olddefconfig'. A
# fragment is used instead of a full .config on purpose: symbol names survive a
# kernel version bump, a 10 000-line .config does not.
#
# merge_config.sh warns loudly when a value here loses to the base, so a silent
# drop is not possible — read its output if the image will not boot.

# --- the boot chain: initramfs -> find the media -> loop-mount the squashfs --
# genkernel builds the initrd with CDROOT=1; these are what it relies on.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=16
CONFIG_BLK_DEV_RAM_SIZE=65536
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# The root filesystem itself. Both codecs: LIVE_COMP defaults to zstd, but an
# older image (or one built with XSTAGE_LIVE_COMP=xz, as bin/v does) must boot
# on the same kernel.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# The boot media: ISO9660 for the CD path, vfat/UDF for the isohybrid USB path.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Writable overlay on a read-only root — this is what makes the session usable.
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- storage controllers: the image boots on hardware it has never seen -----
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_SCSI=y
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m

# USB, including booting from the stick the ISO was dd'ed onto.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UAS=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
# /dev/input/mice for sys-libs/gpm (console mouse; its pre-merge check flags
# this). No longer in defconfig and carries no 'default y', so the merge
# leaves it off unless named here. evdev (the Wayland/libinput path) IS a
# defconfig default and needs no entry.
CONFIG_INPUT_MOUSEDEV=y
# /dev/hidraw*: pam_u2f security keys (the target laptop's /etc/u2f_mappings)
# and openrazer both talk raw HID
CONFIG_HIDRAW=y
CONFIG_USB_PRINTER=m

# virtio: without these 'xp <profile> gate' boots into a kernel panic.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# KVM the other way round: the guest bits above let the image run UNDER qemu
# (the gate); these let the booted image HOST its own VMs — /dev/kvm for
# isolated test machines (and the h5i 'microvm' tier, should microsandbox
# ever get packaged). Host parity (=m on all three); both vendor modules
# because the ISO boots on Intel machines too, and the wrong-vendor module
# simply never loads. VHOST_NET accelerates virtio guest networking.
# Restored 2026-08-08 — an earlier trim dropped it as unused; isolated VMs
# for testing turned out to be exactly what a live image is for.
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_KVM_INTEL=m
CONFIG_VHOST=m
CONFIG_VHOST_NET=m

# --- rescue-image filesystems: mount whatever the broken machine has --------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=y
CONFIG_NFS_FS=m
CONFIG_CIFS=m

# Encrypted and stacked block devices — a rescue image that cannot open a LUKS
# volume is useless on this lab's own machines.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_MIRROR=m
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID456=m
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# --- networking: modules, because the driver depends on the machine ---------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_R8169=m
CONFIG_ATL1C=m
CONFIG_TIGON3=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH11K=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_MT76x2U=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
# Bluetooth PROFILE modules, on top of the adapter driver above. None of
# them is needed for scanning/pairing: verified on a running nvidiahard
# image (2026-08-13) that has all three "not set" and still discovers and
# pairs devices normally. bluetoothd's startup line "kernel lacks
# bnep-protocol support" is therefore a benign warning — BNEP only carries
# PAN/tethering, and bluetoothd just drops that plugin. Do NOT read it as
# the cause of a discovery failure.
# What they DO buy: HIDP = Bluetooth keyboards and mice (a desktop image
# wants this), RFCOMM = the serial profile, BNEP = PAN.
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
# --- BTF: type information for eBPF CO-RE (tracee, bpftool, bpftrace) -------
# Requires a CLANG build (xstage passes LLVM=1 to genkernel). On gcc,
# DEBUG_INFO_BTF 'depends on !GCC_PLUGIN_RANDSTRUCT' (lib/Kconfig.debug:401)
# and hardened.fragment sets RANDSTRUCT_FULL, so olddefconfig would drop BTF
# without a word; live_prep_kconfig's post-merge check now fails the build
# instead. Under clang the same RANDSTRUCT_FULL is provided by
# CC_HAS_RANDSTRUCT and both features coexist (verified on 7.1.5-zen with
# clang 22.1.8: .BTF = 5.3 MB, valid per 'bpftool btf dump file vmlinux').
#
# Cost: DWARF5 in the build tree, NOT in the shipped kernel — the .BTF
# section adds ~5 MB to bzImage and the debug sections never get loaded.
# Modules get no BTF (BTF_MODULES=n) and genkernel is called with
# --strip-type=modules, which keeps /lib/modules at ~129 MB instead of 1.5 GB.
# DEBUG_INFO_NONE must be cleared explicitly: it is the base config's member
# of the same choice, and merge_config.sh only ADDS lines — leaving both =y
# lets olddefconfig keep NONE and drop the DWARF/BTF pair silently.
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# firewalling + containers (docker/lxc are in the package list)
CONFIG_NETFILTER=y
# The SECOND menu gate in this section, and it behaves exactly like
# NETFILTER_XTABLES_LEGACY below: with ADVANCED=n the kernel only offers "the
# ones used in common setups" and every other xt match/target is INVISIBLE —
# not disabled-but-selectable, simply absent from Kconfig. Asking for one of
# them in a fragment is then a no-op that leaves no trace anywhere.
#
# Measured on the installed nvidiahard host 2026-08-13: the whole kernel had
# four xt matches (addrtype, conntrack, policy, state). 'hashlimit' could not
# be enabled at all, and CONFIG_BRIDGE_NETFILTER below had been silently
# dropped from every image built so far despite this fragment asking for it.
# Upstream's own default here is y; something in the zen defconfig turns it off.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=m
CONFIG_NF_CONNTRACK=m
# legacy xtables path too: the hardened layer ships a default-deny
# iptables-restore ruleset, and eselect iptables may point either way.
#
# NETFILTER_XTABLES_LEGACY is the menu gate and it MUST come first. Since the
# 6.15 split, ip_tables.o is built from IP_NF_IPTABLES_LEGACY (see
# net/ipv4/netfilter/Makefile) and FILTER/NAT/MANGLE all 'depends on' that
# symbol, not on IP_NF_IPTABLES. Without the gate, 'make olddefconfig'
# silently drops every one of them: the 2026-08-09 nvidiahard image asked for
# IP_NF_FILTER=m and shipped no ip_tables.ko at all, so iptables could not
# initialise a single table on the installed host ("can't initialize iptables
# table `filter'") and docker had no nat table either. The gate is bool and
# depends on !PREEMPT_RT — fine for zen, which is PREEMPT_DYNAMIC.
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_NAT=m
# Per-source-IP rate limiting for the sshd rule in the hardened layer's
# iptables/ip6tables rules-save. Only reachable because ADVANCED=y above.
# NOTE THE COUPLING: those rules and these symbols must ship together. A
# rules-save containing '-m hashlimit' on a kernel without the module makes
# iptables-restore FAIL, and a failed restore means the machine boots with no
# firewall at all — fail-open, the worst outcome of the three. Never add the
# rule to a layer without this line, or the line without rebuilding the kernel.
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
# docker publishes ports through the nat table; without it 'docker run -p'
# fails at container start
CONFIG_IP_NF_NAT=m
# ...and docker >= 29 needs the RAW table as well, for every container, not
# just published ones. It installs a "direct access filtering" guard at
# container start:
#   iptables -t raw -A PREROUTING -d <container ip> ! -i docker0 -j DROP
# and without the table the daemon refuses to create the endpoint at all:
#   failed to set up container networking: Unable to enable DIRECT ACCESS
#   FILTERING - DROP rule: can't initialize iptables table `raw'
# i.e. NO container starts, not even 'docker run hello-world'. Found on the
# installed nvidiahard host 2026-08-13 — the whole AI stack (ollama,
# open-webui, searxng) was dead on a system where docker.service itself was
# happily "active". Same shape as the XTABLES_LEGACY gate above: a missing
# table shows up as a daemon-level error that reads like a docker bug.
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_RAW=m
# br_netfilter is deliberately OFF, stated explicitly rather than left to a
# default — until 2026-08-13 this line read CONFIG_BRIDGE_NETFILTER=m with the
# comment "docker's bridge networking wants netfilter on the bridge path", and
# that was wrong twice over: the symbol was invisible (ADVANCED=n, see above)
# so no image ever shipped br_netfilter.ko, and docker does not need it anyway.
#
# What it actually does is push L2-BRIDGED frames through the ipv4/ipv6
# iptables hooks and conntrack. Everything docker relies on is routed, not
# bridged — published ports (nat PREROUTING), inter-network isolation
# (FORWARD), egress masquerading, container->host on the bridge address (INPUT).
# Checked on a running installation: containers work and 'docker info' reports
# no warning with the module absent.
#
# It is genuinely required for kubernetes (kube-proxy needs
# bridge-nf-call-iptables=1), for docker --icc=false, and for filtering traffic
# between containers on the SAME bridge — none of which these images do.
#
# The cost is not zero: every bridged frame enters the IP stack and conntrack,
# IP defragmentation is forced on the bridge path, and FORWARD rules suddenly
# apply to traffic nobody expected — with FORWARD policy DROP in the hardened
# ruleset that is a quiet-breakage risk. Upstream is moving the other way
# (nftables has a proper 'bridge' family). Flip this to =m if k8s ever lands.
# CONFIG_BRIDGE_NETFILTER is not set
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_TUN=m
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y

# --- console and graphics ---------------------------------------------------
# A live image must always produce a picture: KMS where possible, EFI/VESA
# framebuffer as the floor (the 'live-nomodeset' boot entry relies on it).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_CIRRUS_QEMU=m
# serial console: how 'xp <profile> gate -nographic' shows anything at all
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- firmware and platform --------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS_PSTORE=m
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_MICROCODE=y
CONFIG_ACPI=y
CONFIG_X86_MCE=y
CONFIG_HOTPLUG_CPU=y
# the installed system's grub cmdline uses 'iommu=pt amd_iommu=on' — both
# vendors named so one image serves Intel and AMD targets
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y
# hwmon the deployed configs load via modules-load.d (jc42 = DIMM sensors,
# nct6775 = desktop super-I/O); k10temp autoloads by PCI id on any AMD box
CONFIG_HWMON=y
CONFIG_SENSORS_JC42=m
CONFIG_SENSORS_NCT6775=m
CONFIG_SENSORS_K10TEMP=m

# --- audio (the desktop profiles ship pipewire) -----------------------------
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m

# --- userland expectations --------------------------------------------------
# The image runs OpenRC, but genkernel and several tools want these anyway.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_EPOLL=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# binfmt_misc is how the ARM half of this lab runs aarch64 binaries under
# qemu-user — the amd64 image keeps it so it can host that work too
CONFIG_BINFMT_MISC=m
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y

# --- observability: eBPF, audit, integrity ----------------------------------
# dev-util/tracee needs BTF; without CONFIG_DEBUG_INFO_BTF it cannot attach.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
# the running kernel can prove its own configuration (/proc/config.gz) —
# closes the loop with kernel_config_sha256 in /etc/image-release
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# the deployed sysctl hardening set expects these on EVERY image, not just the
# hardened flavour: yama for kernel.yama.ptrace_scope (inert at scope 0 until
# sysctl raises it; the default CONFIG_LSM string already lists yama), kexec
# for kernel.kexec_load_disabled=1 (the lock needs kexec compiled in to have
# anything to lock — and a rescue image can kexec into an installed kernel).
# SECURITY itself is named because plain defconfig does not guarantee it and
# the IMA/EVM block below quietly depends on it.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_YAMA=y
# Landlock: unprivileged, stackable filesystem/network sandboxing. Nothing to
# do with the hardened flavour — it is an ordinary LSM and works the same in a
# plain kernel, so it belongs here rather than in hardened.fragment (which
# already enables it, and whose CONFIG_LSM overrides this one because its
# fragment merges later).
#
# Both lines are needed. An LSM that is compiled but absent from the active
# list is inert, and 'make olddefconfig' will NOT insert landlock into an
# existing explicit CONFIG_LSM — this host is the proof: it carries
# CONFIG_LSM="yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor"
# with no landlock in it at all.
#
# The list names exactly the LSMs this fragment compiles. Listing one that is
# not built is harmless (it is skipped), but leaving a built one out silently
# disables it, so extend this string when adding an LSM above.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,yama,integrity"
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
# Measurement hash: sha256, not the kernel's sha1 default. The deployed
# policy (/etc/ima/ima-policy) is measure-only — no appraisal xattrs exist
# that a hash change could invalidate; the switch only affects each boot's
# fresh measurement list and its PCR-10 extends, and nothing on these
# machines seals secrets against PCR 10. Host nvhard switched 2026-08-14.
# CONFIG_IMA_DEFAULT_HASH_SHA1 is not set
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_IMA_DEFAULT_HASH="sha256"
CONFIG_IMA_APPRAISE=y
CONFIG_EVM=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_HW_RANDOM_TPM=y

# --- AMD NPU (Ryzen AI) ------------------------------------------------------
# The DRM accel subsystem. dev-libs/xdna-driver (::pwr, the out-of-tree
# amdxdna module that sci-ml/fastflowlm's XRT stack version-locks against)
# compiles against <drm/drm_accel.h>, whose declarations are guarded by
# IS_ENABLED(CONFIG_DRM_ACCEL) — without it the module build dies with
# "'accel_open' undeclared" (amdkdehard backfill, 2026-08-08). =y like the
# host: the accel core is not modular. The in-tree amdxdna stays =m, also
# host parity; the out-of-tree module lands in updates/ and wins depmod
# priority. Costs nothing on non-AMD images — the subsystem is a few KB and
# the module simply never loads without the hardware.
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_AMDXDNA=m
