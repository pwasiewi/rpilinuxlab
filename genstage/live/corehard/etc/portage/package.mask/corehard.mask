# corehard: exactly one modern JDK (operator 2026-08-16 — "openjdk-bin 21
# stays"). Without this mask virtual/jdk resolves to the newest slot, and
# ant/maven-bin/xz-java/libbluray recorded =virtual/jdk-25 at build time,
# dragging a second 300 MB JDK into the image beside the intended :21.
dev-java/openjdk-bin:25
dev-java/openjdk-bin:27
virtual/jdk:25
virtual/jdk:27
virtual/jre:25
virtual/jre:27
