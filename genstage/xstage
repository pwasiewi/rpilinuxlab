#!/bin/bash
# xstage — Gentoo stage bootstrapping + Buildroot-style tiny rootfs, in the
# xlab/xarm/xowrt style.
#
# Two tracks in one script:
#  * amd64 — catalyst-driven stage1 -> stage3 (the way Release Engineering
#    builds the official tarballs), native on this host. stage2 is kept as an
#    explicit educational step (bootstrap.sh inside the stage1 chroot) but the
#    default pipeline goes stage1 -> stage3 like modern releng.
#  * tiny  — the Gentoo analog of Buildroot: a minimal aarch64 rootfs emerged
#    into a directory with --root= (no portage inside), regenerated from
#    scratch on the host instead of updated on the target.
# Recipe/background: ~/Claude/rpilinuxlab/genstage/readme.md
#
# Usage: xstage <target> <subcommand> [args]
#        xstage targets | status | clean
#
# Targets:
#   amd64      catalyst stage1/stage2/stage3 bootstrap, native amd64
#   tiny       minimal aarch64 rootfs via the xarm crossdev sysroot
#   arm64      arm64 stage3 on a Pi 400 SD image: unpack the official release
#              (no compilation), build stage1/stage3 with catalyst under
#              qemu-user + distcc-to-cross, or cross-emerge a lab stage3
#
# Subcommands (amd64):
#   status           seed / snapshot / specs / built stages
#   setup            check catalyst+pixz+squashfs, dirs on /mnt/db5, private
#                    catalyst.conf, releng + gentoo.git clones          [root]
#   seed             download + sha256-verify the latest amd64 stage3 seed
#                    into ../dl/ and place it in catalyst builds/default/
#   snapshot [REF]   update gentoo.git, catalyst -s REF (default stable),
#                    record the commit hash for the specs               [root]
#   spec             render specs/*.spec.in -> $XSTAGE_DIR/specs/
#   stage1           catalyst -f stage1.spec  (toolchain from the seed) [root]
#   stage2           catalyst -f stage2.spec  (educational: bootstrap.sh
#                    rebuilds the stage1 toolchain with itself; NOT part
#                    of 'all' — releng skips it)                        [root]
#   stage3           catalyst -f stage3.spec  (emerge -e @system)      [root]
#   all              seed + snapshot + spec + stage1 + stage3           [root]
#   verify           unpack the newest built stage3, chroot smoke test  [root]
#   log [emerge]     follow the newest package build log of the running
#                    catalyst (or the chroot's emerge.log); warns when a
#                    duplicate catalyst sits queued on the run lock      [root]
#   qlop [ARGS]      qlop over the run's chroot emerge.log (default -tv:
#                    merge times); 'qlop -r' = current merge + elapsed   [root]
#   clean            rm catalyst tmp/ ('clean all': + built stages,
#                    snapshots and state; seeds and git repos kept)  [confirm]
#
# Subcommands (tiny):
#   status           toolchain / rootfs / squashfs / initrd state
#   build            REGENERATE from scratch: rm rootfs, cross-emerge
#                    baselayout + base packages (+XSTAGE_TINY_PKGS) with
#                    --root=, device nodes, /init                [root,confirm]
#                    base = XSTAGE_TINY_BASE: 'gentoo' (default: bash,
#                    coreutils, util-linux & friends) or 'busybox' (static)
#   pack             mksquashfs + cpio newc initrd into ../build/tinyroot/
#   run              boot the initrd with xlab's arm64 kernel in qemu -M virt,
#                    NIC forwarded to 127.0.0.1:$XSTAGE_SSH_PORT (ssh test)
#   rpi              add the Pi boot payload to the rootfs: cross-emerge
#                    sys-kernel/raspberrypi-image (kernel8.img + start*.elf +
#                    every DTB + /lib/modules); board-independent — the
#                    image step picks the right config.txt              [root]
#   image            build sd.img for the Pi 400: MBR, FAT32 boot + ext4
#                    rootfs, PARTUUID cmdline — the same image boots qemu
#                    and the card. Adds iproute2 + sshd to the rootfs;
#                    /etc/tiny-board.sh gives eth0 a fixed LAN address
#                    (default 192.168.0.200) and starts sshd, so the board
#                    is reachable even with a dark HDMI                  [root]
#   image_zero       the same for a Pi Zero 2 W + Waveshare 2.13" V4 e-Paper
#                    HAT: SPI + USB-gadget (dwc2) in config.txt; kmod, the
#                    eink213 panel driver, iproute2 and sshd added to the
#                    rootfs; /etc/tiny-board.sh brings up usb0 (10.0.0.2,
#                    host = 10.0.0.1), starts sshd and paints the banner
#                    on the display                                      [root]
#   run-rpi          boot sd.img in qemu (raspi4b or raspi3b, matching the
#                    board the image was built for): boot GATE only — output
#                    on ttyAMA1, but qemu can't inject input into it
#   sd DEV           dd sd.img onto a real SD card (/dev/sdX or
#                    /dev/mmcblkN, removable-only safety)        [root,confirm]
#   clean            rm ../build/tinyroot                            [confirm]
#
# Subcommands (arm64):
#   status           seed / rootfs / payload / sd.img / catalyst state
#   seed             download + sha256-verify the latest arm64 stage3
#                    into ../dl/ (+ catalyst builds/default/ when set up)
#   unpack           untar the stage3 into ../build/arm64sd/rootfs
#                    (handbook flags: xattrs, numeric owners); source
#                    override: XSTAGE_ARM64_TARBALL=/path       [root,confirm]
#   rpi              same Pi boot payload step as 'tiny rpi'             [root]
#   image            configure the stage3 (root password + invoker's key,
#                    PermitRootLogin, netifrc eth0 = the board's IP, sshd
#                    in the default runlevel, fstab by label) and build
#                    sd.img for XSTAGE_BOARD (rpi400/rpi3) — real OpenRC
#                    boot, init=/sbin/init                               [root]
#   run-rpi          qemu -M raspi4b boot gate (output-only), OpenRC boot
#   sd DEV           dd sd.img onto a real SD card               [root,confirm]
#   clean            rm ../build/arm64sd                              [confirm]
#   setup            catalyst dirs + catalyst-arm64.conf (distcc option) +
#                    qemu/binfmt/crossdev preflight                     [root]
#   snapshot [REF]   same snapshot step as amd64, own state dir         [root]
#   spec             render specs the qemu way: interpreter key, stages-qemu
#                    confdir, update_seed: no (distcc_hosts sits in the conf)
#   stage1|stage2|stage3  catalyst in a qemu-user chroot; compiles ship to
#                    host distccd -> crossdev cross-gcc (native speed);
#                    distccd is auto-started via xarm when not running  [root]
#   all              seed + snapshot + spec + stage1 + stage3           [root]
#   verify           unpack the newest built stage3, qemu-chroot smoke
#                    test (lends the chroot our static qemu-aarch64)    [root]
#   log|qlop         same build-watching helpers as amd64               [root]
#   crossstage       fast path, no catalyst: cross-emerge @system into a
#                    ROOT at native speed and tar it as a lab-grade
#                    stage3 (feed it back via XSTAGE_ARM64_TARBALL)     [root]
#
# Env overrides:
#   XSTAGE_DIR        catalyst data dir       (default /mnt/db5/genstage;
#                     also settable in /etc/xp.conf — explicit env wins)
#   XSTAGE_JOBS       catalyst/emerge jobs    (default nproc)
#   XSTAGE_MIRROR     gentoo mirror           (default https://distfiles.gentoo.org)
#   XSTAGE_FLAVOR     stage flavour           (default openrc)
#   XSTAGE_REL_TYPE   catalyst rel_type       (default lab; seeds stay in default/)
#   XSTAGE_TREEISH    snapshot hash override  (default: recorded by 'snapshot')
#   XSTAGE_TINY_TUPLE crossdev tuple          (default aarch64-unknown-linux-gnu)
#   XSTAGE_TINY_BASE  rootfs userland         (default gentoo; or busybox)
#   XSTAGE_TINY_PKGS  extra tiny packages     (default empty)
#   XSTAGE_TINY_IMG_MB sd.img size in MiB     (default 2048; keep a power of 2)
#   XSTAGE_ARM64_IMG_MB arm64 sd.img size in MiB (default 4096; power of 2)
#   XSTAGE_BOARD      eth board for 'image': rpi400 (default) or rpi3
#   XSTAGE_BUILD_SUBDIR build tree name under ../build/ (default tinyroot /
#                     arm64sd — xp variant profiles set their own)
#   XSTAGE_PI400_IP   Pi 400 eth0 address     (default 192.168.0.200/24)
#   XSTAGE_PI400_GW   Pi 400 default gateway  (default 192.168.0.1)
#   XSTAGE_PI400_DNS  Pi 400 nameserver       (default: the gateway)
#   XSTAGE_PI3_IP     Pi 3 eth0 address       (default 192.168.0.201/24)
#   XSTAGE_PI3_GW/_DNS Pi 3 gateway/DNS       (default 192.168.0.1 / gateway)
#   XPROFILE          xp profile name (rpilinuxlab/profiles/ — sets the
#                     defaults above; explicit env still wins)
#   XSTAGE_ZERO_IP    Zero 2 W usb0 address   (default 10.0.0.2/24)
#   XSTAGE_ZERO_GW    the machine at the other end of the cable (10.0.0.1)
#   XSTAGE_ZERO_DNS   resolv.conf nameserver  (default 8.8.8.8)
#   XSTAGE_ZERO_PASS  root password, both ssh images         (default tiny)
#   XSTAGE_ZERO_KEY   pubkey for root        (default ~SUDO_USER/.ssh/id_ed25519.pub)
#   XSTAGE_SSH_PORT   host port 'tiny run' forwards to :22   (default 2223)
#   XSTAGE_DISTCC_HOSTS  distcc_hosts for arm64 catalyst (default 127.0.0.1:3632/JOBS)
#   XSTAGE_ARM64_TARBALL stage3 for 'arm64 unpack'  (default: newest in ../dl/)
#
# Typical flow:
#   sudo ./xstage amd64 setup
#   ./xstage amd64 seed
#   sudo ./xstage amd64 all            # stage1 -> stage3, hours of compiling
#   sudo ./xstage amd64 verify
#   sudo ./xstage tiny build && sudo ./xstage tiny pack && ./xstage tiny run
#   sudo ./xstage tiny rpi && sudo ./xstage tiny image && ./xstage tiny run-rpi
#   sudo ./xstage tiny sd /dev/sdX     # then boot the real Pi 400
#   sudo ./xstage tiny rpi && sudo ./xstage tiny image_zero   # Zero 2 W + e-Paper
#   ./xstage tiny run-rpi && sudo ./xstage tiny sd /dev/mmcblk0
#   ./xstage arm64 seed && sudo ./xstage arm64 unpack          # full Gentoo
#   sudo ./xstage arm64 rpi && sudo ./xstage arm64 image && ./xstage arm64 run-rpi
#   sudo ./xstage arm64 sd /dev/sdX    # OpenRC Gentoo on the Pi 400
#   xarm distcc start && sudo ./xstage arm64 setup   # build arm64 stages here:
#   sudo ./xstage arm64 all            # catalyst, qemu+distcc (est. 6-12 h)
#   sudo ./xstage arm64 crossstage     # or the ~1-2 h lab stage3, no catalyst
#   XSTAGE_ARM64_TARBALL=/path sudo ./xstage arm64 unpack   # image own stage3

set -euo pipefail

# --- optional xp profile layer (see rpilinuxlab/profiles/README.md) --------
# XPROFILE=<name> (or XPROFILE_FILE=<path>) sources the profile, which exports
# the XARM_*/XSTAGE_*/XLAB_* env overrides — explicit env still wins.
if [[ -n ${XPROFILE:-}${XPROFILE_FILE:-} ]]; then
    [[ -n ${XP_LAB_DIR:-} || ! -r /etc/xp.conf ]] || source /etc/xp.conf
    if [[ -z ${XP_LAB_DIR:-} ]]; then
        _xpd="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
        for _xpc in "${_xpd}" "${_xpd}/.."; do
            [[ -f ${_xpc}/profiles/global.conf ]] && { XP_LAB_DIR="${_xpc}"; break; }
        done
    fi
    _xpf="${XPROFILE_FILE:-${XP_LAB_DIR:-}/profiles/${XPROFILE:-}.conf}"
    [[ -r ${_xpf} ]] ||
        { echo "❌  xp profile not found: ${_xpf} (set XP_LAB_DIR or write /etc/xp.conf)" >&2; exit 1; }
    source "$(dirname "${_xpf}")/global.conf"
    source "${_xpf}"
    xprofile_apply
fi

# ---------------------------------------------------------------------------
# Globals
# ---------------------------------------------------------------------------
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(dirname "${HERE}")"          # rpilinuxlab root: shared dl/ and build/
DL_DIR="${REPO}/dl"
JOBS="${XSTAGE_JOBS:-$(nproc)}"

# amd64 / catalyst track — data dir precedence: env > /etc/xp.conf > default
if [[ -z ${XSTAGE_DIR:-} && -r /etc/xp.conf ]]; then source /etc/xp.conf; fi
XDIR="${XSTAGE_DIR:-/mnt/db5/genstage}"
MIRROR="${XSTAGE_MIRROR:-https://distfiles.gentoo.org}"
FLAVOR="${XSTAGE_FLAVOR:-openrc}"
REL_TYPE="${XSTAGE_REL_TYPE:-lab}"
SUBARCH=amd64
PROFILE="default/linux/amd64/23.0"
AUTOBUILDS="${MIRROR}/releases/${SUBARCH}/autobuilds"
# per-arch catalyst knobs — amd64 builds natively, so no extra spec keys
CAT_OPTIONS='"autoresume", "bindist", "pkgcache", "seedcache", "ccache"'
CAT_EXTRA_CONF=""       # extra catalyst.conf lines (arm64: distcc_hosts)
INTERPRETER=""          # qemu-user binary catalyst copies into a foreign chroot
UPDATE_SEED="yes"       # stage1: refresh the seed before building from it
DISTCC_HOSTS_VAL=""     # non-empty -> distcc offload expected, gate on distccd
# per-track compiler cache — catalyst's "ccache" option bind-mounts the host
# CCACHE_DIR (set at invocation in run_catalyst) into the chroot at
# /var/tmp/ccache; one cache per architecture, never shared across arches
CCACHE_TRACK_DIR="${XDIR}/ccache-amd64"

STOREDIR="${XDIR}/catalyst"
CONF="${XDIR}/conf/catalyst.conf"
SPECDIR="${XDIR}/specs"
STATE="${XDIR}/state"
LOGDIR="${XDIR}/logs"
RELENG="${XDIR}/releng"
CONFDIR="${RELENG}/releases/portage/stages"
# the sync mirror, not repo/gentoo.git: only it has the CI-verified 'stable'
# branch, plus the generated metadata/md5-cache catalyst profits from
GENTOO_GIT="https://anongit.gentoo.org/git/repo/sync/gentoo.git"
RELENG_GIT="https://github.com/gentoo/releng.git"
GIT_REPO="${STOREDIR}/repos/gentoo.git"

# tiny track
TUPLE="${XSTAGE_TINY_TUPLE:-aarch64-unknown-linux-gnu}"
SYSROOT="/usr/${TUPLE}"
# XSTAGE_BUILD_SUBDIR: variant build trees (xp profiles with PROF_BUILD_SUBDIR)
# — several boards/experiments keep independent rootfs/image dirs while
# sharing the sysroot and its binpkgs
TINY_BLD="${REPO}/build/${XSTAGE_BUILD_SUBDIR:-tinyroot}"
TINY_ROOT="${TINY_BLD}/rootfs"
TINY_IMG="${TINY_BLD}/sd.img"
TINY_MNT="${TINY_BLD}/mnt"
# which board the current sd.img was built for — 'run-rpi' and 'sd' read it
TINY_BOARD_F="${TINY_BLD}/board"
# power of 2: qemu's SD-card emulation rejects other sizes
IMG_MB="${XSTAGE_TINY_IMG_MB:-2048}"
BOOT_MB=256
TINY_BASE="${XSTAGE_TINY_BASE:-gentoo}"     # gentoo | busybox
# Pi Zero 2 W USB-gadget link: the board is ZERO_IP, the machine you plug the
# cable into is ZERO_GW (give it 10.0.0.1/24 on the enx… interface)
ZERO_IP="${XSTAGE_ZERO_IP:-10.0.0.2/24}"
ZERO_GW="${XSTAGE_ZERO_GW:-10.0.0.1}"
ZERO_DNS="${XSTAGE_ZERO_DNS:-8.8.8.8}"
ZERO_PASS="${XSTAGE_ZERO_PASS:-tiny}"
ZERO_KEY="${XSTAGE_ZERO_KEY:-}"             # pubkey file; default: invoker's ed25519
# Pi 400 wired LAN: fixed address so the board is reachable over ssh even
# when HDMI shows nothing — the headless debug console
PI400_IP="${XSTAGE_PI400_IP:-192.168.0.200/24}"
PI400_GW="${XSTAGE_PI400_GW:-192.168.0.1}"
PI400_DNS="${XSTAGE_PI400_DNS:-${PI400_GW}}"
# Pi 3 wired LAN — its own address so both boards can sit on the LAN at once
PI3_IP="${XSTAGE_PI3_IP:-192.168.0.201/24}"
PI3_GW="${XSTAGE_PI3_GW:-192.168.0.1}"
PI3_DNS="${XSTAGE_PI3_DNS:-${PI3_GW}}"
# which eth board 'image' builds for: rpi400 (default) or rpi3; zero2w keeps
# its own subcommand (image_zero). Set by the xp profile layer.
BOARD="${XSTAGE_BOARD:-rpi400}"

# board_eth_vars: BOARD -> ETH_* + the two hostnames (tiny hook / stage3)
board_eth_vars() {
    case "${BOARD}" in
    rpi3)
        ETH_IP="${PI3_IP}"; ETH_GW="${PI3_GW}"; ETH_DNS="${PI3_DNS}"
        # Pi 3 ethernet hangs off USB: LAN9514 (3B, smsc95xx) / LAN7515 (3B+)
        ETH_MODULES="smsc95xx lan78xx"
        BOARD_TINY_HOSTNAME=tinypi3; BOARD_SD_HOSTNAME=pi3 ;;
    *)
        ETH_IP="${PI400_IP}"; ETH_GW="${PI400_GW}"; ETH_DNS="${PI400_DNS}"
        ETH_MODULES="bcmgenet"          # the BCM2711 on-die NIC
        BOARD_TINY_HOSTNAME=tinyroot; BOARD_SD_HOSTNAME=pi400 ;;
    esac
}

# board_dtb: the DTB the firmware picks on the REAL board (payload sanity check)
board_dtb() {
    case "${1:-${BOARD}}" in
        rpi3)   echo bcm2710-rpi-3-b.dtb ;;
        zero2w) echo bcm2710-rpi-zero-2-w.dtb ;;
        *)      echo bcm2711-rpi-400.dtb ;;
    esac
}
# 2223, not 2222: xlab's gentoo VM already forwards that one
SSH_PORT="${XSTAGE_SSH_PORT:-2223}"         # host port 'tiny run' forwards to :22
TINY_PKGS="${XSTAGE_TINY_PKGS:-}"
# the real Gentoo base userland (glibc/ncurses/readline & co. arrive as rdeps)
TINY_BASE_PKGS="app-shells/bash sys-apps/coreutils sys-apps/util-linux
    sys-apps/grep sys-apps/sed sys-apps/gawk sys-apps/findutils
    sys-process/procps sys-apps/less"
XLAB_KERNEL="${REPO}/build/gentoo/emu/vmlinuz"
# what PID 1 is in the image — the tiny rootfs has the /init hook script, a
# stage3 has real OpenRC; rendered into cmdline.txt and the run-rpi -append
TINY_INIT="/init"
ROOT_HINT="tiny build"                      # 'no rootfs' die messages

# arm64 track: same image machinery as tiny, different rootfs source — the
# dispatch switches every TINY_* path here before calling the shared functions
ARM64_AUTOBUILDS="${MIRROR}/releases/arm64/autobuilds"
use_arm64_dirs() {
    TINY_BLD="${REPO}/build/${XSTAGE_BUILD_SUBDIR:-arm64sd}"
    TINY_ROOT="${TINY_BLD}/rootfs"
    TINY_IMG="${TINY_BLD}/sd.img"
    TINY_MNT="${TINY_BLD}/mnt"
    TINY_BOARD_F="${TINY_BLD}/board"
    TINY_INIT="/sbin/init"
    ROOT_HINT="arm64 unpack"
    # a stage3 with the Pi payload is ~2 GB unpacked; still a power of 2
    IMG_MB="${XSTAGE_ARM64_IMG_MB:-4096}"
}

# arm64 catalyst build: the amd64 pipeline retargeted — qemu-user interpreter
# in the chroot, releng's stages-qemu workaround confdir, and distcc shipping
# every compile to host distccd backed by the crossdev cross-gcc (the chroot
# shares the host network, so 127.0.0.1 reaches it). snapshots, releng and
# gentoo.git stay shared with amd64; specs/state/conf/logs get their own dirs.
use_arm64_stage_conf() {
    SUBARCH=arm64
    PROFILE="default/linux/arm64/23.0"
    AUTOBUILDS="${ARM64_AUTOBUILDS}"
    REL_TYPE="${XSTAGE_REL_TYPE:-lab-arm64}"
    CONFDIR="${RELENG}/releases/portage/stages-qemu"
    CONF="${XDIR}/conf/catalyst-arm64.conf"
    SPECDIR="${XDIR}/specs-arm64"
    STATE="${XDIR}/state-arm64"
    LOGDIR="${XDIR}/logs-arm64"
    INTERPRETER="/usr/bin/qemu-aarch64"
    # updating the seed would first recompile half of it under pure emulation
    UPDATE_SEED="no"
    CAT_OPTIONS='"autoresume", "bindist", "pkgcache", "seedcache", "distcc", "ccache"'
    CCACHE_TRACK_DIR="${XDIR}/ccache-arm64"
    DISTCC_HOSTS_VAL="${XSTAGE_DISTCC_HOSTS:-127.0.0.1:3632/${JOBS}}"
    # distcc_hosts is a catalyst.conf value, not a spec key
    CAT_EXTRA_CONF="distcc_hosts = \"${DISTCC_HOSTS_VAL}\""
}

ALL_TARGETS=(amd64 tiny arm64)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die()     { echo "❌  $*" >&2; exit 1; }
info()    { echo ">>>  $*"; }
warn()    { echo "⚠️   $*" >&2; }
confirm() { read -r -p "$1 [yes/NO]: " ans; [[ "$ans" == "yes" ]] || die "Aborted."; }
help()    { sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \?//'; }

need_root()     { [[ $EUID -eq 0 ]] || die "Root required: sudo $0 ${TGT:-} ${CMD:-}"; }
need_catalyst() { command -v catalyst >/dev/null || die "No catalyst — install: emerge -av dev-util/catalyst"; }

# ---------------------------------------------------------------------------
# amd64 track — catalyst stage1/2/3
# ---------------------------------------------------------------------------
seed_tarball()  { ls -1t "${STOREDIR}/builds/default/stage3-${SUBARCH}-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true; }
built_stage()   { ls -1t "${STOREDIR}/builds/${REL_TYPE}/$1-${SUBARCH}-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true; }
snapshot_hash() {
    local s
    s=$(ls -1t "${STOREDIR}/snapshots/gentoo"-*.sqfs 2>/dev/null | head -1 || true)
    if [[ -n ${s} ]]; then s=${s##*/gentoo-}; echo "${s%.sqfs}"; fi
}
treeish() {
    if [[ -n ${XSTAGE_TREEISH:-} ]]; then echo "${XSTAGE_TREEISH}"; return; fi
    if [[ -f ${STATE}/treeish ]]; then cat "${STATE}/treeish"; fi
}

cmd_setup() {
    need_root; need_catalyst
    grep -qw squashfs /proc/filesystems ||
        die "Host kernel lacks SquashFS — catalyst mounts its snapshot as sqfs"
    command -v pixz >/dev/null ||
        warn "No pixz (specs use compression_mode: pixz) — emerge -av app-arch/pixz"
    [[ -f /usr/share/openpgp-keys/gentoo-release.asc ]] ||
        warn "No gentoo-release keyring — snapshot commit verification will fail: emerge -av sec-keys/openpgp-keys-gentoo-release"

    mkdir -p "${XDIR}/conf" "${SPECDIR}" "${STATE}" "${LOGDIR}" \
             "${STOREDIR}/builds/default" "${STOREDIR}/builds/${REL_TYPE}" \
             "${STOREDIR}/repos" "${STOREDIR}/tmp"
    ccache_track_dir_setup

    if [[ -f ${CONF} ]]; then
        info "Keeping existing ${CONF}"
    else
        info "Writing ${CONF}"
        # private config — /etc/catalyst is never touched; every catalyst call
        # in this script passes -c ${CONF}
        cat > "${CONF}" <<-EOF
	# xstage catalyst config (private; used via: catalyst -c ${CONF})
	digests = ["blake2b", "sha512"]
	options = [${CAT_OPTIONS}]
	storedir = "${STOREDIR}"
	port_logdir = "${LOGDIR}"
	jobs = ${JOBS}
	load-average = $(nproc).0
	${CAT_EXTRA_CONF}
	EOF
    fi

    if [[ -d ${RELENG}/.git ]]; then
        info "Keeping existing releng clone"
    else
        info "Cloning releng (spec confdir templates)"
        git clone --depth 1 "${RELENG_GIT}" "${RELENG}"
    fi

    if [[ -d ${GIT_REPO} ]]; then
        info "Keeping existing gentoo.git"
    else
        # catalyst -s snapshots from the git repo at repos/<repo_name>.git
        info "Cloning gentoo.git (bare, branch stable, shallow — ~80 MB)"
        git clone --bare --depth 1 --branch stable "${GENTOO_GIT}" "${GIT_REPO}"
    fi
    # seed and spec run without root — hand their target dirs to the invoker
    if [[ -n ${SUDO_UID:-} ]]; then
        chown "${SUDO_UID}:${SUDO_GID}" "${STOREDIR}/builds/default" "${STATE}" "${SPECDIR}"
    fi
    info "Setup done. Next: $0 ${TGT:-amd64} seed"
}

cmd_seed() {
    mkdir -p "${DL_DIR}"
    local latest_txt="latest-stage3-${SUBARCH}-${FLAVOR}.txt"
    info "Resolving latest stage3 (${SUBARCH}, ${FLAVOR}) from ${AUTOBUILDS}"
    local relpath
    relpath=$(curl -fsSL "${AUTOBUILDS}/${latest_txt}" \
        | awk '/^[0-9]{8}T[0-9]{6}Z\// {print $1; exit}')
    [[ -n ${relpath} ]] || die "Could not parse ${latest_txt}"
    local tarball; tarball=$(basename "${relpath}")

    if [[ -f ${DL_DIR}/${tarball} && -f ${DL_DIR}/${tarball}.sha256 ]]; then
        info "${tarball} already downloaded"
    else
        info "Downloading ${tarball} (~300 MB)"
        wget -O "${DL_DIR}/${tarball}" "${AUTOBUILDS}/${relpath}" ||
            { command rm -f "${DL_DIR}/${tarball}"; die "seed download failed"; }
        wget -qO "${DL_DIR}/${tarball}.sha256" "${AUTOBUILDS}/${relpath}.sha256" ||
            { command rm -f "${DL_DIR}/${tarball}.sha256"; die "sha256 download failed"; }
    fi
    info "Verifying sha256"
    (cd "${DL_DIR}" && grep -E "\s${tarball}\$" "${tarball}.sha256" | sha256sum -c --quiet) ||
        die "SHA256 mismatch on ${tarball} — delete it from dl/ and retry"

    # without the catalyst dirs the seed still serves 'arm64 unpack' from dl/
    if [[ -d ${STOREDIR}/builds/default ]]; then
        if [[ ! -f ${STOREDIR}/builds/default/${tarball} ]]; then
            info "Placing seed in catalyst builds/default/"
            cp "${DL_DIR}/${tarball}" "${STOREDIR}/builds/default/${tarball}"
        fi
        info "Seed ready: ${STOREDIR}/builds/default/${tarball}"
    else
        info "No catalyst dirs (sudo $0 ${TGT:-amd64} setup) — seed stays in ${DL_DIR}"
    fi
}

cmd_snapshot() {
    need_root; need_catalyst
    local ref="${1:-stable}"
    [[ -d ${GIT_REPO} ]] || die "No ${GIT_REPO} — run: sudo $0 ${TGT:-amd64} setup"
    info "Updating gentoo.git (${ref})"
    git -C "${GIT_REPO}" fetch --depth 1 origin "${ref}"
    git -C "${GIT_REPO}" update-ref "refs/heads/${ref}" FETCH_HEAD
    info "Taking snapshot: catalyst -s ${ref}"
    catalyst -c "${CONF}" -s "${ref}"
    local hash; hash=$(snapshot_hash)
    [[ -n ${hash} ]] || die "No snapshot appeared in ${STOREDIR}/snapshots"
    echo "${hash}" > "${STATE}/treeish"
    info "Snapshot treeish recorded: ${hash}"
}

render_spec() {  # render_spec <stage1|stage2|stage3> <stamp> <tree> <seed_subpath>
    local st="$1" stamp="$2" tree="$3" seed="$4"
    sed -e "s|@SUBARCH@|${SUBARCH}|g" \
        -e "s|@FLAVOR@|${FLAVOR}|g" \
        -e "s|@STAMP@|${stamp}|g" \
        -e "s|@REL_TYPE@|${REL_TYPE}|g" \
        -e "s|@PROFILE@|${PROFILE}|g" \
        -e "s|@TREEISH@|${tree}|g" \
        -e "s|@SEED_SUBPATH@|${seed}|g" \
        -e "s|@CONFDIR@|${CONFDIR}|g" \
        -e "s|@UPDATE_SEED@|${UPDATE_SEED}|g" \
        "${HERE}/specs/${st}.spec.in" > "${SPECDIR}/${st}.spec"
    # the arch-conditional key is appended, not templated — the amd64 specs
    # stay byte-identical to what this script always rendered
    if [[ -n ${INTERPRETER} ]]; then
        echo "interpreter: ${INTERPRETER}" >> "${SPECDIR}/${st}.spec"
    fi
    info "Rendered ${SPECDIR}/${st}.spec"
}

cmd_spec() {
    local tree; tree=$(treeish)
    [[ -n ${tree} ]] || die "No snapshot treeish — run: sudo $0 ${TGT:-amd64} snapshot"
    local seed; seed=$(seed_tarball)
    [[ -n ${seed} ]] || die "No seed stage3 in builds/default — run: $0 ${TGT:-amd64} seed"
    local seed_subpath="default/$(basename "${seed}" .tar.xz)"
    # one stamp shared by all three specs, so stage2/stage3 source_subpath
    # points exactly at the stage1 this run produces
    local stamp; stamp=$(date -u +%Y%m%dT%H%M%SZ)
    echo "${stamp}" > "${STATE}/stamp"
    [[ -d ${CONFDIR} ]] || die "No releng confdir ${CONFDIR} — run: sudo $0 ${TGT:-amd64} setup"
    local st
    for st in stage1 stage2 stage3; do
        render_spec "${st}" "${stamp}" "${tree}" "${seed_subpath}"
    done
}

ccache_track_dir_setup() {  # catalyst aborts when the ccache dir is missing
    mkdir -p "${CCACHE_TRACK_DIR}"
    [[ -f ${CCACHE_TRACK_DIR}/ccache.conf ]] ||
        echo "max_size = 20.0G" > "${CCACHE_TRACK_DIR}/ccache.conf"
}

run_catalyst() {  # run_catalyst <stage1|stage2|stage3>
    need_root; need_catalyst
    local spec="${SPECDIR}/$1.spec"
    [[ -f ${spec} ]] || die "No ${spec} — run: $0 ${TGT:-amd64} spec"
    if [[ -n ${DISTCC_HOSTS_VAL} ]]; then
        # without the daemon every compile silently falls back to pure qemu
        # emulation — roughly 19x slower; auto-start it (idempotent: xarm's
        # own start is pgrep-guarded too). Stop stays manual: xarm distcc stop
        if ! pgrep -x distccd >/dev/null; then
            command -v xarm >/dev/null ||
                die "distccd not running and no xarm in PATH to auto-start it"
            local dport="${DISTCC_HOSTS_VAL#*:}"; dport="${dport%%/*}"
            info "Auto-starting distccd (port ${dport}; log /var/tmp/xarm/distccd.log)"
            xarm distcc start "${dport}" || die "distccd auto-start failed"
        fi
    fi
    ccache_track_dir_setup
    info "catalyst -f $1.spec (this compiles for a long time; log: ${LOGDIR})"
    # -a: ignore any stale autoresume points so spec changes take effect.
    # CCACHE_DIR: catalyst's "ccache" option bind-mounts this host dir into
    # the chroot — without it catalyst falls back to /var/tmp/ccache, which
    # here is a symlink to the host's x86 cache (wrong architecture)
    CCACHE_DIR="${CCACHE_TRACK_DIR}" catalyst -c "${CONF}" -af "${spec}"
    local out; out=$(built_stage "$1")
    [[ -n ${out} ]] || die "catalyst finished but no $1 tarball in builds/${REL_TYPE}"
    info "$1 ready: ${out} ($(du -h "${out}" | cut -f1))"
}

cmd_stage1() { run_catalyst stage1; }
cmd_stage2() { run_catalyst stage2; }
cmd_stage3() { run_catalyst stage3; }

# ---------------------------------------------------------------------------
# Watching a running catalyst build — the console stays quiet by design:
# per-package output goes to port_logdir/<rel_type>/<run>/, the package
# counter to the run chroot's /var/log/emerge.log.
# ---------------------------------------------------------------------------
newest_run() { ls -1t "${LOGDIR}/${REL_TYPE}" 2>/dev/null | head -1 || true; }

run_summary() {  # <run> — running instances + "(N of M) pkg" from emerge.log
    local run="$1" elog="${STOREDIR}/tmp/${REL_TYPE}/$1/var/log/emerge.log"
    local pids n
    pids=$(pgrep -f "catalyst -c ${CONF}" | tr '\n' ' ' || true)
    n=$(wc -w <<<"${pids}")
    if [[ ${n} -eq 0 ]]; then
        warn "No catalyst running on $(basename "${CONF}") — showing the last run"
    elif [[ ${n} -gt 1 ]]; then
        warn "${n} catalyst instances on $(basename "${CONF}") (pids: ${pids}) —"
        warn "the one started last is queued on the run lock and, once it frees,"
        warn "will CLEAR AUTORESUME and rebuild from scratch. Kill it."
    fi
    if [[ -r ${elog} ]]; then
        local cur
        cur=$(grep -F '>>> emerge (' "${elog}" | tail -1 |
              sed 's/^[0-9]*: *>>> emerge //; s| to /.*||')
        if [[ -n ${cur} ]]; then info "${run}: last started ${cur}"; fi
    fi
}

cmd_log() {  # [emerge] — follow the newest package log / the emerge.log
    need_root
    local run; run=$(newest_run)
    [[ -n ${run} ]] || die "No runs under ${LOGDIR}/${REL_TYPE} — nothing built yet"
    run_summary "${run}"
    if [[ ${1:-} == emerge ]]; then
        local elog="${STOREDIR}/tmp/${REL_TYPE}/${run}/var/log/emerge.log"
        [[ -f ${elog} ]] || die "No ${elog} — run chroot gone?"
        exec tail -f "${elog}"
    fi
    local dir="${LOGDIR}/${REL_TYPE}/${run}" newest
    newest=$(ls -1t "${dir}" | head -1 || true)
    [[ -n ${newest} ]] || die "No package logs in ${dir} yet"
    info "Following ${newest} (Ctrl-C stops the tail, not the build)"
    exec tail -f "${dir}/${newest}"
}

cmd_qlop() {  # [qlop args] — merge times from the run chroot's emerge.log
    need_root
    command -v qlop >/dev/null || die "No qlop — emerge -av app-portage/portage-utils"
    local run; run=$(newest_run)
    [[ -n ${run} ]] || die "No runs under ${LOGDIR}/${REL_TYPE} — nothing built yet"
    local elog="${STOREDIR}/tmp/${REL_TYPE}/${run}/var/log/emerge.log"
    [[ -f ${elog} ]] || die "No ${elog} — run chroot gone?"
    run_summary "${run}"
    if [[ $# -gt 0 ]]; then exec qlop "$@" -f "${elog}"; fi
    exec qlop -tv -f "${elog}"
}

cmd_all() {
    need_root
    if [[ -n $(seed_tarball) ]]; then
        info "Seed already present — skipping download"
    else
        cmd_seed
    fi
    cmd_snapshot
    cmd_spec
    cmd_stage1
    cmd_stage3
    info "Bootstrap complete: $(built_stage stage3)"
}

cmd_verify() {
    need_root
    local tarball; tarball=$(built_stage stage3)
    [[ -n ${tarball} ]] || die "No built stage3 in builds/${REL_TYPE} — run: sudo $0 ${TGT:-amd64} all"
    local vdir="${STOREDIR}/tmp/verify"
    info "Unpacking $(basename "${tarball}") into ${vdir}"
    command rm -rf "${vdir}"
    mkdir -p "${vdir}"
    tar xpf "${tarball}" -C "${vdir}" --xattrs-include='*.*' --numeric-owner
    if [[ -n ${INTERPRETER} ]]; then
        # binfmt_misc (no F flag here) resolves the interpreter path inside
        # the chroot, and stage tarballs don't ship qemu — lend it ours
        mkdir -p "${vdir}$(dirname "${INTERPRETER}")"
        command cp -f "${INTERPRETER}" "${vdir}${INTERPRETER}"
    fi
    info "Chroot smoke test"
    # portage needs a real /dev (it checks /dev/fd and process substitution)
    # and /proc — without them 'emerge --version' prints warnings and fails
    # while the chroot's exit status still comes from the last command
    mount -t proc none "${vdir}/proc"
    mount --rbind /dev "${vdir}/dev"
    mount --make-rslave "${vdir}/dev"
    # shellcheck disable=SC2064 — expand ${vdir} now, not at trap time
    trap "umount -R '${vdir}/dev' 2>/dev/null || true; umount '${vdir}/proc' 2>/dev/null || true" EXIT INT TERM
    # -e -o pipefail inside the chroot: each check must pass on its own
    chroot "${vdir}" /bin/bash -c '
        set -eo pipefail
        gcc --version | head -1
        emerge --version
        head -1 /etc/os-release' ||
        die "Chroot smoke test failed"
    umount -R "${vdir}/dev"
    umount "${vdir}/proc"
    trap - EXIT INT TERM
    info "OK: tarball $(du -h "${tarball}" | cut -f1), unpacked $(du -sh "${vdir}" | cut -f1)"
}

amd64_status() {
    local cat=MISSING seed="-" tree="-" specs="-" s1="-" s3="-"
    if command -v catalyst >/dev/null; then cat=ok; fi
    local t
    t=$(seed_tarball);        if [[ -n ${t} ]]; then seed=$(basename "${t}"); fi
    t=$(treeish);             if [[ -n ${t} ]]; then tree=${t:0:12}; fi
    if [[ -f ${SPECDIR}/stage1.spec ]]; then specs="rendered ($(cat "${STATE}/stamp" 2>/dev/null || echo '?'))"; fi
    t=$(built_stage stage1);  if [[ -n ${t} ]]; then s1=$(du -h "${t}" | cut -f1); fi
    t=$(built_stage stage3);  if [[ -n ${t} ]]; then s3=$(du -h "${t}" | cut -f1); fi
    echo "amd64  catalyst:${cat}  conf:$([[ -f ${CONF} ]] && echo ok || echo -)  seed:${seed}"
    echo "       treeish:${tree}  specs:${specs}  stage1:${s1}  stage3:${s3}"
}

cmd_clean_amd64() {
    local all="${1:-}"
    if [[ ${all} == all ]]; then
        confirm "Remove catalyst tmp/, built stages, snapshots and state (seeds + git repos kept)?"
        command rm -rf "${STOREDIR}/tmp" "${STOREDIR}/builds/${REL_TYPE}" \
                       "${STOREDIR}/snapshots" "${STATE}" "${SPECDIR}"
    else
        confirm "Remove catalyst tmp/ (scratch chroots)?"
        command rm -rf "${STOREDIR}/tmp"
    fi
    info "Cleaned."
}

# ---------------------------------------------------------------------------
# tiny track — Buildroot-style minimal rootfs
# ---------------------------------------------------------------------------
CROSS_EMERGE="${TUPLE}-emerge"

need_cross() {
    command -v "${CROSS_EMERGE}" >/dev/null ||
        die "No ${CROSS_EMERGE} — install the crossdev toolchain: sudo xarm setup"
}

cmd_tiny_build() {
    need_root; need_cross
    if [[ -d ${TINY_ROOT} && -n $(ls -A "${TINY_ROOT}" 2>/dev/null) ]]; then
        confirm "Regenerate from scratch (rm -rf ${TINY_ROOT})?"
        command rm -rf "${TINY_ROOT}"
    fi
    mkdir -p "${TINY_ROOT}"

    # portage ignores env USE for USE-dependency constraints (busybox[static]
    # needs libxcrypt[static-libs] in the sysroot) — the flags must live in
    # persistent config, so install our namespaced package.use into the sysroot
    info "Installing tiny USE flags: ${SYSROOT}/etc/portage/package.use/xstage-tiny"
    cp "${HERE}/tiny.portage/package.use" "${SYSROOT}/etc/portage/package.use/xstage-tiny"

    # the Buildroot idea on Gentoo: build in the sysroot, install only the
    # runtime files into ROOT; the target never sees portage (updates happen
    # here, the rootfs is regenerated, never emerged on the device)
    info "baselayout (USE=build lays out the FS skeleton)"
    USE="build" "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
        --usepkg --buildpkg --oneshot -q sys-apps/baselayout
    if [[ ${TINY_BASE} == busybox ]]; then
        info "busybox (static, applet symlinks via USE=make-symlinks)"
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q sys-apps/busybox
    else
        info "Gentoo base userland: ${TINY_BASE_PKGS//$'\n'/ }"
        # INSTALL_MASK keeps the Buildroot spirit: no docs/locales on the target
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        INSTALL_MASK="/usr/share/man /usr/share/doc /usr/share/info /usr/share/locale" \
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q ${TINY_BASE_PKGS}
        # /bin/sh normally comes from app-alternatives/sh — symlink it ourselves
        [[ -e ${TINY_ROOT}/bin/sh ]] || ln -s bash "${TINY_ROOT}/bin/sh"
    fi
    if [[ -n ${TINY_PKGS} ]]; then
        info "Extra packages: ${TINY_PKGS}"
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q ${TINY_PKGS}
    fi

    info "Device nodes + /init"
    mkdir -p "${TINY_ROOT}"/{dev,proc,sys,tmp,root,mnt}
    [[ -e ${TINY_ROOT}/dev/console ]] || mknod "${TINY_ROOT}/dev/console" c 5 1
    [[ -e ${TINY_ROOT}/dev/null ]]    || mknod "${TINY_ROOT}/dev/null" c 1 3
    write_tiny_init
    info "rootfs ready: ${TINY_ROOT} ($(du -sh "${TINY_ROOT}" | cut -f1), $(find "${TINY_ROOT}" | wc -l) entries)"
}

# /init is regenerated by 'build' and again by 'image_zero' (which adds the
# e-Paper tool the hook below looks for) — one function, one source of truth
write_tiny_init() {
    local shell=/bin/sh
    [[ ${TINY_BASE} == busybox ]] || shell=/bin/bash
    cat > "${TINY_ROOT}/init" <<-EOF
	#!/bin/sh
	# tinyroot /init — mount pseudo-filesystems and drop to a shell

	mount -t proc     none /proc
	mount -t sysfs    none /sys
	mount -t devtmpfs none /dev 2>/dev/null || true
	# without devpts an ssh login dies with "PTY allocation request failed"
	mkdir -p /dev/pts
	mount -t devpts devpts /dev/pts 2>/dev/null || true

	# board hook: 'xstage tiny image' / 'image_zero' write the board setup
	# here (ethernet or USB gadget, sshd, e-Paper banner)
	[ -x /etc/tiny-board.sh ] && /etc/tiny-board.sh

	echo
	echo "tinyroot: Gentoo-built ${TINY_BASE} rootfs, no portage inside."
	echo "Boot took \$(cut -d' ' -f1 /proc/uptime) seconds"
	echo

	exec ${shell}
	EOF
    chmod +x "${TINY_ROOT}/init"
}

cmd_tiny_pack() {
    need_root
    [[ -x ${TINY_ROOT}/init ]] || die "No rootfs — run: sudo $0 tiny build"
    command -v mksquashfs >/dev/null || die "No mksquashfs — emerge -av sys-fs/squashfs-tools"
    info "Packing squashfs"
    mksquashfs "${TINY_ROOT}" "${TINY_BLD}/rootfs.squashfs" -comp zstd -noappend -quiet
    info "Packing cpio initrd"
    (cd "${TINY_ROOT}" && find . | cpio --quiet -H newc -o --owner=0.0) \
        > "${TINY_BLD}/initrd"
    # give the artifacts back to the invoking user so 'run' works without sudo
    if [[ -n ${SUDO_UID:-} ]]; then
        chown "${SUDO_UID}:${SUDO_GID}" "${TINY_BLD}/rootfs.squashfs" "${TINY_BLD}/initrd"
    fi
    info "squashfs: $(du -h "${TINY_BLD}/rootfs.squashfs" | cut -f1)  initrd: $(du -h "${TINY_BLD}/initrd" | cut -f1)"
}

cmd_tiny_run() {
    command -v qemu-system-aarch64 >/dev/null ||
        die "No qemu-system-aarch64 — emerge qemu with QEMU_SOFTMMU_TARGETS=aarch64"
    [[ -f ${TINY_BLD}/initrd ]] || die "No initrd — run: sudo $0 tiny pack"
    # borrow xlab's arm64 -M virt kernel; do NOT touch xlab's own artifacts
    [[ -f ${XLAB_KERNEL} ]] ||
        die "No ${XLAB_KERNEL} — build it first: (cd ${REPO} && ./xlab gentoo kernel)"
    # a NIC + host forward, so an image built by 'image_zero' can be ssh-tested
    # here (the board hook falls back to eth0 with qemu's user-net defaults
    # when there is no USB gadget): ssh -p ${SSH_PORT} root@127.0.0.1
    info "Booting tinyroot (-M virt, ssh on 127.0.0.1:${SSH_PORT}; quit qemu: Ctrl-A X)"
    # -m 2048: an initramfs is unpacked into tmpfs, so the guest needs room for
    # the cpio *and* its expansion — a rootfs with the Pi module tree and
    # openssh in it panics ("Unable to mount root fs") at 1024
    exec qemu-system-aarch64 -M virt -cpu cortex-a72 -smp 2 -m 2048 \
        -kernel "${XLAB_KERNEL}" -initrd "${TINY_BLD}/initrd" \
        -append "console=ttyAMA0 init=/init" \
        -netdev "user,id=n0,hostfwd=tcp::${SSH_PORT}-:22" \
        -device virtio-net-device,netdev=n0 \
        -nographic
}

# --- Pi 400 SD-card pipeline ----------------------------------------------
# BCM2711 boot chain: EEPROM (no bootcode.bin on the card) -> start4.elf +
# fixup4.dat on an MBR FAT32 partition 1 -> config.txt -> kernel8.img +
# auto-selected DTB (bcm2711-rpi-400.dtb) + cmdline.txt; partition 2 = rootfs.

cmd_tiny_rpi() {
    need_root; need_cross
    [[ -x ${TINY_ROOT}${TINY_INIT} ]] || die "No rootfs — run: sudo $0 ${ROOT_HINT}"
    # keyword (~arm64) + license (proprietary GPU blobs) accepts, namespaced
    # like package.use/xstage-tiny
    info "Installing Pi keyword/license accepts into the sysroot"
    mkdir -p "${SYSROOT}/etc/portage/package.accept_keywords" \
             "${SYSROOT}/etc/portage/package.license"
    cp "${HERE}/tiny.portage/package.accept_keywords" \
       "${SYSROOT}/etc/portage/package.accept_keywords/xstage-tiny"
    cp "${HERE}/tiny.portage/package.license" \
       "${SYSROOT}/etc/portage/package.license/xstage-tiny"
    info "raspberrypi-image (prebuilt kernel8.img + firmware + DTBs + modules)"
    "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
        --usepkg --buildpkg --oneshot -q sys-kernel/raspberrypi-image
    [[ -f ${TINY_ROOT}/boot/kernel8.img ]] || die "No kernel8.img after emerge"
    [[ -f ${TINY_ROOT}/boot/$(board_dtb) ]] || warn "$(board_dtb) missing?"
    # a sane default inside the rootfs; the authoritative copy is written onto
    # the FAT partition by 'image' / 'image_zero', which know the board
    info "Installing the default config.txt (arm_64bit=1, kernel=kernel8.img, uart on)"
    command cp -f "${HERE}/rpi/config.txt" "${TINY_ROOT}/boot/config.txt"
    info "Pi boot payload ready: $(find "${TINY_ROOT}/boot" -type f | wc -l) files in /boot"
}

no_stale_tiny_loop() {
    # a zombie loop pinned in another mount namespace = a live fs instance
    # still writing over the image ('(deleted)' entries are inert)
    local l
    l=$(losetup -j "${TINY_IMG}" 2>/dev/null | { grep -v '(deleted)' || true; } | cut -d: -f1 | head -1)
    [[ -z ${l} ]] || die "Stale loop ${l} still attached to ${TINY_IMG} — find the holder or reboot"
}

tiny_img_mount() {  # $1 = partition device
    mkdir -p "${TINY_MNT}"
    # mounts under the shared /home tree propagate into sandboxed systemd
    # services' namespaces and can get pinned there (xlab corrupted its image
    # that way on 2026-07-31) — a private bind underneath stops propagation
    mount --bind "${TINY_MNT}" "${TINY_MNT}"
    mount --make-private "${TINY_MNT}"
    if ! mount "$1" "${TINY_MNT}"; then
        umount "${TINY_MNT}"
        die "Mount of $1 failed"
    fi
}

tiny_img_umount() {
    # two layers: the partition mount and the private bind under it
    if mountpoint -q "${TINY_MNT}"; then umount "${TINY_MNT}" || warn "umount ${TINY_MNT} failed"; fi
    if mountpoint -q "${TINY_MNT}"; then umount "${TINY_MNT}" || warn "bind umount ${TINY_MNT} failed"; fi
}

cmd_tiny_image() {
    [[ ${BOARD} != zero2w ]] || die "XSTAGE_BOARD=zero2w — use: $0 tiny image_zero"
    tiny_rpi400_payload; tiny_make_image "${BOARD}"
}
cmd_tiny_image_zero() { tiny_zero_payload; tiny_make_image zero2w; }

# --- shared rootfs extras: modprobe, network, sshd -------------------------
# Both board images get the same test workflow: boot headless, ssh to the
# board. What differs is only /etc/tiny-board.sh (which interface, which
# address) — written by the per-board payload function below.

tiny_net_install() {
    if [[ -x ${TINY_ROOT}/bin/modprobe || -x ${TINY_ROOT}/usr/bin/modprobe ||
          -x ${TINY_ROOT}/sbin/modprobe ]]; then
        info "modprobe already in the rootfs"
    else
        info "kmod (modprobe for the kernel's xz-compressed modules)"
        INSTALL_MASK="/usr/share/man /usr/share/doc /usr/share/info /usr/share/locale" \
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q sys-apps/kmod
    fi

    local netpkgs=()
    [[ -x ${TINY_ROOT}/bin/ip || -x ${TINY_ROOT}/sbin/ip ]] || netpkgs+=(sys-apps/iproute2)
    [[ -x ${TINY_ROOT}/usr/sbin/sshd ]] || netpkgs+=(net-misc/openssh)
    if [[ ${#netpkgs[@]} -gt 0 ]]; then
        info "Network + login: ${netpkgs[*]}"
        INSTALL_MASK="/usr/share/man /usr/share/doc /usr/share/info /usr/share/locale" \
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q "${netpkgs[@]}"
    else
        info "iproute2 + openssh already in the rootfs"
    fi
    [[ -x ${TINY_ROOT}/usr/sbin/sshd ]] || die "sshd missing after emerge"
}

# --- Pi 400: wired ethernet + sshd -----------------------------------------

tiny_rpi400_payload() {
    need_root; need_cross
    [[ -x ${TINY_ROOT}/init ]] || die "No rootfs — run: sudo $0 tiny build"
    tiny_net_install
    tiny_ssh_config
    tiny_rpi400_board_hook
    write_tiny_init          # /init runs the hook the call above just wrote
}

tiny_rpi400_board_hook() {
    board_eth_vars
    cat > "${TINY_ROOT}/etc/tiny-board.sh" <<-EOF
	#!/bin/sh
	# ${BOARD} board hook — generated by 'xstage tiny image'.
	# Runs from /init: wired ethernet with a fixed address, sshd — a debug
	# console that works even when HDMI shows nothing.
	IP=${ETH_IP}
	GW=${ETH_GW}
	DNS=${ETH_DNS}
	log() { echo "tiny-board: \$*"; }

	echo ${BOARD_TINY_HOSTNAME} > /proc/sys/kernel/hostname

	# --- wired ethernet ---------------------------------------------------
	# board NIC drivers; modprobe is a no-op for built-ins
	for m in ${ETH_MODULES}; do modprobe "\$m" 2>/dev/null; done
	i=0
	while [ ! -e /sys/class/net/eth0 ] && [ \$i -lt 10 ]; do
	    i=\$((i + 1)); sleep 1
	done
	if [ -e /sys/class/net/eth0 ]; then
	    case "\$(readlink /sys/class/net/eth0/device/driver 2>/dev/null)" in
	    *virtio*)
	        # the 'tiny run' (-M virt) gate: virtio-net on slirp — use qemu's
	        # user-net defaults, the LAN address would go nowhere there
	        IP=10.0.2.15/24
	        GW=10.0.2.2
	        log "virtio NIC — qemu user-net defaults" ;;
	    esac
	    ip addr add "\$IP" dev eth0 2>/dev/null
	    ip link set eth0 up
	    ip route add default via "\$GW" 2>/dev/null
	    echo "nameserver \$DNS" > /etc/resolv.conf
	    log "eth0 \$IP via \$GW"
	else
	    log "no eth0 — did the NIC driver load? (${ETH_MODULES}; lsmod, dmesg)"
	fi

	# --- sshd -------------------------------------------------------------
	if [ -x /usr/sbin/sshd ]; then
	    mkdir -p /run /var/empty /var/log
	    # host keys are made on the board, so the image carries no secrets
	    [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
	    if /usr/sbin/sshd; then
	        log "sshd up: ssh root@\${IP%%/*}"
	    else
	        log "sshd failed to start"
	    fi
	fi
	EOF
    chmod +x "${TINY_ROOT}/etc/tiny-board.sh"
}

# --- Pi Zero 2 W + Waveshare 2.13" V4 e-Paper -----------------------------
# Same partition layout as the Pi 400 image; what differs is config.txt (this
# SoC boots bootcode.bin + start.elf, and the HAT needs SPI) and the rootfs
# extras: modprobe, plus the panel driver that /init calls at boot.

tiny_zero_payload() {
    need_root; need_cross
    [[ -x ${TINY_ROOT}/init ]] || die "No rootfs — run: sudo $0 tiny build"

    tiny_net_install

    # the font header is generated from the kernel tree in ../src, not committed
    [[ -f ${HERE}/rpi/font8x16.h ]] || "${HERE}/rpi/mkfont.sh"
    info "Cross-compiling eink213 (SPI + gpiochip v2, no libs beyond libc)"
    "${TUPLE}-gcc" -O2 -Wall -Wextra -s -o "${TINY_ROOT}/usr/bin/eink213" \
        "${HERE}/rpi/eink213v4.c" ||
        die "eink213 build failed"
    info "e-Paper support ready: /usr/bin/eink213 ($(du -h "${TINY_ROOT}/usr/bin/eink213" | cut -f1))"

    tiny_ssh_config
    tiny_zero_board_hook
    write_tiny_init          # /init runs the hook the two calls above just wrote
}

tiny_ssh_config() {
    mkdir -p "${TINY_ROOT}"/{etc/ssh,root/.ssh,var/empty,run}
    chmod 700 "${TINY_ROOT}/root/.ssh"
    # a lab box on a private link: root logs in directly, there is no other
    # account and no PAM — sshd reads /etc/shadow itself
    cat > "${TINY_ROOT}/etc/ssh/sshd_config" <<-EOF
	# generated by xstage (tiny image / image_zero)
	PermitRootLogin yes
	PasswordAuthentication yes
	PermitEmptyPasswords no
	UsePAM no
	PrintMotd no
	Subsystem sftp /usr/lib/misc/sftp-server
	EOF

    # root password: openssl (host side) writes the SHA-512 crypt into the
    # rootfs shadow — no chroot needed, the file format is arch-independent
    local hash
    hash=$(openssl passwd -6 "${ZERO_PASS}") || die "openssl passwd failed"
    sed -i "s|^root:[^:]*:|root:${hash}:|" "${TINY_ROOT}/etc/shadow" ||
        die "could not set the root password in ${TINY_ROOT}/etc/shadow"

    # key login too, if the invoking user has an ed25519 key (or named one)
    local keyfile="${ZERO_KEY}"
    if [[ -z ${keyfile} && -n ${SUDO_USER:-} ]]; then
        keyfile="/home/${SUDO_USER}/.ssh/id_ed25519.pub"
    fi
    if [[ -n ${keyfile} && -f ${keyfile} ]]; then
        command cp -f "${keyfile}" "${TINY_ROOT}/root/.ssh/authorized_keys"
        chmod 600 "${TINY_ROOT}/root/.ssh/authorized_keys"
        info "ssh: root password '${ZERO_PASS}' + key $(basename "${keyfile}")"
    else
        info "ssh: root password '${ZERO_PASS}' (no pubkey found — set XSTAGE_ZERO_KEY=/path/to/key.pub)"
    fi
}

tiny_zero_board_hook() {
    # everything board-specific lives in one script /init calls, so the rootfs
    # itself (and the Pi 400 image built from it) stays generic
    cat > "${TINY_ROOT}/etc/tiny-board.sh" <<-EOF
	#!/bin/sh
	# Pi Zero 2 W board hook — generated by 'xstage tiny image_zero'.
	# Runs from /init: USB-gadget ethernet, sshd, e-Paper banner.
	IP=${ZERO_IP}
	GW=${ZERO_GW}
	DNS=${ZERO_DNS}
	log() { echo "tiny-board: \$*"; }

	echo tinyzero > /proc/sys/kernel/hostname

	# --- USB gadget ethernet ---------------------------------------------
	# dwc2 is built into the Pi kernel and put into peripheral mode by
	# 'dtoverlay=dwc2'; g_ether then presents a CDC/RNDIS NIC to the host.
	# Fixed locally-administered MACs keep the host-side interface name
	# stable across boots. The cable belongs in the USB port, not PWR IN.
	modprobe g_ether dev_addr=02:00:00:00:00:02 host_addr=02:00:00:00:00:01 2>/dev/null
	i=0
	while [ ! -e /sys/class/net/usb0 ] && [ \$i -lt 10 ]; do
	    i=\$((i + 1)); sleep 1
	done
	if [ -e /sys/class/net/usb0 ]; then
	    ip addr add "\$IP" dev usb0 2>/dev/null
	    ip link set usb0 up
	    ip route add default via "\$GW" 2>/dev/null
	    echo "nameserver \$DNS" > /etc/resolv.conf
	    log "usb0 \$IP via \$GW"
	elif [ -e /sys/class/net/eth0 ]; then
	    # qemu -M virt has no USB gadget, but it does have virtio-net on
	    # slirp: these are qemu's own user-net defaults, so 'xstage tiny run'
	    # can exercise sshd with no hardware attached
	    ip addr add 10.0.2.15/24 dev eth0 2>/dev/null
	    ip link set eth0 up
	    ip route add default via 10.0.2.2 2>/dev/null
	    echo "nameserver \$DNS" > /etc/resolv.conf
	    IP=10.0.2.15/24
	    log "no usb0; eth0 10.0.2.15 (qemu user-net)"
	else
	    log "no usb0 — check dtoverlay=dwc2 and use the USB (data) port"
	fi

	# --- sshd -------------------------------------------------------------
	if [ -x /usr/sbin/sshd ]; then
	    mkdir -p /run /var/empty /var/log
	    # host keys are made on the board, so the image carries no secrets
	    [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
	    if /usr/sbin/sshd; then
	        log "sshd up: ssh root@\${IP%%/*}"
	    else
	        log "sshd failed to start"
	    fi
	fi

	# --- e-Paper ----------------------------------------------------------
	# SPI is a module in the Pi kernel and nothing here runs udev
	if [ -x /usr/bin/eink213 ]; then
	    modprobe spi-bcm2835 2>/dev/null
	    modprobe spidev 2>/dev/null
	    if [ -e /dev/spidev0.0 ]; then
	        /usr/bin/eink213 "tinyroot / gentoo" "\$(uname -r)" \\
	            "ssh root@\${IP%%/*}" \\
	            "boot \$(cut -d' ' -f1 /proc/uptime)s" &
	    fi
	fi
	EOF
    chmod +x "${TINY_ROOT}/etc/tiny-board.sh"
}

tiny_make_image() {  # tiny_make_image <rpi400|rpi3|zero2w>
    need_root
    local board="$1" cfg
    case "${board}" in
        rpi400) cfg="${HERE}/rpi/config.txt" ;;
        rpi3)   cfg="${HERE}/rpi/config-rpi3.txt" ;;
        zero2w) cfg="${HERE}/rpi/config-zero2w.txt" ;;
        *)      die "Unknown board: ${board}" ;;
    esac
    [[ -x ${TINY_ROOT}${TINY_INIT} ]] || die "No rootfs — run: sudo $0 ${ROOT_HINT}"
    [[ -f ${TINY_ROOT}/boot/kernel8.img ]] || die "No Pi payload — run: sudo $0 ${TGT} rpi"
    command -v parted >/dev/null || die "No parted — emerge -av sys-block/parted"
    command -v mkfs.vfat >/dev/null || die "No mkfs.vfat — emerge -av sys-fs/dosfstools"
    no_stale_tiny_loop
    info "Creating ${TINY_IMG} for ${board} (${IMG_MB} MiB: ${BOOT_MB} MiB FAT32 boot + ext4 rootfs)"
    command rm -f "${TINY_IMG}"
    truncate -s "${IMG_MB}M" "${TINY_IMG}"
    # MBR (msdos), not GPT: the Pi GPU bootloader expects an MBR FAT32 part 1
    parted --script "${TINY_IMG}" \
        mklabel msdos \
        mkpart primary fat32 1MiB "$((BOOT_MB + 1))MiB" \
        set 1 lba on \
        mkpart primary ext4 "$((BOOT_MB + 1))MiB" 100%
    local loop
    loop=$(losetup -Pf --show "${TINY_IMG}")
    # shellcheck disable=SC2064 — expand ${loop} now, it's gone at trap time
    trap "tiny_img_umount; losetup -d ${loop} 2>/dev/null || true" EXIT INT TERM
    mkfs.vfat -F32 -n RPIBOOT "${loop}p1" >/dev/null
    mkfs.ext4 -q -L tinyroot "${loop}p2"
    # MBR disk id -> root=PARTUUID=<id>-02: survives dd, so the identical
    # cmdline works in qemu and on the physical card regardless of mmcblk N
    local ptuuid
    ptuuid=$(blkid -o value -s PTUUID "${loop}")
    [[ -n ${ptuuid} ]] || die "No PTUUID on ${loop}"
    echo "${ptuuid}" > "${TINY_BLD}/ptuuid"

    info "Boot partition: /boot payload + ${board} config.txt + rendered cmdline.txt"
    tiny_img_mount "${loop}p1"
    # plain cp -r: vfat has no owners/modes, cp -a would fail preserving them
    cp -r "${TINY_ROOT}/boot/." "${TINY_MNT}/"
    # the board-specific config wins over whatever 'tiny rpi' left in the rootfs
    command cp -f "${cfg}" "${TINY_MNT}/config.txt"
    sed -e "s/@PTUUID@/${ptuuid}/" -e "s|@INIT@|${TINY_INIT}|" \
        "${HERE}/rpi/cmdline.txt.in" > "${TINY_MNT}/cmdline.txt"
    tiny_img_umount

    info "Root partition: rootfs (minus /boot, which lives on the FAT side)"
    tiny_img_mount "${loop}p2"
    rsync -a --exclude='/boot/*' "${TINY_ROOT}/" "${TINY_MNT}/"
    tiny_img_umount

    losetup -d "${loop}"
    trap - EXIT INT TERM
    echo "${board}" > "${TINY_BOARD_F}"
    if [[ -n ${SUDO_UID:-} ]]; then
        chown "${SUDO_UID}:${SUDO_GID}" "${TINY_IMG}" "${TINY_BLD}/ptuuid" "${TINY_BOARD_F}"
    fi
    info "sd.img ready for ${board}: $(du -h "${TINY_IMG}" | cut -f1) (PARTUUID ${ptuuid}-02)"
}

cmd_tiny_run_rpi() {
    command -v qemu-system-aarch64 >/dev/null ||
        die "No qemu-system-aarch64 — emerge qemu with QEMU_SOFTMMU_TARGETS=aarch64"
    [[ -f ${TINY_IMG} ]] || die "No sd.img — run: sudo $0 ${TGT} image"
    local ptuuid board machine dtb
    ptuuid=$(cat "${TINY_BLD}/ptuuid" 2>/dev/null) || die "No ${TINY_BLD}/ptuuid — rerun: sudo $0 ${TGT} image"
    board=$(cat "${TINY_BOARD_F}" 2>/dev/null || echo rpi400)
    # qemu has no model for either of our boards, so use the closest SoC
    # sibling: raspi4b (BCM2711) for the Pi 400, raspi3b (BCM2837) for the
    # Zero 2 W, whose RP3A0 package holds exactly that die.
    case "${board}" in
        rpi3|zero2w) machine=raspi3b; dtb=bcm2710-rpi-3-b.dtb ;;
        *)           machine=raspi4b; dtb=bcm2711-rpi-4-b.dtb ;;
    esac
    # qemu does not emulate the VideoCore firmware chain: kernel goes in via
    # -kernel and the SD image only provides the root device. The working
    # serial console is ttyAMA1, not ttyAMA0/serial0 as on real hardware.
    # KNOWN QEMU GAP (verified 2026-08-01 on both machines, cf. qemu issue
    # #2969): serial and USB input never reach the guest, with -nographic or
    # with -serial stdio alike — these models are output-only. This subcommand
    # is a BOOT GATE (kernel + PARTUUID root + init reach the bash banner);
    # for an interactive shell use 'tiny run' (-M virt) or the real Pi.
    # -snapshot: guest writes go to a temporary overlay, never to sd.img. The
    # gate boots a rootfs that generates ssh host keys on first boot; without
    # this, every card dd'ed from the image would ship the keys qemu made.
    info "Booting sd.img for ${board} (-M ${machine}, -snapshot; OUTPUT-ONLY — quit qemu: Ctrl-A X)"
    exec qemu-system-aarch64 -M "${machine}" -snapshot \
        -kernel "${TINY_ROOT}/boot/kernel8.img" \
        -dtb "${TINY_ROOT}/boot/${dtb}" \
        -drive "file=${TINY_IMG},format=raw,if=sd" \
        -append "console=ttyAMA1,115200 root=PARTUUID=${ptuuid}-02 rootwait rw init=${TINY_INIT}" \
        -nographic
}

cmd_tiny_sd() {
    need_root
    [[ $# -eq 1 ]] || die "Usage: sudo $0 ${TGT} sd /dev/sdX|/dev/mmcblkN"
    local dev="${1%/}"
    [[ -f ${TINY_IMG} ]] || die "No sd.img — run: sudo $0 ${TGT} image"
    [[ ${dev} =~ ^/dev/(sd[a-z]+|mmcblk[0-9]+)$ ]] ||
        die "Whole device without partition expected, e.g. /dev/sdb or /dev/mmcblk0"
    [[ -b ${dev} ]] || die "Block device not found: ${dev}"
    local name="${dev#/dev/}"
    # never a disk that holds a mounted / (covers LUKS/LVM via the child tree)
    lsblk -no MOUNTPOINTS "${dev}" | grep -qx / &&
        die "${dev} holds the root filesystem — refusing"
    local removable idbus model size
    removable=$(cat "/sys/block/${name}/removable" 2>/dev/null || echo 0)
    idbus=$(udevadm info --query=property --name="${dev}" | { grep '^ID_BUS=' || true; } | cut -d= -f2)
    [[ ${removable} == 1 || ${idbus} == usb || ${idbus} == mmc || ${name} == mmcblk* ]] ||
        die "${dev}: removable=0 and ID_BUS='${idbus:-?}' — refusing to touch an internal disk"
    [[ $(blockdev --getsize64 "${dev}") -ge $(stat -c%s "${TINY_IMG}") ]] ||
        die "${dev} is smaller than ${TINY_IMG}"
    model=$(cat "/sys/block/${name}/device/model" 2>/dev/null || echo '?')
    size=$(lsblk -dno SIZE "${dev}")
    warn "Target: ${dev}  model:${model% }  size:${size}  removable:${removable}  bus:${idbus:-?}"
    confirm "Overwrite ${dev} with ${TINY_IMG} (ALL data on it is lost)?"
    local p
    for p in "${dev}"?*; do
        [[ -b ${p} ]] && umount "${p}" 2>/dev/null || true
    done
    dd if="${TINY_IMG}" of="${dev}" bs=8M conv=fsync status=progress
    sync; partprobe "${dev}" 2>/dev/null || true
    lsblk -o NAME,SIZE,FSTYPE,LABEL "${dev}"
    local board; board=$(cat "${TINY_BOARD_F}" 2>/dev/null || echo rpi400)
    if [[ ${board} == zero2w ]]; then
        info "Done (${board}). Insert into the Pi Zero 2 W and power on: the"
        info "e-Paper HAT shows the boot banner; for a shell attach a 3V3 USB"
        info "serial adapter to GPIO 14/15 (115200 8N1) — HDMI works too."
    elif [[ ${board} == rpi3 ]]; then
        info "Done (${board}). Insert into the Pi 3 and power on: console on"
        info "HDMI + USB keyboard; serial on GPIO 14/15 is the PL011"
        info "(dtoverlay=disable-bt pins it to ttyAMA0, 115200 8N1)."
    else
        info "Done (${board}). Insert into the Pi 400 and power on: console on"
        info "HDMI + built-in keyboard (and serial0 on GPIO 14/15)."
    fi
    # mmcblk0 -> mmcblk0p2, sdf -> sdf2
    local part2="${dev}2"; [[ ${dev} == *[0-9] ]] && part2="${dev}p2"
    info "To use the whole card, grow partition + filesystem:"
    info "  sudo parted ${dev} resizepart 2 100%"
    info "  sudo e2fsck -f ${part2}   # resize2fs refuses without a fresh check"
    info "  sudo resize2fs ${part2}"
}

tiny_status() {
    local tc=ok rootfs="-" sq="-" ird="-" pkgs="-"
    if ! command -v "${CROSS_EMERGE}" >/dev/null 2>&1; then tc=MISSING; fi
    if [[ -d ${SYSROOT}/var/cache/binpkgs ]]; then
        pkgs=$({ find "${SYSROOT}/var/cache/binpkgs" -name '*.gpkg.tar' -o -name '*.tbz2' 2>/dev/null || true; } | wc -l)
    fi
    # du exits non-zero on subdirs unreadable without root but still prints
    # the total — don't let pipefail+set -e turn that into a dead status
    local base="-"
    if [[ -x ${TINY_ROOT}/init ]]; then
        rootfs=$(du -sh "${TINY_ROOT}" 2>/dev/null | cut -f1 || true)
        if [[ -e ${TINY_ROOT}/bin/busybox ]]; then base=busybox; else base=gentoo; fi
    fi
    if [[ -f ${TINY_BLD}/rootfs.squashfs ]]; then sq=$(du -h "${TINY_BLD}/rootfs.squashfs" | cut -f1); fi
    if [[ -f ${TINY_BLD}/initrd ]]; then ird=$(du -h "${TINY_BLD}/initrd" | cut -f1); fi
    local sd="-" rpi=no board="-" eink=no
    if [[ -f ${TINY_IMG} ]]; then
        sd=$(du -h "${TINY_IMG}" | cut -f1)
        board=$(cat "${TINY_BOARD_F}" 2>/dev/null || echo '?')
    fi
    if [[ -f ${TINY_ROOT}/boot/kernel8.img ]]; then rpi=yes; fi
    if [[ -x ${TINY_ROOT}/usr/bin/eink213 ]]; then eink=yes; fi
    echo "tiny   tc:${tc}  sysroot-binpkgs:${pkgs}  base:${base}  rootfs:${rootfs}  squashfs:${sq}  initrd:${ird}"
    echo "       kernel:$([[ -f ${XLAB_KERNEL} ]] && echo ok || echo 'MISSING (./xlab gentoo kernel)')  rpi-payload:${rpi}  eink213:${eink}  sd.img:${sd} (${board})"
}

cmd_tiny_clean() {
    confirm "Remove ${TINY_BLD}?"
    command rm -rf "${TINY_BLD}"
    info "Cleaned tiny."
}

# ---------------------------------------------------------------------------
# arm64 track — stage3 on a Pi 400 SD card, plus building the stage3 itself
# ---------------------------------------------------------------------------
# Two halves. The SD half: unpack a stage3, add the Pi payload and reuse the
# tiny image machinery (the dispatch switched every TINY_* path via
# use_arm64_dirs). Unlike tiny this is a full OpenRC system: PID 1 is
# /sbin/init, networking is netifrc and sshd comes from the stage3 itself —
# no /etc/tiny-board.sh. The build half: the shared amd64 catalyst pipeline
# retargeted by use_arm64_stage_conf (qemu-user interpreter + stages-qemu
# confdir + distcc offload to the crossdev cross-gcc), plus the crossstage
# shortcut. 'seed' is the shared cmd_seed retargeted to the arm64 autobuilds.

# --- catalyst under qemu: setup + preflight --------------------------------

arm64_stage_preflight() {
    [[ -x ${INTERPRETER} ]] ||
        die "No ${INTERPRETER} — emerge app-emulation/qemu with QEMU_USER_TARGETS=aarch64 USE=static-user"
    [[ -f /proc/sys/fs/binfmt_misc/qemu-aarch64 ]] ||
        die "binfmt_misc has no qemu-aarch64 entry — the chroot could not exec arm64 binaries"
    command -v "${TUPLE}-gcc" >/dev/null ||
        die "No ${TUPLE}-gcc — the distcc offload needs the crossdev toolchain: sudo xarm setup"
    # drift heuristic: the chroot emerges its gcc from the same stable tree
    # the host follows, so a major-version gap between cross-gcc and host gcc
    # usually means crossdev needs a rebuild before a long distcc run
    local cg hg
    cg=$("${TUPLE}-gcc" -dumpversion 2>/dev/null | cut -d. -f1)
    hg=$(gcc -dumpversion 2>/dev/null | cut -d. -f1)
    if [[ -z ${cg} || ${cg} != "${hg}" ]]; then
        warn "cross-gcc major '${cg:-?}' vs host gcc major '${hg:-?}' — distcc mixes compiler versions; rebuild crossdev (sudo xarm setup) if the chroot ends up on a different gcc"
    fi
}

cmd_arm64_stage_setup() {
    arm64_stage_preflight
    cmd_setup
}

# --- crossstage: @system at native speed, no catalyst ----------------------
# The Buildroot trick scaled up to a full stage3: cross-emerge the system set
# into a ROOT with the crossdev toolchain (the census cross-compiled all 190
# Pi packages this way), then tar it with the release flags. Lab-grade: no
# update_seed sanity, no releng confdir — but ~1-2 h instead of 6-12.

cmd_arm64_crossstage() {
    need_root; need_cross
    local cs_root="${XDIR}/crossstage/rootfs"
    # the sysroot profile decides what @system means — insist on arm64 so the
    # tarball matches the catalyst/release stage3 flavour; repointing it here
    # could break xarm, whose setup owns that symlink
    local prof; prof=$(readlink -f "${SYSROOT}/etc/portage/make.profile" 2>/dev/null || true)
    [[ ${prof} == */arm64/* ]] ||
        die "Sysroot profile '${prof:-unset}' is not arm64 — fix ${SYSROOT}/etc/portage/make.profile (sudo xarm setup)"
    info "Sysroot profile: ${prof#*/profiles/}"

    if [[ -d ${cs_root} && -n $(ls -A "${cs_root}" 2>/dev/null) ]]; then
        confirm "Regenerate from scratch (rm -rf ${cs_root})?"
        command rm -rf "${cs_root}"
    fi
    mkdir -p "${cs_root}"

    info "cross-emerge @system into ${cs_root} (native speed)"
    "${CROSS_EMERGE}" --root="${cs_root}" --root-deps=rdeps \
        --usepkg --buildpkg --jobs="${JOBS}" -q @system
    [[ -x ${cs_root}/bin/bash ]] || die "No /bin/bash after @system — cross-emerge failed?"
    # the release stage3 ships the same dangling symlink; it resolves once
    # the target syncs ::gentoo
    ln -snf "../../var/db/repos/gentoo/profiles/${PROFILE}" \
        "${cs_root}/etc/portage/make.profile"
    [[ -e ${cs_root}/bin/sh ]] || ln -s bash "${cs_root}/bin/sh"

    local stamp out
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    mkdir -p "${STOREDIR}/builds/${REL_TYPE}"
    out="${STOREDIR}/builds/${REL_TYPE}/stage3-${SUBARCH}-${FLAVOR}-${stamp}-cross.tar.xz"
    info "Packing $(basename "${out}")"
    XZ_OPT="-T0" tar cJpf "${out}" --xattrs --numeric-owner -C "${cs_root}" .
    info "crossstage ready: ${out} ($(du -h "${out}" | cut -f1))"
    info "Image it: XSTAGE_ARM64_TARBALL=${out} sudo $0 arm64 unpack"
}

# --- the SD half -----------------------------------------------------------

arm64_newest_stage3() {
    ls -t "${DL_DIR}/stage3-arm64-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true
}

cmd_arm64_unpack() {
    need_root
    # env override: image a self-built stage3 (catalyst or crossstage tarball
    # from builds/) instead of the downloaded release
    local tarball="${XSTAGE_ARM64_TARBALL:-}"
    if [[ -n ${tarball} ]]; then
        [[ -f ${tarball} ]] || die "XSTAGE_ARM64_TARBALL not found: ${tarball}"
        info "Using XSTAGE_ARM64_TARBALL"
    else
        tarball=$(arm64_newest_stage3)
        [[ -n ${tarball} ]] || die "No stage3-arm64 tarball in ${DL_DIR} — run: $0 arm64 seed"
    fi
    if [[ -d ${TINY_ROOT} ]]; then
        confirm "Remove existing ${TINY_ROOT} and re-unpack?"
        command rm -rf "${TINY_ROOT}"
    fi
    mkdir -p "${TINY_ROOT}"
    info "Unpacking $(basename "${tarball}") (handbook flags: xattrs, numeric owners)"
    tar xpf "${tarball}" -C "${TINY_ROOT}" --xattrs-include='*.*' --numeric-owner
    [[ -x ${TINY_ROOT}/sbin/init ]] || die "No /sbin/init after unpack — broken tarball?"
    info "rootfs ready: ${TINY_ROOT} ($(du -sh "${TINY_ROOT}" 2>/dev/null | cut -f1 || true))"
}

arm64_configure() {
    need_root
    [[ -x ${TINY_ROOT}/sbin/init ]] || die "No rootfs — run: sudo $0 arm64 unpack"

    # root password: the same host-side hash trick as the tiny ssh images
    local hash
    hash=$(openssl passwd -6 "${ZERO_PASS}") || die "openssl passwd failed"
    sed -i "s|^root:[^:]*:|root:${hash}:|" "${TINY_ROOT}/etc/shadow" ||
        die "could not set the root password in ${TINY_ROOT}/etc/shadow"

    # ssh: root login + the invoker's key; host keys are generated by the
    # sshd init script on first boot, so the image carries no secrets
    mkdir -p "${TINY_ROOT}/etc/ssh/sshd_config.d" "${TINY_ROOT}/root/.ssh"
    chmod 700 "${TINY_ROOT}/root/.ssh"
    echo "PermitRootLogin yes" > "${TINY_ROOT}/etc/ssh/sshd_config.d/50-xstage.conf"
    local keyfile="${ZERO_KEY}"
    if [[ -z ${keyfile} && -n ${SUDO_USER:-} ]]; then
        keyfile="/home/${SUDO_USER}/.ssh/id_ed25519.pub"
    fi
    if [[ -n ${keyfile} && -f ${keyfile} ]]; then
        command cp -f "${keyfile}" "${TINY_ROOT}/root/.ssh/authorized_keys"
        chmod 600 "${TINY_ROOT}/root/.ssh/authorized_keys"
        info "ssh: root password '${ZERO_PASS}' + key $(basename "${keyfile}")"
    else
        info "ssh: root password '${ZERO_PASS}' (no pubkey found — set XSTAGE_ZERO_KEY=/path/to/key.pub)"
    fi

    # netifrc fixed address on eth0 — what the tiny image fakes with a board
    # hook, a stage3 does with the real thing
    board_eth_vars
    [[ -e ${TINY_ROOT}/etc/init.d/net.lo ]] || warn "netifrc missing in the stage3?"
    cat > "${TINY_ROOT}/etc/conf.d/net" <<-EOF
	# generated by 'xstage arm64 image' (board: ${BOARD})
	config_eth0="${ETH_IP}"
	routes_eth0="default via ${ETH_GW}"
	dns_servers_eth0="${ETH_DNS}"
	EOF
    ln -snf net.lo "${TINY_ROOT}/etc/init.d/net.eth0"
    ln -snf /etc/init.d/net.eth0 "${TINY_ROOT}/etc/runlevels/default/net.eth0"
    ln -snf /etc/init.d/sshd    "${TINY_ROOT}/etc/runlevels/default/sshd"

    echo "hostname=\"${BOARD_SD_HOSTNAME}\"" > "${TINY_ROOT}/etc/conf.d/hostname"

    # fstab by label — tiny_make_image labels the partitions exactly so
    cat > "${TINY_ROOT}/etc/fstab" <<-EOF
	# generated by 'xstage arm64 image'
	LABEL=RPIBOOT   /boot   vfat    noauto,noatime  0 0
	LABEL=tinyroot  /       ext4    noatime         0 1
	EOF
    info "configured: eth0 ${ETH_IP} via ${ETH_GW}, sshd + net.eth0 in the default runlevel"
}

cmd_arm64_image() {
    [[ ${BOARD} != zero2w ]] || die "XSTAGE_BOARD=zero2w is a tiny-track board — use: $0 tiny image_zero"
    arm64_configure
    tiny_make_image "${BOARD}"
}

arm64_status() {
    local seed="-" rootfs="-" rpi=no sd="-"
    local t; t=$(arm64_newest_stage3)
    [[ -n ${t} ]] && seed=$(basename "${t}")
    if [[ -x ${TINY_ROOT}/sbin/init ]]; then
        rootfs=$(du -sh "${TINY_ROOT}" 2>/dev/null | cut -f1 || true)
    fi
    [[ -f ${TINY_ROOT}/boot/kernel8.img ]] && rpi=yes
    [[ -f ${TINY_IMG} ]] && sd=$(du -h "${TINY_IMG}" | cut -f1)
    echo "arm64  seed:${seed}  rootfs:${rootfs}  rpi-payload:${rpi}  sd.img:${sd}"
    # the build half (needs use_arm64_stage_conf applied by the dispatch)
    local tree="-" specs="-" s1="-" s3="-" dd=down
    t=$(treeish);            [[ -n ${t} ]] && tree=${t:0:12}
    [[ -f ${SPECDIR}/stage1.spec ]] && specs="rendered ($(cat "${STATE}/stamp" 2>/dev/null || echo '?'))"
    t=$(built_stage stage1); [[ -n ${t} ]] && s1=$(du -h "${t}" | cut -f1)
    t=$(built_stage stage3); [[ -n ${t} ]] && s3=$(du -h "${t}" | cut -f1)
    pgrep -x distccd >/dev/null && dd=up
    echo "       catalyst: conf:$([[ -f ${CONF} ]] && echo ok || echo -)  treeish:${tree}  specs:${specs}  stage1:${s1}  stage3:${s3}  distccd:${dd}"
}

cmd_arm64_clean() {
    confirm "Remove ${TINY_BLD}?"
    command rm -rf "${TINY_BLD}"
    info "Cleaned arm64."
}

# ---------------------------------------------------------------------------
# status / targets / dispatch
# ---------------------------------------------------------------------------
cmd_status_all() {
    amd64_status
    tiny_status
    ( use_arm64_dirs; use_arm64_stage_conf; arm64_status )
}

cmd_clean_all() {
    # arm64sd* covers the default tree plus every per-profile variant
    # (PROF_BUILD_SUBDIR=arm64sd-<name>)
    local blddir; blddir="$(dirname "${TINY_BLD}")"
    confirm "Clean ALL tracks (catalyst tmp + ${TINY_BLD} + ${blddir}/arm64sd*)?"
    command rm -rf "${STOREDIR}/tmp" "${TINY_BLD}" "${blddir}"/arm64sd*
    info "Cleaned all."
}

cmd_targets() {
    sed -n '/^# Targets:/,/^#$/p' "$0" | sed 's/^# \?//'
}

[[ $# -ge 1 ]] || { help; exit 0; }

case "$1" in
    -h|--help|help) help; exit 0 ;;
    targets)        cmd_targets; exit 0 ;;
    status)         cmd_status_all; exit 0 ;;
    clean)          cmd_clean_all; exit 0 ;;
esac

TGT="$1"; shift
CMD="${1:-status}"; shift || true

case "${TGT}" in
amd64)
    case "${CMD}" in
        status)   amd64_status ;;
        setup)    cmd_setup "$@" ;;
        seed)     cmd_seed "$@" ;;
        snapshot) cmd_snapshot "$@" ;;
        spec)     cmd_spec "$@" ;;
        stage1)   cmd_stage1 "$@" ;;
        stage2)   cmd_stage2 "$@" ;;
        stage3)   cmd_stage3 "$@" ;;
        all)      cmd_all "$@" ;;
        verify)   cmd_verify "$@" ;;
        log)      cmd_log "$@" ;;
        qlop|qlog) cmd_qlop "$@" ;;
        clean)    cmd_clean_amd64 "$@" ;;
        *)        die "Unknown amd64 subcommand: ${CMD} (see: $0 --help)" ;;
    esac ;;
tiny)
    case "${CMD}" in
        status)   tiny_status ;;
        build)    cmd_tiny_build "$@" ;;
        pack)     cmd_tiny_pack "$@" ;;
        run)      cmd_tiny_run "$@" ;;
        rpi)        cmd_tiny_rpi "$@" ;;
        image)      cmd_tiny_image "$@" ;;
        image_zero) cmd_tiny_image_zero "$@" ;;
        run-rpi)  cmd_tiny_run_rpi "$@" ;;
        sd)       cmd_tiny_sd "$@" ;;
        clean)    cmd_tiny_clean "$@" ;;
        *)        die "Unknown tiny subcommand: ${CMD} (see: $0 --help)" ;;
    esac ;;
arm64)
    use_arm64_dirs
    case "${CMD}" in
        status)   use_arm64_stage_conf; arm64_status ;;
        seed)     use_arm64_stage_conf; cmd_seed "$@" ;;
        unpack)   cmd_arm64_unpack "$@" ;;
        rpi)      cmd_tiny_rpi "$@" ;;
        image)    cmd_arm64_image "$@" ;;
        run-rpi)  cmd_tiny_run_rpi "$@" ;;
        sd)       cmd_tiny_sd "$@" ;;
        clean)    cmd_arm64_clean "$@" ;;
        # the build half: the shared catalyst pipeline, retargeted
        setup)    use_arm64_stage_conf; cmd_arm64_stage_setup "$@" ;;
        snapshot) use_arm64_stage_conf; cmd_snapshot "$@" ;;
        spec)     use_arm64_stage_conf; cmd_spec "$@" ;;
        stage1|stage2|stage3)
                  use_arm64_stage_conf; run_catalyst "${CMD}" ;;
        all)      use_arm64_stage_conf; cmd_all "$@" ;;
        verify)   use_arm64_stage_conf; cmd_verify "$@" ;;
        log)      use_arm64_stage_conf; cmd_log "$@" ;;
        qlop|qlog) use_arm64_stage_conf; cmd_qlop "$@" ;;
        crossstage)
                  use_arm64_stage_conf; cmd_arm64_crossstage "$@" ;;
        *)        die "Unknown arm64 subcommand: ${CMD} (see: $0 --help)" ;;
    esac ;;
*)  die "Unknown target: ${TGT} (see: $0 targets)" ;;
esac
