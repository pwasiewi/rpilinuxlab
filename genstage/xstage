#!/bin/bash
# xstage — Gentoo stage bootstrapping + Buildroot-style tiny rootfs, in the
# xlab/xarm/xowrt style.
#
# Two tracks in one script:
#  * amd64 — catalyst-driven stage1 -> stage3 (the way Release Engineering
#    builds the official tarballs), native on this host. stage2 is kept as an
#    explicit educational step (bootstrap.sh inside the stage1 chroot) but the
#    default pipeline goes stage1 -> stage3 like modern releng.
#  * tiny  — the Gentoo analog of Buildroot: a minimal aarch64 rootfs emerged
#    into a directory with --root= (no portage inside), regenerated from
#    scratch on the host instead of updated on the target.
# Recipe/background: rpilinuxlab/genstage/readme.md
#
# Usage: xstage <target> <subcommand> [args]
#        xstage targets | status | clean
#
# Targets:
#   amd64      catalyst stage1/stage2/stage3 bootstrap, native amd64
#   tiny       minimal aarch64 rootfs via the xarm crossdev sysroot
#   arm64      arm64 stage3 on a Pi 400 SD image: unpack the official release
#              (no compilation), build stage1/stage3 with catalyst under
#              qemu-user + distcc-to-cross, or cross-emerge a lab stage3
#
# Subcommands (amd64):
#   status           seed / snapshot / specs / built stages
#   setup            check catalyst+pixz+squashfs, dirs on /mnt/db5, private
#                    catalyst.conf, releng + gentoo.git clones          [root]
#   seed             download + sha256-verify the latest amd64 stage3 seed
#                    into ../dl/ and place it in catalyst builds/default/
#   snapshot [REF]   update gentoo.git, catalyst -s REF (default stable),
#                    record the commit hash for the specs               [root]
#   spec             render specs/*.spec.in -> $XSTAGE_DIR/specs/
#   stage1           catalyst -f stage1.spec  (toolchain from the seed) [root]
#   stage2           catalyst -f stage2.spec  (educational: bootstrap.sh
#                    rebuilds the stage1 toolchain with itself; NOT part
#                    of 'all' — releng skips it)                        [root]
#   stage3           catalyst -f stage3.spec  (emerge -e @system)      [root]
#   all              seed + snapshot + spec + stage1 + stage3           [root]
#   verify           unpack the newest built stage3, chroot smoke test  [root]
#   log [emerge]     follow the newest package build log of the running
#                    catalyst (or the chroot's emerge.log); warns when a
#                    duplicate catalyst sits queued on the run lock      [root]
#   qlop [ARGS]      qlop over the run's chroot emerge.log (default -tv:
#                    merge times); 'qlop -r' = current merge + elapsed   [root]
#   clean            rm catalyst tmp/ ('clean all': + built stages,
#                    snapshots and state; seeds and git repos kept)  [confirm]
#
# Subcommands (amd64 live half — stage3 -> livecd.squashfs; the deliverable
# is the USB stick ('usb'), the isolinux ISO is optional (qemu 'gate' only);
# layout as bin/v builds from /etc/liveusb; driven by an xp native profile):
#   unpack           unpack the newest built stage3 (or the seed) into
#                    build/<profile>/rootfs                                [root]
#   conf             make.conf, repos.conf, ::gentoo + overlays seeded from
#                    the host tree, portage profile, config fragments       [root]
#   pkgs             prepare /usr/src/linux + merged .config (so linux-info
#                    pre-merge checks audit the image, not the host), then
#                    emerge PROF_LIVE_PKGS / _TIERS / _SETS in the chroot   [root]
#   configure        hostname, root password, live user + autologin, sshd,
#                    default runlevel, motd  [root]
#   kernel           genkernel with CDROOT=1 inside the chroot; the .config is
#                    built by merging live/kernel/*.fragment onto a base
#                    (XSTAGE_LIVE_KCONFIG_BASE: defconfig | host | PATH),
#                    re-merged here even if 'pkgs' already staged it        [root]
#   squash           mksquashfs -> iso/livecd.squashfs + the /livecd marker [root]
#   isolinux         populate iso/isolinux/ (optional — only 'iso' needs it) [root]
#   iso              xorriso -> livecd.iso (optional: the qemu-gate artifact;
#                    isohybrid, dd-able; not needed for 'usb')              [root]
#   live             unpack + conf + pkgs + configure + kernel + squash, in
#                    that order (no ISO — 'usb' is next; 'isolinux'+'iso'
#                    only if you want the qemu gate)                        [root]
#   gate             boot the ISO in qemu (interactive, KVM when available)
#   usb DEV [--wipe] the deliverable. Existing build-usb stick: just copies
#                    kernel + UUID-initrd -> p1 and squashfs -> p2 (DATA
#                    partitions untouched). --wipe or no ESP+LIVE layout:
#                    wipes the WHOLE stick — build-usb repartitions, installs
#                    GRUB, then the same copies                    [root,confirm]
#   live-status      rootfs / kernel / squashfs / iso state
#   live-clean       rm the profile's live build tree                    [confirm]
#
# Subcommands (tiny):
#   status           toolchain / rootfs / squashfs / initrd state
#   build            REGENERATE from scratch: rm rootfs, cross-emerge
#                    baselayout + base packages (+XSTAGE_TINY_PKGS) with
#                    --root=, device nodes, /init                [root,confirm]
#                    base = XSTAGE_TINY_BASE: 'gentoo' (default: bash,
#                    coreutils, util-linux & friends) or 'busybox' (static)
#   pack             mksquashfs + cpio newc initrd into ../build/tinyroot/
#   run              boot the initrd with xlab's arm64 kernel in qemu -M virt,
#                    NIC forwarded to 127.0.0.1:$XSTAGE_SSH_PORT (ssh test)
#   rpi              add the Pi boot payload to the rootfs: cross-emerge
#                    sys-kernel/raspberrypi-image (kernel8.img + start*.elf +
#                    every DTB + /lib/modules); board-independent — the
#                    image step picks the right config.txt              [root]
#   image            build sd.img for the Pi 400: MBR, FAT32 boot + ext4
#                    rootfs, PARTUUID cmdline — the same image boots qemu
#                    and the card. Adds iproute2 + sshd to the rootfs;
#                    /etc/tiny-board.sh gives eth0 a fixed LAN address
#                    (default 192.168.0.200) and starts sshd, so the board
#                    is reachable even with a dark HDMI                  [root]
#   image_zero       the same for a Pi Zero 2 W + Waveshare 2.13" V4 e-Paper
#                    HAT: SPI + USB-gadget (dwc2) in config.txt; kmod, the
#                    eink213 panel driver, iproute2 and sshd added to the
#                    rootfs; /etc/tiny-board.sh brings up usb0 (10.0.0.2,
#                    host = 10.0.0.1), starts sshd and paints the banner
#                    on the display                                      [root]
#   run-rpi          boot sd.img in qemu (raspi4b or raspi3b, matching the
#                    board the image was built for): boot GATE only — output
#                    on ttyAMA1, but qemu can't inject input into it
#   sd DEV           dd sd.img onto a real SD card (/dev/sdX or
#                    /dev/mmcblkN, removable-only safety)        [root,confirm]
#   clean            rm ../build/tinyroot                            [confirm]
#
# Subcommands (arm64):
#   status           seed / rootfs / payload / sd.img / catalyst state
#   seed             download + sha256-verify the latest arm64 stage3
#                    into ../dl/ (+ catalyst builds/default/ when set up)
#   unpack           untar the stage3 into ../build/arm64sd/rootfs
#                    (handbook flags: xattrs, numeric owners); source
#                    override: XSTAGE_ARM64_TARBALL=/path       [root,confirm]
#   rpi              same Pi boot payload step as 'tiny rpi'             [root]
#   image            configure the stage3 (root password + invoker's key,
#                    PermitRootLogin, eth0 = the board's IP, sshd enabled,
#                    fstab by label) and build sd.img for XSTAGE_BOARD
#                    (rpi400/rpi3). The init system follows the stage3
#                    flavour: OpenRC gets netifrc + a runlevel symlink and
#                    init=/sbin/init, systemd gets a .network file, unit
#                    .wants symlinks and init=/usr/lib/systemd/systemd  [root]
#   run-rpi          qemu -M raspi4b boot gate (output-only)
#   sd DEV           dd sd.img onto a real SD card               [root,confirm]
#   clean            rm ../build/arm64sd                              [confirm]
#   setup            catalyst dirs + catalyst-arm64.conf (distcc option) +
#                    qemu/binfmt/crossdev preflight                     [root]
#   snapshot [REF]   same snapshot step as amd64, own state dir         [root]
#   spec             render specs the qemu way: interpreter key, stages-qemu
#                    confdir, update_seed: no (distcc_hosts sits in the conf)
#   stage1|stage2|stage3  catalyst in a qemu-user chroot; compiles ship to
#                    host distccd -> crossdev cross-gcc (native speed);
#                    distccd is auto-started via xarm when not running  [root]
#   all              seed + snapshot + spec + stage1 + stage3           [root]
#   verify           unpack the newest built stage3, qemu-chroot smoke
#                    test (lends the chroot our static qemu-aarch64)    [root]
#   log|qlop         same build-watching helpers as amd64               [root]
#   crossstage       fast path, no catalyst: cross-emerge @system into a
#                    ROOT at native speed and tar it as a lab-grade
#                    stage3 (feed it back via XSTAGE_ARM64_TARBALL)     [root]
#
# Env overrides:
#   XSTAGE_DIR        catalyst data dir       (default /mnt/db5/genstage;
#                     also settable in /etc/xp.conf — explicit env wins)
#   XSTAGE_JOBS       catalyst/emerge jobs    (default nproc)
#   XSTAGE_MIRROR     gentoo mirror           (default https://distfiles.gentoo.org)
#   XSTAGE_FLAVOR     stage flavour           (default openrc)
#   XSTAGE_REL_TYPE   catalyst rel_type       (default lab; seeds stay in default/)
#   XSTAGE_TREEISH    snapshot hash override  (default: recorded by 'snapshot')
#   XSTAGE_TINY_TUPLE crossdev tuple          (default aarch64-unknown-linux-gnu)
#   XSTAGE_TINY_BASE  rootfs userland         (default gentoo; or busybox)
#   XSTAGE_TINY_PKGS  extra tiny packages     (default empty)
#   XSTAGE_TINY_IMG_MB sd.img size in MiB     (default 2048; keep a power of 2)
#   XSTAGE_ARM64_IMG_MB arm64 sd.img size in MiB (default 4096; power of 2)
#   XSTAGE_BOARD      eth board for 'image': rpi400 (default) or rpi3
#   XSTAGE_BUILD_SUBDIR build tree name under ../build/ (default tinyroot /
#                     arm64sd — xp variant profiles set their own)
#   XSTAGE_PI400_IP   Pi 400 eth0 address     (default 192.168.0.200/24)
#   XSTAGE_PI400_GW   Pi 400 default gateway  (default 192.168.0.1)
#   XSTAGE_PI400_DNS  Pi 400 nameserver       (default: the gateway)
#   XSTAGE_PI3_IP     Pi 3 eth0 address       (default 192.168.0.201/24)
#   XSTAGE_PI3_GW/_DNS Pi 3 gateway/DNS       (default 192.168.0.1 / gateway)
#   XPROFILE          xp profile name (rpilinuxlab/profiles/ — sets the
#                     defaults above; explicit env still wins)
#   XSTAGE_ZERO_IP    Zero 2 W usb0 address   (default 10.0.0.2/24)
#   XSTAGE_ZERO_GW    the machine at the other end of the cable (10.0.0.1)
#   XSTAGE_ZERO_DNS   resolv.conf nameserver  (default 8.8.8.8)
#   XSTAGE_ROOT_PASS  root password, all ssh images (default tiny; xp
#                     profiles default it to <profile>root, e.g. rpi400root;
#                     XSTAGE_ZERO_PASS = legacy alias)
#   XSTAGE_ROOT_LABEL rootfs partition label, mkfs + fstab (default tinyroot;
#                     xp profiles default it to <profile>root too)
#   XSTAGE_ZERO_KEY   pubkey for root        (default ~SUDO_USER/.ssh/id_ed25519.pub)
#   XSTAGE_SSH_PORT   host port 'tiny run' forwards to :22   (default 2223)
#   XSTAGE_DISTCC_HOSTS  distcc_hosts for arm64 catalyst (default 127.0.0.1:3632/JOBS)
#   XSTAGE_ARM64_TARBALL stage3 for 'arm64 unpack'  (default: newest in ../dl/)
#
# Typical flow:
#   sudo ./xstage amd64 setup
#   ./xstage amd64 seed
#   sudo ./xstage amd64 all            # stage1 -> stage3, hours of compiling
#   sudo ./xstage amd64 verify
#   sudo ./xstage tiny build && sudo ./xstage tiny pack && ./xstage tiny run
#   sudo ./xstage tiny rpi && sudo ./xstage tiny image && ./xstage tiny run-rpi
#   sudo ./xstage tiny sd /dev/sdX     # then boot the real Pi 400
#   sudo ./xstage tiny rpi && sudo ./xstage tiny image_zero   # Zero 2 W + e-Paper
#   ./xstage tiny run-rpi && sudo ./xstage tiny sd /dev/mmcblk0
#   ./xstage arm64 seed && sudo ./xstage arm64 unpack          # full Gentoo
#   sudo ./xstage arm64 rpi && sudo ./xstage arm64 image && ./xstage arm64 run-rpi
#   sudo ./xstage arm64 sd /dev/sdX    # OpenRC Gentoo on the Pi 400
#   xarm distcc start && sudo ./xstage arm64 setup   # build arm64 stages here:
#   sudo ./xstage arm64 all            # catalyst, qemu+distcc (est. 6-12 h)
#   sudo ./xstage arm64 crossstage     # or the ~1-2 h lab stage3, no catalyst
#   XSTAGE_ARM64_TARBALL=/path sudo ./xstage arm64 unpack   # image own stage3

set -euo pipefail

# --- optional xp profile layer (see rpilinuxlab/profiles/README.md) --------
# XPROFILE=<name> (or XPROFILE_FILE=<path>) sources the profile, which exports
# the XARM_*/XSTAGE_*/XLAB_* env overrides — explicit env still wins.
if [[ -n ${XPROFILE:-}${XPROFILE_FILE:-} ]]; then
    [[ -n ${XP_LAB_DIR:-} || ! -r /etc/xp.conf ]] || source /etc/xp.conf
    if [[ -z ${XP_LAB_DIR:-} ]]; then
        _xpd="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
        for _xpc in "${_xpd}" "${_xpd}/.."; do
            [[ -f ${_xpc}/profiles/global.conf ]] && { XP_LAB_DIR="${_xpc}"; break; }
        done
    fi
    _xpf="${XPROFILE_FILE:-${XP_LAB_DIR:-}/profiles/${XPROFILE:-}.conf}"
    [[ -r ${_xpf} ]] ||
        { echo "❌  xp profile not found: ${_xpf} (set XP_LAB_DIR or write /etc/xp.conf)" >&2; exit 1; }
    source "$(dirname "${_xpf}")/global.conf"
    source "${_xpf}"
    xprofile_apply
fi

# ---------------------------------------------------------------------------
# Globals
# ---------------------------------------------------------------------------
HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(dirname "${HERE}")"          # rpilinuxlab root
# Shared data trees — precedence: env / /etc/xp.conf knob > in-repo build/
# and dl/. With XP_BUILD_DIR + XP_DL_DIR set (xp exports them) the repo needs
# no build/dl symlinks at all. The guard mirrors the XSTAGE_DIR one below.
if [[ -z ${XP_DL_DIR:-}${XP_BUILD_DIR:-} && -r /etc/xp.conf ]]; then source /etc/xp.conf; fi
DL_DIR="${XP_DL_DIR:-${REPO}/dl}"
BUILD_ROOT="${XP_BUILD_DIR:-${REPO}/build}"
JOBS="${XSTAGE_JOBS:-$(nproc)}"

# amd64 / catalyst track — data dir precedence: env > /etc/xp.conf > default
if [[ -z ${XSTAGE_DIR:-} && -r /etc/xp.conf ]]; then source /etc/xp.conf; fi
XDIR="${XSTAGE_DIR:-/mnt/db5/genstage}"
MIRROR="${XSTAGE_MIRROR:-https://distfiles.gentoo.org}"
FLAVOR="${XSTAGE_FLAVOR:-openrc}"
REL_TYPE="${XSTAGE_REL_TYPE:-lab}"
SUBARCH=amd64
# The portage profile catalyst builds @system against. It has to agree with
# FLAVOR: a spec stamped 'systemd-<date>' but built against the OpenRC profile
# produces a tarball whose name lies about its contents. The xp profile layer
# exports the right one (PROF_PORTAGE_PROFILE / PROF_LIVE_PORTAGE_PROFILE);
# cmd_spec refuses a value that does not match SUBARCH.
PROFILE="${XSTAGE_PORTAGE_PROFILE:-default/linux/amd64/23.0}"
AUTOBUILDS="${MIRROR}/releases/${SUBARCH}/autobuilds"
# per-arch catalyst knobs — amd64 builds natively, so no extra spec keys
CAT_OPTIONS='"autoresume", "bindist", "pkgcache", "seedcache", "ccache"'
CAT_EXTRA_CONF=""       # extra catalyst.conf lines (arm64: distcc_hosts)
INTERPRETER=""          # qemu-user binary catalyst copies into a foreign chroot
UPDATE_SEED="yes"       # stage1: refresh the seed before building from it
DISTCC_HOSTS_VAL=""     # non-empty -> distcc offload expected, gate on distccd
# per-track compiler cache — catalyst's "ccache" option bind-mounts the host
# CCACHE_DIR (set at invocation in run_catalyst) into the chroot at
# /var/tmp/ccache; one cache per architecture, never shared across arches
CCACHE_TRACK_DIR="${XDIR}/ccache-amd64"

# live half of the amd64 track — the stage3 does not end on an SD card but in
# livecd.squashfs plus an isolinux directory, the layout bin/v builds from
# /etc/liveusb. Own build tree per profile (amd64live, amdkde, …).
LIVE_BLD="${BUILD_ROOT}/${XSTAGE_LIVE_SUBDIR:-amd64live}"
LIVE_ROOT="${LIVE_BLD}/rootfs"
LIVE_ISO_DIR="${LIVE_BLD}/iso"
LIVE_IMG="${LIVE_BLD}/livecd.iso"
LIVE_TIERS="${XSTAGE_LIVE_TIERS:-}"
LIVE_PKGS="${XSTAGE_LIVE_PKGS:-}"
LIVE_OVERLAY_PKGS="${XSTAGE_LIVE_OVERLAY_PKGS:-}"
LIVE_CYCLE_BOOTSTRAP="${XSTAGE_LIVE_CYCLE_BOOTSTRAP:-}"
LIVE_RESTRICT_PKGS="${XSTAGE_LIVE_RESTRICT_PKGS:-}"
LIVE_KMOD_PKGS="${XSTAGE_LIVE_KMOD_PKGS:-}"
LIVE_REPOS="${XSTAGE_LIVE_REPOS:-}"
LIVE_SETS="${XSTAGE_LIVE_SETS:-}"
LIVE_HOSTNAME="${XSTAGE_LIVE_HOSTNAME:-amd64live}"
LIVE_VOLID="${XSTAGE_LIVE_VOLID:-AMD64LIVE}"
LIVE_VIDEO_CARDS="${XSTAGE_LIVE_VIDEO_CARDS:-}"
LIVE_USE="${XSTAGE_LIVE_USE:-}"
LIVE_ACCEPT_LICENSE="${XSTAGE_LIVE_ACCEPT_LICENSE:-}"
LIVE_PYTHON_TARGETS="${XSTAGE_LIVE_PYTHON_TARGETS:-}"
LIVE_EMERGE_OPTS="${XSTAGE_LIVE_EMERGE_OPTS:-}"
LIVE_CFLAGS="${XSTAGE_LIVE_CFLAGS:-}"
LIVE_CPU_FLAGS_X86="${XSTAGE_LIVE_CPU_FLAGS_X86:-}"
LIVE_FEATURES="${XSTAGE_LIVE_FEATURES:-}"
LIVE_CCACHE_DIR="${XSTAGE_LIVE_CCACHE_DIR:-}"
LIVE_CCACHE_MNT="/var/cache/ccache"    # where LIVE_CCACHE_DIR is bind-mounted
LIVE_DISTFILES_DIR="${XSTAGE_LIVE_DISTFILES_DIR:-}"
LIVE_DISTFILES_MNT="/var/tmp/distfiles"   # same path as the host, so DISTDIR reads alike
LIVE_BUILDDIR="${XSTAGE_LIVE_BUILDDIR:-}"
LIVE_BUILDDIR_MNT="/var/tmp/portage"      # PORTAGE_TMPDIR stays /var/tmp
# host binpkg cache shared with the image: getbinpkg reads it, buildpkg fills
# it — and the packages persist across image rebuilds instead of being thrown
# away with the rootfs
LIVE_BINPKGS_DIR="${XSTAGE_LIVE_BINPKGS_DIR:-}"
LIVE_BINPKGS_MNT="/var/cache/binpkgs"     # portage's default PKGDIR
# raw make.conf lines, newline-separated, appended last inside the managed
# block. This is how a profile sets a USE_EXPAND variable (LLVM_SLOT,
# LUA_SINGLE_TARGET, RUBY_TARGETS, …). Writing 'llvm_slot_21' into USE instead
# looks equivalent and is not: USE only ADDS the flag, while the variable
# REPLACES the profile's whole set. With USE the profile's own default stays
# on beside it, and mesa's 'exactly-one-of ( llvm_slot_18 … llvm_slot_22 )'
# then fails — a resolver error, so it aborts the entire run.
LIVE_MAKECONF_EXTRA="${XSTAGE_LIVE_MAKECONF_EXTRA:-}"
# 'pkgs' updates the stage3 to the tree before merging the package list; see
# cmd_live_pkgs for why the two cannot share one resolver graph. Set to 'no'
# only to reproduce a seed-era build.
LIVE_UPDATE_FIRST="${XSTAGE_LIVE_UPDATE_FIRST:-yes}"
LIVE_PYTHON_SINGLE_TARGET="${XSTAGE_LIVE_PYTHON_SINGLE_TARGET:-}"
LIVE_PORTAGE_PROFILE="${XSTAGE_LIVE_PORTAGE_PROFILE:-}"
# the kernel sources /usr/src/linux/.config is built against; a profile whose
# package list ships another sources package (zen-sources, say) should name it
# here too, or the image ends up carrying both trees
LIVE_KERNEL_PKG="${XSTAGE_LIVE_KERNEL_PKG:-sys-kernel/gentoo-sources}"
# unprivileged live user, autologged-in on console and display manager; sddm
# refuses root, so without one a desktop image boots to a dead login screen.
# '-' not ':-' on purpose: XSTAGE_LIVE_USER="" disables the account entirely
LIVE_USER="${XSTAGE_LIVE_USER-guest}"
# squashfs codec: zstd compresses ~4x faster than xz at a few percent size
# cost — bin/v picks xz because its images are burned once and booted forever
LIVE_COMP="${XSTAGE_LIVE_COMP:-zstd}"
SYSLINUX_DIR="${XSTAGE_SYSLINUX_DIR:-/usr/share/syslinux}"
# host scripts owning the USB stick contract (bin/ sibling of the lab repo):
# build-usb partitions + installs GRUB, build-initrd-uuid-next builds the
# busybox initrd that finds the LIVE partition by UUID
USB_TOOLS="${XSTAGE_USB_TOOLS_DIR:-$(dirname "${REPO}")/bin}"
LIVE_TPL="${HERE}/live"
# init and service manager follow from the stage3 flavour (the xp profile layer
# derives them); defaults here keep a bare 'xstage' call working.
# The XSTAGE_LIVE_* spelling is historical — the live ISO was the first
# consumer — but the values describe any image, so the arm64 SD track reads
# them through the neutral aliases below.
LIVE_INIT="${XSTAGE_LIVE_INIT:-/sbin/init}"
LIVE_RC="${XSTAGE_LIVE_RC:-openrc}"
INIT_PATH="${LIVE_INIT}"
RC_SYSTEM="${LIVE_RC}"
LIVE_FLAVOR_NAME="${XSTAGE_STAGE3_FLAVOR:-${FLAVOR}}"
# genkernel's CDROOT initrd finds the media by the /livecd marker, then
# loop-mounts /livecd.squashfs as the real root — hence no root=<device> here.
# real_init is what the initrd execs after the switch: /sbin/init on OpenRC,
# /usr/lib/systemd/systemd on a systemd flavour.
LIVE_APPEND="${XSTAGE_LIVE_APPEND:-root=/dev/ram0 init=/linuxrc real_init=${LIVE_INIT} dokeymap looptype=squashfs loop=/livecd.squashfs cdroot}"

STOREDIR="${XDIR}/catalyst"
CONF="${XDIR}/conf/catalyst.conf"
SPECDIR="${XDIR}/specs"
STATE="${XDIR}/state"
LOGDIR="${XDIR}/logs"
RELENG="${XDIR}/releng"
CONFDIR="${RELENG}/releases/portage/stages"
# the sync mirror, not repo/gentoo.git: only it has the CI-verified 'stable'
# branch, plus the generated metadata/md5-cache catalyst profits from
GENTOO_GIT="https://anongit.gentoo.org/git/repo/sync/gentoo.git"
RELENG_GIT="https://github.com/gentoo/releng.git"
GIT_REPO="${STOREDIR}/repos/gentoo.git"

# tiny track
TUPLE="${XSTAGE_TINY_TUPLE:-aarch64-unknown-linux-gnu}"
SYSROOT="/usr/${TUPLE}"
# XSTAGE_BUILD_SUBDIR: variant build trees (xp profiles with PROF_BUILD_SUBDIR)
# — several boards/experiments keep independent rootfs/image dirs while
# sharing the sysroot and its binpkgs
TINY_BLD="${BUILD_ROOT}/${XSTAGE_BUILD_SUBDIR:-tinyroot}"
TINY_ROOT="${TINY_BLD}/rootfs"
TINY_IMG="${TINY_BLD}/sd.img"
TINY_MNT="${TINY_BLD}/mnt"
# which board the current sd.img was built for — 'run-rpi' and 'sd' read it
TINY_BOARD_F="${TINY_BLD}/board"
# power of 2: qemu's SD-card emulation rejects other sizes
IMG_MB="${XSTAGE_TINY_IMG_MB:-2048}"
BOOT_MB=256
TINY_BASE="${XSTAGE_TINY_BASE:-gentoo}"     # gentoo | busybox
# Pi Zero 2 W USB-gadget link: the board is ZERO_IP, the machine you plug the
# cable into is ZERO_GW (give it 10.0.0.1/24 on the enx… interface)
ZERO_IP="${XSTAGE_ZERO_IP:-10.0.0.2/24}"
ZERO_GW="${XSTAGE_ZERO_GW:-10.0.0.1}"
ZERO_DNS="${XSTAGE_ZERO_DNS:-8.8.8.8}"
# root password for the ssh-enabled images; xp profiles default it to
# <profile>root (XSTAGE_ROOT_PASS); XSTAGE_ZERO_PASS kept for back-compat
ZERO_PASS="${XSTAGE_ROOT_PASS:-${XSTAGE_ZERO_PASS:-tiny}}"
# rootfs partition label (mkfs.ext4 -L + fstab, ext4 limit 16 chars); xp
# profiles default it to <profile>root as well
ROOT_LABEL="${XSTAGE_ROOT_LABEL:-tinyroot}"
ZERO_KEY="${XSTAGE_ZERO_KEY:-}"             # pubkey file; default: invoker's ed25519
# Pi 400 wired LAN: fixed address so the board is reachable over ssh even
# when HDMI shows nothing — the headless debug console
PI400_IP="${XSTAGE_PI400_IP:-192.168.0.200/24}"
PI400_GW="${XSTAGE_PI400_GW:-192.168.0.1}"
PI400_DNS="${XSTAGE_PI400_DNS:-${PI400_GW}}"
# Pi 3 wired LAN — its own address so both boards can sit on the LAN at once
PI3_IP="${XSTAGE_PI3_IP:-192.168.0.201/24}"
PI3_GW="${XSTAGE_PI3_GW:-192.168.0.1}"
PI3_DNS="${XSTAGE_PI3_DNS:-${PI3_GW}}"
# which eth board 'image' builds for: rpi400 (default) or rpi3; zero2w keeps
# its own subcommand (image_zero). Set by the xp profile layer.
BOARD="${XSTAGE_BOARD:-rpi400}"

# board_eth_vars: BOARD -> ETH_* + the two hostnames (tiny hook / stage3)
board_eth_vars() {
    case "${BOARD}" in
    rpi3)
        ETH_IP="${PI3_IP}"; ETH_GW="${PI3_GW}"; ETH_DNS="${PI3_DNS}"
        # Pi 3 ethernet hangs off USB: LAN9514 (3B, smsc95xx) / LAN7515 (3B+)
        ETH_MODULES="smsc95xx lan78xx"
        BOARD_TINY_HOSTNAME=tinypi3; BOARD_SD_HOSTNAME=pi3 ;;
    *)
        ETH_IP="${PI400_IP}"; ETH_GW="${PI400_GW}"; ETH_DNS="${PI400_DNS}"
        ETH_MODULES="bcmgenet"          # the BCM2711 on-die NIC
        BOARD_TINY_HOSTNAME=tinyroot; BOARD_SD_HOSTNAME=pi400 ;;
    esac
}

# board_dtb: the DTB the firmware picks on the REAL board (payload sanity check)
board_dtb() {
    case "${1:-${BOARD}}" in
        rpi3)   echo bcm2710-rpi-3-b.dtb ;;
        zero2w) echo bcm2710-rpi-zero-2-w.dtb ;;
        *)      echo bcm2711-rpi-400.dtb ;;
    esac
}
# 2223, not 2222: xlab's gentoo VM already forwards that one
SSH_PORT="${XSTAGE_SSH_PORT:-2223}"         # host port 'tiny run' forwards to :22
TINY_PKGS="${XSTAGE_TINY_PKGS:-}"
# the real Gentoo base userland (glibc/ncurses/readline & co. arrive as rdeps)
TINY_BASE_PKGS="app-shells/bash sys-apps/coreutils sys-apps/util-linux
    sys-apps/grep sys-apps/sed sys-apps/gawk sys-apps/findutils
    sys-process/procps sys-apps/less"
XLAB_KERNEL="${BUILD_ROOT}/gentoo/emu/vmlinuz"
# what PID 1 is in the image — the tiny rootfs has the /init hook script, a
# stage3 has real OpenRC; rendered into cmdline.txt and the run-rpi -append
TINY_INIT="/init"
ROOT_HINT="tiny build"                      # 'no rootfs' die messages

# arm64 track: same image machinery as tiny, different rootfs source — the
# dispatch switches every TINY_* path here before calling the shared functions
ARM64_AUTOBUILDS="${MIRROR}/releases/arm64/autobuilds"
use_arm64_dirs() {
    TINY_BLD="${BUILD_ROOT}/${XSTAGE_BUILD_SUBDIR:-arm64sd}"
    TINY_ROOT="${TINY_BLD}/rootfs"
    TINY_IMG="${TINY_BLD}/sd.img"
    TINY_MNT="${TINY_BLD}/mnt"
    TINY_BOARD_F="${TINY_BLD}/board"
    # PID 1 on the card. /sbin/init is a symlink to systemd on a systemd
    # stage3, so it would work either way — but naming the real binary keeps
    # cmdline.txt honest and survives a stage3 that drops the compat symlink.
    TINY_INIT="${INIT_PATH}"
    ROOT_HINT="arm64 unpack"
    # a stage3 with the Pi payload is ~2 GB unpacked; still a power of 2
    IMG_MB="${XSTAGE_ARM64_IMG_MB:-4096}"
}

# arm64 catalyst build: the amd64 pipeline retargeted — qemu-user interpreter
# in the chroot, releng's stages-qemu workaround confdir, and distcc shipping
# every compile to host distccd backed by the crossdev cross-gcc (the chroot
# shares the host network, so 127.0.0.1 reaches it). snapshots, releng and
# gentoo.git stay shared with amd64; specs/state/conf/logs get their own dirs.
use_arm64_stage_conf() {
    SUBARCH=arm64
    PROFILE="${XSTAGE_PORTAGE_PROFILE:-default/linux/arm64/23.0}"
    AUTOBUILDS="${ARM64_AUTOBUILDS}"
    REL_TYPE="${XSTAGE_REL_TYPE:-lab-arm64}"
    CONFDIR="${RELENG}/releases/portage/stages-qemu"
    CONF="${XDIR}/conf/catalyst-arm64.conf"
    SPECDIR="${XDIR}/specs-arm64"
    STATE="${XDIR}/state-arm64"
    LOGDIR="${XDIR}/logs-arm64"
    INTERPRETER="/usr/bin/qemu-aarch64"
    # updating the seed would first recompile half of it under pure emulation
    UPDATE_SEED="no"
    CAT_OPTIONS='"autoresume", "bindist", "pkgcache", "seedcache", "distcc", "ccache"'
    CCACHE_TRACK_DIR="${XDIR}/ccache-arm64"
    DISTCC_HOSTS_VAL="${XSTAGE_DISTCC_HOSTS:-127.0.0.1:3632/${JOBS}}"
    # distcc_hosts is a catalyst.conf value, not a spec key
    CAT_EXTRA_CONF="distcc_hosts = \"${DISTCC_HOSTS_VAL}\""
}

ALL_TARGETS=(amd64 tiny arm64)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die()     { echo "❌  $*" >&2; exit 1; }
info()    { echo ">>>  $*"; }
warn()    { echo "⚠️   $*" >&2; }
confirm() { read -r -p "$1 [yes/NO]: " ans; [[ "$ans" == "yes" ]] || die "Aborted."; }
help()    { sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \?//'; }

need_root()     { [[ $EUID -eq 0 ]] || die "Root required: sudo $0 ${TGT:-} ${CMD:-}"; }
need_catalyst() { command -v catalyst >/dev/null || die "No catalyst — install: emerge -av dev-util/catalyst"; }

# The lab has two halves that must never borrow each other's verbs: ARM boards
# (cross-compiled, run under qemu) and the native amd64 live image. Both write
# to build/<subdir>/rootfs, so a mismatched profile is not a harmless typo — it
# is an offer to overwrite the other half's rootfs. XSTAGE_PROF_KIND comes from
# the xp profile layer; when no profile is active the check stays quiet, since
# a bare 'xstage' call has no profile to contradict.
need_native_profile() {
    [[ ${XSTAGE_PROF_KIND:-native} != board ]] ||
        die "'${CMD:-?}' builds the native amd64 live image, but the active profile is ${XSTAGE_PROF_NAME:-?} (an ARM board under qemu). Switch it: XPROFILE=amdkde $0 ${TGT:-amd64} ${CMD:-?}"
}
need_board_profile() {
    [[ ${XSTAGE_PROF_KIND:-board} != native ]] ||
        die "'${TGT:-?} ${CMD:-?}' builds an ARM board rootfs, but the active profile is ${XSTAGE_PROF_NAME:-?} (native amd64). Switch it: XPROFILE=rpi400 $0 ${TGT:-?} ${CMD:-?}"
}

# ---------------------------------------------------------------------------
# amd64 track — catalyst stage1/2/3
# ---------------------------------------------------------------------------
seed_tarball()  { ls -1t "${STOREDIR}/builds/default/stage3-${SUBARCH}-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true; }
built_stage()   { ls -1t "${STOREDIR}/builds/${REL_TYPE}/$1-${SUBARCH}-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true; }
snapshot_hash() {
    local s
    s=$(ls -1t "${STOREDIR}/snapshots/gentoo"-*.sqfs 2>/dev/null | head -1 || true)
    if [[ -n ${s} ]]; then s=${s##*/gentoo-}; echo "${s%.sqfs}"; fi
}
treeish() {
    if [[ -n ${XSTAGE_TREEISH:-} ]]; then echo "${XSTAGE_TREEISH}"; return; fi
    if [[ -f ${STATE}/treeish ]]; then cat "${STATE}/treeish"; fi
}

cmd_setup() {
    need_root; need_catalyst
    grep -qw squashfs /proc/filesystems ||
        die "Host kernel lacks SquashFS — catalyst mounts its snapshot as sqfs"
    command -v pixz >/dev/null ||
        warn "No pixz (specs use compression_mode: pixz) — emerge -av app-arch/pixz"
    [[ -f /usr/share/openpgp-keys/gentoo-release.asc ]] ||
        warn "No gentoo-release keyring — snapshot commit verification will fail: emerge -av sec-keys/openpgp-keys-gentoo-release"

    mkdir -p "${XDIR}/conf" "${SPECDIR}" "${STATE}" "${LOGDIR}" \
             "${STOREDIR}/builds/default" "${STOREDIR}/builds/${REL_TYPE}" \
             "${STOREDIR}/repos" "${STOREDIR}/tmp"
    ccache_track_dir_setup

    if [[ -f ${CONF} ]]; then
        info "Keeping existing ${CONF}"
    else
        info "Writing ${CONF}"
        # private config — /etc/catalyst is never touched; every catalyst call
        # in this script passes -c ${CONF}
        cat > "${CONF}" <<-EOF
	# xstage catalyst config (private; used via: catalyst -c ${CONF})
	digests = ["blake2b", "sha512"]
	options = [${CAT_OPTIONS}]
	storedir = "${STOREDIR}"
	port_logdir = "${LOGDIR}"
	jobs = ${JOBS}
	load-average = $(nproc).0
	${CAT_EXTRA_CONF}
	EOF
    fi

    if [[ -d ${RELENG}/.git ]]; then
        info "Keeping existing releng clone"
    else
        info "Cloning releng (spec confdir templates)"
        git clone --depth 1 "${RELENG_GIT}" "${RELENG}"
    fi

    if [[ -d ${GIT_REPO} ]]; then
        info "Keeping existing gentoo.git"
    else
        # catalyst -s snapshots from the git repo at repos/<repo_name>.git
        info "Cloning gentoo.git (bare, branch stable, shallow — ~80 MB)"
        git clone --bare --depth 1 --branch stable "${GENTOO_GIT}" "${GIT_REPO}"
    fi
    # seed and spec run without root — hand their target dirs to the invoker
    if [[ -n ${SUDO_UID:-} ]]; then
        chown "${SUDO_UID}:${SUDO_GID}" "${STOREDIR}/builds/default" "${STATE}" "${SPECDIR}"
    fi
    info "Setup done. Next: $0 ${TGT:-amd64} seed"
}

cmd_seed() {
    mkdir -p "${DL_DIR}"
    local latest_txt="latest-stage3-${SUBARCH}-${FLAVOR}.txt"
    info "Resolving latest stage3 (${SUBARCH}, ${FLAVOR}) from ${AUTOBUILDS}"
    local relpath
    relpath=$(curl -fsSL "${AUTOBUILDS}/${latest_txt}" \
        | awk '/^[0-9]{8}T[0-9]{6}Z\// {print $1; exit}')
    [[ -n ${relpath} ]] || die "Could not parse ${latest_txt}"
    local tarball; tarball=$(basename "${relpath}")

    if [[ -f ${DL_DIR}/${tarball} && -f ${DL_DIR}/${tarball}.sha256 ]]; then
        info "${tarball} already downloaded"
    else
        info "Downloading ${tarball} (~300 MB)"
        wget -O "${DL_DIR}/${tarball}" "${AUTOBUILDS}/${relpath}" ||
            { command rm -f "${DL_DIR}/${tarball}"; die "seed download failed"; }
        wget -qO "${DL_DIR}/${tarball}.sha256" "${AUTOBUILDS}/${relpath}.sha256" ||
            { command rm -f "${DL_DIR}/${tarball}.sha256"; die "sha256 download failed"; }
    fi
    info "Verifying sha256"
    (cd "${DL_DIR}" && grep -E "\s${tarball}\$" "${tarball}.sha256" | sha256sum -c --quiet) ||
        die "SHA256 mismatch on ${tarball} — delete it from dl/ and retry"

    # origin, not just transport: the .sha256 rides the same mirror as the
    # tarball. Verify releng's detached signature against the packaged keyring.
    local keyring=/usr/share/openpgp-keys/gentoo-release.asc
    if [[ -f ${keyring} ]]; then
        if [[ ! -f ${DL_DIR}/${tarball}.asc ]]; then
            wget -qO "${DL_DIR}/${tarball}.asc" "${AUTOBUILDS}/${relpath}.asc" ||
                { command rm -f "${DL_DIR}/${tarball}.asc"; die "asc download failed"; }
        fi
        info "Verifying releng GPG signature"
        local gtmp; gtmp=$(mktemp -d)
        GNUPGHOME="${gtmp}" gpg -q --import "${keyring}" 2>/dev/null
        GNUPGHOME="${gtmp}" gpg -q --trust-model always \
            --verify "${DL_DIR}/${tarball}.asc" "${DL_DIR}/${tarball}" 2>/dev/null ||
            { command rm -rf "${gtmp}"; die "GPG verification FAILED on ${tarball}"; }
        command rm -rf "${gtmp}"
        info "GPG signature good (Gentoo Release Engineering)"
    else
        warn "No ${keyring} — stage3 origin NOT verified: emerge -av sec-keys/openpgp-keys-gentoo-release"
    fi

    # without the catalyst dirs the seed still serves 'arm64 unpack' from dl/
    if [[ -d ${STOREDIR}/builds/default ]]; then
        if [[ ! -f ${STOREDIR}/builds/default/${tarball} ]]; then
            info "Placing seed in catalyst builds/default/"
            cp "${DL_DIR}/${tarball}" "${STOREDIR}/builds/default/${tarball}"
        fi
        info "Seed ready: ${STOREDIR}/builds/default/${tarball}"
    else
        info "No catalyst dirs (sudo $0 ${TGT:-amd64} setup) — seed stays in ${DL_DIR}"
    fi
}

cmd_snapshot() {
    need_root; need_catalyst
    local ref="${1:-stable}"
    [[ -d ${GIT_REPO} ]] || die "No ${GIT_REPO} — run: sudo $0 ${TGT:-amd64} setup"
    info "Updating gentoo.git (${ref})"
    git -C "${GIT_REPO}" fetch --depth 1 origin "${ref}"
    git -C "${GIT_REPO}" update-ref "refs/heads/${ref}" FETCH_HEAD
    info "Taking snapshot: catalyst -s ${ref}"
    catalyst -c "${CONF}" -s "${ref}"
    local hash; hash=$(snapshot_hash)
    [[ -n ${hash} ]] || die "No snapshot appeared in ${STOREDIR}/snapshots"
    echo "${hash}" > "${STATE}/treeish"
    info "Snapshot treeish recorded: ${hash}"
}

render_spec() {  # render_spec <stage1|stage2|stage3> <stamp> <tree> <seed_subpath>
    local st="$1" stamp="$2" tree="$3" seed="$4"
    sed -e "s|@SUBARCH@|${SUBARCH}|g" \
        -e "s|@FLAVOR@|${FLAVOR}|g" \
        -e "s|@STAMP@|${stamp}|g" \
        -e "s|@REL_TYPE@|${REL_TYPE}|g" \
        -e "s|@PROFILE@|${PROFILE}|g" \
        -e "s|@TREEISH@|${tree}|g" \
        -e "s|@SEED_SUBPATH@|${seed}|g" \
        -e "s|@CONFDIR@|${CONFDIR}|g" \
        -e "s|@UPDATE_SEED@|${UPDATE_SEED}|g" \
        "${HERE}/specs/${st}.spec.in" > "${SPECDIR}/${st}.spec"
    # the arch-conditional key is appended, not templated — the amd64 specs
    # stay byte-identical to what this script always rendered
    if [[ -n ${INTERPRETER} ]]; then
        echo "interpreter: ${INTERPRETER}" >> "${SPECDIR}/${st}.spec"
    fi
    info "Rendered ${SPECDIR}/${st}.spec"
}

cmd_spec() {
    # the profile decides what @system is; the flavour only names the tarball.
    # Catch a mismatch here, before six hours of catalyst mislabels its output.
    [[ ${PROFILE} == */${SUBARCH}/* ]] ||
        die "Portage profile '${PROFILE}' is not a ${SUBARCH} profile — check PROF_PORTAGE_PROFILE in the active xp profile (${XSTAGE_PROF_NAME:-none})"
    if [[ ${FLAVOR} == *systemd && ${PROFILE} != *systemd* ]]; then
        die "FLAVOR='${FLAVOR}' but profile '${PROFILE}' is not a systemd profile — the stage3 would be named systemd and built as OpenRC"
    fi
    if [[ ${FLAVOR} != *systemd && ${PROFILE} == *systemd* ]]; then
        die "profile '${PROFILE}' is systemd but FLAVOR='${FLAVOR}' is not — set PROF_STAGE3_FLAVOR to a *-systemd flavour"
    fi
    info "Building against profile ${PROFILE} (flavour ${FLAVOR})"
    local tree; tree=$(treeish)
    [[ -n ${tree} ]] || die "No snapshot treeish — run: sudo $0 ${TGT:-amd64} snapshot"
    local seed; seed=$(seed_tarball)
    [[ -n ${seed} ]] || die "No seed stage3 in builds/default — run: $0 ${TGT:-amd64} seed"
    local seed_subpath="default/$(basename "${seed}" .tar.xz)"
    # one stamp shared by all three specs, so stage2/stage3 source_subpath
    # points exactly at the stage1 this run produces
    local stamp; stamp=$(date -u +%Y%m%dT%H%M%SZ)
    echo "${stamp}" > "${STATE}/stamp"
    [[ -d ${CONFDIR} ]] || die "No releng confdir ${CONFDIR} — run: sudo $0 ${TGT:-amd64} setup"
    local st
    for st in stage1 stage2 stage3; do
        render_spec "${st}" "${stamp}" "${tree}" "${seed_subpath}"
    done
}

ccache_track_dir_setup() {  # catalyst aborts when the ccache dir is missing
    mkdir -p "${CCACHE_TRACK_DIR}"
    [[ -f ${CCACHE_TRACK_DIR}/ccache.conf ]] ||
        echo "max_size = 20.0G" > "${CCACHE_TRACK_DIR}/ccache.conf"
}

run_catalyst() {  # run_catalyst <stage1|stage2|stage3>
    need_root; need_catalyst
    local spec="${SPECDIR}/$1.spec"
    [[ -f ${spec} ]] || die "No ${spec} — run: $0 ${TGT:-amd64} spec"
    if [[ -n ${DISTCC_HOSTS_VAL} ]]; then
        # without the daemon every compile silently falls back to pure qemu
        # emulation — roughly 19x slower; auto-start it (idempotent: xarm's
        # own start is pgrep-guarded too). Stop stays manual: xarm distcc stop
        if ! pgrep -x distccd >/dev/null; then
            command -v xarm >/dev/null ||
                die "distccd not running and no xarm in PATH to auto-start it"
            local dport="${DISTCC_HOSTS_VAL#*:}"; dport="${dport%%/*}"
            info "Auto-starting distccd (port ${dport}; log /var/tmp/xarm/distccd.log)"
            xarm distcc start "${dport}" || die "distccd auto-start failed"
        fi
    fi
    ccache_track_dir_setup
    info "catalyst -f $1.spec (this compiles for a long time; log: ${LOGDIR})"
    # -a: ignore any stale autoresume points so spec changes take effect.
    # CCACHE_DIR: catalyst's "ccache" option bind-mounts this host dir into
    # the chroot — without it catalyst falls back to /var/tmp/ccache, which
    # here is a symlink to the host's x86 cache (wrong architecture)
    CCACHE_DIR="${CCACHE_TRACK_DIR}" catalyst -c "${CONF}" -af "${spec}"
    local out; out=$(built_stage "$1")
    [[ -n ${out} ]] || die "catalyst finished but no $1 tarball in builds/${REL_TYPE}"
    info "$1 ready: ${out} ($(du -h "${out}" | cut -f1))"
}

cmd_stage1() { run_catalyst stage1; }
cmd_stage2() { run_catalyst stage2; }
cmd_stage3() { run_catalyst stage3; }

# ---------------------------------------------------------------------------
# Watching a running catalyst build — the console stays quiet by design:
# per-package output goes to port_logdir/<rel_type>/<run>/, the package
# counter to the run chroot's /var/log/emerge.log.
# ---------------------------------------------------------------------------
newest_run() { ls -1t "${LOGDIR}/${REL_TYPE}" 2>/dev/null | head -1 || true; }

run_summary() {  # <run> — running instances + "(N of M) pkg" from emerge.log
    local run="$1" elog="${STOREDIR}/tmp/${REL_TYPE}/$1/var/log/emerge.log"
    local pids n
    pids=$(pgrep -f "catalyst -c ${CONF}" | tr '\n' ' ' || true)
    n=$(wc -w <<<"${pids}")
    if [[ ${n} -eq 0 ]]; then
        warn "No catalyst running on $(basename "${CONF}") — showing the last run"
    elif [[ ${n} -gt 1 ]]; then
        warn "${n} catalyst instances on $(basename "${CONF}") (pids: ${pids}) —"
        warn "the one started last is queued on the run lock and, once it frees,"
        warn "will CLEAR AUTORESUME and rebuild from scratch. Kill it."
    fi
    if [[ -r ${elog} ]]; then
        local cur
        cur=$(grep -F '>>> emerge (' "${elog}" | tail -1 |
              sed 's/^[0-9]*: *>>> emerge //; s| to /.*||')
        if [[ -n ${cur} ]]; then info "${run}: last started ${cur}"; fi
    fi
}

cmd_log() {  # [emerge] — follow the newest package log / the emerge.log
    need_root
    local run; run=$(newest_run)
    [[ -n ${run} ]] || die "No runs under ${LOGDIR}/${REL_TYPE} — nothing built yet"
    run_summary "${run}"
    if [[ ${1:-} == emerge ]]; then
        local elog="${STOREDIR}/tmp/${REL_TYPE}/${run}/var/log/emerge.log"
        [[ -f ${elog} ]] || die "No ${elog} — run chroot gone?"
        exec tail -f "${elog}"
    fi
    local dir="${LOGDIR}/${REL_TYPE}/${run}" newest
    newest=$(ls -1t "${dir}" | head -1 || true)
    [[ -n ${newest} ]] || die "No package logs in ${dir} yet"
    info "Following ${newest} (Ctrl-C stops the tail, not the build)"
    exec tail -f "${dir}/${newest}"
}

cmd_qlop() {  # [qlop args] — merge times from the run chroot's emerge.log
    need_root
    command -v qlop >/dev/null || die "No qlop — emerge -av app-portage/portage-utils"
    local run; run=$(newest_run)
    [[ -n ${run} ]] || die "No runs under ${LOGDIR}/${REL_TYPE} — nothing built yet"
    local elog="${STOREDIR}/tmp/${REL_TYPE}/${run}/var/log/emerge.log"
    [[ -f ${elog} ]] || die "No ${elog} — run chroot gone?"
    run_summary "${run}"
    if [[ $# -gt 0 ]]; then exec qlop "$@" -f "${elog}"; fi
    exec qlop -tv -f "${elog}"
}

cmd_all() {
    need_root
    if [[ -n $(seed_tarball) ]]; then
        info "Seed already present — skipping download"
    else
        cmd_seed
    fi
    cmd_snapshot
    cmd_spec
    cmd_stage1
    cmd_stage3
    info "Bootstrap complete: $(built_stage stage3)"
}

cmd_verify() {
    need_root
    local tarball; tarball=$(built_stage stage3)
    [[ -n ${tarball} ]] || die "No built stage3 in builds/${REL_TYPE} — run: sudo $0 ${TGT:-amd64} all"
    local vdir="${STOREDIR}/tmp/verify"
    info "Unpacking $(basename "${tarball}") into ${vdir}"
    command rm -rf "${vdir}"
    mkdir -p "${vdir}"
    tar xpf "${tarball}" -C "${vdir}" --xattrs-include='*.*' --numeric-owner
    if [[ -n ${INTERPRETER} ]]; then
        # binfmt_misc (no F flag here) resolves the interpreter path inside
        # the chroot, and stage tarballs don't ship qemu — lend it ours
        mkdir -p "${vdir}$(dirname "${INTERPRETER}")"
        command cp -f "${INTERPRETER}" "${vdir}${INTERPRETER}"
    fi
    info "Chroot smoke test"
    # portage needs a real /dev (it checks /dev/fd and process substitution)
    # and /proc — without them 'emerge --version' prints warnings and fails
    # while the chroot's exit status still comes from the last command
    mount -t proc none "${vdir}/proc"
    mount --rbind /dev "${vdir}/dev"
    mount --make-rslave "${vdir}/dev"
    # shellcheck disable=SC2064 — expand ${vdir} now, not at trap time
    trap "umount -R '${vdir}/dev' 2>/dev/null || true; umount '${vdir}/proc' 2>/dev/null || true" EXIT INT TERM
    # -e -o pipefail inside the chroot: each check must pass on its own
    chroot "${vdir}" /bin/bash -c '
        set -eo pipefail
        gcc --version | head -1
        emerge --version
        head -1 /etc/os-release' ||
        die "Chroot smoke test failed"
    umount -R "${vdir}/dev"
    umount "${vdir}/proc"
    trap - EXIT INT TERM
    info "OK: tarball $(du -h "${tarball}" | cut -f1), unpacked $(du -sh "${vdir}" | cut -f1)"
}

amd64_status() {
    local cat=MISSING seed="-" tree="-" specs="-" s1="-" s3="-"
    if command -v catalyst >/dev/null; then cat=ok; fi
    local t
    t=$(seed_tarball);        if [[ -n ${t} ]]; then seed=$(basename "${t}"); fi
    t=$(treeish);             if [[ -n ${t} ]]; then tree=${t:0:12}; fi
    if [[ -f ${SPECDIR}/stage1.spec ]]; then specs="rendered ($(cat "${STATE}/stamp" 2>/dev/null || echo '?'))"; fi
    t=$(built_stage stage1);  if [[ -n ${t} ]]; then s1=$(du -h "${t}" | cut -f1); fi
    t=$(built_stage stage3);  if [[ -n ${t} ]]; then s3=$(du -h "${t}" | cut -f1); fi
    echo "amd64  catalyst:${cat}  conf:$([[ -f ${CONF} ]] && echo ok || echo -)  seed:${seed}"
    echo "       treeish:${tree}  specs:${specs}  stage1:${s1}  stage3:${s3}"
}

cmd_clean_amd64() {
    local all="${1:-}"
    if [[ ${all} == all ]]; then
        confirm "Remove catalyst tmp/, built stages, snapshots and state (seeds + git repos kept)?"
        command rm -rf "${STOREDIR}/tmp" "${STOREDIR}/builds/${REL_TYPE}" \
                       "${STOREDIR}/snapshots" "${STATE}" "${SPECDIR}"
    else
        confirm "Remove catalyst tmp/ (scratch chroots)?"
        command rm -rf "${STOREDIR}/tmp"
    fi
    info "Cleaned."
}

# ---------------------------------------------------------------------------
# live half of the amd64 track — squashfs + isolinux ISO
# ---------------------------------------------------------------------------
# The arm64 track turns a stage3 into an SD card; this turns one into a live
# ISO the way bin/v does for /etc/liveusb, minus v's host-specific profile
# layout. Everything runs natively (this IS an amd64 host), so the chroot needs
# no qemu interpreter — that is the ARM half of the lab's problem, not this one.

# resolve the package list: tiers out of the catalogue + the profile's atoms
live_pkg_list() {
    local catalogue="${XSTAGE_LIVE_PKGSFILE:-${XP_LAB_DIR:-${REPO}}/profiles/amd64.pkgs}"
    {
        if [[ -n ${LIVE_TIERS} ]]; then
            [[ -f ${catalogue} ]] || die "No package catalogue ${catalogue} — needed by XSTAGE_LIVE_TIERS"
            local tier
            for tier in ${LIVE_TIERS}; do
                # print the atoms between '# @tier <name>' and the next @tier;
                # strip trailing comments, drop blanks and comment-only lines
                awk -v want="${tier}" '
                    /^#[ \t]*@tier[ \t]+/ { in_t = ($3 == want); next }
                    in_t { sub(/#.*/, ""); gsub(/^[ \t]+|[ \t]+$/, "");
                           if (length($0)) print }
                ' "${catalogue}"
            done
        fi
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        [[ -n ${LIVE_PKGS} ]] && printf '%s\n' ${LIVE_PKGS}
    } | awk 'NF && !seen[$0]++'
}

# run a script inside the live rootfs; native amd64, so a plain chroot works
# ccache is shared with the host on purpose: object files are keyed on the
# compiler binary and the full command line, so the hardened toolchain in the
# image and the host's non-hardened one never collide in the cache. The first
# hardened build therefore misses everywhere; the payoff is on re-runs.
# The host's DISTDIR, shared rather than re-downloaded. A fresh image resolves
# to ~12 GB of source tarballs, most of which this host already has; the mount
# is read-write so anything new lands in the host cache too. 'squash' already
# excludes /var/cache/distfiles, so none of it reaches the ISO.
# Archives portage may not download for itself (RESTRICT="fetch"), copied into
# DISTDIR before anything merges. They are kept OUTSIDE DISTDIR because DISTDIR
# is shared with the host and eclean-dist prunes whatever the tree stops
# referencing — which is how dev-db/sqldeveloper's zip was lost once already.
# Recovery is manual and version-specific: RESTRICT="fetch" still checks the
# Manifest digest, so an installed copy cannot be re-archived into a valid
# distfile.
#
# Copy, not a symlink or a bind mount: portage writes lock files next to a
# distfile and the store should stay read-only in spirit. Existing files are
# left alone, so this never overwrites a good DISTDIR entry, and it is a no-op
# once the file is there.
live_distfiles_seed() {
    local store="${DL_DIR}/distfiles-restricted"
    [[ -d ${store} && -n ${LIVE_DISTFILES_DIR} && -d ${LIVE_DISTFILES_DIR} ]] || return 0
    local f n=0
    for f in "${store}"/*; do
        [[ -f ${f} ]] || continue
        case "${f}" in *.md|*.txt) continue ;; esac
        [[ -e ${LIVE_DISTFILES_DIR}/${f##*/} ]] && continue
        cp -n "${f}" "${LIVE_DISTFILES_DIR}/" && n=$((n + 1))
    done
    [[ ${n} -eq 0 ]] || info "Seeded ${n} fetch-restricted distfile(s) from ${store}"
}

live_distfiles_mount() {
    [[ -n ${LIVE_DISTFILES_DIR} ]] || return 0
    [[ -d ${LIVE_DISTFILES_DIR} ]] ||
        { warn "XSTAGE_LIVE_DISTFILES_DIR=${LIVE_DISTFILES_DIR} does not exist — the image will download its own"; return 0; }
    mkdir -p "${LIVE_ROOT}${LIVE_DISTFILES_MNT}"
    mount --bind "${LIVE_DISTFILES_DIR}" "${LIVE_ROOT}${LIVE_DISTFILES_MNT}"
    info "distfiles: ${LIVE_DISTFILES_DIR} -> ${LIVE_DISTFILES_MNT} (bind)"
}

# PKGDIR shared with the host. Unlike distfiles an empty directory is a valid
# starting point (buildpkg fills it), so it is created rather than skipped.
# 'squash' excludes /var/cache/binpkgs, so nothing binary reaches the image.
live_binpkgs_mount() {
    [[ -n ${LIVE_BINPKGS_DIR} ]] || return 0
    mkdir -p "${LIVE_BINPKGS_DIR}" "${LIVE_ROOT}${LIVE_BINPKGS_MNT}"
    mount --bind "${LIVE_BINPKGS_DIR}" "${LIVE_ROOT}${LIVE_BINPKGS_MNT}"
    info "binpkgs: ${LIVE_BINPKGS_DIR} -> ${LIVE_BINPKGS_MNT} (bind)"
}

# PORTAGE_TMPDIR/portage, shared with the host. Build trees for a 700-package
# run are tens of GB; keeping them out of the image rootfs means the tree stays
# the size of the installed system, and the host's filesystem absorbs the churn.
# 'squash' excludes /var/tmp/portage regardless, so this changes where the churn
# lands, not what ships.
#
# Portage does not lock across chroots, so this must NOT be the host's own
# /var/tmp/portage: a host emerge and an image 'pkgs' would then share one
# <category>/<pf> build tree, as would two image profiles running at once. The
# profiles therefore point it at a per-profile subdirectory,
# /var/tmp/portage/<profile>, which is still on the host volume (that path is a
# bind mount to /home/tmp/portage) but cannot collide.
live_builddir_mount() {
    [[ -n ${LIVE_BUILDDIR} ]] || return 0
    # Create it rather than warning past it. The profiles now point this at a
    # per-profile subdirectory (/var/tmp/portage/<profile>), which by
    # definition does not exist before the first run — and the old "does not
    # exist -> build inside the image tree" path is a silent downgrade: the
    # build still succeeds, so nobody notices that tens of GB of build trees
    # went into the rootfs instead of the host volume.
    #
    # portage:portage 0775 matches the host's own /var/tmp/portage. userpriv
    # builds run as portage inside the chroot, and a root-owned 0755 directory
    # would fail every unpack with a permission error that reads like a
    # sandbox problem.
    if [[ ! -d ${LIVE_BUILDDIR} ]]; then
        mkdir -p "${LIVE_BUILDDIR}" ||
            { warn "cannot create XSTAGE_LIVE_BUILDDIR=${LIVE_BUILDDIR} — building inside the image tree"; return 0; }
        chown portage:portage "${LIVE_BUILDDIR}" 2>/dev/null || true
        chmod 0775 "${LIVE_BUILDDIR}" 2>/dev/null || true
        info "build dir: created ${LIVE_BUILDDIR}"
    fi
    mkdir -p "${LIVE_ROOT}${LIVE_BUILDDIR_MNT}"
    mount --bind "${LIVE_BUILDDIR}" "${LIVE_ROOT}${LIVE_BUILDDIR_MNT}"
    info "build dir: ${LIVE_BUILDDIR} -> ${LIVE_BUILDDIR_MNT} (bind)"
}

live_ccache_mount() {
    [[ -n ${LIVE_CCACHE_DIR} ]] || return 0
    [[ -d ${LIVE_CCACHE_DIR} ]] ||
        { warn "XSTAGE_LIVE_CCACHE_DIR=${LIVE_CCACHE_DIR} does not exist — building without ccache"; return 0; }
    mkdir -p "${LIVE_ROOT}${LIVE_CCACHE_MNT}"
    mount --bind "${LIVE_CCACHE_DIR}" "${LIVE_ROOT}${LIVE_CCACHE_MNT}"
    info "ccache: ${LIVE_CCACHE_DIR} -> ${LIVE_CCACHE_MNT} (bind)"
}

live_chroot() {  # live_chroot <label>  (script on stdin)
    local label="$1"
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    command cp -f /etc/resolv.conf "${LIVE_ROOT}/etc/resolv.conf"
    mount -t proc  none "${LIVE_ROOT}/proc"
    mount --rbind /sys  "${LIVE_ROOT}/sys";  mount --make-rslave "${LIVE_ROOT}/sys"
    mount --rbind /dev  "${LIVE_ROOT}/dev";  mount --make-rslave "${LIVE_ROOT}/dev"
    live_ccache_mount
    live_distfiles_mount
    live_builddir_mount
    live_binpkgs_mount
    # shellcheck disable=SC2064 — expand ${LIVE_ROOT} now, not at trap time
    trap "live_chroot_umount '${LIVE_ROOT}'" EXIT INT TERM
    local rc=0
    # LC_ALL=C.UTF-8: the host's pl_PL.utf8 is not generated inside a stage3,
    # and every step otherwise opens with two setlocale warnings
    LC_ALL=C.UTF-8 chroot "${LIVE_ROOT}" /bin/bash -s <<-EOF || rc=$?
	set -eo pipefail
	source /etc/profile >/dev/null 2>&1 || true
	$(cat)
	EOF
    live_chroot_umount "${LIVE_ROOT}"
    trap - EXIT INT TERM
    [[ ${rc} -eq 0 ]] || die "chroot step '${label}' failed (exit ${rc})"
}

live_chroot_umount() {
    local r="$1"
    umount "${r}${LIVE_CCACHE_MNT}" 2>/dev/null || true
    umount "${r}${LIVE_DISTFILES_MNT}" 2>/dev/null || true
    umount "${r}${LIVE_BUILDDIR_MNT}" 2>/dev/null || true
    umount "${r}${LIVE_BINPKGS_MNT}" 2>/dev/null || true
    umount -R "${r}/dev"  2>/dev/null || true
    umount -R "${r}/sys"  2>/dev/null || true
    umount    "${r}/proc" 2>/dev/null || true
}

cmd_live_unpack() {
    need_root
    # a self-built stage3 wins over the downloaded seed: the point of the
    # catalyst half is to boot what this lab produced, not what Gentoo shipped
    local tarball="${XSTAGE_LIVE_TARBALL:-}"
    if [[ -n ${tarball} ]]; then
        [[ -f ${tarball} ]] || die "XSTAGE_LIVE_TARBALL not found: ${tarball}"
        info "Using XSTAGE_LIVE_TARBALL"
    else
        # preference order: a stage3 this lab built, then the seed in the
        # catalyst dirs, then the plain download in dl/ — the last one matters,
        # because building only a live image needs no catalyst at all, and then
        # 'seed' never gets a builds/default/ to copy into
        tarball=$(built_stage stage3)
        [[ -n ${tarball} ]] || tarball=$(seed_tarball)
        [[ -n ${tarball} ]] ||
            tarball=$(ls -1t "${DL_DIR}/stage3-${SUBARCH}-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true)
        [[ -n ${tarball} ]] ||
            die "No stage3-${SUBARCH}-${FLAVOR} tarball — fetch one ($0 ${TGT:-amd64} seed) or build it (sudo $0 ${TGT:-amd64} all)"
    fi
    if [[ -d ${LIVE_ROOT} && -n $(ls -A "${LIVE_ROOT}" 2>/dev/null) ]]; then
        confirm "Remove existing ${LIVE_ROOT} and re-unpack?"
        command rm -rf "${LIVE_ROOT}"
    fi
    mkdir -p "${LIVE_ROOT}"
    info "Unpacking $(basename "${tarball}") (handbook flags: xattrs, numeric owners)"
    tar xpf "${tarball}" -C "${LIVE_ROOT}" --xattrs-include='*.*' --numeric-owner
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No /bin/bash after unpack — broken tarball?"
    # provenance marker for /etc/image-release, written at squash time
    { echo "stage3=$(basename "${tarball}")"
      echo "stage3_sha256=$(sha256sum "${tarball}" | cut -d' ' -f1)"
    } > "${LIVE_BLD}/stage3.provenance"
    info "rootfs ready: ${LIVE_ROOT} ($(du -sh "${LIVE_ROOT}" 2>/dev/null | cut -f1 || true))"
}

# make.conf, ebuild repos and the portage profile — everything 'pkgs' depends on
cmd_live_conf() {
    need_root
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    mkdir -p "${LIVE_ROOT}/etc/portage/repos.conf" "${LIVE_ROOT}/var/db/repos"

    info "make.conf: MAKEOPTS -j${JOBS}${LIVE_VIDEO_CARDS:+, VIDEO_CARDS ${LIVE_VIDEO_CARDS}}${LIVE_ACCEPT_LICENSE:+, extra licences}"
    # appended, not overwritten: the stage3 make.conf carries CHOST/CFLAGS the
    # tarball was actually built with, and those must survive.
    #
    # Idempotent, because 'conf' gets re-run every time the profile changes and
    # a blind append left one stale copy of the block per run. Both formats are
    # dropped first: the current marker-delimited one, and the older headline-
    # only one, which was always written last and so can be cut to EOF.
    local mc="${LIVE_ROOT}/etc/portage/make.conf"
    if [[ -f ${mc} ]]; then
        sed -i '/^# --- BEGIN xstage-managed block/,/^# --- END xstage-managed block/d' "${mc}"
        sed -i '/^# --- appended by .xstage .* conf./,$d' "${mc}"
    fi
    {
        echo
        echo "# --- BEGIN xstage-managed block ('xstage ${TGT:-amd64} conf', xp profile ${XPROFILE:-none}) ---"
        # -l as well as -j, because these two multiply. MAKEOPTS is per-package
        # and EMERGE_DEFAULT_OPTS carries --jobs=16, so the worst case is 16
        # packages x -j${JOBS} compilers at once. Nothing bounds that, and on
        # 2026-08-07 it did not stay theoretical: sci-ml/caffe2 alone ran ~30
        # nvcc/cicc at ~1.5 GB resident each and took a 64 GB machine down with
        # a global OOM and a reboot. The per-package cap for that case lives in
        # package.env (lowmem-j4.conf); this is the general net under it.
        #
        # -l does not bound memory — it bounds runnable processes — so it is a
        # brake on fan-out, not a guarantee. It matches what this host runs
        # ("-j16 -l32"). The -j value is left at nproc rather than halved,
        # because that trade-off belongs to whoever is watching the build.
        echo "MAKEOPTS=\"-j${JOBS} -l${JOBS}\""
        # a profile that sets its own opts replaces these wholesale: portage
        # does not merge EMERGE_DEFAULT_OPTS, the last assignment wins, and
        # this block is appended last — so a line the user wrote earlier in
        # make.conf would be silently overridden instead of taking effect
        if [[ -n ${LIVE_EMERGE_OPTS} ]]; then
            echo "EMERGE_DEFAULT_OPTS=\"$(echo "${LIVE_EMERGE_OPTS}" | tr -s '[:space:]' ' ')\""
        else
            echo "EMERGE_DEFAULT_OPTS=\"--jobs=${JOBS} --load-average=$(nproc) --quiet-build=y\""
        fi
        [[ -n ${LIVE_VIDEO_CARDS} ]] && echo "VIDEO_CARDS=\"${LIVE_VIDEO_CARDS}\""
        # Replaces the stage3's COMMON_FLAGS-derived CFLAGS. Only worth setting
        # when the image is built for the machine that builds it: '-march=native'
        # resolves against THIS cpu, and an ISO carrying it will SIGILL on any
        # other. CXXFLAGS follows CFLAGS, as in every stage3 make.conf.
        if [[ -n ${LIVE_CFLAGS} ]]; then
            echo "CFLAGS=\"$(echo "${LIVE_CFLAGS}" | tr -s '[:space:]' ' ')\""
            echo 'CXXFLAGS="${CFLAGS}"'
            echo 'FCFLAGS="${CFLAGS}"'
            echo 'FFLAGS="${CFLAGS}"'
        fi
        [[ -n ${LIVE_CPU_FLAGS_X86} ]] &&
            echo "CPU_FLAGS_X86=\"$(echo "${LIVE_CPU_FLAGS_X86}" | tr -s '[:space:]' ' ')\""
        [[ -n ${LIVE_USE} ]] && echo "USE=\"\${USE} $(echo "${LIVE_USE}" | tr -s '[:space:]' ' ')\""
        # incremental, like USE: this adds to the profile's ACCEPT_LICENSE
        # rather than replacing it, so '@FREE' stays in effect either way
        [[ -n ${LIVE_ACCEPT_LICENSE} ]] &&
            echo "ACCEPT_LICENSE=\"\${ACCEPT_LICENSE} $(echo "${LIVE_ACCEPT_LICENSE}" | tr -s '[:space:]' ' ')\""
        # The ::gentoo profile default is a single python (python3_14 as of
        # 2026-08). Packages that upstream has not ported yet carry a
        # REQUIRED_USE naming only the older slots — sys-process/criu-4.1 wants
        # any-of ( python3_12 python3_13 ) — and an unsatisfiable REQUIRED_USE
        # is a resolver error, so it aborts the whole 'pkgs' run rather than
        # skipping the package. Naming a second target is what the host does.
        [[ -n ${LIVE_PYTHON_TARGETS} ]] &&
            echo "PYTHON_TARGETS=\"$(echo "${LIVE_PYTHON_TARGETS}" | tr -s '[:space:]' ' ')\""
        [[ -n ${LIVE_PYTHON_SINGLE_TARGET} ]] &&
            echo "PYTHON_SINGLE_TARGET=\"${LIVE_PYTHON_SINGLE_TARGET}\""
        # a live image is read-only at runtime: no reason to carry build logs
        echo 'FEATURES="${FEATURES} parallel-install"'
        [[ -n ${LIVE_FEATURES} ]] &&
            echo "FEATURES=\"\${FEATURES} $(echo "${LIVE_FEATURES}" | tr -s '[:space:]' ' ')\""
        # ccache lives outside the image: live_chroot bind-mounts the host
        # directory here, and 'squash' excludes the path so a multi-GB cache
        # never reaches the ISO
        if [[ -n ${LIVE_CCACHE_DIR} ]]; then
            echo 'FEATURES="${FEATURES} ccache"'
            echo "CCACHE_DIR=\"${LIVE_CCACHE_MNT}\""
        fi
        [[ -n ${LIVE_DISTFILES_DIR} ]] && echo "DISTDIR=\"${LIVE_DISTFILES_MNT}\""
        # last, so a profile can override anything the block set above it
        [[ -n ${LIVE_MAKECONF_EXTRA} ]] && printf '%s\n' "${LIVE_MAKECONF_EXTRA}"
        echo "# --- END xstage-managed block ---"
    } >> "${mc}"

    info "repos.conf: ::gentoo (rsync)"
    cat > "${LIVE_ROOT}/etc/portage/repos.conf/gentoo.conf" <<-'EOF'
	[DEFAULT]
	main-repo = gentoo

	[gentoo]
	location = /var/db/repos/gentoo
	sync-type = rsync
	sync-uri = rsync://rsync.gentoo.org/gentoo-portage
	auto-sync = yes
	# gemato: verify the MetaManifest against the releng key on every sync —
	# needs sec-keys/openpgp-keys-gentoo-release installed (in the pkg lists)
	sync-rsync-verify-metamanifest = yes
	sync-openpgp-key-path = /usr/share/openpgp-keys/gentoo-release.asc
	EOF

    # the host already has a synced tree; copying beats a fresh rsync inside
    # the chroot, and it pins the image to a tree we know builds
    local hostrepo; hostrepo=$(portageq get_repo_path / gentoo 2>/dev/null || true)
    if [[ -n ${hostrepo} && -d ${hostrepo} ]]; then
        info "Seeding ::gentoo from the host tree ${hostrepo} (rsync, no network)"
        rsync -a --delete --exclude='/distfiles' --exclude='/packages' \
            "${hostrepo}/" "${LIVE_ROOT}/var/db/repos/gentoo/"
    else
        warn "No host ::gentoo found — the image will have to 'emerge --sync' itself"
    fi

    local r
    for r in ${LIVE_REPOS}; do
        local rp; rp=$(portageq get_repo_path / "${r}" 2>/dev/null || true)
        if [[ -z ${rp} || ! -d ${rp} ]]; then
            warn "Overlay '${r}' not on this host — its packages will be skipped"
            continue
        fi
        info "Seeding overlay ::${r} from ${rp}"
        mkdir -p "${LIVE_ROOT}/var/db/repos/${r}"
        rsync -a --delete --exclude='/distfiles' --exclude='/packages' \
            "${rp}/" "${LIVE_ROOT}/var/db/repos/${r}/"
        cat > "${LIVE_ROOT}/etc/portage/repos.conf/${r}.conf" <<-EOF
		[${r}]
		location = /var/db/repos/${r}
		auto-sync = no
		EOF
    done

    # binpkg verification trust: seed the image's portage keyring from the
    # host's working one — getuto's Gentoo binhost anchors plus the gen2db
    # signing key — so the image can verify binhost packages from its very
    # first merge. Public material only: private keys, the passphrase file and
    # revocation certs stay on the host, because this rootfs ships as
    # livecd.squashfs and a signing key inside it is a key given away.
    #
    # Gated on getbinpkg, not on FEATURES=binpkg-request-signature. That
    # FEATURE is global — it applies to the packages the image BUILDS as well
    # as the ones it downloads — so in a chroot with buildpkg and no signing
    # key it rejects portage's own freshly built binpkg and the merge never
    # happens (amdkde, zen-sources, 2026-08-07; the reasoning is in
    # profiles/amdkde.conf next to PROF_LIVE_FEATURES). The verification an
    # image actually wants is per-repository, and that is binrepos.conf's
    # 'verify-signature' — which needs exactly the same keyring.
    if [[ " ${LIVE_FEATURES} " == *getbinpkg* ]]; then
        if [[ -f /etc/portage/gnupg/pubring.kbx ]]; then
            info "Seeding /etc/portage/gnupg (binpkg trust anchors, public only)"
            mkdir -p "${LIVE_ROOT}/etc/portage/gnupg"
            rsync -a --delete \
                --exclude='private-keys-v1.d' --exclude='pass' \
                --exclude='openpgp-revocs.d' --exclude='.#*' \
                --exclude='*~' --exclude='tofu.db' --exclude='S.*' \
                /etc/portage/gnupg/ "${LIVE_ROOT}/etc/portage/gnupg/"
        else
            warn "getbinpkg is set but the host has no /etc/portage/gnupg — run getuto first"
        fi
        # Assert the per-repo verification rather than trusting the stage3 to
        # have shipped it: a binrepos.conf section without the line fetches
        # from a remote binhost unverified and says nothing about it. Appended
        # at the end of the file, which is the last (and by convention only)
        # section it declares.
        local brc
        for brc in "${LIVE_ROOT}"/etc/portage/binrepos.conf/*.conf \
                   "${LIVE_ROOT}"/etc/portage/binrepos.conf; do
            [[ -f ${brc} ]] || continue
            # 'if !' and not 'grep -q ... && continue': under set -e the
            # short-circuited AND-list is itself the statement's exit status,
            # so a file that legitimately lacks the line would abort 'conf'
            if ! grep -q '^[[:space:]]*verify-signature' "${brc}"; then
                info "binrepos.conf: asserting 'verify-signature = true' in ${brc#"${LIVE_ROOT}"}"
                printf 'verify-signature = true\n' >> "${brc}"
            fi
        done
    fi

    if [[ -n ${LIVE_PORTAGE_PROFILE} ]]; then
        info "Portage profile: ${LIVE_PORTAGE_PROFILE}"
        [[ -d ${LIVE_ROOT}/var/db/repos/gentoo/profiles/${LIVE_PORTAGE_PROFILE} ]] ||
            die "No such profile in the image tree: ${LIVE_PORTAGE_PROFILE}"
        ln -snf "../../var/db/repos/gentoo/profiles/${LIVE_PORTAGE_PROFILE}" \
            "${LIVE_ROOT}/etc/portage/make.profile"
    fi

    # Config fragments: portage keyword/USE files, sysctl/modprobe/auditd rules.
    #
    # A space-separated LIST, applied left to right, so a profile can stack a
    # shared layer under its own: 'common hardened' gives every image the host
    # transplant (host.keywords, host.use, the cycle cuts) and the hardened one
    # its extra desktop-profile.use and sysctl rules on top. Later dirs win,
    # which is also why image decisions are named zz-*.use — portage reads
    # package.use/* alphabetically and the last match wins.
    #
    # rsync here is additive by design: renaming or deleting a fragment leaves
    # the old file behind in an image tree that has already been configured.
    #
    # --chown=root:root, because rsync running as root otherwise preserves the
    # checkout's ownership and every overlaid file lands in the image owned by
    # the uid that edited it. Most consumers do not care; some refuse the file
    # and say so only in a debug run — logrotate skips any /etc/logrotate.d
    # entry not owned by uid 0 ("Ignoring aide because the file owner is
    # wrong"), which is a rotation that silently never happens.
    if [[ -n ${XSTAGE_LIVE_OVERLAY_DIR:-} ]]; then
        local ovdir
        for ovdir in ${XSTAGE_LIVE_OVERLAY_DIR}; do
            # absolute entries are personal payload trees that live OUTSIDE
            # this repo (e.g. ~/Claude/secure/live-overlay: install scripts,
            # the target laptop's /etc snapshot) — same rsync-onto-/ contract
            local ov="${LIVE_TPL}/${ovdir}"
            [[ ${ovdir} == /* ]] && ov="${ovdir}"
            if [[ -d ${ov} ]]; then
                info "Overlaying config fragments from ${ov}"
                rsync -a --chown=root:root "${ov}/" "${LIVE_ROOT}/"
            else
                warn "PROF_LIVE_OVERLAY_DIR names '${ovdir}' but ${ov} does not exist"
            fi
        done
    fi
    # FEATURES=ccache does nothing without the masquerade symlinks in
    # /usr/lib/ccache/bin, and those come from dev-util/ccache being installed
    # INSIDE the image. Merging it here rather than listing it in the package
    # set matters: by 'pkgs' time the very first compile should already be
    # going through the cache.
    if [[ -n ${LIVE_CCACHE_DIR} ]] && [[ ! -d ${LIVE_ROOT}/usr/lib/ccache/bin ]]; then
        info "Installing dev-util/ccache in the image (masquerade dir for FEATURES=ccache)"
        # EMERGE_DEFAULT_OPTS is cleared for this one call: the profile's
        # '--update --newuse --deep' would turn a single-package bootstrap into
        # the whole world rebuild that 'pkgs' is for.
        # '|| true' inside the script, because live_chroot die()s on a non-zero
        # exit and a missing ccache is a warning, not a reason to stop.
        live_chroot ccache-bootstrap <<-'EOF'
		EMERGE_DEFAULT_OPTS="" emerge --oneshot --quiet --jobs=4 dev-util/ccache || true
		EOF
        [[ -d ${LIVE_ROOT}/usr/lib/ccache/bin ]] ||
            warn "dev-util/ccache did not install — FEATURES=ccache will be inert this run"
    fi
    # A warm eix database, so 'eix qt6' on the booted image answers at once
    # instead of demanding an eix-update first. Cheap to ship (~22 MB, a few MB
    # after squashfs compression) and built from the tree this very function
    # just rsynced in, so it matches what the image ships.
    #
    # Two things that are easy to get wrong here:
    #   - app-portage/eix does NOT own /var/cache/eix. It comes from
    #     /usr/lib/tmpfiles.d/eix.conf ('d /var/cache/eix 0775 portage portage')
    #     at boot, which never runs in a chroot — so create it here.
    #   - eix-update drops privileges to portage (EIX_USER), so a root:root
    #     directory is not writable and eix-update fails only AFTER doing all
    #     the work, with "cannot open database file ... for writing".
    #
    # Skipped on a fresh stage3 that has no eix yet; the 'conf' after 'pkgs'
    # picks it up. Installed-package state is not in this cache — eix reads
    # /var/db/pkg live — so 'pkgs' merging afterwards does not invalidate it.
    if [[ -x ${LIVE_ROOT}/usr/bin/eix-update ]]; then
        info "Seeding the eix cache (/var/cache/eix/portage.eix)"
        live_chroot eix-seed <<-'EOF'
		install -d -o portage -g portage -m 0775 /var/cache/eix
		eix-update || true
		EOF
        [[ -s ${LIVE_ROOT}/var/cache/eix/portage.eix ]] ||
            warn "eix-update produced no cache — the image will have to build it on first use"
    fi
    info "Image configured."
}

# Kernel sources + merged .config inside the image: emerge gentoo-sources if
# /usr/src/linux is absent, stage the per-flavour Kconfig fragments, merge them
# onto the base, run 'make olddefconfig', and verify the boot chain survived.
#
# Called from TWO verbs, and the order is the point:
#   - 'pkgs' runs it BEFORE the first emerge. Every linux-info pre-merge check
#     (systemd's CONFIG_BPF_LSM, libfido2, bpftrace, ...) reads
#     /usr/src/linux/.config inside the chroot; without one the eclass falls
#     back to the HOST's running kernel and audits the wrong config — its
#     warnings then describe this laptop, not the image being built.
#   - 'kernel' runs it again before genkernel: cheap and idempotent, and it
#     picks up fragment edits made after 'pkgs' already ran.
live_prep_kconfig() {
    # The base the fragments are merged onto:
    #   defconfig  the kernel's own x86_64 defconfig — reproducible, and the
    #              live fragment adds the breadth an ISO needs (default)
    #   host       this machine's /usr/src/linux/.config — widest driver set,
    #              but it is tuned for THIS laptop and carries its quirks
    #   <path>     any .config file on the host
    local base="${XSTAGE_LIVE_KCONFIG_BASE:-defconfig}"
    local frags=("${LIVE_TPL}/kernel/live.fragment")
    # extra symbols the post-merge check insists on, per flavour
    local kcheck=""
    # systemd as PID 1 has its own mandatory Kconfig list (its README); an
    # OpenRC image has no use for it, so it is a separate fragment
    if [[ ${LIVE_RC} == systemd ]]; then
        frags+=("${LIVE_TPL}/kernel/systemd.fragment")
        kcheck+=" CONFIG_FHANDLE CONFIG_AUTOFS_FS CONFIG_DMIID CONFIG_CGROUPS"
        info "systemd flavour — adding the systemd kernel fragment"
    fi
    # a hardened image needs kernel-side hardening too: the portage 'hardened'
    # profile only changes the toolchain, never the kernel
    if [[ ${LIVE_PORTAGE_PROFILE} == *hardened* || -n ${XSTAGE_LIVE_KHARDEN:-} ]]; then
        frags+=("${LIVE_TPL}/kernel/hardened.fragment")
        info "Hardened profile detected — adding the KSPP kernel fragment"
    fi
    local f
    for f in "${frags[@]}"; do
        [[ -f ${f} ]] || die "Missing Kconfig fragment: ${f}"
    done

    info "Kernel config base: ${base}; fragments: $(basename -a "${frags[@]}" | tr '\n' ' ')"
    mkdir -p "${LIVE_ROOT}/tmp/xstage-kconfig"
    # a previous run may have staged MORE fragments than this one (flavour or
    # profile changed) — stale numbered files would silently merge back in
    command rm -f "${LIVE_ROOT}/tmp/xstage-kconfig/"*
    local i=0
    for f in "${frags[@]}"; do
        command cp -f "${f}" "${LIVE_ROOT}/tmp/xstage-kconfig/$((i++))-$(basename "${f}")"
    done
    if [[ ${base} != defconfig && ${base} != host ]]; then
        [[ -f ${base} ]] || die "XSTAGE_LIVE_KCONFIG_BASE='${base}' is neither 'defconfig', 'host', nor a file"
        command cp -f "${base}" "${LIVE_ROOT}/tmp/xstage-kconfig/base.config"
    elif [[ ${base} == host ]]; then
        [[ -f /usr/src/linux/.config ]] ||
            die "XSTAGE_LIVE_KCONFIG_BASE=host but this machine has no /usr/src/linux/.config"
        command cp -f /usr/src/linux/.config "${LIVE_ROOT}/tmp/xstage-kconfig/base.config"
    fi

    live_chroot kconfig <<-EOF
	# --ignore-default-opts is load-bearing: the image's EMERGE_DEFAULT_OPTS
	# carry --update --deep --newuse, which drag the whole stage3-to-tree
	# transition (the perl 5.44 graph) into this one-package resolution — the
	# exact slot-conflict wall the two-pass 'pkgs' design exists to avoid.
	# USE=symlink because no sources ebuild enables it by default, and the
	# eclasses find the tree through the /usr/src/linux symlink; eselect covers
	# sources that are already installed without the flag.
	[ -e /usr/src/linux ] || eselect kernel set 1 2>/dev/null || true
	[ -e /usr/src/linux ] ||
	    USE=symlink emerge --ignore-default-opts --verbose --oneshot ${LIVE_KERNEL_PKG}
	[ -e /usr/src/linux ] || eselect kernel set 1
	[ -e /usr/src/linux ] || { echo "no /usr/src/linux symlink" >&2; exit 1; }
	cd /usr/src/linux

	# 1. the base config
	if [ -f /tmp/xstage-kconfig/base.config ]; then
	    cp /tmp/xstage-kconfig/base.config .config
	else
	    make defconfig
	fi

	# 2. merge the fragments. -m keeps the merge in .config without running
	#    a config target yet; olddefconfig then answers every new symbol with
	#    its default instead of prompting (a chroot has no one to prompt).
	./scripts/kconfig/merge_config.sh -m .config /tmp/xstage-kconfig/[0-9]-*
	make olddefconfig

	# 3. fail loudly if the boot chain did not survive the merge — a live ISO
	#    without squashfs or loop is a two-hour build that cannot boot
	for sym in CONFIG_SQUASHFS CONFIG_BLK_DEV_LOOP CONFIG_ISO9660_FS \\
	           CONFIG_BLK_DEV_INITRD CONFIG_OVERLAY_FS ${kcheck}; do
	    grep -q "^\${sym}=y" .config ||
	        { echo "FATAL: \${sym} is not =y after merge — the ISO would not boot" >&2; exit 1; }
	done
	EOF
}

cmd_live_pkgs() {
    need_root
    local list; list=$(live_pkg_list)
    [[ -n ${list} || -n ${LIVE_SETS} ]] ||
        die "Nothing to install — the profile sets neither PROF_LIVE_PKGS/TIERS nor PROF_LIVE_SETS"
    [[ -d ${LIVE_ROOT}/var/db/repos/gentoo/profiles ]] ||
        die "No ebuild tree in the image — run: sudo $0 ${TGT:-amd64} conf"
    live_prep_kconfig
    local n; n=$(printf '%s\n' "${list}" | grep -c . || true)

    # Out-of-tree kernel modules, deferred to the post-kernel pass in
    # cmd_live_kernel. linux-mod-r1.eclass dies in setup when
    # /usr/src/linux/Module.symvers is missing ("built kernel sources are
    # required to build kernel modules"), and 'pkgs' runs before 'kernel' by
    # design, so these cannot succeed here at all.
    #
    # This must apply to BOTH passes. Pass 1 is an @world/@installed update,
    # and a module package reached through a dependency — nvidia-drivers via
    # dev-util/nvidia-cuda-toolkit, or via VIDEO_CARDS=nvidia through
    # x11-drivers/xorg-drivers — is in that graph just as much as in the
    # payload list. Excluding it only from pass 2 is what let run6 merge 148 of
    # 148 packages and still abort: --keep-going means the one failure does not
    # stop the run, but emerge still exits 1, and live_chroot dies on that.
    local kmod_excl=""
    local kp
    while IFS= read -r kp; do
        [[ -n ${kp} ]] || continue
        kmod_excl+=" --exclude ${kp}"
    done <<< "${LIVE_KMOD_PKGS}"
    [[ -z ${kmod_excl} ]] ||
        info "Deferred to the post-kernel module pass:${kmod_excl//--exclude/}"
    # Pass 1: bring the stage3 up to the tree BEFORE adding the package list.
    #
    # Not an optimisation — the two do not fit in one resolver graph. A stage3
    # is a snapshot, so the tree has usually moved a language runtime under it,
    # and dev-lang/perl is the reliable offender: 5.42 -> 5.44 changes the
    # subslot, the ~60 dev-perl modules the stage3 ships pin ':0/5.42=', and the
    # fresh virtual/perl-* the tree offers demand '=dev-lang/perl-5.44*'.
    # Resolving that transition at the same time as several hundred new atoms
    # made portage give up after 23 backtracks and 220 s (measured, amdkde
    # 2026-08-05). Alone it takes 30 s and 3 backtracks.
    #
    # This costs no extra build time: '--update --newuse --deep' rebuilds that
    # part of the stage3 either way, because the image's USE and CFLAGS differ
    # from the seed's. It only fixes the ORDER.
    #
    # @installed alongside @world on purpose: the packages holding the old
    # subslot are stage3 leaves that nothing in @world reaches, so without it
    # they stay outside the graph and portage never schedules their rebuild.
    if [[ ${LIVE_UPDATE_FIRST} == yes ]]; then
        info "Pass 1/2: updating the stage3 to the tree (@world @installed)"
        live_chroot update-seed <<-EOF
	emerge --verbose --keep-going --with-bdeps=y${kmod_excl} \\
	    --update --deep --newuse @world @installed
	EOF
    fi
    # A gcc merged as a NEW slot stays unselected — gcc-config keeps the seed
    # stage3's compiler, so without this step pass 2 (the entire payload) would
    # silently build with the old gcc while the tree's sits installed and idle.
    # binutils-config, in contrast, auto-selects on install. No-op when seed
    # and tree agree on the slot, or when a profile masks the newer one (as
    # amdkde does: nvcc caps its host compiler at gcc-15).
    live_chroot toolchain-select <<-EOF
	latest=\$(gcc-config -l | awk '/^ *\[/{p=\$2} END{print p}')
	current=\$(gcc-config -c)
	if [ "\${latest}" != "\${current}" ]; then
	    gcc-config "\${latest}"
	    env-update
	    # libtool bakes the selected compiler's paths into its script
	    emerge --ignore-default-opts --oneshot --quiet dev-build/libtool
	fi
	echo "gcc-config: \$(gcc-config -c)"
	EOF
    # Build-time cycles with no permanent USE cut. Portage can break a cycle by
    # dropping a flag, but only if the image can live without it; where the
    # image's own packages USE-depend on the flag, the only way in is to merge
    # one side once with the flag off, so the other side has something to build
    # against, and let pass 2 rebuild it properly.
    #
    # Each entry is "<atom> <USE overrides...>", and each is skipped once the
    # atom is installed — so this costs nothing on a re-run, and nothing at all
    # for a profile that sets no PROF_LIVE_CYCLE_BOOTSTRAP.
    #
    # EMERGE_DEFAULT_OPTS is cleared for the same reason as the ccache
    # bootstrap: the profile's '--update --newuse --deep' would pull the whole
    # graph back in, and with it the very packages whose USE-dep this step
    # exists to defer.
    if [[ -n ${LIVE_CYCLE_BOOTSTRAP} ]]; then
        local entry atom useov
        while IFS= read -r entry; do
            [[ -n ${entry} ]] || continue
            atom=${entry%% *}
            useov=${entry#"${atom}"}
            info "Cycle bootstrap: ${atom} with USE='${useov# }' (skipped if already installed)"
            live_chroot "cycle-${atom##*/}" <<-EOF
		if ls -d /var/db/pkg/${atom}-* >/dev/null 2>&1; then
		    echo ">>> ${atom} already installed — bootstrap not needed"
		else
		    EMERGE_DEFAULT_OPTS="" USE="${useov}" \\
		        emerge --oneshot --verbose ${atom}
		fi
		EOF
        done <<< "${LIVE_CYCLE_BOOTSTRAP}"
    fi
    info "Pass 2/2: merging ${n} top-level packages${LIVE_SETS:+ + sets: ${LIVE_SETS}} (dependencies resolve inside)"
    # --keep-going: one broken ebuild in a 300-package image should not throw
    # away hours of work; the summary at the end names what failed
    #
    # --with-bdeps=n, unlike pass 1, and it is a resolver fix rather than a
    # slimming measure. A binary package records the RESOLVED subslot of its
    # build deps, so a binhost package built when the tree carried an older
    # language runtime drags that pin into the graph. go-module.eclass puts
    # 'dev-lang/go:=' in BDEPEND, so the Gentoo binhost's restic, syncthing,
    # docker, lxd, containerd, gocryptfs, github-cli ... all arrive demanding
    # 'dev-lang/go:0/1.26.3=' while the image has go-1.26.5 installed (which
    # net-dns/doggo needs, at >=1.26.4). With --with-bdeps=y that is an
    # unsolvable slot conflict and the whole pass aborts before merging
    # anything (measured 2026-08-07, 1549-package plan).
    #
    # =n does not lose the build deps of anything portage actually BUILDS —
    # those are strictly required and pulled regardless. It only stops pulling
    # the toolchain that built a package we are installing prebuilt, which is
    # exactly the useless edge here: dev-lang/go is a PROF_LIVE_PKGS entry, so
    # the image gets a go either way, just the tree's one.
    #
    # The RDEPEND-side twin of this failure (dev-perl/* binaries pinning an
    # old dev-lang/perl subslot) cannot be fixed this way and is handled with
    # --usepkg-exclude in PROF_LIVE_EMERGE_OPTS; see the profile.
    # Out-of-tree kernel modules cannot be built here at all: linux-mod-r1
    # requires a BUILT kernel tree (it checks /usr/src/linux/Module.symvers)
    # and this step only CONFIGURES it — genkernel compiles the tree later, in
    # 'kernel', which already ends with a 'module-pkgs' pass that exists to
    # merge exactly these packages.
    #
    # So the failure was never the missing module: it was that nvidia-drivers
    # dying under --keep-going still makes the step exit 1, and that abort took
    # the overlay-pkgs run below with it (measured 2026-08-07: 1930 packages
    # merged, sci-ml/unsloth and the whole ::pwr half never attempted).
    # Excluding them turns an inevitable failure into a deliberate skip.
    #
    # --exclude is the right tool even though nothing lists nvidia-drivers
    # directly — it arrives via VIDEO_CARDS=nvidia -> x11-drivers/xorg-drivers,
    # so it cannot be dropped from PROF_LIVE_PKGS. Portage omits it from the
    # merge list without failing the resolve.
    live_chroot pkgs <<-EOF
	emerge --verbose --keep-going --with-bdeps=n${kmod_excl} \\
	    ${LIVE_SETS} $(printf '%s ' ${list})
	EOF
    if [[ -n ${LIVE_OVERLAY_PKGS} ]]; then
        local missing=""
        local r
        for r in ${LIVE_REPOS}; do
            [[ -d ${LIVE_ROOT}/var/db/repos/${r} ]] || missing+=" ${r}"
        done
        if [[ -n ${missing} ]]; then
            warn "Skipping overlay packages — missing repos in the image:${missing}"
        else
            # portage-bashrc-mv first and ALONE, when listed: it installs
            # /etc/portage/bashrc phase hooks, and under --jobs a package
            # whose setup ran before the hooks appeared dies in preinst with
            # "compile or preinst before setup" (10-flag.sh). Five packages
            # went down that way in one run (amdkdehard, 2026-08-08).
            if [[ " ${LIVE_OVERLAY_PKGS} " == *" app-portage/portage-bashrc-mv "* ]]; then
                info "Merging portage-bashrc-mv ahead of the rest (bashrc hook ordering)"
                live_chroot overlay-pkgs-bashrc <<-EOF
		emerge --verbose --jobs=1 app-portage/portage-bashrc-mv
		EOF
            fi
            info "Merging overlay packages: ${LIVE_OVERLAY_PKGS}"
            live_chroot overlay-pkgs <<-EOF
		emerge --verbose --keep-going ${LIVE_OVERLAY_PKGS}
		EOF
        fi
    fi
    info "Package set installed: $(du -sh "${LIVE_ROOT}" | cut -f1) unpacked"
}

# Plasma ships a light Breeze by default; the live image is dark instead (user
# request 2026-08-06). Everything is written under /etc/xdg — the first entry
# of XDG_CONFIG_DIRS — so it applies to the live user, to any account added
# later, and stays overridable from System Settings, which is not true of a
# file dropped into a home directory. Self-guarding: profiles without Plasma
# (intelgnome, the headless arm ones) simply return.
live_kde_dark() {
    local scheme="${LIVE_ROOT}/usr/share/color-schemes/BreezeDark.colors"
    [[ -f ${scheme} ]] || return 0
    info "Plasma: Breeze Dark as the system-wide default"
    local kg="${LIVE_ROOT}/etc/xdg/kdeglobals"
    mkdir -p "${LIVE_ROOT}/etc/xdg"
    # A .colors file IS a kdeglobals fragment: [Colors:*], [General] with
    # ColorScheme=, [WM] and [KDE] are exactly the groups Plasma reads back out
    # of kdeglobals. Naming the scheme alone would not recolour anything — the
    # colours themselves have to be here. Comments and the ~50 translated
    # Name[xx]= lines are dropped as noise.
    grep -v -e '^#' -e '^Name\[' "${scheme}" > "${kg}"
    # into the scheme's own [KDE] group rather than appending a second one:
    # KConfig merges duplicate groups on read, but not every consumer does
    sed -i '/^\[KDE\]$/a LookAndFeelPackage=org.kde.breezedark.desktop\nwidgetStyle=Breeze' "${kg}"
    printf '\n[Icons]\nTheme=breeze-dark\n' >> "${kg}"
    grep -q '^LookAndFeelPackage=' "${kg}" ||
        die "BreezeDark.colors has no [KDE] group — kdeglobals would be light"
    # panel and widget theme: a separate file from the colour scheme
    printf '[Theme]\nname=breeze-dark\n' > "${LIVE_ROOT}/etc/xdg/plasmarc"
    # GTK apps do not read kdeglobals; without this every GTK file dialog
    # stays white next to a dark Plasma
    local gtktheme=Adwaita-dark
    [[ -d ${LIVE_ROOT}/usr/share/themes/Breeze-Dark ]] && gtktheme=Breeze-Dark
    local g
    for g in gtk-3.0 gtk-4.0; do
        mkdir -p "${LIVE_ROOT}/etc/xdg/${g}"
        cat > "${LIVE_ROOT}/etc/xdg/${g}/settings.ini" <<-EOF
		[Settings]
		gtk-theme-name=${gtktheme}
		gtk-icon-theme-name=breeze-dark
		gtk-application-prefer-dark-theme=1
		EOF
    done
    # The greeter is normally skipped by autologin, but it is what shows after
    # a logout or with XSTAGE_LIVE_USER="" — sddm's breeze theme is the dark one.
    if [[ -d ${LIVE_ROOT}/usr/share/sddm/themes/breeze ]]; then
        mkdir -p "${LIVE_ROOT}/etc/sddm.conf.d"
        printf '[Theme]\nCurrent=breeze\n' \
            > "${LIVE_ROOT}/etc/sddm.conf.d/20-xstage-theme.conf"
    fi
}

# Sound for the desktop user. Installing PipeWire is not enough to hear
# anything: this image has no /etc/xdg/autostart entry for it and an empty
# /etc/systemd/user, so nothing ever starts the daemon and the desktop comes up
# silent with a working sound card.
#
# 'systemctl --global enable' is the offline-safe spelling of 'systemctl --user
# enable' for an image: it writes the same .wants symlinks, but under
# /etc/systemd/user/ and for every account, so it needs neither a session bus
# nor a per-user HOME that does not exist yet at build time.
live_sound_units() {
    [[ -x ${LIVE_ROOT}/usr/bin/pipewire ]] || return 0
    # pipewire.socket starts the daemon on first client connect;
    # pipewire-pulse.socket serves the PulseAudio protocol (what the ALSA
    # pulse plugin, Firefox and Chromium actually talk to); wireplumber is the
    # session manager — without it PipeWire runs but routes nothing, which
    # looks exactly like broken hardware.
    local uunits=(pipewire.socket pipewire-pulse.socket wireplumber.service)
    local uu missing=()
    for uu in "${uunits[@]}"; do
        [[ -e ${LIVE_ROOT}/usr/lib/systemd/user/${uu} ]] || missing+=("${uu}")
    done
    if (( ${#missing[@]} )); then
        warn "PipeWire is installed but its user units are missing (${missing[*]})" \
             "— the desktop will have no sound"
        return 0
    fi
    info "sound: enabling ${uunits[*]} for every user"
    live_chroot enable-sound <<-EOF
	systemctl --global enable ${uunits[*]}
	EOF
    # --global writes plain symlinks and cannot fail loudly; check the result
    [[ -e ${LIVE_ROOT}/etc/systemd/user/sockets.target.wants/pipewire.socket ]] ||
        die "systemctl --global enable left no symlinks — the image would be silent"
}

# Packages that must not share a resolver graph — or a run — with 'pkgs'.
#
# A separate verb rather than a bucket inside 'pkgs' on purpose. What lands
# here is awkward for reasons that have nothing to do with the image: an
# archive portage may not fetch, or a bootstrap chain that pulls an ancient
# toolchain in behind it. Neither should be able to abort, or be buried in,
# a multi-hour package run — and both are things you want to retry on their
# own without touching the other 1500 packages.
#
# dev-db/sqldeveloper is both at once:
#   - RESTRICT="fetch". The zip is a click-through download from Oracle, so
#     portage stops at dependency resolution with "Fetch Restriction". The
#     archive is kept in dl/distfiles-restricted and seeded below.
#   - It RDEPENDs dev-java/openjdk:11[javafx], openjdk:11[javafx] needs
#     dev-java/openjfx:11, and openjfx:11 BDEPENDs a JDK 11 to build itself —
#     satisfied by dev-java/openjdk-bin:11. A whole second, obsolete JVM
#     bootstrap, resolved here where it cannot perturb the main graph.
#
# Not part of 'live' (cmd_live_all): this is opt-in by design. Run it after
# 'pkgs' and before 'squash'.
cmd_live_restrict_run() {
    need_root
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    if [[ -z ${LIVE_RESTRICT_PKGS} ]]; then
        info "Profile sets no PROF_LIVE_RESTRICT_PKGS — nothing to do"
        return 0
    fi
    live_distfiles_seed
    local entry
    while IFS= read -r entry; do
        [[ -n ${entry} ]] || continue
        info "Restricted run: ${entry}"
        # Each line is its own emerge, so one entry's bootstrap cannot be
        # merged into the next one's graph. EMERGE_DEFAULT_OPTS is kept: these
        # are ordinary packages once their archive is in place, and --keep-going
        # still applies.
        live_chroot "restrict-${entry##*/}" <<-EOF
	emerge --verbose ${entry}
	EOF
    done <<< "${LIVE_RESTRICT_PKGS}"
    info "Restricted packages installed"
}

cmd_live_configure() {
    need_root
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    info "hostname ${LIVE_HOSTNAME}, root password '${ZERO_PASS}', sshd + NetworkManager"
    echo "${LIVE_HOSTNAME}" > "${LIVE_ROOT}/etc/hostname"
    # /etc/hostname is read by both init systems; /etc/conf.d/hostname is
    # OpenRC's older spelling and the directory does not exist at all in a
    # systemd stage3 — writing it unconditionally would abort under set -e
    [[ -d ${LIVE_ROOT}/etc/conf.d ]] &&
        echo "hostname=\"${LIVE_HOSTNAME}\"" > "${LIVE_ROOT}/etc/conf.d/hostname"

    # same host-side hash trick as the SD images — no plaintext in the chroot
    local hash; hash=$(openssl passwd -6 "${ZERO_PASS}") || die "openssl passwd failed"
    sed -i "s|^root:[^:]*:|root:${hash}:|" "${LIVE_ROOT}/etc/shadow" ||
        die "could not set the root password in ${LIVE_ROOT}/etc/shadow"

    mkdir -p "${LIVE_ROOT}/etc/ssh/sshd_config.d"
    echo "PermitRootLogin yes" > "${LIVE_ROOT}/etc/ssh/sshd_config.d/50-xstage.conf"

    # A stage3 ships /etc/locale.gen with every entry commented out, so the
    # image would have C.UTF-8 and nothing else — glibc then falls back
    # silently and anything asking for pl_PL.UTF-8 gets C. The list is a plain
    # config file in the 'common' overlay layer, so it is edited there, not
    # here; this only runs the generator when the layer actually enabled
    # something. locale-gen is idempotent and skips locales already built.
    if grep -qv -e '^#' -e '^$' "${LIVE_ROOT}/etc/locale.gen" 2>/dev/null; then
        info "locales: $(grep -v -e '^#' -e '^$' "${LIVE_ROOT}/etc/locale.gen" | tr '\n' ' ')"
        live_chroot locale-gen <<-EOF
		locale-gen
		EOF
    fi

    # Live user (the gap the old v-pipeline image filled with a hand-edited
    # passwd): created by useradd IN the chroot so passwd/shadow/group stay
    # consistent — never overlaid as files. Password = the same hash as root's
    # (host-side, no plaintext enters the chroot); single-quoted so the $6$
    # salt survives the unquoted heredoc.
    if [[ -n ${LIVE_USER} ]]; then
        info "Live user '${LIVE_USER}' (password '${ZERO_PASS}', autologin)"
        live_chroot live-user <<-EOF
	id -u ${LIVE_USER} >/dev/null 2>&1 ||
	    useradd -m -c "Live user" -s /bin/bash -p '${hash}' ${LIVE_USER}
	# Every group the image defines, not a hand-picked list (user rule
	# 2026-08-06): a live medium is expected to reach all hardware and every
	# service group without a reinstall, and the set differs per profile.
	# Skipped: root, so root-group-owned files stay out of reach of a plain
	# guest process, and the two "no privileges" groups, where membership
	# means nothing.
	for g in \$(cut -d: -f1 /etc/group); do
	    case \${g} in root|nogroup|nobody|${LIVE_USER}) continue ;; esac
	    gpasswd -a ${LIVE_USER} \${g} >/dev/null || true
	done
	EOF
        if [[ -n ${XSTAGE_LIVE_XSESSION:-} ]]; then
            # sddm needs BOTH keys. 'User=' alone does nothing at all — the
            # daemon skips autologin without a word in the journal and shows
            # the greeter, which is exactly what the first booted image did.
            # Session is a .desktop NAME, not a command, so resolve it from the
            # profile's session command by matching Exec=; Wayland first.
            local sdir sfile sess="" stype=""
            for sdir in wayland-sessions xsessions; do
                for sfile in "${LIVE_ROOT}/usr/share/${sdir}"/*.desktop; do
                    [[ -e ${sfile} ]] || continue
                    grep -q "^Exec=.*${XSTAGE_LIVE_XSESSION}\b" "${sfile}" || continue
                    sess=$(basename "${sfile}" .desktop); stype=${sdir}; break 2
                done
            done
            [[ -n ${sess} ]] || die "no .desktop session runs '${XSTAGE_LIVE_XSESSION}' —" \
                "autologin would be skipped silently"
            info "sddm autologin: ${LIVE_USER} -> ${sess} (${stype})"
            mkdir -p "${LIVE_ROOT}/etc/sddm.conf.d"
            # Relogin=false: after a deliberate logout you get the greeter,
            # not an endless loop straight back into the session.
            cat > "${LIVE_ROOT}/etc/sddm.conf.d/10-xstage-autologin.conf" <<-EOF
		[Autologin]
		User=${LIVE_USER}
		Session=${sess}
		Relogin=false
		EOF
            # The greeter's display server has to match the session's type.
            # Gentoo's own 01gentoo.conf pins DisplayServer=x11, which sorts
            # first and would leave sddm starting an X server for a Wayland
            # session. Same block the build host runs with a working autologin.
            if [[ ${stype} == wayland-sessions ]]; then
                cat >> "${LIVE_ROOT}/etc/sddm.conf.d/10-xstage-autologin.conf" <<-EOF

		[General]
		DisplayServer=wayland
		GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

		[Wayland]
		CompositorCommand=kwin_wayland --drm --no-lockscreen --no-global-shortcuts --locale1
		EOF
            fi
        fi
        if [[ ${LIVE_RC} == systemd ]]; then
            mkdir -p "${LIVE_ROOT}/etc/systemd/system/getty@tty1.service.d"
            cat > "${LIVE_ROOT}/etc/systemd/system/getty@tty1.service.d/autologin.conf" <<-EOF
		[Service]
		ExecStart=
		ExecStart=-/sbin/agetty --autologin ${LIVE_USER} --noclear %I \$TERM
		EOF
        fi
        # Standard live-medium convenience; the installed system's sudoers
        # comes from the /root/* payload kits, not from here.
        #
        # The guard used to be '[[ -d /etc/sudoers.d ]]' — and a stage3 ships
        # /etc/sudoers with '@includedir /etc/sudoers.d' but NOT the directory,
        # so it never fired and every image so far gave the live user no sudo
        # at all. Create it; only a missing sudo binary is a real reason to
        # skip, and that gets a warning rather than silence.
        if [[ -x ${LIVE_ROOT}/usr/bin/sudo ]]; then
            install -d -m 0755 "${LIVE_ROOT}/etc/sudoers.d"
            # The explicit user line is not redundant with %wheel: it keeps
            # sudo working if the account is ever created outside wheel, and
            # it is what the display manager's single login is traded for —
            # sddm autologs the user in, so a second password prompt for sudo
            # protects nothing (user decision 2026-08-06).
            cat > "${LIVE_ROOT}/etc/sudoers.d/95-xstage-live" <<-EOF
		%wheel ALL=(ALL:ALL) NOPASSWD: ALL
		${LIVE_USER} ALL=(ALL:ALL) NOPASSWD: ALL
		EOF
            chmod 0440 "${LIVE_ROOT}/etc/sudoers.d/95-xstage-live"
            # a syntax error here locks sudo out completely, and it would only
            # surface on the booted image
            live_chroot sudoers-check <<-EOF
		visudo -cf /etc/sudoers.d/95-xstage-live
		EOF
        else
            warn "no /usr/bin/sudo in the image — ${LIVE_USER} gets no sudo"
        fi
    fi

    live_kde_dark

    # Enabling services differs per flavour, and neither method can simply be
    # "run the tool": no init system is running in this chroot. OpenRC's
    # runlevels are plain symlinks, so they are made directly; systemd's
    # 'systemctl enable' works offline against the unit files, so it is run
    # inside the chroot rather than symlinked by hand.
    info "Service manager: ${LIVE_RC} (stage3 flavour ${LIVE_FLAVOR_NAME})"
    local want=(sshd dbus)
    if [[ ${LIVE_RC} == systemd ]]; then
        local units=(sshd.service dbus.service)
        [[ -e ${LIVE_ROOT}/usr/lib/systemd/system/NetworkManager.service ]] &&
            units+=(NetworkManager.service)
        [[ -n ${XSTAGE_LIVE_XSESSION:-} && -e ${LIVE_ROOT}/usr/lib/systemd/system/sddm.service ]] &&
            units+=(sddm.service)
        [[ -n ${XSTAGE_LIVE_XSESSION:-} && -e ${LIVE_ROOT}/usr/lib/systemd/system/gdm.service ]] &&
            units+=(gdm.service)
        # Without the timer nothing ever calls logrotate, and every
        # /etc/logrotate.d file in the image (aide's included) is decoration.
        [[ -e ${LIVE_ROOT}/usr/lib/systemd/system/logrotate.timer ]] &&
            units+=(logrotate.timer)
        live_chroot enable-units <<-EOF
		systemctl enable ${units[*]} || true
		systemctl set-default graphical.target 2>/dev/null || true
		EOF
        live_sound_units
    else
        local svc
        for svc in "${want[@]}"; do
            [[ -e ${LIVE_ROOT}/etc/init.d/${svc} ]] &&
                ln -snf "/etc/init.d/${svc}" "${LIVE_ROOT}/etc/runlevels/default/${svc}"
        done
        if [[ -e ${LIVE_ROOT}/etc/init.d/NetworkManager ]]; then
            ln -snf /etc/init.d/NetworkManager "${LIVE_ROOT}/etc/runlevels/default/NetworkManager"
        elif [[ -e ${LIVE_ROOT}/etc/init.d/dhcpcd ]]; then
            ln -snf /etc/init.d/dhcpcd "${LIVE_ROOT}/etc/runlevels/default/dhcpcd"
        fi
        if [[ -n ${XSTAGE_LIVE_XSESSION:-} && -e ${LIVE_ROOT}/etc/init.d/display-manager ]]; then
            ln -snf /etc/init.d/display-manager \
                "${LIVE_ROOT}/etc/runlevels/default/display-manager"
            info "display-manager in the default runlevel (session ${XSTAGE_LIVE_XSESSION})"
        fi
    fi

    cat > "${LIVE_ROOT}/etc/motd" <<-EOF
	${LIVE_VOLID} — Gentoo live image built by xstage (rpilinuxlab)
	Built $(date -u +%Y-%m-%dT%H:%M:%SZ) from $(basename "$(built_stage stage3 || echo 'a seed stage3')")
	The system runs from a read-only squashfs; changes live in RAM only.
	EOF
    info "Configured."
}

# genkernel with CDROOT=1: exactly what bin/v does, and the reason the ISO
# needs no root= — the initrd hunts for the /livecd marker itself
cmd_live_kernel() {
    need_root
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    live_prep_kconfig

    info "Building the live kernel with genkernel (CDROOT=1) — this takes a while"
    live_chroot kernel <<-EOF
	# --ignore-default-opts for the same reason as the kconfig step: the
	# image's EMERGE_DEFAULT_OPTS would drag the stage3 transition graph in
	command -v genkernel >/dev/null ||
	    emerge --ignore-default-opts --verbose --oneshot sys-kernel/genkernel
	[ -f /usr/src/linux/.config ] || { echo "no /usr/src/linux/.config" >&2; exit 1; }

	sed -i 's/CDROOT="0"/CDROOT="1"/' /usr/share/genkernel/defaults/initrd.defaults
	genkernel --makeopts=-j${JOBS} --kernel-config=/usr/src/linux/.config \\
	    --luks --lvm --btrfs --busybox --no-clean all
	sed -i 's/CDROOT="1"/CDROOT="0"/' /usr/share/genkernel/defaults/initrd.defaults
	EOF
    # keep the exact config next to the artifacts: without it a built ISO
    # cannot be reproduced or bisected later
    command cp -f "${LIVE_ROOT}/usr/src/linux/.config" "${LIVE_BLD}/kernel.config" 2>/dev/null || true
    mkdir -p "${LIVE_BLD}"
    local k i
    # genkernel 4.x names artifacts vmlinuz-<KV> / initramfs-<KV>.img — the
    # 3.x "-genkernel-" infix is gone, so match on the prefix only
    k=$(ls -1t "${LIVE_ROOT}/boot/"{vmlinuz,kernel}-* 2>/dev/null | head -1 || true)
    i=$(ls -1t "${LIVE_ROOT}/boot/"initramfs-* 2>/dev/null | head -1 || true)
    [[ -n ${k} ]] || die "genkernel produced no kernel in ${LIVE_ROOT}/boot"
    [[ -n ${i} ]] || die "genkernel produced no initramfs in ${LIVE_ROOT}/boot"
    command cp -f "${k}" "${LIVE_BLD}/bzImage"
    command cp -f "${i}" "${LIVE_BLD}/initrd"
    info "kernel: $(basename "${k}") ($(du -h "${LIVE_BLD}/bzImage" | cut -f1))"
    info "initrd: $(basename "${i}") ($(du -h "${LIVE_BLD}/initrd" | cut -f1))"

    # Pass 2: same kernel relinked with the initramfs built in
    # (CONFIG_INITRAMFS_SOURCE). A UEFI firmware boot entry can exec this one
    # PE binary directly — no bootloader, no separate initrd, no cmdline (the
    # CDROOT logic hunts for the /livecd marker itself). The split pair from
    # pass 1 stays the GRUB/isolinux payload.
    info "Building the stub kernel (integrated initramfs) for direct UEFI boot"
    live_chroot kernel-stub <<-EOF
	sed -i 's/CDROOT="0"/CDROOT="1"/' /usr/share/genkernel/defaults/initrd.defaults
	genkernel --makeopts=-j${JOBS} --kernel-config=/usr/src/linux/.config \\
	    --luks --lvm --btrfs --busybox --no-clean --integrated-initramfs all
	sed -i 's/CDROOT="1"/CDROOT="0"/' /usr/share/genkernel/defaults/initrd.defaults
	EOF
    k=$(ls -1t "${LIVE_ROOT}/boot/"{vmlinuz,kernel}-* 2>/dev/null | head -1 || true)
    [[ -n ${k} ]] || die "stub pass produced no kernel in ${LIVE_ROOT}/boot"
    command cp -f "${k}" "${LIVE_BLD}/bzImage-stub"
    # if the initramfs really got linked in, the stub must be visibly bigger
    [[ $(stat -c%s "${LIVE_BLD}/bzImage-stub") -gt $(stat -c%s "${LIVE_BLD}/bzImage") ]] ||
        die "bzImage-stub is not bigger than bzImage — initramfs not integrated?"
    info "stub kernel: $(basename "${k}") ($(du -h "${LIVE_BLD}/bzImage-stub" | cut -f1))"

    # Out-of-tree module packages (nvidia-drivers, bbswitch, openrazer, ...)
    # check /usr/src/linux/Module.symvers in pkg_setup — it only exists NOW,
    # after genkernel compiled the tree, so during 'pkgs' they inevitably
    # failed with "tree has not been built". Re-run the package list: with
    # EMERGE_DEFAULT_OPTS carrying --update, everything already merged drops
    # out of the graph and only the module packages (plus whatever their
    # failure dropped via --keep-going) merge here.
    local list; list=$(live_pkg_list)
    if [[ -n ${list} || -n ${LIVE_SETS} ]]; then
        info "Post-kernel pass: retrying packages that needed the built kernel tree"
        live_chroot module-pkgs <<-EOF
	emerge --verbose --keep-going --with-bdeps=y \\
	    ${LIVE_SETS} $(printf '%s ' ${list})
	EOF
    fi
}

# /etc/image-release: every input of this build, machine-readable — the
# auditable "what went in" record the security policy's chain-of-trust
# section promises. The package inventory sits beside it.
live_write_release() {
    local rel="${LIVE_ROOT}/etc/image-release"
    local treestamp pwrhead labhead kver="" kcfg="" rp
    treestamp=$(cat "${LIVE_ROOT}/var/db/repos/gentoo/metadata/timestamp.chk" 2>/dev/null || true)
    rp=$(portageq get_repo_path / pwr 2>/dev/null || true)
    pwrhead=$([[ -n ${rp} ]] && git -C "${rp}" rev-parse --short HEAD 2>/dev/null || true)
    labhead=$(git -C "${REPO}" describe --always --dirty 2>/dev/null || true)
    kver=$(readlink "${LIVE_ROOT}/usr/src/linux" 2>/dev/null | sed 's/^linux-//' || true)
    [[ -f ${LIVE_ROOT}/usr/src/linux/.config ]] &&
        kcfg=$(sha256sum "${LIVE_ROOT}/usr/src/linux/.config" | cut -d' ' -f1)
    {
        echo "# xstage image provenance — the inputs of this build"
        echo "profile=${XPROFILE:-none}"
        echo "built=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "builder=$(hostname)"
        echo "rpilinuxlab=${labhead}"
        [[ -f ${LIVE_BLD}/stage3.provenance ]] && cat "${LIVE_BLD}/stage3.provenance"
        echo "gentoo_tree=${treestamp}"
        echo "pwr=${pwrhead}"
        echo "kernel=${kver}"
        echo "kernel_config_sha256=${kcfg}"
    } > "${rel}"
    (cd "${LIVE_ROOT}/var/db/pkg" && ls -d ./*/* 2>/dev/null | sed 's|^\./||' | sort) \
        > "${LIVE_ROOT}/etc/image-release.packages"
    info "Provenance: /etc/image-release + .packages ($(grep -c . "${LIVE_ROOT}/etc/image-release.packages") packages)"
}

cmd_live_squash() {
    need_root
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    command -v mksquashfs >/dev/null || die "No mksquashfs — emerge -av sys-fs/squashfs-tools"
    mkdir -p "${LIVE_ISO_DIR}"

    live_write_release

    # /etc under git from before first boot — the installed system inherits
    # an audit trail that starts at the build, and etckeeper's hooks keep it
    # growing with every emerge
    if [[ -x ${LIVE_ROOT}/usr/bin/etckeeper ]]; then
        info "etckeeper: baseline commit of /etc"
        live_chroot etckeeper <<-EOF
	git config --system user.name  "xstage"
	git config --system user.email "root@${LIVE_HOSTNAME}"
	[ -d /etc/.git ] || etckeeper init
	etckeeper commit "image build ${XPROFILE:-} $(date -u +%Y-%m-%d)" || true
	EOF
    fi

    # AIDE baseline from BEFORE first boot — strictly stronger than one made
    # after installation (predates any network exposure). The copy inside the
    # image is convenience; the one exported here is authoritative and must
    # move to the encrypted volume.
    if [[ -x ${LIVE_ROOT}/usr/bin/aide ]]; then
        # The image's exclusions live in a FRAGMENT under aide.conf.d (shipped
        # by the hardened overlay), not in a replaced aide.conf: aide.conf is a
        # package file, and carrying a private copy of it means every aide
        # upgrade either clobbers our edits or silently keeps shipping a stale
        # default. Only the include line is added here, appended so the
        # fragment's rules are read last, and only once.
        local aconf="${LIVE_ROOT}/etc/aide/aide.conf"
        if [[ -d ${LIVE_ROOT}/etc/aide/aide.conf.d ]] &&
           ! grep -q '^@@include /etc/aide/aide.conf.d' "${aconf}"; then
            info "AIDE: including /etc/aide/aide.conf.d fragments"
            printf '\n# xstage: image-specific exclusions, read last\n@@include /etc/aide/aide.conf.d ^.*\\.conf$\n' >> "${aconf}"
        fi
        info "AIDE: initializing pristine baseline (this hashes the whole rootfs)"
        # No "|| echo AIDE-INIT-FAILED": swallowing the failure once shipped an
        # image whose promised baseline did not exist, and clobbered the previous
        # good export with a 0-byte file. live_chroot dies on a non-zero step.
        live_chroot aide-init <<-EOF
	# a typo in a fragment must fail here, in a second, not after the
	# full-rootfs hash run has already burned the time
	aide --config-check
	aide --init || aide -i
	# aide.conf reads database_in=/var/lib/aide/aide.db, but --init writes
	# aide.db.new — without this rename "aide --check" on the installed
	# system finds no database at all
	mv -f /var/lib/aide/aide.db.new /var/lib/aide/aide.db
	EOF
        local adb="${LIVE_ROOT}/var/lib/aide/aide.db"
        # -s, not -n: an empty file is what a failed run leaves behind, and it
        # must never overwrite a good baseline in LIVE_BLD
        [[ -s ${adb} ]] ||
            die "aide produced no usable database — refusing to ship an image without its baseline"
        command cp -f "${adb}" "${LIVE_BLD}/aide-baseline-$(date -u +%Y%m%d).db"
        info "AIDE baseline exported: ${LIVE_BLD}/aide-baseline-*.db — move to the encrypted volume"
    fi
    info "Compressing the rootfs into livecd.squashfs (-comp ${LIVE_COMP})"
    # -e: the pseudo-filesystems are mount points inside the image, and the
    # portage tree we seeded is worth ~1.5 GB of the result on its own
    # Unmount the chroot's API filesystems and bind mounts FIRST, then squash
    # /proc and /sys as the plain empty directories they are. They used to be
    # in the exclude list, which was the wrong fix twice over: 'mksquashfs -e'
    # drops the DIRECTORY, not just its contents, and the live root is
    # read-only squashfs — systemd cannot mkdir the mount points at boot, so
    # PID 1 died with "Failed to mount early API filesystems. Freezing
    # execution." (T14, 2026-08-06). Excluding them also hid the real problem:
    # a chroot step that leaves its mounts behind.
    live_chroot_umount "${LIVE_ROOT}"
    # /proc/mounts spells mount points with symlinks RESOLVED (build/ is a
    # symlink to the data volume), so match both spellings — and with index()
    # rather than a regex, since the path may hold regex metacharacters
    local stale rp
    rp=$(realpath "${LIVE_ROOT}")
    stale=$(awk -v a="${LIVE_ROOT}/" -v b="${rp}/" \
        'index($2,a)==1 || index($2,b)==1 {print $2}' /proc/mounts || true)
    [[ -z ${stale} ]] || die "still mounted under ${LIVE_ROOT} — refusing to squash:
${stale}"

    # var/cache/eix is deliberately NOT excluded: 'conf' seeds it (~22 MB, a
    # few MB compressed) so that 'eix' on the booted image answers instantly
    # instead of making the user sit through an eix-update first.
    local excl=(dev/pts dev/shm var/tmp/portage var/tmp/distfiles var/cache/distfiles var/cache/ccache var/cache/binpkgs)
    mksquashfs "${LIVE_ROOT}" "${LIVE_ISO_DIR}/livecd.squashfs" \
        -comp "${LIVE_COMP}" -noappend -no-progress -b 1048576 -no-xattrs \
        -e "${excl[@]}" || die "mksquashfs failed"
    # guard: the image is unbootable without these, and the failure only shows
    # up on real hardware minutes into a boot — assert it here instead
    # List once into a variable: 'unsquashfs -l | grep -q' would make grep exit
    # early, SIGPIPE unsquashfs, and pipefail turn that into a false failure
    local mp sqlist
    sqlist=$(unsquashfs -l "${LIVE_ISO_DIR}/livecd.squashfs" 2>/dev/null || true)
    for mp in proc sys dev run; do
        grep -qx "squashfs-root/${mp}" <<<"${sqlist}" ||
            die "squashfs has no /${mp} mount point — systemd cannot boot it"
    done
    # the marker the CDROOT initrd looks for when identifying the boot media
    touch "${LIVE_ISO_DIR}/livecd"
    # recorded OUTSIDE the iso tree: the artifact's own fingerprint, for the
    # provenance record and for verifying whatever lands on a stick later
    sha256sum "${LIVE_ISO_DIR}/livecd.squashfs" | sed "s|${LIVE_ISO_DIR}/||" \
        > "${LIVE_BLD}/livecd.squashfs.sha256"
    info "livecd.squashfs: $(du -h "${LIVE_ISO_DIR}/livecd.squashfs" | cut -f1)  (sha256 in ${LIVE_BLD})"
    info "Next: sudo $0 ${TGT:-amd64} usb /dev/sdX   (ISO only for the qemu gate: isolinux + iso)"
}

cmd_live_isolinux() {
    need_root
    [[ -f ${LIVE_BLD}/bzImage ]] || die "No kernel — run: sudo $0 ${TGT:-amd64} kernel"
    [[ -f ${LIVE_BLD}/initrd ]]  || die "No initrd — run: sudo $0 ${TGT:-amd64} kernel"
    [[ -f ${SYSLINUX_DIR}/isolinux.bin ]] ||
        die "No ${SYSLINUX_DIR}/isolinux.bin — emerge -av sys-boot/syslinux"
    install -d "${LIVE_ISO_DIR}/isolinux"
    info "Populating ${LIVE_ISO_DIR}/isolinux (legacy BIOS, syslinux)"
    # ldlinux.c32 is not optional on syslinux 6.x: isolinux.bin refuses to boot
    # without its companion module in the same directory
    local f
    for f in isolinux.bin ldlinux.c32; do
        command cp -f "${SYSLINUX_DIR}/${f}" "${LIVE_ISO_DIR}/isolinux/" ||
            die "could not copy ${f} from ${SYSLINUX_DIR}"
    done
    command cp -f "${LIVE_BLD}/bzImage" "${LIVE_ISO_DIR}/isolinux/gentoo"
    command cp -f "${LIVE_BLD}/initrd"  "${LIVE_ISO_DIR}/isolinux/initrd"
    sed -e "s|@APPEND@|${LIVE_APPEND}|g" -e "s|@VOLID@|${LIVE_VOLID}|g" \
        "${LIVE_TPL}/isolinux.cfg.in" > "${LIVE_ISO_DIR}/isolinux/isolinux.cfg"
    sed -e "s|@VOLID@|${LIVE_VOLID}|g" -e "s|@ROOTPASS@|${ZERO_PASS}|g" \
        "${LIVE_TPL}/boot.msg.in" > "${LIVE_ISO_DIR}/isolinux/boot.msg"
    info "isolinux ready (kernel 'gentoo', initrd, isolinux.cfg, boot.msg)"
}

cmd_live_iso() {
    need_root
    command -v xorriso >/dev/null || die "No xorriso — emerge -av dev-libs/libisoburn"
    [[ -f ${LIVE_ISO_DIR}/livecd.squashfs ]] || die "No squashfs — run: sudo $0 ${TGT:-amd64} squash"
    [[ -f ${LIVE_ISO_DIR}/isolinux/isolinux.bin ]] || die "No isolinux — run: sudo $0 ${TGT:-amd64} isolinux"
    info "Mastering ${LIVE_IMG} (volid ${LIVE_VOLID})"
    # -isohybrid-mbr makes the same file work as a CD image and as something
    # you can dd straight onto a stick; -partition_offset 16 keeps the embedded
    # partition table addressable after dd
    xorriso -as mkisofs -quiet \
        -o "${LIVE_IMG}" \
        -volid "${LIVE_VOLID}" \
        -J -joliet-long -rational-rock \
        -b isolinux/isolinux.bin -c isolinux/boot.cat \
        -no-emul-boot -boot-load-size 4 -boot-info-table \
        -isohybrid-mbr "${SYSLINUX_DIR}/isohdpfx.bin" \
        -partition_offset 16 \
        "${LIVE_ISO_DIR}" || die "xorriso failed"
    if [[ -n ${SUDO_UID:-} ]]; then chown "${SUDO_UID}:${SUDO_GID}" "${LIVE_IMG}"; fi
    info "ISO ready: ${LIVE_IMG} ($(du -h "${LIVE_IMG}" | cut -f1))"
    info "Boot gate: $0 ${TGT:-amd64} gate     USB deliverable: sudo $0 ${TGT:-amd64} usb /dev/sdX"
}

cmd_live_all() {
    need_root
    cmd_live_unpack
    cmd_live_conf
    cmd_live_pkgs
    cmd_live_configure
    cmd_live_kernel
    cmd_live_squash
    info "Deliverable: sudo $0 ${TGT:-amd64} usb /dev/sdX"
    info "Optional qemu-gate ISO: sudo $0 ${TGT:-amd64} isolinux && sudo $0 ${TGT:-amd64} iso"
}

cmd_live_gate() {
    command -v qemu-system-x86_64 >/dev/null ||
        die "No qemu-system-x86_64 — emerge qemu with QEMU_SOFTMMU_TARGETS=x86_64"
    [[ -f ${LIVE_IMG} ]] || die "No ISO — run: sudo $0 ${TGT:-amd64} iso"
    # unlike the Pi gates this one is fully interactive: KVM on native hardware,
    # a real serial console, and the ISO attached as a CD-ROM
    info "Booting ${LIVE_IMG} (-M q35, KVM if available; quit qemu: Ctrl-A X)"
    local kvm=()
    [[ -w /dev/kvm ]] && kvm=(-enable-kvm -cpu host)
    exec qemu-system-x86_64 -M q35 "${kvm[@]}" -m 4096 -smp 4 \
        -cdrom "${LIVE_IMG}" -boot d \
        -netdev "user,id=n0,hostfwd=tcp::${SSH_PORT}-:22" \
        -device virtio-net-pci,netdev=n0 \
        -nographic
}

# the deliverable for the amd64 profiles: a USB stick in the build-usb layout
# (p1 = ESP with GRUB --removable, p2 = ext4 GENTOO_LIVE, p3+ = the user's
# DATA partitions). p1 gets the kernel as /gentoo plus a busybox initrd keyed
# to p2's filesystem UUID; p2 gets livecd.squashfs. Boots UEFI-only via GRUB —
# the isohybrid ISO stays around as the qemu-gate artifact and is not needed
# here. An already-prepared stick is reused (DATA partitions survive, p2 UUID
# is stable so a rebuilt squashfs only needs re-copying); --wipe repartitions.
cmd_live_usb() {
    need_root
    local wipe=0 dev="" a
    for a in "$@"; do
        case "${a}" in
            --wipe) wipe=1 ;;
            *)      dev="${a%/}" ;;
        esac
    done
    [[ -n ${dev} ]] || die "Usage: sudo $0 ${TGT:-amd64} usb /dev/sdX [--wipe]"
    [[ -f ${LIVE_ISO_DIR}/livecd.squashfs ]] || die "No squashfs — run: sudo $0 ${TGT:-amd64} squash"
    [[ -f ${LIVE_BLD}/bzImage ]] || die "No kernel — run: sudo $0 ${TGT:-amd64} kernel"
    [[ ${dev} =~ ^/dev/sd[a-z]+$ ]] ||
        die "Whole device without partition expected, e.g. /dev/sdb (build-usb layout is sdX-only)"
    [[ -b ${dev} ]] || die "Block device not found: ${dev}"
    [[ -x ${USB_TOOLS}/build-usb ]] || die "No ${USB_TOOLS}/build-usb"
    [[ -x ${USB_TOOLS}/build-initrd-uuid-next ]] || die "No ${USB_TOOLS}/build-initrd-uuid-next"
    local name="${dev#/dev/}"
    lsblk -no MOUNTPOINTS "${dev}" | grep -qx / &&
        die "${dev} holds the root filesystem — refusing"
    local removable idbus
    removable=$(cat "/sys/block/${name}/removable" 2>/dev/null || echo 0)
    idbus=$(udevadm info --query=property --name="${dev}" | { grep '^ID_BUS=' || true; } | cut -d= -f2)
    [[ ${removable} == 1 || ${idbus} == usb ]] ||
        die "${dev}: removable=0 and ID_BUS='${idbus:-?}' — refusing to touch an internal disk"

    local p1="${dev}1" p2="${dev}2"
    # desktop automount grabs the stick on plug-in; DATA partitions stay put
    umount "${p1}" "${p2}" 2>/dev/null || true
    if [[ ${wipe} == 1 || $(lsblk -no FSTYPE "${p1}" 2>/dev/null) != vfat \
          || $(lsblk -no FSTYPE "${p2}" 2>/dev/null) != ext4 ]]; then
        # build-usb shows the device, asks its own 'yes', partitions, formats
        # and installs GRUB + grub.cfg (kernel /gentoo, initrd.uuid.cpio.gz)
        "${USB_TOOLS}/build-usb" "${dev}" || die "build-usb failed"
        partprobe "${dev}" 2>/dev/null || true; sleep 1
    else
        info "Reusing existing ESP+LIVE layout on ${dev} (--wipe repartitions, wiping DATA too)"
    fi
    [[ -b ${p1} && -b ${p2} ]] || die "Missing ${p1}/${p2} after layout step"

    local uuid
    uuid=$(lsblk -no UUID "${p2}" | head -n1)
    [[ -n ${uuid} ]] || die "No filesystem UUID on ${p2}"
    info "LIVE partition ${p2}: UUID=${uuid}"
    # the initrd is rebuilt per stick (UUID is baked in); the static busybox
    # it embeds caches in dl/ and survives across profiles and sticks
    mkdir -p "${DL_DIR}/uuid-initrd"
    ( cd "${DL_DIR}/uuid-initrd" &&
      "${USB_TOOLS}/build-initrd-uuid-next" --uuid "${uuid}" \
          --init "${LIVE_INIT}" --tmpfs-mb 8192 ) ||
        die "build-initrd-uuid-next failed"

    local mnt
    mnt=$(mktemp -d /tmp/xstage-usb-XXXXXX)
    trap 'umount "${mnt}" 2>/dev/null || true; rmdir "${mnt}" 2>/dev/null || true' EXIT
    mount "${p1}" "${mnt}" || die "mount ${p1} failed"
    [[ -f ${mnt}/boot/grub/grub.cfg ]] ||
        die "No GRUB on ${p1} — rerun with --wipe"
    info "ESP ${p1}: kernel -> /gentoo, initrd.uuid.cpio.gz"
    command cp -f "${LIVE_BLD}/bzImage" "${mnt}/gentoo"
    command cp -f "${DL_DIR}/uuid-initrd/initrd.uuid.cpio.gz" "${mnt}/initrd.uuid.cpio.gz"
    # stub kernel with builtin initramfs: bootable straight from the firmware
    # menu / efibootmgr without GRUB (kernel EFI stub, no cmdline needed)
    if [[ -f ${LIVE_BLD}/bzImage-stub ]]; then
        mkdir -p "${mnt}/EFI/Gentoo"
        command cp -f "${LIVE_BLD}/bzImage-stub" "${mnt}/EFI/Gentoo/gentoo-stub.efi"
        info "ESP ${p1}: stub kernel -> /EFI/Gentoo/gentoo-stub.efi"
    fi
    umount "${mnt}"
    mount "${p2}" "${mnt}" || die "mount ${p2} failed"
    info "LIVE ${p2}: livecd.squashfs ($(du -h "${LIVE_ISO_DIR}/livecd.squashfs" | cut -f1))"
    command cp -f "${LIVE_ISO_DIR}/livecd.squashfs" "${mnt}/livecd.squashfs"
    sync
    umount "${mnt}"
    trap - EXIT
    rmdir "${mnt}"
    lsblk -o NAME,SIZE,FSTYPE,LABEL,UUID "${dev}"
    info "USB ready: UEFI GRUB on ${p1}, initrd finds ${p2} by UUID=${uuid}."
}

live_status() {
    local rootfs="-" sq="-" krn="-" iso="-" n=0
    [[ -x ${LIVE_ROOT}/bin/bash ]] && rootfs=$(du -sh "${LIVE_ROOT}" 2>/dev/null | cut -f1 || true)
    [[ -f ${LIVE_ISO_DIR}/livecd.squashfs ]] && sq=$(du -h "${LIVE_ISO_DIR}/livecd.squashfs" | cut -f1)
    [[ -f ${LIVE_BLD}/bzImage ]] && krn=$(du -h "${LIVE_BLD}/bzImage" | cut -f1)
    [[ -f ${LIVE_IMG} ]] && iso=$(du -h "${LIVE_IMG}" | cut -f1)
    n=$(live_pkg_list 2>/dev/null | grep -c . || true)
    echo "live   profile:${XPROFILE:-none}  stage3:${LIVE_FLAVOR_NAME}  rc:${LIVE_RC}  tree:${LIVE_BLD#"${REPO}"/}  pkgs:${n}"
    echo "       rootfs:${rootfs}  kernel:${krn}  squashfs:${sq}  iso:${iso}"
}

cmd_live_clean() {
    confirm "Remove ${LIVE_BLD}?"
    command rm -rf "${LIVE_BLD}"
    info "Cleaned live tree."
}

# emerge inside the live image, with the same bind mounts 'pkgs' gets.
# For fixing one package by hand without re-running the whole set, and for
# 'emerge -p' probes that need the image's real config rather than the host's.
cmd_live_emerge() {
    need_root
    [[ $# -gt 0 ]] || die "Usage: $0 ${TGT:-amd64} live-emerge <emerge args...>"
    local args="" a
    for a in "$@"; do args+=" $(printf '%q' "${a}")"; done
    info "emerge${args} (inside ${LIVE_ROOT})"
    live_chroot emerge <<-EOF
	emerge${args}
	EOF
}

# Interactive shell in the live rootfs — for inspecting what 'conf' actually
# wrote (make.conf, package.accept_keywords, repos.conf) and for trying an
# 'emerge -p' by hand before committing to a multi-hour 'pkgs'.
#
# Separate from live_chroot() because that one feeds a script on stdin, which
# leaves the chroot's own stdin unusable for a terminal. Here /dev is rbound
# and no heredoc is in the way, so bash gets a real tty.
cmd_live_enter() {
    need_root
    [[ -x ${LIVE_ROOT}/bin/bash ]] || die "No rootfs — run: sudo $0 ${TGT:-amd64} unpack"
    command cp -f /etc/resolv.conf "${LIVE_ROOT}/etc/resolv.conf"
    mount -t proc  none "${LIVE_ROOT}/proc"
    mount --rbind /sys  "${LIVE_ROOT}/sys";  mount --make-rslave "${LIVE_ROOT}/sys"
    mount --rbind /dev  "${LIVE_ROOT}/dev";  mount --make-rslave "${LIVE_ROOT}/dev"
    live_ccache_mount
    live_distfiles_mount
    live_builddir_mount
    live_binpkgs_mount
    # shellcheck disable=SC2064 — expand ${LIVE_ROOT} now, not at trap time
    trap "live_chroot_umount '${LIVE_ROOT}'" EXIT INT TERM
    info "Entering ${LIVE_ROOT} — 'exit' to leave (mounts are undone on the way out)"
    local rc=0
    # PS1 so a root shell inside the image is never mistaken for the host's.
    # Start in /root, not /: chroot always lands on the new root, and that is
    # both a worse place to work and easy to mistake for the host's /.
    LC_ALL=C.UTF-8 chroot "${LIVE_ROOT}" /bin/bash -c \
        'source /etc/profile >/dev/null 2>&1 || true
         cd /root 2>/dev/null || cd /
         export HOME=/root
         export PS1="(${XPROFILE:-live}) \w \\\$ "
         exec /bin/bash --norc -i' "$@" || rc=$?
    live_chroot_umount "${LIVE_ROOT}"
    trap - EXIT INT TERM
    info "Left the image chroot (exit ${rc})"
    return 0
}

# ---------------------------------------------------------------------------
# tiny track — Buildroot-style minimal rootfs
# ---------------------------------------------------------------------------
CROSS_EMERGE="${TUPLE}-emerge"

need_cross() {
    command -v "${CROSS_EMERGE}" >/dev/null ||
        die "No ${CROSS_EMERGE} — install the crossdev toolchain: sudo xarm setup"
}

cmd_tiny_build() {
    need_root; need_cross
    if [[ -d ${TINY_ROOT} && -n $(ls -A "${TINY_ROOT}" 2>/dev/null) ]]; then
        confirm "Regenerate from scratch (rm -rf ${TINY_ROOT})?"
        command rm -rf "${TINY_ROOT}"
    fi
    mkdir -p "${TINY_ROOT}"

    # portage ignores env USE for USE-dependency constraints (busybox[static]
    # needs libxcrypt[static-libs] in the sysroot) — the flags must live in
    # persistent config, so install our namespaced package.use into the sysroot
    info "Installing tiny USE flags: ${SYSROOT}/etc/portage/package.use/xstage-tiny"
    cp "${HERE}/tiny.portage/package.use" "${SYSROOT}/etc/portage/package.use/xstage-tiny"

    # the Buildroot idea on Gentoo: build in the sysroot, install only the
    # runtime files into ROOT; the target never sees portage (updates happen
    # here, the rootfs is regenerated, never emerged on the device)
    info "baselayout (USE=build lays out the FS skeleton)"
    USE="build" "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
        --usepkg --buildpkg --oneshot -q sys-apps/baselayout
    if [[ ${TINY_BASE} == busybox ]]; then
        info "busybox (static, applet symlinks via USE=make-symlinks)"
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q sys-apps/busybox
    else
        info "Gentoo base userland: ${TINY_BASE_PKGS//$'\n'/ }"
        # INSTALL_MASK keeps the Buildroot spirit: no docs/locales on the target
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        INSTALL_MASK="/usr/share/man /usr/share/doc /usr/share/info /usr/share/locale" \
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q ${TINY_BASE_PKGS}
        # /bin/sh normally comes from app-alternatives/sh — symlink it ourselves
        [[ -e ${TINY_ROOT}/bin/sh ]] || ln -s bash "${TINY_ROOT}/bin/sh"
    fi
    if [[ -n ${TINY_PKGS} ]]; then
        info "Extra packages: ${TINY_PKGS}"
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q ${TINY_PKGS}
    fi

    info "Device nodes + /init"
    mkdir -p "${TINY_ROOT}"/{dev,proc,sys,tmp,root,mnt}
    [[ -e ${TINY_ROOT}/dev/console ]] || mknod "${TINY_ROOT}/dev/console" c 5 1
    [[ -e ${TINY_ROOT}/dev/null ]]    || mknod "${TINY_ROOT}/dev/null" c 1 3
    write_tiny_init
    info "rootfs ready: ${TINY_ROOT} ($(du -sh "${TINY_ROOT}" | cut -f1), $(find "${TINY_ROOT}" | wc -l) entries)"
}

# /init is regenerated by 'build' and again by 'image_zero' (which adds the
# e-Paper tool the hook below looks for) — one function, one source of truth
write_tiny_init() {
    local shell=/bin/sh
    [[ ${TINY_BASE} == busybox ]] || shell=/bin/bash
    cat > "${TINY_ROOT}/init" <<-EOF
	#!/bin/sh
	# tinyroot /init — mount pseudo-filesystems and drop to a shell

	mount -t proc     none /proc
	mount -t sysfs    none /sys
	mount -t devtmpfs none /dev 2>/dev/null || true
	# without devpts an ssh login dies with "PTY allocation request failed"
	mkdir -p /dev/pts
	mount -t devpts devpts /dev/pts 2>/dev/null || true

	# board hook: 'xstage tiny image' / 'image_zero' write the board setup
	# here (ethernet or USB gadget, sshd, e-Paper banner)
	[ -x /etc/tiny-board.sh ] && /etc/tiny-board.sh

	echo
	echo "tinyroot: Gentoo-built ${TINY_BASE} rootfs, no portage inside."
	echo "Boot took \$(cut -d' ' -f1 /proc/uptime) seconds"
	echo

	exec ${shell}
	EOF
    chmod +x "${TINY_ROOT}/init"
}

cmd_tiny_pack() {
    need_root
    [[ -x ${TINY_ROOT}/init ]] || die "No rootfs — run: sudo $0 tiny build"
    command -v mksquashfs >/dev/null || die "No mksquashfs — emerge -av sys-fs/squashfs-tools"
    info "Packing squashfs"
    mksquashfs "${TINY_ROOT}" "${TINY_BLD}/rootfs.squashfs" -comp zstd -noappend -quiet
    info "Packing cpio initrd"
    (cd "${TINY_ROOT}" && find . | cpio --quiet -H newc -o --owner=0.0) \
        > "${TINY_BLD}/initrd"
    # give the artifacts back to the invoking user so 'run' works without sudo
    if [[ -n ${SUDO_UID:-} ]]; then
        chown "${SUDO_UID}:${SUDO_GID}" "${TINY_BLD}/rootfs.squashfs" "${TINY_BLD}/initrd"
    fi
    info "squashfs: $(du -h "${TINY_BLD}/rootfs.squashfs" | cut -f1)  initrd: $(du -h "${TINY_BLD}/initrd" | cut -f1)"
}

cmd_tiny_run() {
    command -v qemu-system-aarch64 >/dev/null ||
        die "No qemu-system-aarch64 — emerge qemu with QEMU_SOFTMMU_TARGETS=aarch64"
    [[ -f ${TINY_BLD}/initrd ]] || die "No initrd — run: sudo $0 tiny pack"
    # borrow xlab's arm64 -M virt kernel; do NOT touch xlab's own artifacts
    [[ -f ${XLAB_KERNEL} ]] ||
        die "No ${XLAB_KERNEL} — build it first: (cd ${REPO} && ./xlab gentoo kernel)"
    # a NIC + host forward, so an image built by 'image_zero' can be ssh-tested
    # here (the board hook falls back to eth0 with qemu's user-net defaults
    # when there is no USB gadget): ssh -p ${SSH_PORT} root@127.0.0.1
    info "Booting tinyroot (-M virt, ssh on 127.0.0.1:${SSH_PORT}; quit qemu: Ctrl-A X)"
    # -m 2048: an initramfs is unpacked into tmpfs, so the guest needs room for
    # the cpio *and* its expansion — a rootfs with the Pi module tree and
    # openssh in it panics ("Unable to mount root fs") at 1024
    exec qemu-system-aarch64 -M virt -cpu cortex-a72 -smp 2 -m 2048 \
        -kernel "${XLAB_KERNEL}" -initrd "${TINY_BLD}/initrd" \
        -append "console=ttyAMA0 init=/init" \
        -netdev "user,id=n0,hostfwd=tcp::${SSH_PORT}-:22" \
        -device virtio-net-device,netdev=n0 \
        -nographic
}

# --- Pi 400 SD-card pipeline ----------------------------------------------
# BCM2711 boot chain: EEPROM (no bootcode.bin on the card) -> start4.elf +
# fixup4.dat on an MBR FAT32 partition 1 -> config.txt -> kernel8.img +
# auto-selected DTB (bcm2711-rpi-400.dtb) + cmdline.txt; partition 2 = rootfs.

cmd_tiny_rpi() {
    need_root; need_cross
    [[ -x ${TINY_ROOT}${TINY_INIT} ]] || die "No rootfs — run: sudo $0 ${ROOT_HINT}"
    # keyword (~arm64) + license (proprietary GPU blobs) accepts, namespaced
    # like package.use/xstage-tiny
    info "Installing Pi keyword/license accepts into the sysroot"
    mkdir -p "${SYSROOT}/etc/portage/package.accept_keywords" \
             "${SYSROOT}/etc/portage/package.license"
    cp "${HERE}/tiny.portage/package.accept_keywords" \
       "${SYSROOT}/etc/portage/package.accept_keywords/xstage-tiny"
    cp "${HERE}/tiny.portage/package.license" \
       "${SYSROOT}/etc/portage/package.license/xstage-tiny"
    info "raspberrypi-image (prebuilt kernel8.img + firmware + DTBs + modules)"
    "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
        --usepkg --buildpkg --oneshot -q sys-kernel/raspberrypi-image
    [[ -f ${TINY_ROOT}/boot/kernel8.img ]] || die "No kernel8.img after emerge"
    [[ -f ${TINY_ROOT}/boot/$(board_dtb) ]] || warn "$(board_dtb) missing?"
    # a sane default inside the rootfs; the authoritative copy is written onto
    # the FAT partition by 'image' / 'image_zero', which know the board
    info "Installing the default config.txt (arm_64bit=1, kernel=kernel8.img, uart on)"
    command cp -f "${HERE}/rpi/config.txt" "${TINY_ROOT}/boot/config.txt"
    info "Pi boot payload ready: $(find "${TINY_ROOT}/boot" -type f | wc -l) files in /boot"
}

no_stale_tiny_loop() {
    # a zombie loop pinned in another mount namespace = a live fs instance
    # still writing over the image ('(deleted)' entries are inert)
    local l
    l=$(losetup -j "${TINY_IMG}" 2>/dev/null | { grep -v '(deleted)' || true; } | cut -d: -f1 | head -1)
    [[ -z ${l} ]] || die "Stale loop ${l} still attached to ${TINY_IMG} — find the holder or reboot"
}

tiny_img_mount() {  # $1 = partition device
    mkdir -p "${TINY_MNT}"
    # mounts under the shared /home tree propagate into sandboxed systemd
    # services' namespaces and can get pinned there (xlab corrupted its image
    # that way on 2026-07-31) — a private bind underneath stops propagation
    mount --bind "${TINY_MNT}" "${TINY_MNT}"
    mount --make-private "${TINY_MNT}"
    if ! mount "$1" "${TINY_MNT}"; then
        umount "${TINY_MNT}"
        die "Mount of $1 failed"
    fi
}

tiny_img_umount() {
    # two layers: the partition mount and the private bind under it
    if mountpoint -q "${TINY_MNT}"; then umount "${TINY_MNT}" || warn "umount ${TINY_MNT} failed"; fi
    if mountpoint -q "${TINY_MNT}"; then umount "${TINY_MNT}" || warn "bind umount ${TINY_MNT} failed"; fi
}

cmd_tiny_image() {
    [[ ${BOARD} != zero2w ]] || die "XSTAGE_BOARD=zero2w — use: $0 tiny image_zero"
    tiny_rpi400_payload; tiny_make_image "${BOARD}"
}
cmd_tiny_image_zero() { tiny_zero_payload; tiny_make_image zero2w; }

# --- shared rootfs extras: modprobe, network, sshd -------------------------
# Both board images get the same test workflow: boot headless, ssh to the
# board. What differs is only /etc/tiny-board.sh (which interface, which
# address) — written by the per-board payload function below.

tiny_net_install() {
    if [[ -x ${TINY_ROOT}/bin/modprobe || -x ${TINY_ROOT}/usr/bin/modprobe ||
          -x ${TINY_ROOT}/sbin/modprobe ]]; then
        info "modprobe already in the rootfs"
    else
        info "kmod (modprobe for the kernel's xz-compressed modules)"
        INSTALL_MASK="/usr/share/man /usr/share/doc /usr/share/info /usr/share/locale" \
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q sys-apps/kmod
    fi

    local netpkgs=()
    [[ -x ${TINY_ROOT}/bin/ip || -x ${TINY_ROOT}/sbin/ip ]] || netpkgs+=(sys-apps/iproute2)
    [[ -x ${TINY_ROOT}/usr/sbin/sshd ]] || netpkgs+=(net-misc/openssh)
    if [[ ${#netpkgs[@]} -gt 0 ]]; then
        info "Network + login: ${netpkgs[*]}"
        INSTALL_MASK="/usr/share/man /usr/share/doc /usr/share/info /usr/share/locale" \
        "${CROSS_EMERGE}" --root="${TINY_ROOT}" --root-deps=rdeps \
            --usepkg --buildpkg --oneshot -q "${netpkgs[@]}"
    else
        info "iproute2 + openssh already in the rootfs"
    fi
    [[ -x ${TINY_ROOT}/usr/sbin/sshd ]] || die "sshd missing after emerge"
}

# --- Pi 400: wired ethernet + sshd -----------------------------------------

tiny_rpi400_payload() {
    need_root; need_cross
    [[ -x ${TINY_ROOT}/init ]] || die "No rootfs — run: sudo $0 tiny build"
    tiny_net_install
    tiny_ssh_config
    tiny_rpi400_board_hook
    write_tiny_init          # /init runs the hook the call above just wrote
}

tiny_rpi400_board_hook() {
    board_eth_vars
    cat > "${TINY_ROOT}/etc/tiny-board.sh" <<-EOF
	#!/bin/sh
	# ${BOARD} board hook — generated by 'xstage tiny image'.
	# Runs from /init: wired ethernet with a fixed address, sshd — a debug
	# console that works even when HDMI shows nothing.
	IP=${ETH_IP}
	GW=${ETH_GW}
	DNS=${ETH_DNS}
	log() { echo "tiny-board: \$*"; }

	echo ${BOARD_TINY_HOSTNAME} > /proc/sys/kernel/hostname

	# --- wired ethernet ---------------------------------------------------
	# board NIC drivers; modprobe is a no-op for built-ins
	for m in ${ETH_MODULES}; do modprobe "\$m" 2>/dev/null; done
	i=0
	while [ ! -e /sys/class/net/eth0 ] && [ \$i -lt 10 ]; do
	    i=\$((i + 1)); sleep 1
	done
	if [ -e /sys/class/net/eth0 ]; then
	    case "\$(readlink /sys/class/net/eth0/device/driver 2>/dev/null)" in
	    *virtio*)
	        # the 'tiny run' (-M virt) gate: virtio-net on slirp — use qemu's
	        # user-net defaults, the LAN address would go nowhere there
	        IP=10.0.2.15/24
	        GW=10.0.2.2
	        log "virtio NIC — qemu user-net defaults" ;;
	    esac
	    ip addr add "\$IP" dev eth0 2>/dev/null
	    ip link set eth0 up
	    ip route add default via "\$GW" 2>/dev/null
	    echo "nameserver \$DNS" > /etc/resolv.conf
	    log "eth0 \$IP via \$GW"
	else
	    log "no eth0 — did the NIC driver load? (${ETH_MODULES}; lsmod, dmesg)"
	fi

	# --- sshd -------------------------------------------------------------
	if [ -x /usr/sbin/sshd ]; then
	    mkdir -p /run /var/empty /var/log
	    # host keys are made on the board, so the image carries no secrets
	    [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
	    if /usr/sbin/sshd; then
	        log "sshd up: ssh root@\${IP%%/*}"
	    else
	        log "sshd failed to start"
	    fi
	fi
	EOF
    chmod +x "${TINY_ROOT}/etc/tiny-board.sh"
}

# --- Pi Zero 2 W + Waveshare 2.13" V4 e-Paper -----------------------------
# Same partition layout as the Pi 400 image; what differs is config.txt (this
# SoC boots bootcode.bin + start.elf, and the HAT needs SPI) and the rootfs
# extras: modprobe, plus the panel driver that /init calls at boot.

tiny_zero_payload() {
    need_root; need_cross
    [[ -x ${TINY_ROOT}/init ]] || die "No rootfs — run: sudo $0 tiny build"

    tiny_net_install

    # the font header is generated from the kernel tree in ../src, not committed
    [[ -f ${HERE}/rpi/font8x16.h ]] || "${HERE}/rpi/mkfont.sh"
    info "Cross-compiling eink213 (SPI + gpiochip v2, no libs beyond libc)"
    "${TUPLE}-gcc" -O2 -Wall -Wextra -s -o "${TINY_ROOT}/usr/bin/eink213" \
        "${HERE}/rpi/eink213v4.c" ||
        die "eink213 build failed"
    info "e-Paper support ready: /usr/bin/eink213 ($(du -h "${TINY_ROOT}/usr/bin/eink213" | cut -f1))"

    tiny_ssh_config
    tiny_zero_board_hook
    write_tiny_init          # /init runs the hook the two calls above just wrote
}

tiny_ssh_config() {
    mkdir -p "${TINY_ROOT}"/{etc/ssh,root/.ssh,var/empty,run}
    chmod 700 "${TINY_ROOT}/root/.ssh"
    # a lab box on a private link: root logs in directly, there is no other
    # account and no PAM — sshd reads /etc/shadow itself
    cat > "${TINY_ROOT}/etc/ssh/sshd_config" <<-EOF
	# generated by xstage (tiny image / image_zero)
	PermitRootLogin yes
	PasswordAuthentication yes
	PermitEmptyPasswords no
	UsePAM no
	PrintMotd no
	Subsystem sftp /usr/lib/misc/sftp-server
	EOF

    # root password: openssl (host side) writes the SHA-512 crypt into the
    # rootfs shadow — no chroot needed, the file format is arch-independent
    local hash
    hash=$(openssl passwd -6 "${ZERO_PASS}") || die "openssl passwd failed"
    sed -i "s|^root:[^:]*:|root:${hash}:|" "${TINY_ROOT}/etc/shadow" ||
        die "could not set the root password in ${TINY_ROOT}/etc/shadow"

    # key login too, if the invoking user has an ed25519 key (or named one)
    local keyfile="${ZERO_KEY}"
    if [[ -z ${keyfile} && -n ${SUDO_USER:-} ]]; then
        keyfile="/home/${SUDO_USER}/.ssh/id_ed25519.pub"
    fi
    if [[ -n ${keyfile} && -f ${keyfile} ]]; then
        command cp -f "${keyfile}" "${TINY_ROOT}/root/.ssh/authorized_keys"
        chmod 600 "${TINY_ROOT}/root/.ssh/authorized_keys"
        info "ssh: root password '${ZERO_PASS}' + key $(basename "${keyfile}")"
    else
        info "ssh: root password '${ZERO_PASS}' (no pubkey found — set XSTAGE_ZERO_KEY=/path/to/key.pub)"
    fi
}

tiny_zero_board_hook() {
    # everything board-specific lives in one script /init calls, so the rootfs
    # itself (and the Pi 400 image built from it) stays generic
    cat > "${TINY_ROOT}/etc/tiny-board.sh" <<-EOF
	#!/bin/sh
	# Pi Zero 2 W board hook — generated by 'xstage tiny image_zero'.
	# Runs from /init: USB-gadget ethernet, sshd, e-Paper banner.
	IP=${ZERO_IP}
	GW=${ZERO_GW}
	DNS=${ZERO_DNS}
	log() { echo "tiny-board: \$*"; }

	echo tinyzero > /proc/sys/kernel/hostname

	# --- USB gadget ethernet ---------------------------------------------
	# dwc2 is built into the Pi kernel and put into peripheral mode by
	# 'dtoverlay=dwc2'; g_ether then presents a CDC/RNDIS NIC to the host.
	# Fixed locally-administered MACs keep the host-side interface name
	# stable across boots. The cable belongs in the USB port, not PWR IN.
	modprobe g_ether dev_addr=02:00:00:00:00:02 host_addr=02:00:00:00:00:01 2>/dev/null
	i=0
	while [ ! -e /sys/class/net/usb0 ] && [ \$i -lt 10 ]; do
	    i=\$((i + 1)); sleep 1
	done
	if [ -e /sys/class/net/usb0 ]; then
	    ip addr add "\$IP" dev usb0 2>/dev/null
	    ip link set usb0 up
	    ip route add default via "\$GW" 2>/dev/null
	    echo "nameserver \$DNS" > /etc/resolv.conf
	    log "usb0 \$IP via \$GW"
	elif [ -e /sys/class/net/eth0 ]; then
	    # qemu -M virt has no USB gadget, but it does have virtio-net on
	    # slirp: these are qemu's own user-net defaults, so 'xstage tiny run'
	    # can exercise sshd with no hardware attached
	    ip addr add 10.0.2.15/24 dev eth0 2>/dev/null
	    ip link set eth0 up
	    ip route add default via 10.0.2.2 2>/dev/null
	    echo "nameserver \$DNS" > /etc/resolv.conf
	    IP=10.0.2.15/24
	    log "no usb0; eth0 10.0.2.15 (qemu user-net)"
	else
	    log "no usb0 — check dtoverlay=dwc2 and use the USB (data) port"
	fi

	# --- sshd -------------------------------------------------------------
	if [ -x /usr/sbin/sshd ]; then
	    mkdir -p /run /var/empty /var/log
	    # host keys are made on the board, so the image carries no secrets
	    [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
	    if /usr/sbin/sshd; then
	        log "sshd up: ssh root@\${IP%%/*}"
	    else
	        log "sshd failed to start"
	    fi
	fi

	# --- e-Paper ----------------------------------------------------------
	# SPI is a module in the Pi kernel and nothing here runs udev
	if [ -x /usr/bin/eink213 ]; then
	    modprobe spi-bcm2835 2>/dev/null
	    modprobe spidev 2>/dev/null
	    if [ -e /dev/spidev0.0 ]; then
	        /usr/bin/eink213 "tinyroot / gentoo" "\$(uname -r)" \\
	            "ssh root@\${IP%%/*}" \\
	            "boot \$(cut -d' ' -f1 /proc/uptime)s" &
	    fi
	fi
	EOF
    chmod +x "${TINY_ROOT}/etc/tiny-board.sh"
}

tiny_make_image() {  # tiny_make_image <rpi400|rpi3|zero2w>
    need_root
    local board="$1" cfg
    case "${board}" in
        rpi400) cfg="${HERE}/rpi/config.txt" ;;
        rpi3)   cfg="${HERE}/rpi/config-rpi3.txt" ;;
        zero2w) cfg="${HERE}/rpi/config-zero2w.txt" ;;
        *)      die "Unknown board: ${board}" ;;
    esac
    [[ -x ${TINY_ROOT}${TINY_INIT} ]] || die "No rootfs — run: sudo $0 ${ROOT_HINT}"
    [[ -f ${TINY_ROOT}/boot/kernel8.img ]] || die "No Pi payload — run: sudo $0 ${TGT} rpi"
    command -v parted >/dev/null || die "No parted — emerge -av sys-block/parted"
    command -v mkfs.vfat >/dev/null || die "No mkfs.vfat — emerge -av sys-fs/dosfstools"
    no_stale_tiny_loop
    info "Creating ${TINY_IMG} for ${board} (${IMG_MB} MiB: ${BOOT_MB} MiB FAT32 boot + ext4 rootfs)"
    command rm -f "${TINY_IMG}"
    truncate -s "${IMG_MB}M" "${TINY_IMG}"
    # MBR (msdos), not GPT: the Pi GPU bootloader expects an MBR FAT32 part 1
    parted --script "${TINY_IMG}" \
        mklabel msdos \
        mkpart primary fat32 1MiB "$((BOOT_MB + 1))MiB" \
        set 1 lba on \
        mkpart primary ext4 "$((BOOT_MB + 1))MiB" 100%
    local loop
    loop=$(losetup -Pf --show "${TINY_IMG}")
    # shellcheck disable=SC2064 — expand ${loop} now, it's gone at trap time
    trap "tiny_img_umount; losetup -d ${loop} 2>/dev/null || true" EXIT INT TERM
    mkfs.vfat -F32 -n RPIBOOT "${loop}p1" >/dev/null
    mkfs.ext4 -q -L "${ROOT_LABEL}" "${loop}p2"
    # MBR disk id -> root=PARTUUID=<id>-02: survives dd, so the identical
    # cmdline works in qemu and on the physical card regardless of mmcblk N
    local ptuuid
    ptuuid=$(blkid -o value -s PTUUID "${loop}")
    [[ -n ${ptuuid} ]] || die "No PTUUID on ${loop}"
    echo "${ptuuid}" > "${TINY_BLD}/ptuuid"

    info "Boot partition: /boot payload + ${board} config.txt + rendered cmdline.txt"
    tiny_img_mount "${loop}p1"
    # plain cp -r: vfat has no owners/modes, cp -a would fail preserving them
    cp -r "${TINY_ROOT}/boot/." "${TINY_MNT}/"
    # the board-specific config wins over whatever 'tiny rpi' left in the rootfs
    command cp -f "${cfg}" "${TINY_MNT}/config.txt"
    sed -e "s/@PTUUID@/${ptuuid}/" -e "s|@INIT@|${TINY_INIT}|" \
        "${HERE}/rpi/cmdline.txt.in" > "${TINY_MNT}/cmdline.txt"
    tiny_img_umount

    info "Root partition: rootfs (minus /boot, which lives on the FAT side)"
    tiny_img_mount "${loop}p2"
    rsync -a --exclude='/boot/*' "${TINY_ROOT}/" "${TINY_MNT}/"
    tiny_img_umount

    losetup -d "${loop}"
    trap - EXIT INT TERM
    echo "${board}" > "${TINY_BOARD_F}"
    if [[ -n ${SUDO_UID:-} ]]; then
        chown "${SUDO_UID}:${SUDO_GID}" "${TINY_IMG}" "${TINY_BLD}/ptuuid" "${TINY_BOARD_F}"
    fi
    info "sd.img ready for ${board}: $(du -h "${TINY_IMG}" | cut -f1) (PARTUUID ${ptuuid}-02)"
}

cmd_tiny_run_rpi() {
    command -v qemu-system-aarch64 >/dev/null ||
        die "No qemu-system-aarch64 — emerge qemu with QEMU_SOFTMMU_TARGETS=aarch64"
    [[ -f ${TINY_IMG} ]] || die "No sd.img — run: sudo $0 ${TGT} image"
    local ptuuid board machine dtb
    ptuuid=$(cat "${TINY_BLD}/ptuuid" 2>/dev/null) || die "No ${TINY_BLD}/ptuuid — rerun: sudo $0 ${TGT} image"
    board=$(cat "${TINY_BOARD_F}" 2>/dev/null || echo rpi400)
    # qemu has no model for either of our boards, so use the closest SoC
    # sibling: raspi4b (BCM2711) for the Pi 400, raspi3b (BCM2837) for the
    # Zero 2 W, whose RP3A0 package holds exactly that die.
    case "${board}" in
        rpi3|zero2w) machine=raspi3b; dtb=bcm2710-rpi-3-b.dtb ;;
        *)           machine=raspi4b; dtb=bcm2711-rpi-4-b.dtb ;;
    esac
    # qemu does not emulate the VideoCore firmware chain: kernel goes in via
    # -kernel and the SD image only provides the root device. The working
    # serial console is ttyAMA1, not ttyAMA0/serial0 as on real hardware.
    # KNOWN QEMU GAP (verified 2026-08-01 on both machines, cf. qemu issue
    # #2969): serial and USB input never reach the guest, with -nographic or
    # with -serial stdio alike — these models are output-only. This subcommand
    # is a BOOT GATE (kernel + PARTUUID root + init reach the bash banner);
    # for an interactive shell use 'tiny run' (-M virt) or the real Pi.
    # -snapshot: guest writes go to a temporary overlay, never to sd.img. The
    # gate boots a rootfs that generates ssh host keys on first boot; without
    # this, every card dd'ed from the image would ship the keys qemu made.
    info "Booting sd.img for ${board} (-M ${machine}, -snapshot; OUTPUT-ONLY — quit qemu: Ctrl-A X)"
    exec qemu-system-aarch64 -M "${machine}" -snapshot \
        -kernel "${TINY_ROOT}/boot/kernel8.img" \
        -dtb "${TINY_ROOT}/boot/${dtb}" \
        -drive "file=${TINY_IMG},format=raw,if=sd" \
        -append "console=ttyAMA1,115200 root=PARTUUID=${ptuuid}-02 rootwait rw init=${TINY_INIT}" \
        -nographic
}

cmd_tiny_sd() {
    need_root
    [[ $# -eq 1 ]] || die "Usage: sudo $0 ${TGT} sd /dev/sdX|/dev/mmcblkN"
    local dev="${1%/}"
    [[ -f ${TINY_IMG} ]] || die "No sd.img — run: sudo $0 ${TGT} image"
    [[ ${dev} =~ ^/dev/(sd[a-z]+|mmcblk[0-9]+)$ ]] ||
        die "Whole device without partition expected, e.g. /dev/sdb or /dev/mmcblk0"
    [[ -b ${dev} ]] || die "Block device not found: ${dev}"
    local name="${dev#/dev/}"
    # never a disk that holds a mounted / (covers LUKS/LVM via the child tree)
    lsblk -no MOUNTPOINTS "${dev}" | grep -qx / &&
        die "${dev} holds the root filesystem — refusing"
    local removable idbus model size
    removable=$(cat "/sys/block/${name}/removable" 2>/dev/null || echo 0)
    idbus=$(udevadm info --query=property --name="${dev}" | { grep '^ID_BUS=' || true; } | cut -d= -f2)
    [[ ${removable} == 1 || ${idbus} == usb || ${idbus} == mmc || ${name} == mmcblk* ]] ||
        die "${dev}: removable=0 and ID_BUS='${idbus:-?}' — refusing to touch an internal disk"
    [[ $(blockdev --getsize64 "${dev}") -ge $(stat -c%s "${TINY_IMG}") ]] ||
        die "${dev} is smaller than ${TINY_IMG}"
    model=$(cat "/sys/block/${name}/device/model" 2>/dev/null || echo '?')
    size=$(lsblk -dno SIZE "${dev}")
    warn "Target: ${dev}  model:${model% }  size:${size}  removable:${removable}  bus:${idbus:-?}"
    confirm "Overwrite ${dev} with ${TINY_IMG} (ALL data on it is lost)?"
    local p
    for p in "${dev}"?*; do
        [[ -b ${p} ]] && umount "${p}" 2>/dev/null || true
    done
    dd if="${TINY_IMG}" of="${dev}" bs=8M conv=fsync status=progress
    sync; partprobe "${dev}" 2>/dev/null || true
    lsblk -o NAME,SIZE,FSTYPE,LABEL "${dev}"
    local board; board=$(cat "${TINY_BOARD_F}" 2>/dev/null || echo rpi400)
    if [[ ${board} == zero2w ]]; then
        info "Done (${board}). Insert into the Pi Zero 2 W and power on: the"
        info "e-Paper HAT shows the boot banner; for a shell attach a 3V3 USB"
        info "serial adapter to GPIO 14/15 (115200 8N1) — HDMI works too."
    elif [[ ${board} == rpi3 ]]; then
        info "Done (${board}). Insert into the Pi 3 and power on: console on"
        info "HDMI + USB keyboard; serial on GPIO 14/15 is the PL011"
        info "(dtoverlay=disable-bt pins it to ttyAMA0, 115200 8N1)."
    else
        info "Done (${board}). Insert into the Pi 400 and power on: console on"
        info "HDMI + built-in keyboard (and serial0 on GPIO 14/15)."
    fi
    # mmcblk0 -> mmcblk0p2, sdf -> sdf2
    local part2="${dev}2"; [[ ${dev} == *[0-9] ]] && part2="${dev}p2"
    info "To use the whole card, grow partition + filesystem:"
    info "  sudo parted ${dev} resizepart 2 100%"
    info "  sudo e2fsck -f ${part2}   # resize2fs refuses without a fresh check"
    info "  sudo resize2fs ${part2}"
}

tiny_status() {
    local tc=ok rootfs="-" sq="-" ird="-" pkgs="-"
    if ! command -v "${CROSS_EMERGE}" >/dev/null 2>&1; then tc=MISSING; fi
    # xarm splits the binpkg cache per portage profile (binpkgs-<profile>);
    # count the one this profile would actually use, not every cache present
    local pkgdir="${SYSROOT}/var/cache/binpkgs-$(echo "${PROFILE#default/linux/}" | tr '/' '-')"
    [[ -d ${pkgdir} ]] || pkgdir="${SYSROOT}/var/cache/binpkgs"   # pre-split layout
    if [[ -d ${pkgdir} ]]; then
        pkgs=$({ find "${pkgdir}" -name '*.gpkg.tar' -o -name '*.tbz2' 2>/dev/null || true; } | wc -l)
    fi
    # du exits non-zero on subdirs unreadable without root but still prints
    # the total — don't let pipefail+set -e turn that into a dead status
    local base="-"
    if [[ -x ${TINY_ROOT}/init ]]; then
        rootfs=$(du -sh "${TINY_ROOT}" 2>/dev/null | cut -f1 || true)
        if [[ -e ${TINY_ROOT}/bin/busybox ]]; then base=busybox; else base=gentoo; fi
    fi
    if [[ -f ${TINY_BLD}/rootfs.squashfs ]]; then sq=$(du -h "${TINY_BLD}/rootfs.squashfs" | cut -f1); fi
    if [[ -f ${TINY_BLD}/initrd ]]; then ird=$(du -h "${TINY_BLD}/initrd" | cut -f1); fi
    local sd="-" rpi=no board="-" eink=no
    if [[ -f ${TINY_IMG} ]]; then
        sd=$(du -h "${TINY_IMG}" | cut -f1)
        board=$(cat "${TINY_BOARD_F}" 2>/dev/null || echo '?')
    fi
    if [[ -f ${TINY_ROOT}/boot/kernel8.img ]]; then rpi=yes; fi
    if [[ -x ${TINY_ROOT}/usr/bin/eink213 ]]; then eink=yes; fi
    echo "tiny   tc:${tc}  sysroot-binpkgs:${pkgs}  base:${base}  rootfs:${rootfs}  squashfs:${sq}  initrd:${ird}"
    echo "       kernel:$([[ -f ${XLAB_KERNEL} ]] && echo ok || echo 'MISSING (./xlab gentoo kernel)')  rpi-payload:${rpi}  eink213:${eink}  sd.img:${sd} (${board})"
}

cmd_tiny_clean() {
    confirm "Remove ${TINY_BLD}?"
    command rm -rf "${TINY_BLD}"
    info "Cleaned tiny."
}

# ---------------------------------------------------------------------------
# arm64 track — stage3 on a Pi 400 SD card, plus building the stage3 itself
# ---------------------------------------------------------------------------
# Two halves. The SD half: unpack a stage3, add the Pi payload and reuse the
# tiny image machinery (the dispatch switched every TINY_* path via
# use_arm64_dirs). Unlike tiny this is a full OpenRC system: PID 1 is
# /sbin/init, networking is netifrc and sshd comes from the stage3 itself —
# no /etc/tiny-board.sh. The build half: the shared amd64 catalyst pipeline
# retargeted by use_arm64_stage_conf (qemu-user interpreter + stages-qemu
# confdir + distcc offload to the crossdev cross-gcc), plus the crossstage
# shortcut. 'seed' is the shared cmd_seed retargeted to the arm64 autobuilds.

# --- catalyst under qemu: setup + preflight --------------------------------

arm64_stage_preflight() {
    [[ -x ${INTERPRETER} ]] ||
        die "No ${INTERPRETER} — emerge app-emulation/qemu with QEMU_USER_TARGETS=aarch64 USE=static-user"
    [[ -f /proc/sys/fs/binfmt_misc/qemu-aarch64 ]] ||
        die "binfmt_misc has no qemu-aarch64 entry — the chroot could not exec arm64 binaries"
    command -v "${TUPLE}-gcc" >/dev/null ||
        die "No ${TUPLE}-gcc — the distcc offload needs the crossdev toolchain: sudo xarm setup"
    # drift heuristic: the chroot emerges its gcc from the same stable tree
    # the host follows, so a major-version gap between cross-gcc and host gcc
    # usually means crossdev needs a rebuild before a long distcc run
    local cg hg
    cg=$("${TUPLE}-gcc" -dumpversion 2>/dev/null | cut -d. -f1)
    hg=$(gcc -dumpversion 2>/dev/null | cut -d. -f1)
    if [[ -z ${cg} || ${cg} != "${hg}" ]]; then
        warn "cross-gcc major '${cg:-?}' vs host gcc major '${hg:-?}' — distcc mixes compiler versions; rebuild crossdev (sudo xarm setup) if the chroot ends up on a different gcc"
    fi
}

cmd_arm64_stage_setup() {
    arm64_stage_preflight
    cmd_setup
}

# --- crossstage: @system at native speed, no catalyst ----------------------
# The Buildroot trick scaled up to a full stage3: cross-emerge the system set
# into a ROOT with the crossdev toolchain (the census cross-compiled all 190
# Pi packages this way), then tar it with the release flags. Lab-grade: no
# update_seed sanity, no releng confdir — but ~1-2 h instead of 6-12.

cmd_arm64_crossstage() {
    need_root; need_cross
    local cs_root="${XDIR}/crossstage/rootfs"
    # The sysroot profile decides what @system means, and the tarball this
    # writes claims ${PROFILE} in its own make.profile symlink — so the two
    # must be the SAME profile, not merely both arm64. An openrc sysroot with
    # a systemd FLAVOR would produce a tarball named systemd, symlinked to the
    # systemd profile, containing an OpenRC @system. xarm owns that symlink;
    # this only refuses to build against the wrong one.
    local prof; prof=$(readlink -f "${SYSROOT}/etc/portage/make.profile" 2>/dev/null || true)
    [[ ${prof} == */arm64/* ]] ||
        die "Sysroot profile '${prof:-unset}' is not arm64 — fix ${SYSROOT}/etc/portage/make.profile (sudo xarm setup)"
    [[ ${prof} == */profiles/${PROFILE} ]] ||
        die "Sysroot profile is '${prof#*/profiles/}' but this build targets '${PROFILE}' (flavour ${FLAVOR}) — run: sudo xarm setup"
    info "Sysroot profile: ${prof#*/profiles/} (flavour ${FLAVOR})"

    if [[ -d ${cs_root} && -n $(ls -A "${cs_root}" 2>/dev/null) ]]; then
        confirm "Regenerate from scratch (rm -rf ${cs_root})?"
        command rm -rf "${cs_root}"
    fi
    mkdir -p "${cs_root}"

    info "cross-emerge @system into ${cs_root} (native speed)"
    "${CROSS_EMERGE}" --root="${cs_root}" --root-deps=rdeps \
        --usepkg --buildpkg --jobs="${JOBS}" -q @system
    [[ -x ${cs_root}/bin/bash ]] || die "No /bin/bash after @system — cross-emerge failed?"
    # the release stage3 ships the same dangling symlink; it resolves once
    # the target syncs ::gentoo
    ln -snf "../../var/db/repos/gentoo/profiles/${PROFILE}" \
        "${cs_root}/etc/portage/make.profile"
    [[ -e ${cs_root}/bin/sh ]] || ln -s bash "${cs_root}/bin/sh"

    local stamp out
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    mkdir -p "${STOREDIR}/builds/${REL_TYPE}"
    out="${STOREDIR}/builds/${REL_TYPE}/stage3-${SUBARCH}-${FLAVOR}-${stamp}-cross.tar.xz"
    info "Packing $(basename "${out}")"
    XZ_OPT="-T0" tar cJpf "${out}" --xattrs --numeric-owner -C "${cs_root}" .
    info "crossstage ready: ${out} ($(du -h "${out}" | cut -f1))"
    info "Image it: XSTAGE_ARM64_TARBALL=${out} sudo $0 arm64 unpack"
}

# --- the SD half -----------------------------------------------------------

arm64_newest_stage3() {
    ls -t "${DL_DIR}/stage3-arm64-${FLAVOR}"-*.tar.xz 2>/dev/null | head -1 || true
}

cmd_arm64_unpack() {
    need_root
    # env override: image a self-built stage3 (catalyst or crossstage tarball
    # from builds/) instead of the downloaded release
    local tarball="${XSTAGE_ARM64_TARBALL:-}"
    if [[ -n ${tarball} ]]; then
        [[ -f ${tarball} ]] || die "XSTAGE_ARM64_TARBALL not found: ${tarball}"
        info "Using XSTAGE_ARM64_TARBALL"
    else
        tarball=$(arm64_newest_stage3)
        [[ -n ${tarball} ]] || die "No stage3-arm64 tarball in ${DL_DIR} — run: $0 arm64 seed"
    fi
    if [[ -d ${TINY_ROOT} ]]; then
        confirm "Remove existing ${TINY_ROOT} and re-unpack?"
        command rm -rf "${TINY_ROOT}"
    fi
    mkdir -p "${TINY_ROOT}"
    info "Unpacking $(basename "${tarball}") (handbook flags: xattrs, numeric owners)"
    tar xpf "${tarball}" -C "${TINY_ROOT}" --xattrs-include='*.*' --numeric-owner
    [[ -x ${TINY_ROOT}${TINY_INIT} ]] ||
        die "No ${TINY_INIT} after unpack — broken tarball, or a stage3 whose flavour is not ${LIVE_FLAVOR_NAME}?"
    info "rootfs ready: ${TINY_ROOT} ($(du -sh "${TINY_ROOT}" 2>/dev/null | cut -f1 || true))"
}

# The systemd half of arm64_configure. Units are enabled by writing the .wants
# symlinks directly rather than by running 'systemctl enable' in a qemu-user
# chroot: 'enable' does exactly this, the symlinks are what the image ships,
# and doing it host-side keeps 'image' free of any binfmt_misc dependency (the
# card can be built on a machine that never registered qemu-aarch64).
arm64_sd_enable() {  # arm64_sd_enable <unit> [target]
    local unit="$1" target="${2:-multi-user.target}"
    local src=""
    local d
    for d in /usr/lib/systemd/system /lib/systemd/system /etc/systemd/system; do
        [[ -f ${TINY_ROOT}${d}/${unit} ]] && { src="${d}/${unit}"; break; }
    done
    if [[ -z ${src} ]]; then
        warn "systemd unit '${unit}' is not in the stage3 — not enabled"
        return 0
    fi
    mkdir -p "${TINY_ROOT}/etc/systemd/system/${target}.wants"
    ln -snf "${src}" "${TINY_ROOT}/etc/systemd/system/${target}.wants/${unit}"
    # what the closing summary reports — a missing unit must not be summarised
    # as if it had been enabled
    SD_ENABLED+="${unit} "
}

arm64_configure_systemd() {
    SD_ENABLED=""
    # A .network file replaces netifrc's /etc/conf.d/net. Match by interface
    # name, which udev keeps stable per board: bcmgenet gives eth0 on the
    # BCM2711, the Pi 3's USB NIC also lands on eth0 (see board_eth_vars).
    mkdir -p "${TINY_ROOT}/etc/systemd/network"
    cat > "${TINY_ROOT}/etc/systemd/network/10-eth0.network" <<-EOF
	# generated by 'xstage arm64 image' (board: ${BOARD})
	[Match]
	Name=eth0

	[Network]
	Address=${ETH_IP}
	Gateway=${ETH_GW}
	DNS=${ETH_DNS}
	EOF

    arm64_sd_enable systemd-networkd.service
    arm64_sd_enable systemd-networkd.socket sockets.target
    # the D-Bus name networkctl talks to; 'systemctl enable' creates this alias
    if [[ -f ${TINY_ROOT}/usr/lib/systemd/system/systemd-networkd.service ]]; then
        ln -snf /usr/lib/systemd/system/systemd-networkd.service \
            "${TINY_ROOT}/etc/systemd/system/dbus-org.freedesktop.network1.service"
    fi
    arm64_sd_enable sshd.service

    # systemd-resolved is deliberately NOT enabled: it would want /etc/resolv.conf
    # to be a symlink into /run, which is one more moving part on a debug image
    # whose whole job is to answer ssh at a fixed address. A static file is
    # enough, and networkd leaves it alone.
    cat > "${TINY_ROOT}/etc/resolv.conf" <<-EOF
	# generated by 'xstage arm64 image' — static, systemd-resolved is off
	nameserver ${ETH_DNS}
	EOF

    # serial and tty1 gettys need no action: systemd-getty-generator reads the
    # console= arguments cmdline.txt already carries and spawns them itself.
    info "eth0 ${ETH_IP} via ${ETH_GW}; units enabled: ${SD_ENABLED:-none}"
}

arm64_configure() {
    need_root
    [[ -x ${TINY_ROOT}${TINY_INIT} ]] || die "No rootfs — run: sudo $0 arm64 unpack"

    # root password: the same host-side hash trick as the tiny ssh images
    local hash
    hash=$(openssl passwd -6 "${ZERO_PASS}") || die "openssl passwd failed"
    sed -i "s|^root:[^:]*:|root:${hash}:|" "${TINY_ROOT}/etc/shadow" ||
        die "could not set the root password in ${TINY_ROOT}/etc/shadow"

    # ssh: root login + the invoker's key; host keys are generated by the
    # sshd init script on first boot, so the image carries no secrets
    mkdir -p "${TINY_ROOT}/etc/ssh/sshd_config.d" "${TINY_ROOT}/root/.ssh"
    chmod 700 "${TINY_ROOT}/root/.ssh"
    echo "PermitRootLogin yes" > "${TINY_ROOT}/etc/ssh/sshd_config.d/50-xstage.conf"
    local keyfile="${ZERO_KEY}"
    if [[ -z ${keyfile} && -n ${SUDO_USER:-} ]]; then
        keyfile="/home/${SUDO_USER}/.ssh/id_ed25519.pub"
    fi
    if [[ -n ${keyfile} && -f ${keyfile} ]]; then
        command cp -f "${keyfile}" "${TINY_ROOT}/root/.ssh/authorized_keys"
        chmod 600 "${TINY_ROOT}/root/.ssh/authorized_keys"
        info "ssh: root password '${ZERO_PASS}' + key $(basename "${keyfile}")"
    else
        info "ssh: root password '${ZERO_PASS}' (no pubkey found — set XSTAGE_ZERO_KEY=/path/to/key.pub)"
    fi

    # A fixed address on eth0 — what the tiny image fakes with a board hook, a
    # stage3 does with the real thing. Which "real thing" depends on the stage3
    # flavour: netifrc under OpenRC, systemd-networkd under systemd.
    board_eth_vars
    echo "${BOARD_SD_HOSTNAME}" > "${TINY_ROOT}/etc/hostname"
    info "Service manager: ${RC_SYSTEM} (stage3 flavour ${LIVE_FLAVOR_NAME})"

    if [[ ${RC_SYSTEM} == systemd ]]; then
        arm64_configure_systemd
    else
        [[ -e ${TINY_ROOT}/etc/init.d/net.lo ]] || warn "netifrc missing in the stage3?"
        cat > "${TINY_ROOT}/etc/conf.d/net" <<-EOF
		# generated by 'xstage arm64 image' (board: ${BOARD})
		config_eth0="${ETH_IP}"
		routes_eth0="default via ${ETH_GW}"
		dns_servers_eth0="${ETH_DNS}"
		EOF
        ln -snf net.lo "${TINY_ROOT}/etc/init.d/net.eth0"
        ln -snf /etc/init.d/net.eth0 "${TINY_ROOT}/etc/runlevels/default/net.eth0"
        ln -snf /etc/init.d/sshd    "${TINY_ROOT}/etc/runlevels/default/sshd"
        echo "hostname=\"${BOARD_SD_HOSTNAME}\"" > "${TINY_ROOT}/etc/conf.d/hostname"
    fi

    # fstab by label — tiny_make_image labels the partitions exactly so
    cat > "${TINY_ROOT}/etc/fstab" <<-EOF
	# generated by 'xstage arm64 image'
	LABEL=RPIBOOT   /boot   vfat    noauto,noatime  0 0
	LABEL=${ROOT_LABEL}  /       ext4    noatime         0 1
	EOF
    info "configured: ${BOARD_SD_HOSTNAME}, eth0 ${ETH_IP} via ${ETH_GW}, ssh on, init ${TINY_INIT}"
}

cmd_arm64_image() {
    [[ ${BOARD} != zero2w ]] || die "XSTAGE_BOARD=zero2w is a tiny-track board — use: $0 tiny image_zero"
    arm64_configure
    tiny_make_image "${BOARD}"
}

arm64_status() {
    local seed="-" rootfs="-" rpi=no sd="-"
    local t; t=$(arm64_newest_stage3)
    [[ -n ${t} ]] && seed=$(basename "${t}")
    if [[ -x ${TINY_ROOT}/sbin/init ]]; then
        rootfs=$(du -sh "${TINY_ROOT}" 2>/dev/null | cut -f1 || true)
    fi
    [[ -f ${TINY_ROOT}/boot/kernel8.img ]] && rpi=yes
    [[ -f ${TINY_IMG} ]] && sd=$(du -h "${TINY_IMG}" | cut -f1)
    echo "arm64  seed:${seed}  rootfs:${rootfs}  rpi-payload:${rpi}  sd.img:${sd}"
    # the build half (needs use_arm64_stage_conf applied by the dispatch)
    local tree="-" specs="-" s1="-" s3="-" dd=down
    t=$(treeish);            [[ -n ${t} ]] && tree=${t:0:12}
    [[ -f ${SPECDIR}/stage1.spec ]] && specs="rendered ($(cat "${STATE}/stamp" 2>/dev/null || echo '?'))"
    t=$(built_stage stage1); [[ -n ${t} ]] && s1=$(du -h "${t}" | cut -f1)
    t=$(built_stage stage3); [[ -n ${t} ]] && s3=$(du -h "${t}" | cut -f1)
    pgrep -x distccd >/dev/null && dd=up
    echo "       catalyst: conf:$([[ -f ${CONF} ]] && echo ok || echo -)  treeish:${tree}  specs:${specs}  stage1:${s1}  stage3:${s3}  distccd:${dd}"
}

cmd_arm64_clean() {
    confirm "Remove ${TINY_BLD}?"
    command rm -rf "${TINY_BLD}"
    info "Cleaned arm64."
}

# ---------------------------------------------------------------------------
# status / targets / dispatch
# ---------------------------------------------------------------------------
cmd_status_all() {
    amd64_status
    live_status
    tiny_status
    ( use_arm64_dirs; use_arm64_stage_conf; arm64_status )
}

cmd_clean_all() {
    # arm64sd* covers the default tree plus every per-profile variant
    # (PROF_BUILD_SUBDIR=arm64sd-<name>)
    local blddir; blddir="$(dirname "${TINY_BLD}")"
    confirm "Clean ALL tracks (catalyst tmp + ${TINY_BLD} + ${blddir}/arm64sd*)?"
    command rm -rf "${STOREDIR}/tmp" "${TINY_BLD}" "${blddir}"/arm64sd*
    info "Cleaned all."
}

cmd_targets() {
    sed -n '/^# Targets:/,/^#$/p' "$0" | sed 's/^# \?//'
}

[[ $# -ge 1 ]] || { help; exit 0; }

case "$1" in
    -h|--help|help) help; exit 0 ;;
    targets)        cmd_targets; exit 0 ;;
    status)         cmd_status_all; exit 0 ;;
    clean)          cmd_clean_all; exit 0 ;;
esac

TGT="$1"; shift
CMD="${1:-status}"; shift || true

case "${TGT}" in
amd64)
    case "${CMD}" in
        status)   amd64_status ;;
        setup)    cmd_setup "$@" ;;
        seed)     cmd_seed "$@" ;;
        snapshot) cmd_snapshot "$@" ;;
        spec)     cmd_spec "$@" ;;
        stage1)   cmd_stage1 "$@" ;;
        stage2)   cmd_stage2 "$@" ;;
        stage3)   cmd_stage3 "$@" ;;
        all)      cmd_all "$@" ;;
        verify)   cmd_verify "$@" ;;
        log)      cmd_log "$@" ;;
        qlop|qlog) cmd_qlop "$@" ;;
        clean)    cmd_clean_amd64 "$@" ;;
        # the live half: stage3 -> squashfs + isolinux ISO. Every one of these
        # writes into build/<live subdir>, so they all refuse a board profile.
        unpack)     need_native_profile; cmd_live_unpack "$@" ;;
        conf)       need_native_profile; cmd_live_conf "$@" ;;
        pkgs)       need_native_profile; cmd_live_pkgs "$@" ;;
        restrict-run) need_native_profile; cmd_live_restrict_run "$@" ;;
        configure)  need_native_profile; cmd_live_configure "$@" ;;
        kernel)     need_native_profile; cmd_live_kernel "$@" ;;
        squash)     need_native_profile; cmd_live_squash "$@" ;;
        isolinux)   need_native_profile; cmd_live_isolinux "$@" ;;
        iso)        need_native_profile; cmd_live_iso "$@" ;;
        live)       need_native_profile; cmd_live_all "$@" ;;
        gate)       need_native_profile; cmd_live_gate "$@" ;;
        usb)        need_native_profile; cmd_live_usb "$@" ;;
        live-enter) need_native_profile; cmd_live_enter "$@" ;;
        live-emerge) need_native_profile; cmd_live_emerge "$@" ;;
        live-status) live_status ;;
        live-clean)  need_native_profile; cmd_live_clean "$@" ;;
        *)        die "Unknown amd64 subcommand: ${CMD} (see: $0 --help)" ;;
    esac ;;
tiny)
    case "${CMD}" in
        status)   tiny_status ;;
        build)    need_board_profile; cmd_tiny_build "$@" ;;
        pack)     cmd_tiny_pack "$@" ;;
        run)      cmd_tiny_run "$@" ;;
        rpi)        need_board_profile; cmd_tiny_rpi "$@" ;;
        image)      need_board_profile; cmd_tiny_image "$@" ;;
        image_zero) need_board_profile; cmd_tiny_image_zero "$@" ;;
        run-rpi)  cmd_tiny_run_rpi "$@" ;;
        sd)       cmd_tiny_sd "$@" ;;
        clean)    cmd_tiny_clean "$@" ;;
        *)        die "Unknown tiny subcommand: ${CMD} (see: $0 --help)" ;;
    esac ;;
arm64)
    use_arm64_dirs
    case "${CMD}" in
        status)   use_arm64_stage_conf; arm64_status ;;
        seed)     use_arm64_stage_conf; cmd_seed "$@" ;;
        unpack)   need_board_profile; cmd_arm64_unpack "$@" ;;
        rpi)      need_board_profile; cmd_tiny_rpi "$@" ;;
        image)    need_board_profile; cmd_arm64_image "$@" ;;
        run-rpi)  cmd_tiny_run_rpi "$@" ;;
        sd)       cmd_tiny_sd "$@" ;;
        clean)    cmd_arm64_clean "$@" ;;
        # the build half: the shared catalyst pipeline, retargeted
        setup)    use_arm64_stage_conf; cmd_arm64_stage_setup "$@" ;;
        snapshot) use_arm64_stage_conf; cmd_snapshot "$@" ;;
        spec)     use_arm64_stage_conf; cmd_spec "$@" ;;
        stage1|stage2|stage3)
                  use_arm64_stage_conf; run_catalyst "${CMD}" ;;
        all)      use_arm64_stage_conf; cmd_all "$@" ;;
        verify)   use_arm64_stage_conf; cmd_verify "$@" ;;
        log)      use_arm64_stage_conf; cmd_log "$@" ;;
        qlop|qlog) use_arm64_stage_conf; cmd_qlop "$@" ;;
        crossstage)
                  need_board_profile; use_arm64_stage_conf; cmd_arm64_crossstage "$@" ;;
        *)        die "Unknown arm64 subcommand: ${CMD} (see: $0 --help)" ;;
    esac ;;
*)  die "Unknown target: ${TGT} (see: $0 targets)" ;;
esac
