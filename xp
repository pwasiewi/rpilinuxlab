#!/bin/bash
# xp — profile dispatcher for the rpilinuxlab scripts (xarm / xstage / xlab)
#
# One environment switch for the whole lab: a profile names a board (or the
# native host), and xp routes tool-agnostic verbs to the right script with the
# right env. Profiles live in <lab>/profiles/*.conf (see profiles/README.md).
#
# Usage:
#   xp <profile> <verb> [args...]        # explicit profile
#   xp <verb> [args...]                  # profile from $XPROFILE (per-tab env)
#   xp profiles                          # list profiles
#   xp <profile> xarm|xstage|xlab [...]  # passthrough escape hatch
#
# Profiles: rpi400, rpi3, zero2w, amd64 (xp profiles → current list)
#
# Verbs, in the order a build runs them.
#
# Stage-building pipeline (catalyst track; 'seed' alone is also what feeds
# 'build' below):
#   setup           xarm setup (board only), then xstage setup          [root]
#   seed            download + verify the stage3 seed for the profile's
#                   flavour (hardened-systemd for the hardened images)  [root]
#   snapshot spec stage1 stage2 stage3 all verify
#                   the rest of the xstage stage pipeline               [root]
#   crossstage      board: no-catalyst fast path (cross-emerge @system) [root]
#
# Board profiles — rootfs to SD card, in order:
#   build           make the rootfs: 'arm64 unpack' (stage3 method) or
#                   'tiny build' (rootfs method)                        [root]
#   rootgcc         align the rootfs' native gcc with the cross
#                   toolchain's major — 'pkgs' refuses until they match  [root]
#   sysroot-prep    OPTIONAL, only needed after a from-scratch sysroot
#                   (xarm clean / fresh setup): cross-emerge
#                   $PROF_SYSROOT_PKGS into the SYSROOT (not the rootfs)
#                   and re-run 'xarm qca-fix' — pre-seeds packages that
#                   'pkgs' resolver can never pull in on its own (BDEPEND-
#                   only tools consumed via cmake find_package, acct-*
#                   groups fowners checks against the sysroot). No-op if
#                   the profile sets no PROF_SYSROOT_PKGS. Safe to skip
#                   when the sysroot already has a completed build in it
#                   (see rpilinuxlab/crosscompile skill for why)         [root]
#   pkgs            cross-emerge $PROF_PKGS into the profile rootfs     [root]
#   update [-n]     full update: sysroot, then rootfs -uDN @world + $PROF_PKGS
#                   (xarm tune, Qt lockstep, PROF_SYSROOT_PKGS, qca-fix,
#                   perl moved in the qemu chroot, stale :=-consumers
#                   rebuilt explicitly; gcc + PROF_UPDATE_EXCLUDE held;
#                   -n = stale lists + both plans)
#                                                                       [root]
#   conf            overlay PROF_BOARD_OVERLAY_DIR layers onto the
#                   rootfs (also runs first inside 'image')             [root]
#   rpi             Pi boot payload into the rootfs                     [root]
#   image           build sd.img                                        [root]
#   gate            boot the result in qemu (output-only)
#   sd DEV          dd sd.img onto a real card                  [root,confirm]
#
# Native profiles — live image (squashfs, the layout bin/v builds), in
# order; or just 'live' for the chain through squash:
#   build | unpack  unpack a stage3 into the live tree                  [root]
#   conf            portage config, repos and the overlay stack into it [root]
#   pkgs            emerge the profile's package list in the chroot     [root]
#   lock ATOM...    hold ATOM (e.g. sys-devel/gcc) at the version the image
#                   already has — package.mask '>ver' inside the chroot, so
#                   repeat 'pkgs' runs keep ccache valid instead of paying
#                   for a compiler bump; no args lists locks. Stored in the
#                   rootfs, so a fresh 'build' (first pass from stage3)
#                   starts unlocked                                     [root]
#   unlock ATOM...|all  release — the next 'pkgs' updates it again      [root]
#   restrict-run    merge PROF_LIVE_RESTRICT_PKGS in their own emerge
#                   runs — fetch-restricted archives and bootstrap
#                   chains kept out of the main 'pkgs' graph            [root]
#   configure       system configuration inside the image              [root]
#   livekernel      genkernel build ('kernel' alone is the xlab verb)   [root]
#   rmkernel VER    drop one kernel from the live tree: sources package,
#                   source tree, modules, /boot payloads       [root,confirm]
#                   VER is the UPSTREAM version (7.2.3), not the
#                   /lib/modules name (7.2.3-zen1-x86_64)
#                   boards: no VER — remove the unowned /lib/modules trees
#                   a SLOT=0 raspberrypi-image upgrade leaves  [root,confirm]
#   squash          livecd.squashfs + sha256 + AIDE baseline            [root]
#   isolinux iso    optional — only the qemu 'gate' needs an ISO        [root]
#   image           native alias for 'iso'                              [root]
#   gate            boot the ISO in qemu (interactive, KVM if available)
#   usb DEV [--wipe] the deliverable: kernel + UUID-initrd -> p1,
#                   squashfs -> p2 of an existing build-usb stick;
#                   --wipe (or no layout) first wipes the whole stick,
#                   repartitions and installs GRUB              [root,confirm]
#
# Working verbs, any point in the flow:
#   enter [sysroot|PATH] [CMD]  board: qemu-user chroot into the profile's
#                   build rootfs (default), the crossdev sysroot, or PATH;
#                   native: an interactive shell in the live image tree [root]
#   emerge ARGS     board: cross-emerge into the sysroot (xarm emerge);
#                   native: emerge inside the live image chroot         [root]
#   1by1 ARGS       xarm 1by1 (board)                                   [root]
#   clean-world -c|-i [ENTRY...] | -g FILE | -a FILE
#                   audit / interactively deselect redundant world entries
#                   (the bin/clean-world tool); -g writes a grouped, review-
#                   able candidate file, -a walks the reviewed file with
#                   per-entry y/N ('yes y |' bulk-accepts). Native
#                   profile: the live image's world; pseudo-profile 'host':
#                   the RUNNING system's — the only verb 'host' takes.
#                   Boards have no world file and are refused    [root for -i]
#   run             xlab run for the profile's xlab target
#   kernel          xlab kernel build (the QEMU lab, not the live image)
#   binhost         serve sysroot binpkgs over HTTP (port from global.conf)
#   distcc ...      xarm distcc start|stop|status
#
# Auxiliary — read-only, any time:
#   status          xarm + xstage + xlab status for the profile
#   log [emerge]    follow the running catalyst build: newest package
#                   log, or the run chroot's emerge.log                 [root]
#   qlop [ARGS]     merge times from the run chroot's emerge.log        [root]
#
# Timing: every long verb runs under the bash 'time' keyword — a
#   ">>>  xp <profile> <verb>: ..." elapsed/user/sys line prints when it ends.
#   Interactive and read-only verbs (enter, status, gate, log, qlop, run,
#   binhost, distcc, the passthroughs) are exempt.
#
# Env:
#   XPROFILE        active profile when no <profile> arg (export per tab)
#   XP_LAB_DIR      lab root override; else /etc/xp.conf, else xp's own dir
#
# Typical flow:
#   export XPROFILE=rpi3
#   sudo xp setup && sudo xp build && sudo xp rpi && sudo xp image
#   xp gate && sudo xp sd /dev/sdX
#   sudo xp rpi400 enter                 # aarch64 shell in the Pi 400 rootfs

set -euo pipefail

die()  { echo "❌  $*" >&2; exit 1; }
info() { echo ">>>  $*"; }
warn() { echo "⚠️   $*" >&2; }
help() { sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \?//'; }

# timed CMD... — replaces exec for the long verbs: run CMD under the bash
# 'time' keyword and exit with its status, so every build step ends with an
# elapsed/user/sys line. Interactive and read-only verbs keep plain exec.
timed() {
    local rc=0
    local TIMEFORMAT=">>>  xp ${PROF} ${VERB}: %lR elapsed (user %lU, sys %lS)"
    time "$@" || rc=$?
    exit "${rc}"
}

# --- lab root discovery: env > /etc/xp.conf > next to this script ----------
if [[ -z ${XP_LAB_DIR:-} && -r /etc/xp.conf ]]; then
    source /etc/xp.conf
fi
if [[ -z ${XP_LAB_DIR:-} ]]; then
    _here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
    [[ -f ${_here}/profiles/global.conf ]] && XP_LAB_DIR="${_here}"
fi
[[ -n ${XP_LAB_DIR:-} && -f ${XP_LAB_DIR}/profiles/global.conf ]] ||
    die "Lab root not found — point /etc/xp.conf at it: echo 'XP_LAB_DIR=/path/to/rpilinuxlab' | sudo tee /etc/xp.conf"
export XP_LAB_DIR
# Data-tree knobs from xp.conf reach xstage/xlab only through the environment:
# with XP_LAB_DIR exported, those scripts skip sourcing xp.conf themselves.
[[ -z ${XP_BUILD_DIR:-} ]] || export XP_BUILD_DIR
[[ -z ${XP_DL_DIR:-} ]] || export XP_DL_DIR
PROFDIR="${XP_LAB_DIR}/profiles"

XSTAGE="${XP_LAB_DIR}/genstage/xstage"
XLAB="${XP_LAB_DIR}/xlab"
xarm_bin() { command -v xarm >/dev/null && echo xarm || echo "${XP_LAB_DIR}/xarm"; }

list_profiles() {
    local f
    for f in "${PROFDIR}"/*.conf; do
        [[ $(basename "${f}") == global.conf ]] && continue
        basename "${f}" .conf
    done
}

# --- argument parsing: $1 is a profile iff profiles/$1.conf exists ---------
[[ $# -ge 1 ]] || { help; exit 0; }
case "$1" in
    -h|--help|help) help; echo "Active XPROFILE: ${XPROFILE:-none}"; exit 0 ;;
    profiles)       list_profiles; exit 0 ;;
esac

# a profile file named like a verb would shadow it — refuse such confs
RESERVED=" status setup enter emerge 1by1 rootgcc sysroot-prep pkgs update lock unlock clean-world seed snapshot spec stage1 stage2 stage3 all verify crossstage log qlop qlog build rpi image gate run kernel livekernel rmkernel sd binhost distcc unpack conf configure restrict-run squash isolinux iso live usb xarm xstage xlab profiles help "

PROF=""
if [[ -f ${PROFDIR}/$1.conf ]]; then
    [[ ${RESERVED} != *" $1 "* ]] ||
        die "Profile name '$1' collides with an xp verb — rename ${PROFDIR}/$1.conf"
    PROF="$1"; shift
    [[ $# -ge 1 ]] || die "Usage: xp ${PROF} <verb> (see: xp --help)"
else
    PROF="${XPROFILE:-}"
    [[ -n ${PROF} ]] || die "No profile: 'xp <profile> <verb>' or export XPROFILE (profiles: $(list_profiles | tr '\n' ' '))"
    [[ -f ${PROFDIR}/${PROF}.conf ]] || die "XPROFILE=${PROF}: no ${PROFDIR}/${PROF}.conf"
fi
VERB="$1"; shift

# --- apply the profile ------------------------------------------------------
source "${PROFDIR}/global.conf"
source "${PROFDIR}/${PROF}.conf"
xprofile_apply
export XPROFILE="${PROF}"
export XPROFILE_FILE="${PROFDIR}/${PROF}.conf"

T="${PROF_XSTAGE_TARGET}"
L="${PROF_XLAB_TARGET}"
is_board() { [[ ${PROF_KIND} == board ]]; }
is_host()  { [[ ${PROF_KIND} == host ]]; }
# the 'host' profile is the running system, not a build tree — only the
# host-maintenance verbs may pass; everything else must die before it can
# touch a real target
if is_host; then
    case "${VERB}" in clean-world) ;; *)
        die "Profile 'host' is the running system — it takes host-maintenance verbs only (clean-world), not '${VERB}'" ;;
    esac
fi
need_board() { is_board || die "'${VERB}' needs a board profile — ${PROF} is native (${PROF_KIND})"; }
need_native() { is_board && die "'${VERB}' is a live-image verb — ${PROF} is a board profile"; return 0; }
no_args() { [[ $# -eq 0 ]] || die "xp ${PROF} ${VERB}: unexpected arguments: $*"; }

# the profile's own rootfs/build tree (variant-aware)
prof_build_dir() {
    local sub="${PROF_BUILD_SUBDIR:-}"
    if [[ -z ${sub} ]]; then
        [[ ${T} == tiny ]] && sub=tinyroot || sub=arm64sd
    fi
    echo "${XP_BUILD_DIR:-${XP_LAB_DIR}/build}/${sub}"
}

# rootgcc_guard ROOT — a cross-emerge COMPILES with the cross gcc and LINKS
# against ITS libstdc++, while the binaries RUN against whatever gcc-config
# selected inside ROOT. A major gap is invisible at build time and fatal on the
# board ("GLIBCXX_3.4.35 not found"), so refuse rather than build something
# unloadable. Not fixed automatically: aligning them can mean an hours-long
# native gcc build, which must not start as a surprise inside another verb.
rootgcc_guard() {
    local xg rg
    xg=$("${PROF_TUPLE}-gcc" -dumpversion 2>/dev/null | cut -d. -f1)
    rg=$(ROOT="$1/" gcc-config -c "${PROF_TUPLE}" 2>/dev/null |
         sed -n "s|^${PROF_TUPLE}-\([0-9]\+\).*|\1|p")
    [[ -z ${xg} || -z ${rg} || ${xg} == "${rg}" ]] ||
        die "$1 is on gcc-${rg}, cross toolchain is gcc-${xg} — cross-built C++ would not load on the board. Run first: sudo xp ${PROF} rootgcc"
}

# sysroot_portageq CMD ARGS — portageq against the crossdev sysroot's own
# config (its profile, keywords and installed db), not the host's. The root
# MUST be portageq's positional argument: with '/' there, ROOT= in the env is
# ignored and match/best_version answer from the HOST's vardb (found
# 2026-10-08: the host's qtwebengine showed up as a sysroot Qt module).
sysroot_portageq() {
    PORTAGE_CONFIGROOT="/usr/${PROF_TUPLE}" \
        portageq "$1" "/usr/${PROF_TUPLE}/" "${@:2}" 2>/dev/null
}

# stale_consumers ROOT — "cat/pn<TAB>dep-cat/pn" for every package installed
# in ROOT whose recorded slot-operator dependency (dep:SLOT/SUB=) no longer
# matches the installed SUB. Portage should schedule those rebuilds itself,
# but in a cross graph (--root-deps=rdeps, and in the sysroot) it does not:
# it reaches for stale binpkgs or tries a downgrade, and the update dies on
# a slot conflict or "no ebuilds to satisfy <dep>:<slot>/<OLD SUB>=" (podman
# vs shadow 0/6, 20 Qt/KDE packages vs qtbase 6.11.1, 2026-10-08). Naming
# them as atoms is what makes the resolver rebuild them.
stale_consumers() {
    python3 - "$1" <<'PYEOF'
import glob, os, re, sys
db = sys.argv[1].rstrip("/") + "/var/db/pkg"
def pn(pf):
    m = re.match(r"(.+?)-(\d.*)$", pf)
    return m.group(1) if m else pf
inst = {}
for d in glob.glob(db + "/*/*"):
    cat, pf = d.split("/")[-2:]
    try:
        slot, _, sub = open(d + "/SLOT").read().strip().partition("/")
    except OSError:
        continue
    inst.setdefault(cat + "/" + pn(pf), {})[slot] = sub or slot
dep_re = re.compile(r"[<>=~]*([a-z0-9-]+/[A-Za-z0-9_+-]+?)(?:-\d[^\s:\[]*)?:([^\s/\[]+)/([^\s=\[]+)=")
out = set()
for d in glob.glob(db + "/*/*"):
    cat, pf = d.split("/")[-2:]
    deps = ""
    for f in ("RDEPEND", "DEPEND"):
        if os.path.exists(d + "/" + f):
            deps += " " + open(d + "/" + f).read()
    for cp, slot, sub in dep_re.findall(deps):
        have = inst.get(cp, {}).get(slot)
        if have and have != sub:
            out.add((cat + "/" + pn(pf), cp))
for me, cp in sorted(out):
    print(me + "\t" + cp)
PYEOF
}

# drop_held "ATOMS" "PATTERNS" — the atoms not matched by any hold pattern
# (globs such as dev-texlive/*); a held atom named explicitly would only turn
# into "masked by: exclude option"
drop_held() {
    local a p keep out=()
    for a in $1; do
        keep=1
        for p in $2; do
            # shellcheck disable=SC2053 — glob match against the hold pattern is intended
            [[ ${a} == ${p} ]] && { keep=0; break; }
        done
        (( keep )) && out+=("${a}")
    done
    echo "${out[*]}"
}

# stale_rebuild ROOT HOLDS — rebuild what stale_consumers still lists, as a
# pass of its own WITHOUT --update. Riding along in the -uDN @world command
# is not enough: --update skips an atom already at its newest version, and a
# stale :=-consumer is exactly that (dolphin, kate, pyqt6 stayed stale after
# a clean world run, 2026-10-09). --usepkg=n: the binpkg of that same version
# is the stale build.
stale_rebuild() {
    local root="$1" holds="$2" atoms rootarg=()
    atoms=$(drop_held "$(stale_consumers "${root}" | cut -f1 | sort -u | tr '\n' ' ')" "${holds}")
    if [[ -z ${atoms// } ]]; then
        info "${root}: no stale :=-consumers left"
        return 0
    fi
    [[ ${root%/} == "/usr/${PROF_TUPLE}" ]] || rootarg=(--root="${root}" --root-deps=rdeps)
    info "${root}: rebuilding stale :=-consumers: ${atoms}"
    # shellcheck disable=SC2086 — word splitting of the atom list is intended
    "${PROF_TUPLE}-emerge" "${rootarg[@]}" --oneshot --usepkg=n --buildpkg --keep-going \
        --with-bdeps=n --ignore-built-slot-operator-deps=y --exclude "${holds}" ${atoms}
}

# perl_align ROOT — a perl subslot bump (5.42 -> 5.44) cannot happen inside a
# cross graph: every dev-perl/*, perl-core/*, virtual/perl-* and :=-bound
# consumer must move in the SAME transaction, and XS modules only build
# natively. Run it as one emerge in the QEMU chroot of ROOT. No-op when perl
# is current and nothing is bound to an old perl subslot. ROOT must carry a
# native gcc (the sysroot and the board rootfs both do).
perl_align() {
    local root="$1" atoms best perl_atom=""
    ls -d "${root}"/var/db/pkg/dev-lang/perl-[0-9]* >/dev/null 2>&1 || return 0
    # best_visible can fail against a root's own config (the board rootfs
    # answers rc=1, empty): then only the stale-consumer check below decides
    best=$(PORTAGE_CONFIGROOT="${root}" portageq best_visible "${root}/" dev-lang/perl 2>/dev/null) || best=""
    [[ -n ${best} ]] && ! PORTAGE_CONFIGROOT="${root}" portageq has_version "${root}/" "=${best}" 2>/dev/null &&
        perl_atom="=${best}"
    atoms=$(stale_consumers "${root}" | awk -F'\t' '$2=="dev-lang/perl"{print $1}' | sort -u | tr '\n' ' ')
    if [[ -z ${perl_atom} && -z ${atoms// } ]]; then
        info "perl in ${root}: current, nothing bound to an old subslot"
        return 0
    fi
    atoms+=" $(cd "${root}/var/db/pkg" && ls -d virtual/perl-* perl-core/* 2>/dev/null | sed -E 's/-[0-9].*//' | sort -u | tr '\n' ' ')"
    info "perl in ${root}: ${perl_atom:-perl current} + $(wc -w <<<"${atoms}") bound packages, one transaction in the qemu chroot"
    # NOT --update: the consumers are already at their newest version and must
    # be REbuilt against the new perl. xarm chroot runs its arguments as
    # bash -lc "$*", so the command goes in as ONE string.
    # The chroot cannot use the root's make.conf as-is when it is a CROSS one
    # (the sysroot's says ROOT=/usr/<tuple>/, CBUILD=x86_64-…,
    # PORTAGE_TMPDIR=${ROOT}tmp/): inside the chroot that ROOT is a real
    # directory (binutils' target dir), so the vardb looked empty (541
    # packages planned for 60) and every ebuild died "merged-usr profile, but
    # disk is split-usr" — ROOT=/ in the ENVIRONMENT reaches the resolver but
    # not the ebuild phases (2026-10-09). So emerge runs on a native COPY of
    # /etc/portage (PORTAGE_CONFIGROOT) with those lines dropped and ${ROOT}
    # paths made absolute; the root's own config is never touched. Harmless
    # on a native rootfs make.conf. NOT proven for the sysroot: emerge there
    # still died on the split-usr check even with this copy (2026-10-09), so
    # 'update' prunes the sysroot's perl modules instead (sysroot_perl_prune)
    # and calls perl_align only for the board rootfs, whose config is native.
    # on a native rootfs make.conf. make.profile is re-pointed absolute: its
    # relative link (../../../../var/db/...) breaks one level deeper.
    # /var/tmp, not /tmp: xarm chroot
    # bind-mounts the host's /tmp over the root's.
    local native
    # shellcheck disable=SC2016 — expanded inside the chroot, not here
    native='N=/var/tmp/xp-native; mkdir -p $N/etc && rm -rf $N/etc/portage && cp -a /etc/portage $N/etc/ && sed -i -E '"'"'/^[[:space:]]*(ROOT|SYSROOT|CBUILD|PORTAGE_TMPDIR)=/d; s#\$\{ROOT\}#/#g'"'"' $N/etc/portage/make.conf && echo PORTAGE_TMPDIR=/var/tmp >> $N/etc/portage/make.conf && ln -sfn "$(readlink -f /etc/portage/make.profile)" $N/etc/portage/make.profile'
    XARM_CHROOT_ROOT="${root}" "$(xarm_bin)" chroot \
        "${native} && PORTAGE_CONFIGROOT=/var/tmp/xp-native emerge --ignore-default-opts --oneshot --usepkg=n --keep-going ${perl_atom} ${atoms}"
}

# sysroot_perl_prune — the SYSROOT's own answer to a perl subslot bump.
# Cross builds run the HOST's perl; dev-perl/*, perl-core/* and virtual/perl-*
# land in the sysroot only as leftovers of earlier cross-emerges, and after
# the sysroot's perl moves (5.42 -> 5.44) they block every later sysroot
# graph. They cannot be rebuilt there either: XS modules only build natively,
# and a qemu chroot of the sysroot runs on its CROSS make.conf, whose ROOT
# (/usr/<tuple>/) exists inside the chroot as binutils' target dir — every
# ebuild then dies "merged-usr profile, but disk is split-usr" (2026-10-09).
# So unmerge them — but only when nothing non-perl in the sysroot depends on
# them and none is in its world file; otherwise stop and say why.
sysroot_perl_prune() {
    local sr="/usr/${PROF_TUPLE}" atoms users inworld
    atoms=$(cd "${sr}/var/db/pkg" 2>/dev/null &&
            ls -d dev-perl/* perl-core/* virtual/perl-* 2>/dev/null | sed -E 's/-[0-9].*//' | sort -u | tr '\n' ' ')
    if [[ -z ${atoms// } ]]; then
        info "sysroot: no perl modules installed — nothing to prune"
        return 0
    fi
    if [[ -z $(stale_consumers "${sr}" | awk -F'\t' '$2=="dev-lang/perl"') ]]; then
        info "sysroot: perl modules match the installed perl — kept"
        return 0
    fi
    users=$(cd "${sr}/var/db/pkg" && grep -lE '(dev-perl|perl-core|virtual/perl-)' ./*/*/RDEPEND ./*/*/DEPEND 2>/dev/null |
            sed -E 's|^\./||; s|/[A-Z]*DEPEND$||' | grep -vE '^(dev-perl|perl-core|virtual)/' | sort -u | tr '\n' ' ') || true
    # no match is the GOOD case: grep exits 1, which pipefail + set -e would turn fatal
    inworld=$(grep -E '^(dev-perl|perl-core|virtual/perl-)' "${sr}/var/lib/portage/world" 2>/dev/null | tr '\n' ' ') || true
    [[ -z ${users// } && -z ${inworld// } ]] ||
        die "sysroot perl modules are bound to the old perl but still needed (users: ${users:-none}; world: ${inworld:-none}) — rebuild them natively, they cannot cross-build"
    info "sysroot: unmerging $(wc -w <<<"${atoms}") stale perl modules (unused there; cross builds run the host's perl)"
    # shellcheck disable=SC2086 — word splitting of the atom list is intended
    "${PROF_TUPLE}-emerge" --unmerge ${atoms}
}

# update_qt_lockstep — bring every installed dev-qt/*:6 in the sysroot to the
# version portage would pick for qtbase, one package at a time.
#
# A plain '-uDN @world' cannot do this (2026-10-08, Qt 6.11.1 -> 6.11.2):
# every Qt module pins ~qtbase-<same ver>, a module in the set RDEPENDs on
# ~qttranslations-<ver>, and qttranslations' cmake needs the SYSROOT's
# Qt6Linguist (from qttools) at that exact version. Portage orders
# qttranslations before qttools, it fails on "Qt6Linguist 6.11.2 requested,
# 6.11.1 found", --keep-going drops the rest, and the sysroot is left
# half-upgraded (qtbase new, everything else old) — after which even
# '-1 qttools' is a slot conflict. --nodeps in this fixed order is the way
# out; it is idempotent, so a rerun after a failure resumes.
update_qt_lockstep() {
    local want have p ver order=()
    want=$(sysroot_portageq best_visible dev-qt/qtbase:6)
    [[ -n ${want} ]] || { info "Qt: no dev-qt/qtbase:6 visible in the sysroot — skipped"; return 0; }
    ver=${want#dev-qt/qtbase-}; ver=${ver%%-r*}
    # every installed Qt 6 module, core ones first, qttools then
    # qttranslations last (qttranslations needs the new Linguist)
    for p in qtbase qtshadertools qtsvg qtdeclarative; do
        [[ -n $(sysroot_portageq best_version "dev-qt/${p}:6") ]] && order+=("${p}")
    done
    while read -r p; do
        case ${p} in qtbase|qtshadertools|qtsvg|qtdeclarative|qttools|qttranslations) continue ;; esac
        order+=("${p}")
    done < <(sysroot_portageq match "dev-qt/*:6" | sed -E 's|^dev-qt/||; s/-[0-9].*//' | sort -u)
    for p in qttools qttranslations; do
        [[ -n $(sysroot_portageq best_version "dev-qt/${p}:6") ]] && order+=("${p}")
    done
    for p in "${order[@]}"; do
        have=$(sysroot_portageq best_version "dev-qt/${p}:6")
        if [[ ${have} == "dev-qt/${p}-${ver}"* ]]; then continue; fi
        info "Qt lockstep: ${have:-dev-qt/${p} (missing)} -> ${ver}"
        EMERGE_DEFAULT_OPTS="" "${PROF_TUPLE}-emerge" --oneshot --nodeps \
            --usepkg --buildpkg "=dev-qt/${p}-${ver}*" ||
            die "Qt lockstep stopped at dev-qt/${p}-${ver} — fix it, then rerun: sudo xp ${PROF} update"
    done
    info "Qt: sysroot modules all at ${ver}"
}

case "${VERB}" in
status)
    no_args "$@"
    if is_board; then "$(xarm_bin)" status || warn "xarm status failed"; fi
    "${XSTAGE}" "${T}" status || warn "xstage status failed"
    is_board || "${XSTAGE}" "${T}" live-status || warn "xstage live-status failed"
    "${XLAB}" "${L}" status || warn "xlab status failed"
    ;;
setup)
    no_args "$@"
    if is_board; then "$(xarm_bin)" setup; fi
    timed "${XSTAGE}" "${T}" setup
    ;;
enter)
    # native profiles have exactly one rootfs — the live image tree — and
    # xstage owns its bind mounts, so hand the whole verb over
    if ! is_board; then no_args "$@"; exec "${XSTAGE}" "${T}" live-enter; fi
    root="$(prof_build_dir)/rootfs"
    case "${1:-}" in
        sysroot) root="/usr/${PROF_TUPLE}"; shift ;;
        /*)      root="$1"; shift ;;
    esac
    if [[ ! -d ${root} ]]; then
        warn "No ${root} yet — falling back to the sysroot /usr/${PROF_TUPLE}"
        root="/usr/${PROF_TUPLE}"
    fi
    XARM_CHROOT_ROOT="${root}" exec "$(xarm_bin)" chroot "$@"
    ;;
emerge|1by1)
    # native profiles have no cross-toolchain: 'emerge' means emerge inside the
    # live image, with the same bind mounts (distfiles, build dir, ccache) that
    # 'pkgs' runs with
    if ! is_board && [[ ${VERB} == emerge ]]; then
        # exit, do not fall through: need_board below would die with
        # "'emerge' needs a board profile" AFTER the live-emerge had already
        # run and succeeded — a non-zero exit and a wrong diagnosis on a
        # working command (found 2026-08-11). 'enter' above avoids this by
        # using exec; 'timed' is a function, so this branch needs an exit.
        timed "${XSTAGE}" "${T}" live-emerge "$@"
        exit $?
    fi
    need_board
    timed "$(xarm_bin)" "${VERB}" "$@"
    ;;
rootgcc)
    need_board; no_args "$@"
    root="$(prof_build_dir)/rootfs"
    [[ -d ${root} ]] || die "No ${root} — run: sudo xp ${PROF} build"
    timed "$(xarm_bin)" rootgcc "${root}"
    ;;
sysroot-prep)
    need_board; no_args "$@"
    # Everything 'pkgs' needs is either in the profile's package.use/env
    # layer (synced automatically) or already sitting in the sysroot from a
    # previous build. The two things that are NEITHER — a from-scratch
    # sysroot has neither — are: (1) packages that are BDEPEND-only in their
    # ebuild (host-resolved by the cross wrapper, so the pkgs resolver never
    # installs them into the sysroot) yet get discovered via cmake
    # find_package() by OTHER cross packages under MODE_PACKAGE=ONLY; and
    # (2) sysroot-local file patches applied after a package installs, which
    # portage has no hook for. Both only bite on a wiped sysroot — see the
    # gentoo-crosscompile skill's pitfalls table for the full mechanism.
    if [[ -z ${PROF_SYSROOT_PKGS:-} ]]; then
        info "Profile ${PROF} sets no PROF_SYSROOT_PKGS — nothing to pre-seed"
    else
        info "Pre-seeding sysroot: ${PROF_SYSROOT_PKGS}"
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        timed "$(xarm_bin)" emerge --oneshot -q ${PROF_SYSROOT_PKGS}
    fi
    # Idempotent and safe even if qca wasn't in PROF_SYSROOT_PKGS or isn't
    # installed yet — re-run once qca lands (e.g. after the real 'pkgs').
    "$(xarm_bin)" qca-fix
    ;;
pkgs)
    no_args "$@"
    # native profiles emerge inside the live chroot (xstage owns that);
    # boards cross-emerge into the rootfs with the crossdev toolchain
    if ! is_board; then timed "${XSTAGE}" "${T}" pkgs; fi
    [[ -n ${PROF_PKGS:-} ]] || die "Profile ${PROF} sets no PROF_PKGS"
    root="$(prof_build_dir)/rootfs"
    [[ -d ${root} ]] || die "No ${root} — run: sudo xp ${PROF} build"
    rootgcc_guard "${root}"
    info "Installing into ${root}: ${PROF_PKGS}"
    # shellcheck disable=SC2086 — word splitting of the package list is intended
    timed "${PROF_TUPLE}-emerge" --root="${root}" --root-deps=rdeps \
        --usepkg --buildpkg --oneshot -q ${PROF_PKGS}
    ;;
update)
    # Full system update of a board: sysroot first (what the cross builds
    # link against), then the rootfs (what goes on the card), with
    # $PROF_PKGS merged on top. 'pkgs' only installs the list; this moves
    # everything. Order and every step below came out of the 2026-10-08
    # rpi400kde Qt 6.11.1->6.11.2 / Plasma 6.6->6.7 update; each one fixed a
    # real failure. Idempotent: after a failure, fix it and rerun.
    need_board
    dry=0
    case "${1:-}" in -n|--pretend) dry=1; shift ;; esac
    no_args "$@"
    [[ -n ${PROF_PKGS:-} ]] || die "Profile ${PROF} sets no PROF_PKGS"
    root="$(prof_build_dir)/rootfs"
    [[ -d ${root} ]] || die "No ${root} — run: sudo xp ${PROF} build"
    rootgcc_guard "${root}"
    # gcc is never updated here: the rootfs gcc must stay on the cross
    # toolchain's major, and moving it is 'rootgcc', an explicit hours-long
    # verb. The profile adds packages it cannot (or will not) move now.
    xa="sys-devel/gcc ${PROF_UPDATE_EXCLUDE:-}"
    xb="${xa} ${PROF_UPDATE_ROOTFS_EXCLUDE:-}"
    # --with-bdeps=n: build-only deps resolve on the host through the cross
    # wrapper; the arch-independent ones cmake finds IN the sysroot
    # (extra-cmake-modules, ...) are PROF_SYSROOT_PKGS, updated in step 3.
    # --ignore-built-slot-operator-deps: the RECORDED :=-subslots of installed
    # packages are what let a held package (cryptography on cffi:0/2.0.0=)
    # block the whole graph. Safe here because every stale :=-consumer is
    # named explicitly below (stale_consumers), which is the only job those
    # recorded subslots would have done (2026-10-09).
    a_args=(-uDN --with-bdeps=n --keep-going --usepkg --buildpkg --ignore-built-slot-operator-deps=y
            --exclude "${xa}" @world)
    # shellcheck disable=SC2206 — word splitting of the package list is intended
    b_args=(--root="${root}" --root-deps=rdeps -uDN --with-bdeps=n --keep-going
            --usepkg --buildpkg --ignore-built-slot-operator-deps=y --exclude "${xb}" @world ${PROF_PKGS})
    # EMERGE_DEFAULT_OPTS="" everywhere: a host --update/--deep would leak in
    export EMERGE_DEFAULT_OPTS=""
    if (( dry )); then
        info "Dry run — sysroot plan, then rootfs plan (the sysroot config is NOT retuned in a dry run)"
        info "sysroot stale :=-consumers: $(stale_consumers "/usr/${PROF_TUPLE}" | cut -f1 | sort -u | tr '\n' ' ')"
        info "rootfs stale :=-consumers: $(stale_consumers "${root}" | cut -f1 | sort -u | tr '\n' ' ')"
        # shellcheck disable=SC2046 — word splitting of the atom lists is intended
        "${PROF_TUPLE}-emerge" -p "${a_args[@]}" $(drop_held "$(stale_consumers "/usr/${PROF_TUPLE}" | cut -f1 | sort -u | tr '\n' ' ')" "${xa}") ||
            warn "sysroot plan did not resolve"
        # shellcheck disable=SC2046
        "${PROF_TUPLE}-emerge" -p "${b_args[@]}" $(drop_held "$(stale_consumers "${root}" | cut -f1 | sort -u | tr '\n' ' ')" "${xb}") ||
            warn "rootfs plan did not resolve"
        exit 0
    fi
    # every step needs its own || die: timed runs this under "|| rc=$?",
    # which switches set -e off inside the function
    update_run() {
        # 1. the sysroot is shared by every ARM profile: point its portage
        #    config at THIS one (xarm tune without XPROFILE wipes fragments)
        info "1/7 xarm tune for ${PROF}"
        XPROFILE="${PROF}" "$(xarm_bin)" tune || die "xarm tune failed"
        # 2. Qt must move as one set, in an order portage will not pick
        info "2/7 Qt lockstep in the sysroot"
        update_qt_lockstep
        # 3. sysroot pre-seed set: cmake-config packages a KF6/Plasma bump
        #    needs at the new version (ECM 6.27 vs "requested 6.29" otherwise)
        if [[ -n ${PROF_SYSROOT_PKGS:-} ]]; then
            info "3/7 updating PROF_SYSROOT_PKGS in the sysroot"
            # shellcheck disable=SC2086
            "${PROF_TUPLE}-emerge" --oneshot -u --usepkg --buildpkg --exclude "${xa}" ${PROF_SYSROOT_PKGS} ||
                die "sysroot pre-seed update failed — fix it, then rerun: sudo xp ${PROF} update"
        fi
        # 4. qca re-merged = host paths back in its cmake export, and the
        #    next KF6 link picks the HOST libqca ("file in wrong format",
        #    kwallet-runtime). Move it now, alone, and repatch before @world.
        if [[ -n $(sysroot_portageq best_version app-crypt/qca) ]]; then
            info "4/7 qca update + qca-fix"
            "${PROF_TUPLE}-emerge" --oneshot -u --usepkg --buildpkg app-crypt/qca ||
                die "qca update failed — fix it, then rerun: sudo xp ${PROF} update"
        fi
        "$(xarm_bin)" qca-fix || die "xarm qca-fix failed"
        # 4b. binpkgs whose version has left the tree: with --usepkg the
        #     resolver reaches for them (qtbase-6.11.1, kio-6.27) to satisfy
        #     stale consumers and the graph ends in a slot conflict. eclean-pkg
        #     without --deep removes exactly those (169 files / 2 GB, 2026-10-09).
        info "4b/7 removing binpkgs whose ebuild left the tree"
        PORTAGE_CONFIGROOT="/usr/${PROF_TUPLE}" eclean-pkg ||
            warn "eclean-pkg failed — stale binpkgs may cause slot conflicts"
        # 5. stale perl modules pruned (sysroot_perl_prune), then the sysroot
        #    world with every remaining stale :=-consumer named as an atom.
        #    Stop on failure: the rootfs builds against the sysroot.
        info "5/7 sysroot: prune stale perl modules, then -uDN @world (excluding: ${xa})"
        sysroot_perl_prune ||
            die "sysroot perl prune failed — fix it, then rerun: sudo xp ${PROF} update"
        stale=$(drop_held "$(stale_consumers "/usr/${PROF_TUPLE}" | cut -f1 | sort -u | tr '\n' ' ')" "${xa}")
        # shellcheck disable=SC2086 — word splitting of the atom list is intended
        "${PROF_TUPLE}-emerge" "${a_args[@]}" ${stale} &&
            stale_rebuild "/usr/${PROF_TUPLE}" "${xa}" ||
            die "sysroot update had failures (see above) — fix them, then rerun: sudo xp ${PROF} update"
        # 6. a qca bump inside step 5 would have undone step 4
        info "6/7 qca-fix"
        "$(xarm_bin)" qca-fix || die "xarm qca-fix failed"
        # 7. the rootfs world + the profile's package list
        # 7. the rootfs: perl alignment, then world + PROF_PKGS + its own
        #    stale :=-consumers
        info "7/7 rootfs: perl alignment, then -uDN @world + PROF_PKGS (excluding: ${xb})"
        perl_align "${root}" ||
            die "rootfs perl alignment failed — fix it, then rerun: sudo xp ${PROF} update"
        stale=$(drop_held "$(stale_consumers "${root}" | cut -f1 | sort -u | tr '\n' ' ')" "${xb}")
        # shellcheck disable=SC2086 — word splitting of the atom list is intended
        "${PROF_TUPLE}-emerge" "${b_args[@]}" ${stale} &&
            stale_rebuild "${root}" "${xb}"
    }
    timed update_run
    ;;
seed|snapshot|spec|stage1|stage2|stage3|all|verify)
    # 'seed' on a native profile fetches the flavour the profile asks for
    # (hardened-openrc for the hardened image, plain openrc otherwise)
    timed "${XSTAGE}" "${T}" "${VERB}" "$@"
    ;;
log|qlop|qlog)
    [[ ${VERB} == qlog ]] && VERB=qlop   # common slip of the finger
    exec "${XSTAGE}" "${T}" "${VERB}" "$@"
    ;;
crossstage)
    need_board
    timed "${XSTAGE}" "${T}" crossstage "$@"
    ;;
build)
    no_args "$@"
    # 'build' means "make the rootfs" on both sides of the lab: unpack a stage3
    # for the live image, unpack/cross-emerge one for a board
    if ! is_board; then timed "${XSTAGE}" "${T}" unpack; fi
    if [[ ${T} == tiny ]]; then timed "${XSTAGE}" tiny build; fi
    timed "${XSTAGE}" "${T}" unpack
    ;;
rpi)
    need_board; no_args "$@"
    timed "${XSTAGE}" "${T}" rpi
    ;;
image)
    no_args "$@"
    # boards produce sd.img; native profiles produce livecd.iso (optional
    # qemu-gate artifact — the native deliverable is 'usb')
    if ! is_board; then timed "${XSTAGE}" "${T}" iso; fi
    timed "${XSTAGE}" "${T}" "${PROF_IMAGE_CMD}"
    ;;
gate)
    no_args "$@"
    if ! is_board; then exec "${XSTAGE}" "${T}" gate; fi
    exec "${XSTAGE}" "${T}" run-rpi
    ;;
# --- live-image verbs (native profiles): the squashfs + isolinux pipeline ---
conf)
    # both kinds since the rpi400kde work: native rsyncs PROF_LIVE_OVERLAY_DIR
    # into the live tree, boards rsync PROF_BOARD_OVERLAY_DIR into the rootfs
    no_args "$@"
    timed "${XSTAGE}" "${T}" conf
    ;;
unpack|configure|squash|isolinux|iso|live|restrict-run)
    need_native; no_args "$@"
    timed "${XSTAGE}" "${T}" "${VERB}"
    ;;
lock|unlock)
    # native-only: the board 'pkgs' resolves against the crossdev sysroot's
    # portage config, not the rootfs, so a rootfs mask would be a silent no-op
    # there. Instant admin ops — no 'timed' line.
    need_native
    exec "${XSTAGE}" "${T}" "${VERB}" "$@"
    ;;
clean-world)
    # one verb, two real targets: profile 'host' audits the running system's
    # world file, a native profile the live image's (xstage adds -r rootfs).
    # Boards refused: their packages are driven by PROF_PKGS + the sysroot,
    # not a world file. Interactive (prompts) — exec, not timed.
    if is_host; then
        cw=$(command -v clean-world || true)
        [[ -n ${cw} ]] || cw="${XP_LAB_DIR}/genstage/live/tools/usr/local/bin/clean-world"
        [[ -x ${cw} ]] || die "clean-world not found on PATH or in the lab's live/tools — run genstage/live/tools-sync.sh"
        exec "${cw}" "$@"
    fi
    need_native
    exec "${XSTAGE}" "${T}" clean-world "$@"
    ;;
livekernel)
    # spelled out, because plain 'kernel' belongs to the xlab QEMU lab
    need_native; no_args "$@"
    timed "${XSTAGE}" "${T}" kernel
    ;;
rmkernel)
    # native: drop one named kernel version from the live tree (argument —
    # xstage does the validating and the confirming). Boards: no argument;
    # removes the unowned /lib/modules/<oldver>* trees a SLOT=0
    # raspberrypi-image upgrade leaves behind ('rpi' warns when they exist).
    if is_board; then
        no_args "$@"
        timed "${XSTAGE}" "${T}" rmkernel
    else
        need_native
        timed "${XSTAGE}" "${T}" rmkernel "$@"
    fi
    ;;
usb)
    need_native
    [[ $# -ge 1 ]] || die "Usage: sudo xp ${PROF} usb /dev/sdX [--wipe]"
    timed "${XSTAGE}" "${T}" usb "$@"
    ;;
run)
    exec "${XLAB}" "${L}" run "$@"
    ;;
kernel)
    timed "${XLAB}" "${L}" kernel "$@"
    ;;
sd)
    need_board
    [[ $# -eq 1 ]] || die "Usage: sudo xp ${PROF} sd /dev/sdX|/dev/mmcblkN"
    timed "${XSTAGE}" "${T}" sd "$1"
    ;;
binhost)
    need_board; no_args "$@"
    exec "$(xarm_bin)" binhost "${LAB_BINHOST_PORT}"
    ;;
distcc)
    need_board
    exec "$(xarm_bin)" distcc "$@"
    ;;
xarm)
    need_board
    exec "$(xarm_bin)" "$@"
    ;;
xstage)
    exec "${XSTAGE}" "$@"
    ;;
xlab)
    exec "${XLAB}" "$@"
    ;;
*)
    die "Unknown verb: ${VERB} (see: xp --help)"
    ;;
esac
