#!/bin/bash
# xp — profile dispatcher for the rpilinuxlab scripts (xarm / xstage / xlab)
#
# One environment switch for the whole lab: a profile names a board (or the
# native host), and xp routes tool-agnostic verbs to the right script with the
# right env. Profiles live in <lab>/profiles/*.conf (see profiles/README.md).
#
# Usage:
#   xp <profile> <verb> [args...]        # explicit profile
#   xp <verb> [args...]                  # profile from $XPROFILE (per-tab env)
#   xp profiles                          # list profiles
#   xp <profile> xarm|xstage|xlab [...]  # passthrough escape hatch
#
# Profiles: rpi400, rpi3, zero2w, amd64 (xp profiles → current list)
#
# Verbs, in the order a build runs them.
#
# Stage-building pipeline (catalyst track; 'seed' alone is also what feeds
# 'build' below):
#   setup           xarm setup (board only), then xstage setup          [root]
#   seed            download + verify the stage3 seed for the profile's
#                   flavour (hardened-systemd for the hardened images)  [root]
#   snapshot spec stage1 stage2 stage3 all verify
#                   the rest of the xstage stage pipeline               [root]
#   crossstage      board: no-catalyst fast path (cross-emerge @system) [root]
#
# Board profiles — rootfs to SD card, in order:
#   build           make the rootfs: 'arm64 unpack' (stage3 method) or
#                   'tiny build' (rootfs method)                        [root]
#   rootgcc         align the rootfs' native gcc with the cross
#                   toolchain's major — 'pkgs' refuses until they match  [root]
#   sysroot-prep    OPTIONAL, only needed after a from-scratch sysroot
#                   (xarm clean / fresh setup): cross-emerge
#                   $PROF_SYSROOT_PKGS into the SYSROOT (not the rootfs)
#                   and re-run 'xarm qca-fix' — pre-seeds packages that
#                   'pkgs' resolver can never pull in on its own (BDEPEND-
#                   only tools consumed via cmake find_package, acct-*
#                   groups fowners checks against the sysroot). No-op if
#                   the profile sets no PROF_SYSROOT_PKGS. Safe to skip
#                   when the sysroot already has a completed build in it
#                   (see rpilinuxlab/crosscompile skill for why)         [root]
#   pkgs            cross-emerge $PROF_PKGS into the profile rootfs     [root]
#   conf            overlay PROF_BOARD_OVERLAY_DIR layers onto the
#                   rootfs (also runs first inside 'image')             [root]
#   rpi             Pi boot payload into the rootfs                     [root]
#   image           build sd.img                                        [root]
#   gate            boot the result in qemu (output-only)
#   sd DEV          dd sd.img onto a real card                  [root,confirm]
#
# Native profiles — live image (squashfs, the layout bin/v builds), in
# order; or just 'live' for the chain through squash:
#   build | unpack  unpack a stage3 into the live tree                  [root]
#   conf            portage config, repos and the overlay stack into it [root]
#   pkgs            emerge the profile's package list in the chroot     [root]
#   restrict-run    merge PROF_LIVE_RESTRICT_PKGS in their own emerge
#                   runs — fetch-restricted archives and bootstrap
#                   chains kept out of the main 'pkgs' graph            [root]
#   configure       system configuration inside the image              [root]
#   livekernel      genkernel build ('kernel' alone is the xlab verb)   [root]
#   rmkernel VER    drop one kernel from the live tree: sources package,
#                   source tree, modules, /boot payloads       [root,confirm]
#   squash          livecd.squashfs + sha256 + AIDE baseline            [root]
#   isolinux iso    optional — only the qemu 'gate' needs an ISO        [root]
#   image           native alias for 'iso'                              [root]
#   gate            boot the ISO in qemu (interactive, KVM if available)
#   usb DEV [--wipe] the deliverable: kernel + UUID-initrd -> p1,
#                   squashfs -> p2 of an existing build-usb stick;
#                   --wipe (or no layout) first wipes the whole stick,
#                   repartitions and installs GRUB              [root,confirm]
#
# Working verbs, any point in the flow:
#   enter [sysroot|PATH] [CMD]  board: qemu-user chroot into the profile's
#                   build rootfs (default), the crossdev sysroot, or PATH;
#                   native: an interactive shell in the live image tree [root]
#   emerge ARGS     board: cross-emerge into the sysroot (xarm emerge);
#                   native: emerge inside the live image chroot         [root]
#   1by1 ARGS       xarm 1by1 (board)                                   [root]
#   run             xlab run for the profile's xlab target
#   kernel          xlab kernel build (the QEMU lab, not the live image)
#   binhost         serve sysroot binpkgs over HTTP (port from global.conf)
#   distcc ...      xarm distcc start|stop|status
#
# Auxiliary — read-only, any time:
#   status          xarm + xstage + xlab status for the profile
#   log [emerge]    follow the running catalyst build: newest package
#                   log, or the run chroot's emerge.log                 [root]
#   qlop [ARGS]     merge times from the run chroot's emerge.log        [root]
#
# Timing: every long verb runs under the bash 'time' keyword — a
#   ">>>  xp <profile> <verb>: ..." elapsed/user/sys line prints when it ends.
#   Interactive and read-only verbs (enter, status, gate, log, qlop, run,
#   binhost, distcc, the passthroughs) are exempt.
#
# Env:
#   XPROFILE        active profile when no <profile> arg (export per tab)
#   XP_LAB_DIR      lab root override; else /etc/xp.conf, else xp's own dir
#
# Typical flow:
#   export XPROFILE=rpi3
#   sudo xp setup && sudo xp build && sudo xp rpi && sudo xp image
#   xp gate && sudo xp sd /dev/sdX
#   sudo xp rpi400 enter                 # aarch64 shell in the Pi 400 rootfs

set -euo pipefail

die()  { echo "❌  $*" >&2; exit 1; }
info() { echo ">>>  $*"; }
warn() { echo "⚠️   $*" >&2; }
help() { sed -n '2,/^set /p' "$0" | grep '^#' | sed 's/^# \?//'; }

# timed CMD... — replaces exec for the long verbs: run CMD under the bash
# 'time' keyword and exit with its status, so every build step ends with an
# elapsed/user/sys line. Interactive and read-only verbs keep plain exec.
timed() {
    local rc=0
    local TIMEFORMAT=">>>  xp ${PROF} ${VERB}: %lR elapsed (user %lU, sys %lS)"
    time "$@" || rc=$?
    exit "${rc}"
}

# --- lab root discovery: env > /etc/xp.conf > next to this script ----------
if [[ -z ${XP_LAB_DIR:-} && -r /etc/xp.conf ]]; then
    source /etc/xp.conf
fi
if [[ -z ${XP_LAB_DIR:-} ]]; then
    _here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
    [[ -f ${_here}/profiles/global.conf ]] && XP_LAB_DIR="${_here}"
fi
[[ -n ${XP_LAB_DIR:-} && -f ${XP_LAB_DIR}/profiles/global.conf ]] ||
    die "Lab root not found — point /etc/xp.conf at it: echo 'XP_LAB_DIR=/path/to/rpilinuxlab' | sudo tee /etc/xp.conf"
export XP_LAB_DIR
# Data-tree knobs from xp.conf reach xstage/xlab only through the environment:
# with XP_LAB_DIR exported, those scripts skip sourcing xp.conf themselves.
[[ -z ${XP_BUILD_DIR:-} ]] || export XP_BUILD_DIR
[[ -z ${XP_DL_DIR:-} ]] || export XP_DL_DIR
PROFDIR="${XP_LAB_DIR}/profiles"

XSTAGE="${XP_LAB_DIR}/genstage/xstage"
XLAB="${XP_LAB_DIR}/xlab"
xarm_bin() { command -v xarm >/dev/null && echo xarm || echo "${XP_LAB_DIR}/xarm"; }

list_profiles() {
    local f
    for f in "${PROFDIR}"/*.conf; do
        [[ $(basename "${f}") == global.conf ]] && continue
        basename "${f}" .conf
    done
}

# --- argument parsing: $1 is a profile iff profiles/$1.conf exists ---------
[[ $# -ge 1 ]] || { help; exit 0; }
case "$1" in
    -h|--help|help) help; echo "Active XPROFILE: ${XPROFILE:-none}"; exit 0 ;;
    profiles)       list_profiles; exit 0 ;;
esac

# a profile file named like a verb would shadow it — refuse such confs
RESERVED=" status setup enter emerge 1by1 rootgcc sysroot-prep pkgs seed snapshot spec stage1 stage2 stage3 all verify crossstage log qlop qlog build rpi image gate run kernel livekernel rmkernel sd binhost distcc unpack conf configure restrict-run squash isolinux iso live usb xarm xstage xlab profiles help "

PROF=""
if [[ -f ${PROFDIR}/$1.conf ]]; then
    [[ ${RESERVED} != *" $1 "* ]] ||
        die "Profile name '$1' collides with an xp verb — rename ${PROFDIR}/$1.conf"
    PROF="$1"; shift
    [[ $# -ge 1 ]] || die "Usage: xp ${PROF} <verb> (see: xp --help)"
else
    PROF="${XPROFILE:-}"
    [[ -n ${PROF} ]] || die "No profile: 'xp <profile> <verb>' or export XPROFILE (profiles: $(list_profiles | tr '\n' ' '))"
    [[ -f ${PROFDIR}/${PROF}.conf ]] || die "XPROFILE=${PROF}: no ${PROFDIR}/${PROF}.conf"
fi
VERB="$1"; shift

# --- apply the profile ------------------------------------------------------
source "${PROFDIR}/global.conf"
source "${PROFDIR}/${PROF}.conf"
xprofile_apply
export XPROFILE="${PROF}"
export XPROFILE_FILE="${PROFDIR}/${PROF}.conf"

T="${PROF_XSTAGE_TARGET}"
L="${PROF_XLAB_TARGET}"
is_board() { [[ ${PROF_KIND} == board ]]; }
need_board() { is_board || die "'${VERB}' needs a board profile — ${PROF} is native (${PROF_KIND})"; }
need_native() { is_board && die "'${VERB}' is a live-image verb — ${PROF} is a board profile"; return 0; }
no_args() { [[ $# -eq 0 ]] || die "xp ${PROF} ${VERB}: unexpected arguments: $*"; }

# the profile's own rootfs/build tree (variant-aware)
prof_build_dir() {
    local sub="${PROF_BUILD_SUBDIR:-}"
    if [[ -z ${sub} ]]; then
        [[ ${T} == tiny ]] && sub=tinyroot || sub=arm64sd
    fi
    echo "${XP_BUILD_DIR:-${XP_LAB_DIR}/build}/${sub}"
}

case "${VERB}" in
status)
    no_args "$@"
    if is_board; then "$(xarm_bin)" status || warn "xarm status failed"; fi
    "${XSTAGE}" "${T}" status || warn "xstage status failed"
    is_board || "${XSTAGE}" "${T}" live-status || warn "xstage live-status failed"
    "${XLAB}" "${L}" status || warn "xlab status failed"
    ;;
setup)
    no_args "$@"
    if is_board; then "$(xarm_bin)" setup; fi
    timed "${XSTAGE}" "${T}" setup
    ;;
enter)
    # native profiles have exactly one rootfs — the live image tree — and
    # xstage owns its bind mounts, so hand the whole verb over
    if ! is_board; then no_args "$@"; exec "${XSTAGE}" "${T}" live-enter; fi
    root="$(prof_build_dir)/rootfs"
    case "${1:-}" in
        sysroot) root="/usr/${PROF_TUPLE}"; shift ;;
        /*)      root="$1"; shift ;;
    esac
    if [[ ! -d ${root} ]]; then
        warn "No ${root} yet — falling back to the sysroot /usr/${PROF_TUPLE}"
        root="/usr/${PROF_TUPLE}"
    fi
    XARM_CHROOT_ROOT="${root}" exec "$(xarm_bin)" chroot "$@"
    ;;
emerge|1by1)
    # native profiles have no cross-toolchain: 'emerge' means emerge inside the
    # live image, with the same bind mounts (distfiles, build dir, ccache) that
    # 'pkgs' runs with
    if ! is_board && [[ ${VERB} == emerge ]]; then
        # exit, do not fall through: need_board below would die with
        # "'emerge' needs a board profile" AFTER the live-emerge had already
        # run and succeeded — a non-zero exit and a wrong diagnosis on a
        # working command (found 2026-08-11). 'enter' above avoids this by
        # using exec; 'timed' is a function, so this branch needs an exit.
        timed "${XSTAGE}" "${T}" live-emerge "$@"
        exit $?
    fi
    need_board
    timed "$(xarm_bin)" "${VERB}" "$@"
    ;;
rootgcc)
    need_board; no_args "$@"
    root="$(prof_build_dir)/rootfs"
    [[ -d ${root} ]] || die "No ${root} — run: sudo xp ${PROF} build"
    timed "$(xarm_bin)" rootgcc "${root}"
    ;;
sysroot-prep)
    need_board; no_args "$@"
    # Everything 'pkgs' needs is either in the profile's package.use/env
    # layer (synced automatically) or already sitting in the sysroot from a
    # previous build. The two things that are NEITHER — a from-scratch
    # sysroot has neither — are: (1) packages that are BDEPEND-only in their
    # ebuild (host-resolved by the cross wrapper, so the pkgs resolver never
    # installs them into the sysroot) yet get discovered via cmake
    # find_package() by OTHER cross packages under MODE_PACKAGE=ONLY; and
    # (2) sysroot-local file patches applied after a package installs, which
    # portage has no hook for. Both only bite on a wiped sysroot — see the
    # gentoo-crosscompile skill's pitfalls table for the full mechanism.
    if [[ -z ${PROF_SYSROOT_PKGS:-} ]]; then
        info "Profile ${PROF} sets no PROF_SYSROOT_PKGS — nothing to pre-seed"
    else
        info "Pre-seeding sysroot: ${PROF_SYSROOT_PKGS}"
        # shellcheck disable=SC2086 — word splitting of the package list is intended
        timed "$(xarm_bin)" emerge --oneshot -q ${PROF_SYSROOT_PKGS}
    fi
    # Idempotent and safe even if qca wasn't in PROF_SYSROOT_PKGS or isn't
    # installed yet — re-run once qca lands (e.g. after the real 'pkgs').
    "$(xarm_bin)" qca-fix
    ;;
pkgs)
    no_args "$@"
    # native profiles emerge inside the live chroot (xstage owns that);
    # boards cross-emerge into the rootfs with the crossdev toolchain
    if ! is_board; then timed "${XSTAGE}" "${T}" pkgs; fi
    [[ -n ${PROF_PKGS:-} ]] || die "Profile ${PROF} sets no PROF_PKGS"
    root="$(prof_build_dir)/rootfs"
    [[ -d ${root} ]] || die "No ${root} — run: sudo xp ${PROF} build"
    # The emerge below COMPILES with the cross gcc and LINKS against ITS
    # libstdc++, while the binaries RUN against whatever gcc-config selected
    # inside the rootfs. A major gap is invisible here and fatal on the board
    # ("GLIBCXX_3.4.35 not found"), so refuse rather than build something
    # unloadable. Not fixed automatically: aligning them can mean an hours-long
    # native gcc build, which must not start as a surprise inside another verb.
    _xg=$("${PROF_TUPLE}-gcc" -dumpversion 2>/dev/null | cut -d. -f1)
    _rg=$(ROOT="${root}/" gcc-config -c "${PROF_TUPLE}" 2>/dev/null |
          sed -n "s|^${PROF_TUPLE}-\([0-9]\+\).*|\1|p")
    [[ -z ${_xg} || -z ${_rg} || ${_xg} == "${_rg}" ]] ||
        die "${root} is on gcc-${_rg}, cross toolchain is gcc-${_xg} — cross-built C++ would not load on the board. Run first: sudo xp ${PROF} rootgcc"
    info "Installing into ${root}: ${PROF_PKGS}"
    # shellcheck disable=SC2086 — word splitting of the package list is intended
    timed "${PROF_TUPLE}-emerge" --root="${root}" --root-deps=rdeps \
        --usepkg --buildpkg --oneshot -q ${PROF_PKGS}
    ;;
seed|snapshot|spec|stage1|stage2|stage3|all|verify)
    # 'seed' on a native profile fetches the flavour the profile asks for
    # (hardened-openrc for the hardened image, plain openrc otherwise)
    timed "${XSTAGE}" "${T}" "${VERB}" "$@"
    ;;
log|qlop|qlog)
    [[ ${VERB} == qlog ]] && VERB=qlop   # common slip of the finger
    exec "${XSTAGE}" "${T}" "${VERB}" "$@"
    ;;
crossstage)
    need_board
    timed "${XSTAGE}" "${T}" crossstage "$@"
    ;;
build)
    no_args "$@"
    # 'build' means "make the rootfs" on both sides of the lab: unpack a stage3
    # for the live image, unpack/cross-emerge one for a board
    if ! is_board; then timed "${XSTAGE}" "${T}" unpack; fi
    if [[ ${T} == tiny ]]; then timed "${XSTAGE}" tiny build; fi
    timed "${XSTAGE}" "${T}" unpack
    ;;
rpi)
    need_board; no_args "$@"
    timed "${XSTAGE}" "${T}" rpi
    ;;
image)
    no_args "$@"
    # boards produce sd.img; native profiles produce livecd.iso (optional
    # qemu-gate artifact — the native deliverable is 'usb')
    if ! is_board; then timed "${XSTAGE}" "${T}" iso; fi
    timed "${XSTAGE}" "${T}" "${PROF_IMAGE_CMD}"
    ;;
gate)
    no_args "$@"
    if ! is_board; then exec "${XSTAGE}" "${T}" gate; fi
    exec "${XSTAGE}" "${T}" run-rpi
    ;;
# --- live-image verbs (native profiles): the squashfs + isolinux pipeline ---
conf)
    # both kinds since the rpi400kde work: native rsyncs PROF_LIVE_OVERLAY_DIR
    # into the live tree, boards rsync PROF_BOARD_OVERLAY_DIR into the rootfs
    no_args "$@"
    timed "${XSTAGE}" "${T}" conf
    ;;
unpack|configure|squash|isolinux|iso|live|restrict-run)
    need_native; no_args "$@"
    timed "${XSTAGE}" "${T}" "${VERB}"
    ;;
livekernel)
    # spelled out, because plain 'kernel' belongs to the xlab QEMU lab
    need_native; no_args "$@"
    timed "${XSTAGE}" "${T}" kernel
    ;;
rmkernel)
    # drop one kernel version from the live tree. Takes an argument, so no
    # no_args here; xstage does the validating and the confirming.
    need_native
    timed "${XSTAGE}" "${T}" rmkernel "$@"
    ;;
usb)
    need_native
    [[ $# -ge 1 ]] || die "Usage: sudo xp ${PROF} usb /dev/sdX [--wipe]"
    timed "${XSTAGE}" "${T}" usb "$@"
    ;;
run)
    exec "${XLAB}" "${L}" run "$@"
    ;;
kernel)
    timed "${XLAB}" "${L}" kernel "$@"
    ;;
sd)
    need_board
    [[ $# -eq 1 ]] || die "Usage: sudo xp ${PROF} sd /dev/sdX|/dev/mmcblkN"
    timed "${XSTAGE}" "${T}" sd "$1"
    ;;
binhost)
    need_board; no_args "$@"
    exec "$(xarm_bin)" binhost "${LAB_BINHOST_PORT}"
    ;;
distcc)
    need_board
    exec "$(xarm_bin)" distcc "$@"
    ;;
xarm)
    need_board
    exec "$(xarm_bin)" "$@"
    ;;
xstage)
    exec "${XSTAGE}" "$@"
    ;;
xlab)
    exec "${XLAB}" "$@"
    ;;
*)
    die "Unknown verb: ${VERB} (see: xp --help)"
    ;;
esac
